  "description": "Status group of the order list (enum order_status_group; members in BR-TEXT-02 细则).",\n        "enum": [\n          "all",\n          "estimating",\n          "credited",\n          "no_rebate"\n        ]\n      },\n      "OrderDisplayStatus": {\n        "type": "string",\n        "description": "User-visible order status (enum display_status; BR-FUND-17); unknown codes map to UNKNOWN.",\n        "enum": [\n          "PAID",\n          "DEPOSIT_PAID",\n          "WAITING",\n          "CREDITING",\n          "REVIEWING",\n          "RIGHTS_PENDING",\n          "CREDITED",\n          "CREDITED_PART_CLAWED",\n          "NO_REBATE",\n          "INVALID",\n          "CLAWED_BACK"\n        ]\n      },\n      "OrderReasonCode": {\n        "type": "string",\n        "description": "Order reason code (enum order_reason); texts and actions come from /v1/dict.",\n        "enum": [\n          "REFUND",\n          "RIGHTS",\n          "PUNISH",\n          "PRESALE_UNPAID",\n          "COMMISSION_ZERO",\n          "OTHER",\n          "BLACKLIST",\n          "PART_REFUND",\n          "PRICE_COMPARE",\n          "PRICE_PROTECT",\n          "SETTLE_DIFF",\n          "NOT_TRACKED",\n          "EXPIRED_CLICK",\n          "OTHER_TLJ",\n          "RELATION_INVALID",\n          "CANCELLED"\n        ]\n      },\n      "OrderTimelineNode": {\n        "type": "string",\n        "description": "Timeline node of the order detail (enum order_timeline_node; BR-TEXT-02 细则「时间线」):\\na pre-sale order starts with deposit_paid and has final_paid instead of paid; invalid /\\nclawed_back / part_clawed_back only when the order reached that state.\\n",\n        "enum": [\n          "deposit_paid",\n          "paid",\n          "final_paid",\n          "received",\n          "credit_expected",\n          "credited",\n          "invalid",\n          "clawed_back",\n          "part_clawed_back"\n        ]\n      },\n      "OrderSummary": {\n        "type": "object",\n        "description": "One row of GET /v1/orders. Exactly one of order_no (my own purchase) and masked_order_no (a\\nshared order); the oneOf branches declare the property they require (strict Ajv2020). A\\nshared order with is_other_product=true has title and image_url null and never the full\\norder_no (BR-TEXT-02 细则\\n「订单的检索范围与分享单的投影」). OrderDetail repeats these fields (kept as two closed\\nobjects; redocly\'s example check closes every allOf member, so no shared allOf base).\\n",\n        "additionalProperties": false,\n        "required": [\n          "order_id",\n          "platform",\n          "title",\n          "image_url",\n          "pay_amount_fen",\n          "quantity",\n          "display_status",\n          "reason",\n          "est_rebate_fen",\n          "paid_at",\n          "is_other_product"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri"\n          },\n          "pay_amount_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "quantity": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "description": "Full platform order number (self-purchase only, copyable)."\n          },\n          "masked_order_no": {\n            "type": "string",\n            "minLength": 1,\n            "description": "Masked by the server (BR-TEXT-02 细则「订单号的显示」); shared orders never carry the full number."\n          },\n          "display_status": {\n            "$ref": "#/components/schemas/OrderDisplayStatus"\n          },\n          "reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/OrderReasonCode"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "est_rebate_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Payment time (the final payment of a pre-sale order); null for a pre-sale order still in\\nDEPOSIT_PAID (BR-ATTR-25 keeps paid_at for the final payment).\\n"\n          },\n          "is_other_product": {\n            "type": "boolean",\n            "description": "A shared order whose bought product is not the shared one."\n          },\n          "is_price_compare": {\n            "type": [\n              "boolean",\n              "null"\n            ],\n            "description": "orders.is_price_compare (04 §6.4, 2026-11-05). true: the client shows the 「比价订单」 tag\\n(text key order.tag.price_compare, BR-TEXT-03; not a display_status, amounts unchanged).\\nSet only from the union order API field (BR-CALC-16); null on a platform whose field is\\nnot yet verified, and the server does not set it before then. null, false or absent:\\nno tag. Optional: added to an existing /v1 shape (contracts/README rule 8).\\n"\n          }\n        },\n        "not": {\n          "type": "object",\n          "additionalProperties": true,\n          "properties": {\n            "is_other_product": {\n              "const": true\n            }\n          },\n          "required": [\n            "is_other_product"\n          ],\n          "anyOf": [\n            {\n              "type": "object",\n              "properties": {\n                "title": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "title"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "image_url": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "image_url"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "order_no": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "order_no"\n              ]\n            }\n          ]\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "order_no": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "order_no"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "masked_order_no": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "masked_order_no"\n            ]\n          }\n        ]\n      },\n      "OrderListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor",\n          "earliest_visible_date"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/OrderSummary"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "earliest_visible_date": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date"\n          },\n          "claim_entry_pinned": {\n            "type": "boolean",\n            "description": "Whether the claim entry is pinned on the order page (J-6). Only with scope=self, absent with scope=share; computed by the server at the current time per BR-ATTR-17 (latest own jump-out at least 30 minutes and at most 72 hours ago and no new order attributed to the user since; a no-rebate purchase counts only under 拍板第二批 TRADE-09). Not the same as show_claim_entry of the pending-track card."\n          }\n        }\n      },\n      "OrderListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OrderListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ClaimStatus": {\n        "type": "string",\n        "description": "Claim status (contracts/enums/order.yaml claim_status; BR-ATTR-16, BR-ATTR-18).",\n        "enum": [\n          "submitted",\n          "auto_matched",\n          "manual_review",\n          "approved",\n          "rejected",\n          "cancelled"\n        ]\n      },\n      "ClaimItemDecision": {\n        "type": "string",\n        "description": "Decision on one child order of a claim (enum claim_item_decision).",\n        "enum": [\n          "approved",\n          "rejected",\n          "cancelled"\n        ]\n      },\n      "ClaimRejectReason": {\n        "type": "string",\n        "description": "Reject reason of a child order (enum claim_reject_reason; NOT_IN_POOL and ORDER_INVALID are set by the system).",\n        "enum": [\n          "NO_EVIDENCE",\n          "EXPIRED_CLICK",\n          "NOT_TRACKED",\n          "OTHER_TLJ",\n          "FRAUD",\n          "OTHER",\n          "NOT_IN_POOL",\n          "ORDER_INVALID"\n        ]\n      },\n      "CreateOrderClaimRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "order_no",\n          "paid_date"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Order number; spaces are removed, then it is matched exactly as a string, first against child order numbers, then against parent order numbers (BR-ATTR-17). For pdd the hyphens are removed from both the input and the stored numbers before comparing; stored and displayed numbers are unchanged. Empty after removing spaces is 20001."\n          },\n          "paid_date": {\n            "type": "string",\n            "format": "date",\n            "description": "Payment date, YYYY-MM-DD in +08:00 (second factor); for a pre-sale order the date the deposit was paid."\n          }\n        }\n      },\n      "OrderClaimItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "sub_order_id",\n          "decision",\n          "reject_reason"\n        ],\n        "properties": {\n          "sub_order_id": {\n            "type": "string",\n            "minLength": 1\n          },\n          "decision": {\n            "description": "null while pending.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ClaimItemDecision"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reject_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ClaimRejectReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "OrderClaim": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "claim_id",\n          "platform",\n          "order_no",\n          "paid_date",\n          "status",\n          "created_at",\n          "items"\n        ],\n        "properties": {\n          "claim_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "order_no": {\n            "type": "string",\n            "description": "The order number as submitted, spaces removed."\n          },\n          "paid_date": {\n            "type": "string",\n            "format": "date"\n          },\n          "status": {\n            "$ref": "#/components/schemas/ClaimStatus"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "items": {\n            "type": "array",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/OrderClaimItem"\n            }\n          }\n        }\n      },\n      "OrderClaimResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OrderClaim"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OrderClaimListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/OrderClaim"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          }\n        }\n      },\n      "OrderClaimListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OrderClaimListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OrderTimelineItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "node",\n          "at",\n          "period"\n        ],\n        "properties": {\n          "node": {\n            "$ref": "#/components/schemas/OrderTimelineNode"\n          },\n          "at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When it happened; null when it has not (shown greyed) or the platform gives no time."\n          },\n          "period": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",\n            "description": "Expected settlement month (YYYY-MM), only on credit_expected; null otherwise."\n          }\n        }\n      },\n      "OrderDetail": {\n        "type": "object",\n        "description": "The list row fields (same as OrderSummary) plus the detail fields of 04 §6.4. product_key\\nis null when is_other_product=true; with is_other_product=true title and image_url are\\nnull too.\\n",\n        "additionalProperties": false,\n        "required": [\n          "order_id",\n          "platform",\n          "title",\n          "image_url",\n          "pay_amount_fen",\n          "quantity",\n          "display_status",\n          "reason",\n          "est_rebate_fen",\n          "paid_at",\n          "is_other_product",\n          "product_key",\n          "reason_action",\n          "timeline",\n          "expected_credit_period",\n          "credit_overdue",\n          "actual_fen",\n          "clawback_fen",\n          "appeal_pending",\n          "is_price_compare"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri"\n          },\n          "pay_amount_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "quantity": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "description": "Full platform order number (self-purchase only, copyable)."\n          },\n          "masked_order_no": {\n            "type": "string",\n            "minLength": 1,\n            "description": "Masked by the server (BR-TEXT-02 细则「订单号的显示」); shared orders never carry the full number."\n          },\n          "display_status": {\n            "$ref": "#/components/schemas/OrderDisplayStatus"\n          },\n          "reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/OrderReasonCode"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "est_rebate_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Payment time (the final payment of a pre-sale order); null for a pre-sale order still in\\nDEPOSIT_PAID (BR-ATTR-25 keeps paid_at for the final payment).\\n"\n          },\n          "is_other_product": {\n            "type": "boolean",\n            "description": "A shared order whose bought product is not the shared one."\n          },\n          "product_key": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ProductKey"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reason_action": {\n            "type": "array",\n            "description": "Action codes of the reason (the order_reason dictionary\'s action[], BR-TEXT-05).",\n            "items": {\n              "type": "string"\n            }\n          },\n          "timeline": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/OrderTimelineItem"\n            }\n          },\n          "expected_credit_period": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n          },\n          "credit_overdue": {\n            "type": "boolean"\n          },\n          "actual_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "clawback_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "appeal_pending": {\n            "type": "boolean"\n          },\n          "is_price_compare": {\n            "type": [\n              "boolean",\n              "null"\n            ]\n          }\n        },\n        "not": {\n          "type": "object",\n          "additionalProperties": true,\n          "properties": {\n            "is_other_product": {\n              "const": true\n            }\n          },\n          "required": [\n            "is_other_product"\n          ],\n          "anyOf": [\n            {\n              "type": "object",\n              "properties": {\n                "title": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "title"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "image_url": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "image_url"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "order_no": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "order_no"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "product_key": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "product_key"\n              ]\n            }\n          ]\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "order_no": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "order_no"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "masked_order_no": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "masked_order_no"\n            ]\n          }\n        ]\n      },\n      "OrderDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OrderDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "PendingTrack": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "link_id",\n          "attempt_id",\n          "platform",\n          "jumped_at",\n          "show_claim_entry",\n          "dismissed"\n        ],\n        "properties": {\n          "link_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "attempt_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "jumped_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "show_claim_entry": {\n            "type": "boolean"\n          },\n          "dismissed": {\n            "type": "boolean"\n          }\n        }\n      },\n      "PendingTracksData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/PendingTrack"\n            }\n          }\n        }\n      },\n      "PendingTracksResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/PendingTracksData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "DismissPendingTrackRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id"\n        ],\n        "properties": {\n          "attempt_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          }\n        }\n      },\n      "ReportPushTokenRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "provider",\n          "token"\n        ],\n        "properties": {\n          "provider": {\n            "type": "string",\n            "description": "Push provider; a string until the provider is chosen (D-14).",\n            "minLength": 1,\n            "maxLength": 32\n          },\n          "token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 4096\n          }\n        }\n      },\n      "BindPhoneRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "code"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          },\n          "code": {\n            "type": "string",\n            "description": "purpose=bind SMS code sent to the new number.",\n            "pattern": "^[0-9]{6}$"\n          }\n        }\n      },\n      "UpdateMeRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "nickname"\n        ],\n        "properties": {\n          "nickname": {\n            "type": "string",\n            "description": "New nickname. The server trims leading and trailing white space and checks the length\\nas 1–16 extended grapheme clusters (BR-ID-39); no minLength / maxLength here because\\nJSON Schema counts code points.\\n"\n          }\n        }\n      },\n      "MergeAccountRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "merge_ticket"\n        ],\n        "properties": {\n          "merge_ticket": {\n            "type": "string",\n            "description": "data.merge_ticket of the 30411 returned by POST /v1/me/phone; valid for 5 minutes and\\nonce. Its format is not part of the contract.\\n",\n            "minLength": 1\n          }\n        }\n      },\n      "BindInviterRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "invite_code"\n        ],\n        "properties": {\n          "invite_code": {\n            "type": "string",\n            "description": "Invite code as typed or pasted. The server normalises it and checks the format\\n(BR-INV-02); an empty or malformed code is 30401 and counts towards the daily limit, so\\nthe schema has no pattern or minLength.\\n",\n            "maxLength": 64\n          }\n        }\n      },\n      "MyInvite": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "can_invite",\n          "invite_code",\n          "landing_url",\n          "poster_url",\n          "direct_count"\n        ],\n        "properties": {\n          "can_invite": {\n            "type": "boolean",\n            "description": "false when inviter_unavailable(self) (BR-INV-02); the reason is not given."\n          },\n          "invite_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "My invite code; null when can_invite=false.",\n            "pattern": "^[2-9A-HJ-NP-Z]{6}$"\n          },\n          "landing_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri",\n            "description": "`{share domain}/i/{invite_code}`, optionally with a channel code parameter; never the\\nUID, phone number or nickname. null when can_invite=false.\\n"\n          },\n          "poster_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri",\n            "description": "Poster image drawn by the server (04 §6.4, TECH-13); null when can_invite=false and\\nwhile poster drawing is not available.\\n"\n          },\n          "direct_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Number of my direct invitees (BR-INV-16); returned even when can_invite=false."\n          }\n        }\n      },\n      "MyInviteResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/MyInvite"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "LandingSmsCodeRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          }\n        }\n      },\n      "LandingRegisterRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "sms_code",\n          "invite_code",\n          "agreed"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          },\n          "sms_code": {\n            "type": "string",\n            "description": "The purpose=login code from POST /v1/landing/sms-codes; a wrong or expired code is\\n20002 / 20003 (BR-ID-05).\\n",\n            "maxLength": 64\n          },\n          "invite_code": {\n            "type": "string",\n            "description": "Invite code of the landing link. Normalised and checked by the server (BR-INV-02); an\\nempty or malformed code is 30401 and counts towards the daily limit, so the schema has\\nno pattern or minLength.\\n",\n            "maxLength": 64\n          },\n          "agreed": {\n            "type": "boolean",\n            "description": "The user agreement and privacy policy box was ticked. false is 10004 with\\ndata.consent_type=agreement, not a validation error; on success the agreement and\\nprivacy consents are recorded with channel h5_landing (BR-INV-05, BR-ID-32).\\n"\n          },\n          "channel": {\n            "type": "string",\n            "description": "Optional channel code of the landing link, kept as the account\'s registered channel\\n(BR-ID-04, BR-INV-05).\\n",\n            "minLength": 1,\n            "maxLength": 32,\n            "pattern": "^[A-Za-z0-9_-]+$"\n          }\n        }\n      },\n      "LandingRegisterData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "result"\n        ],\n        "properties": {\n          "result": {\n            "type": "string",\n            "description": "registered = account created and bound to the inviter; already_registered = the phone\\nalready has an account (in deletion included), nothing changed (BR-INV-05).\\n",\n            "enum": [\n              "registered",\n              "already_registered"\n            ]\n          }\n        }\n      },\n      "LandingRegisterResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/LandingRegisterData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "TipKey": {\n        "type": "string",\n        "description": "One-time tip (enum tip_key; BR-ATTR-21, BR-INV-03 细则). inviter_before_buy is deprecated\\nsince 2026-10-19 (first-purchase inviter tip cancelled): kept and accepted as before, not\\nused by clients, never reused.\\n",\n        "enum": [\n          "jump_tip",\n          "inviter_before_buy"\n        ]\n      },\n      "ResettableTipKey": {\n        "type": "string",\n        "description": "The tip that settings can show again (subset of tip_key).",\n        "enum": [\n          "jump_tip"\n        ]\n      },\n      "MarkTipReadRequest": {\n        "type": "object",\n        "description": "Body of tip_key=jump_tip; tip_key=inviter_before_buy (deprecated 2026-10-19) sends no body.",\n        "additionalProperties": false,\n        "required": [\n          "platform"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          }\n        }\n      },\n      "TipReadAt": {\n        "type": [\n          "string",\n          "null"\n        ],\n        "format": "date-time"\n      },\n      "TipsData": {\n        "type": "object",\n        "description": "Read states of the one-time tips. inviter_before_buy is deprecated since 2026-10-19\\n(first-purchase inviter tip cancelled, BR-INV-03 细则): clients no longer read it; still\\nreturned as before until removed from the contract.\\n",\n        "additionalProperties": false,\n        "required": [\n          "jump_tip",\n          "inviter_before_buy"\n        ],\n        "properties": {\n          "jump_tip": {\n            "type": "object",\n            "description": "read_at per platform; a platform never read is absent or null.",\n            "propertyNames": {\n              "$ref": "#/components/schemas/PlatformCode"\n            },\n            "additionalProperties": {\n              "$ref": "#/components/schemas/TipReadAt"\n            }\n          },\n          "inviter_before_buy": {\n            "$ref": "#/components/schemas/TipReadAt"\n          }\n        }\n      },\n      "TipsResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/TipsData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "DeletionStatus": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml deletion_status (BR-ID-27).",\n        "enum": [\n          "cooling",\n          "processing",\n          "done",\n          "cancelled"\n        ]\n      },\n      "DeletionCancelReason": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml deletion_cancel_reason (04 §3.2 deletion_requests).",\n        "enum": [\n          "user",\n          "negative_balance"\n        ]\n      },\n      "Deletion": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "status",\n          "apply_at",\n          "cooling_until",\n          "can_cancel",\n          "cancelled_at",\n          "cancel_reason",\n          "processed_at"\n        ],\n        "properties": {\n          "status": {\n            "$ref": "#/components/schemas/DeletionStatus"\n          },\n          "apply_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "cooling_until": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "can_cancel": {\n            "type": "boolean",\n            "description": "status=cooling and now before cooling_until (BR-ID-27)."\n          },\n          "cancelled_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "cancel_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/DeletionCancelReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "processed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "DataCopyItem": {\n        "type": "object",\n        "description": "One downloadable personal information copy of mine (no link, no extraction code).",\n        "additionalProperties": false,\n        "required": [\n          "copy_id",\n          "status",\n          "generated_at",\n          "expires_at"\n        ],\n        "properties": {\n          "copy_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml personal_data_copy_status; only ready or delivered are listed.",\n            "enum": [\n              "ready",\n              "delivered"\n            ]\n          },\n          "generated_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time the copy was generated."\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "End of the download period (24 hours after generation, BR-ID-30 ⑨)."\n          }\n        }\n      },\n      "DataCopyList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/DataCopyItem"\n            }\n          }\n        }\n      },\n      "DataCopyListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/DataCopyList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "DataCopyDownload": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "url",\n          "url_expires_at"\n        ],\n        "properties": {\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048,\n            "description": "Signed link to the encrypted file; valid until url_expires_at. Opened with the extraction code from the SMS."\n          },\n          "url_expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "min(5 minutes after signing, the copy\'s expires_at)."\n          }\n        }\n      },\n      "DataCopyDownloadResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/DataCopyDownload"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "DeletionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Deletion"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AppealStatus": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml appeal_status (BR-ID-36).",\n        "enum": [\n          "processing",\n          "upheld",\n          "revoked"\n        ]\n      },\n      "AppealTargetType": {\n        "type": "string",\n        "description": "Subset of contracts/enums/identity.yaml appeal_target_type (04 §6.1, BR-ID-36): the\\nuser-side appeal endpoints take and return account and order only. blocked_request (a\\nwrite request blocked with 44001) is registered by customer service in the admin console\\nonly and is not accepted here (04 §3.2 appeals, §6.1; BR-ID-36 细则「被拦截请求申诉」).\\n",\n        "enum": [\n          "account",\n          "order"\n        ]\n      },\n      "SubmitAppealRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "target_type",\n          "content"\n        ],\n        "properties": {\n          "target_type": {\n            "$ref": "#/components/schemas/AppealTargetType"\n          },\n          "target_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "content": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "Appeal": {\n        "type": "object",\n        "additionalProperties": false,\n        "description": "One of my appeals (04 §3.2 appeals). No deadline_at or handler_id: the processing time\\nlimit is internal only (BR-ID-36 细则).\\n",\n        "required": [\n          "appeal_id",\n          "target_type",\n          "target_id",\n          "status",\n          "content",\n          "created_at",\n          "closed_at",\n          "attempt_no",\n          "can_resubmit"\n        ],\n        "properties": {\n          "appeal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "target_type": {\n            "$ref": "#/components/schemas/AppealTargetType"\n          },\n          "target_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "The order_id when target_type=order. For target_type=account how it is filled is not\\nset by 04 or BR-ID-36.\\n"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AppealStatus"\n          },\n          "content": {\n            "type": "string",\n            "description": "The text the user submitted."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Submission time."\n          },\n          "closed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the appeal was closed (upheld or revoked); null while processing."\n          },\n          "attempt_no": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Which appeal this is for the same target under its current penalty, counting the first\\none (starts at 1); the cap is set by BR-ID-36 and is not sent to the client.\\n"\n          },\n          "can_resubmit": {\n            "type": "boolean",\n            "description": "Computed by the server (BR-ID-36 细则): true only when this is the latest appeal for the\\ntarget, it was upheld, the appeal count for the target\'s current penalty is not used up\\n(same rule as 30418), and the target is still restricted (account still frozen or\\nbanned, order still voided); false otherwise.\\n"\n          }\n        }\n      },\n      "AppealResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/Appeal"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AppealListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/Appeal"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          }\n        }\n      },\n      "AppealListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AppealListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "InviteBackfill": {\n        "type": "object",\n        "additionalProperties": false,\n        "description": "Whether the invite code can still be filled in and until when (computed by the server per\\nBR-INV-07, also for an account without phone; BR-INV-03 细则).\\n",\n        "required": [\n          "eligible",\n          "deadline_at"\n        ],\n        "properties": {\n          "eligible": {\n            "type": "boolean"\n          },\n          "deadline_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "PayoutAccount": {\n        "description": "The current payout account, by payout_method (bank_name only for a bank card).",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/PayoutAccountAlipay"\n          },\n          {\n            "$ref": "#/components/schemas/PayoutAccountBankCard"\n          }\n        ]\n      },\n      "PayoutAccountAlipay": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_account_id",\n          "payout_method",\n          "masked_account",\n          "masked_payee_name",\n          "change_remaining_this_month"\n        ],\n        "properties": {\n          "payout_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "alipay"\n            ]\n          },\n          "masked_account": {\n            "type": "string",\n            "description": "Masked by the server (BR-ID-33 细则「收款账号的脱敏格式」)."\n          },\n          "masked_payee_name": {\n            "type": "string"\n          },\n          "change_remaining_this_month": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "PayoutAccountBankCard": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_account_id",\n          "payout_method",\n          "masked_account",\n          "bank_name",\n          "masked_payee_name",\n          "change_remaining_this_month"\n        ],\n        "properties": {\n          "payout_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "bank_card"\n            ]\n          },\n          "masked_account": {\n            "type": "string",\n            "description": "Masked by the server (BR-ID-33 细则「收款账号的脱敏格式」)."\n          },\n          "bank_name": {\n            "type": "string",\n            "description": "From the card BIN."\n          },\n          "masked_payee_name": {\n            "type": "string"\n          },\n          "change_remaining_this_month": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "PayoutAccountResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "description": "The account, or an empty object when nothing is bound.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/PayoutAccount"\n              },\n              {\n                "$ref": "#/components/schemas/EmptyData"\n              }\n            ]\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "SavePayoutAccountByAlipay": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_method",\n          "alipay_logon_id",\n          "payee_name"\n        ],\n        "properties": {\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "alipay"\n            ]\n          },\n          "alipay_logon_id": {\n            "type": "string",\n            "description": "Alipay logon id (phone or e-mail form), normalised by the server (BR-WDR-02 细则).",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "payee_name": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          }\n        }\n      },\n      "SavePayoutAccountByBankCard": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_method",\n          "card_no",\n          "payee_name"\n        ],\n        "properties": {\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "bank_card"\n            ]\n          },\n          "card_no": {\n            "type": "string",\n            "description": "Card number as typed; the server removes spaces and hyphens, then checks 12–19 digits and\\nLuhn (20001 data.fields=[card_no], BR-WDR-02 ⑥ and 细则).\\n",\n            "minLength": 1,\n            "maxLength": 32\n          },\n          "bank_name": {\n            "type": "string",\n            "description": "Optional and ignored by the server: the opening bank is taken from the card BIN, the\\nuser does not type it (BR-WDR-02 细则「只支持本人名下借记卡」). Accepted so that older\\nclients sending it are not refused.\\n",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "payee_name": {\n            "type": "string",\n            "description": "Account holder name (BR-WDR-02 ①).",\n            "minLength": 1,\n            "maxLength": 64\n          }\n        }\n      },\n      "SavePayoutAccountRequest": {\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/SavePayoutAccountByAlipay"\n          },\n          {\n            "$ref": "#/components/schemas/SavePayoutAccountByBankCard"\n          }\n        ]\n      },\n      "SubmitRealnameRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "name",\n          "id_no"\n        ],\n        "properties": {\n          "name": {\n            "type": "string",\n            "description": "Real name as typed; normalised by the server.",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "id_no": {\n            "type": "string",\n            "description": "18-digit resident ID number as typed. No pattern here: length and check digit are judged\\nby the server (20001 data.fields=[id_no], BR-ID-25) after the phone and consent checks.\\n",\n            "maxLength": 32\n          }\n        }\n      },\n      "SubmitRealnameResult": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "realname_status",\n          "masked_name"\n        ],\n        "properties": {\n          "realname_status": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml realname_status; always verified on success.",\n            "enum": [\n              "verified"\n            ]\n          },\n          "masked_name": {\n            "type": "string",\n            "description": "Masked by the server (BR-ID-33)."\n          }\n        }\n      },\n      "SubmitRealnameResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/SubmitRealnameResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "LaborAgreement": {\n        "type": "object",\n        "description": "Currently effective labor agreement and the user\'s signing state (BR-WDR-31).",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "text_url",\n          "text_sha256",\n          "need_sign",\n          "signed_version",\n          "signed_at"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Currently effective version."\n          },\n          "text_url": {\n            "type": "string",\n            "format": "uri",\n            "description": "Address of the full text of that version."\n          },\n          "text_sha256": {\n            "type": "string",\n            "description": "Lower-case hex sha256 of that version\'s text.",\n            "pattern": "^[0-9a-f]{64}$"\n          },\n          "need_sign": {\n            "type": "boolean",\n            "description": "True when the user has never signed, or the latest signature\'s version is below the\\nre-sign threshold (resign_from_version); a higher current version below the threshold\\ndoes not require signing again (08 BR-WDR-31).\\n"\n          },\n          "signed_version": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Version of the latest signature (may be below the current version when no re-signing\\nis required); null when never signed.\\n"\n          },\n          "signed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Server time of the latest signature; null when never signed."\n          }\n        }\n      },\n      "LaborAgreementResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/LaborAgreement"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "SignLaborAgreementRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "text_sha256",\n          "agreed"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "description": "The version shown to the user (GET /v1/me/labor-agreement); must be the current one."\n          },\n          "text_sha256": {\n            "type": "string",\n            "description": "sha256 of the text shown; must match that version (20001 data.fields=[text_sha256])."\n          },\n          "agreed": {\n            "type": "boolean",\n            "description": "Must be true; the server returns 20001 data.fields=[agreed] otherwise."\n          }\n        }\n      },\n      "AgreementType": {\n        "type": "string",\n        "description": "Agreement type (04 §6.2 agreements.type; 01 §4.2). sdk_list (the SDK list) and collect_list\\n(the personal information collection list) are versioned public notices only: published\\nlike the others (BR-ID-12) but taking no part in consent (D10-465) — min_version always\\nequals version, never in first-launch consent, re-consent or re-signing, and never listed\\nby GET /v1/agreements. Consent and signing fields keep their own types without these two.\\n",\n        "enum": [\n          "privacy",\n          "agreement",\n          "labor_agreement",\n          "sdk_list",\n          "collect_list"\n        ]\n      },\n      "PublicAgreement": {\n        "type": "object",\n        "description": "The currently effective version of the privacy policy or the user agreement (04 §6.2).",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "version",\n          "min_version",\n          "article_id",\n          "article_version",\n          "text_sha256",\n          "url",\n          "published_at"\n        ],\n        "properties": {\n          "type": {\n            "type": "string",\n            "enum": [\n              "privacy",\n              "agreement"\n            ]\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Currently effective version."\n          },\n          "min_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Consent to a version below this one must be given again (BR-ID-12)."\n          },\n          "article_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "article_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Version of the article holding the text (GET /v1/articles/{article_id}?version=)."\n          },\n          "text_sha256": {\n            "type": "string",\n            "description": "Lower-case hex sha256 of the text.",\n            "pattern": "^[0-9a-f]{64}$"\n          },\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "description": "Address of the full text of this version."\n          },\n          "published_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AgreementsData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "privacy",\n          "agreement"\n        ],\n        "properties": {\n          "privacy": {\n            "description": "The current privacy policy; null when never published.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/PublicAgreement"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "agreement": {\n            "description": "The current user agreement; null when never published.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/PublicAgreement"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AgreementsResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgreementsData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "PublicAgreementVersion": {\n        "type": "object",\n        "description": "One version of an agreement or public notice (04 §6.2; types in AgreementType).",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "version",\n          "min_version",\n          "article_id",\n          "article_version",\n          "text_sha256",\n          "url",\n          "published_at"\n        ],\n        "properties": {\n          "type": {\n            "$ref": "#/components/schemas/AgreementType"\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Version of the agreement, counted per type from 1."\n          },\n          "min_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Consent to a version below this one must be given again (BR-ID-12), as recorded on this version; always equals version for sdk_list and collect_list (D10-465)."\n          },\n          "article_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "article_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Version of the article holding the text (GET /v1/articles/{article_id}?version=)."\n          },\n          "text_sha256": {\n            "type": "string",\n            "description": "Lower-case hex sha256 of the text.",\n            "pattern": "^[0-9a-f]{64}$"\n          },\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "description": "Address of the full text of this version."\n          },\n          "published_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "PublicAgreementVersionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/PublicAgreementVersion"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ArticleCategory": {\n        "type": "string",\n        "description": "Article category (04 §6.2：帮助、规则、公告、协议; codes defined here, no enums/ entry yet).",\n        "enum": [\n          "help",\n          "rule",\n          "notice",\n          "agreement"\n        ]\n      },\n      "ArticleHelpSection": {\n        "type": "string",\n        "description": "Sub-section of a help article (04 §3.2 articles.help_section; 变更记录 20261020-内容线默认回写\\n§1.6). Codes are defined by the contract line (no enums/ entry, same as ArticleCategory);\\nthe list follows the help-centre board and grows or shrinks with it under the enum\\nextension rules: getting_started = 新手教程, rebate_settlement = 返利与结算, orders_claims =\\n订单与找回, withdraw = 提现, invite = 邀请好友, account_privacy = 账号与隐私. Only an article of\\ncategory help may carry one.\\n",\n        "enum": [\n          "getting_started",\n          "rebate_settlement",\n          "orders_claims",\n          "withdraw",\n          "invite",\n          "account_privacy"\n        ]\n      },\n      "RouteTarget": {\n        "type": "object",\n        "description": "In-app jump target {route, params} (contracts/routes.json; TECH-04). route stays a string on\\npurpose: a server may return a route newer than an installed client, which then opens the\\nupgrade page (03 §4.4), so the HTTP contract cannot pin the route list. The client checks\\nroute and params against its own routes table (bridge RouteTarget) before opening; the\\nserver only stores targets checked against routes.json when they are saved.\\n",\n        "additionalProperties": false,\n        "required": [\n          "route"\n        ],\n        "properties": {\n          "route": {\n            "type": "string",\n            "minLength": 1\n          },\n          "params": {\n            "type": "object",\n            "additionalProperties": true\n          }\n        }\n      },\n      "NoticeItem": {\n        "type": "object",\n        "description": "One notice-bar entry, shared by the static (home schema) and api (GET /v1/articles notice\\ncategory) sources; closing and content-version rules only in BR-TEXT-13 细则「首页公告条的\\n关闭与内容版本」 (04 §6.2).\\n",\n        "additionalProperties": false,\n        "not": {\n          "type": "object",\n          "additionalProperties": true,\n          "description": "A notice that cannot be closed must have end_at (BR-TEXT-13 细则「生效区间」).",\n          "properties": {\n            "closable": {\n              "const": false\n            },\n            "end_at": {\n              "type": "null"\n            }\n          },\n          "required": [\n            "closable",\n            "end_at"\n          ]\n        },\n        "required": [\n          "item_id",\n          "content_version",\n          "text",\n          "target",\n          "closable",\n          "start_at",\n          "end_at"\n        ],\n        "properties": {\n          "item_id": {\n            "type": "string",\n            "minLength": 1,\n            "description": "For api entries the notice article id."\n          },\n          "content_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "text": {\n            "type": "string",\n            "minLength": 1\n          },\n          "target": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/RouteTarget"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "closable": {\n            "type": "boolean"\n          },\n          "start_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "end_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "ArticleSummary": {\n        "description": "A list item; items of the notice category carry notice (04 §6.2), others do not.",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/NoticeArticleSummary"\n          },\n          {\n            "$ref": "#/components/schemas/PlainArticleSummary"\n          }\n        ]\n      },\n      "NoticeArticleSummary": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "article_id",\n          "category",\n          "title",\n          "version",\n          "published_at",\n          "notice"\n        ],\n        "properties": {\n          "article_id": {\n            "type": "string",\n            "minLength": 1\n          },\n          "category": {\n            "type": "string",\n            "enum": [\n              "notice"\n            ]\n          },\n          "title": {\n            "type": "string"\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "published_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "summary": {\n            "$ref": "#/components/schemas/ArticleListSummaryText"\n          },\n          "notice": {\n            "$ref": "#/components/schemas/NoticeItem"\n          }\n        }\n      },\n      "PlainArticleSummary": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "article_id",\n          "category",\n          "title",\n          "version",\n          "published_at"\n        ],\n        "properties": {\n          "article_id": {\n            "type": "string",\n            "minLength": 1\n          },\n          "category": {\n            "type": "string",\n            "enum": [\n              "help",\n              "rule",\n              "agreement"\n            ]\n          },\n          "title": {\n            "type": "string"\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "published_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "help_section": {\n            "$ref": "#/components/schemas/ArticleHelpSection",\n            "description": "Present only when category is help and the current version has one set; absent otherwise (never null)."\n          },\n          "summary": {\n            "$ref": "#/components/schemas/ArticleListSummaryText"\n          },\n          "faq_rank": {\n            "$ref": "#/components/schemas/ArticleFaqRank",\n            "description": "Present only when category is help and the current version has one set; absent otherwise (never null)."\n          }\n        }\n      },\n      "ArticleListSummaryText": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 80,\n        "description": "List summary (W-25, 编排者默认): derived by the server from the current version\'s body —\\nthe plain text of its first non-empty paragraph, cut to 80 characters; not entered in the\\nadmin console. Absent when the body has no text paragraph (never null).\\n"\n      },\n      "ArticleFaqRank": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 1,\n        "maximum": 999,\n        "description": "Manual order of a help article in the help home 「常见问题」 list (W-25, 编排者默认): the\\nclient sorts that list by faq_rank ascending (the server keeps the usual list order of\\n04 §6.2); GET /v1/articles?category=help&faq=true lists only articles whose current\\nversion has it set. Help articles only.\\n"\n      },\n      "ArticleListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/ArticleSummary"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          }\n        }\n      },\n      "ArticleListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ArticleListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "Article": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "article_id",\n          "category",\n          "title",\n          "version",\n          "published_at",\n          "body"\n        ],\n        "properties": {\n          "article_id": {\n            "type": "string",\n            "minLength": 1\n          },\n          "category": {\n            "$ref": "#/components/schemas/ArticleCategory"\n          },\n          "title": {\n            "type": "string"\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "published_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "body": {\n            "type": "string"\n          },\n          "help_section": {\n            "$ref": "#/components/schemas/ArticleHelpSection",\n            "description": "Present only when category is help and the returned version has one set; absent otherwise (never null)."\n          },\n          "faq_rank": {\n            "$ref": "#/components/schemas/ArticleFaqRank",\n            "description": "Present only when category is help and the returned version has one set; absent otherwise (never null)."\n          }\n        }\n      },\n      "ArticleResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/Article"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ArticleVersionStatus": {\n        "type": "string",\n        "description": "Status of one article version row (04 §6.2): draft = saved, never published; published =\\npublished (counts only once published_at is not later than now); offline = taken offline.\\n",\n        "enum": [\n          "draft",\n          "published",\n          "offline"\n        ]\n      },\n      "AdminArticleSummary": {\n        "type": "object",\n        "description": "One article in the admin list.",\n        "additionalProperties": false,\n        "required": [\n          "article_id",\n          "category",\n          "title",\n          "latest_version",\n          "latest_status",\n          "current_version",\n          "published_at",\n          "row_version",\n          "updated_at"\n        ],\n        "properties": {\n          "article_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "category": {\n            "$ref": "#/components/schemas/ArticleCategory"\n          },\n          "title": {\n            "type": "string",\n            "description": "Title of the newest version row."\n          },\n          "latest_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Newest version, drafts included."\n          },\n          "latest_status": {\n            "$ref": "#/components/schemas/ArticleVersionStatus"\n          },\n          "current_version": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Largest published version already due; null = none."\n          },\n          "published_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "published_at of the current version; null when there is none."\n          },\n          "row_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The article\'s CAS value (row_version of the newest version row)."\n          },\n          "updated_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "help_section": {\n            "$ref": "#/components/schemas/Artic