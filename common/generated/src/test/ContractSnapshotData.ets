abled off →\\n30701. Terms and text keys per BR-TEXT-01.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [\n          30701\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "name": "platform",\n            "in": "query",\n            "required": false,\n            "description": "Platform code (enum platform); filters self and share only. Absent = all.",\n            "schema": {\n              "$ref": "#/components/schemas/PlatformCode"\n            }\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The dashboard figures.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EarningsSummaryResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "as_of": "2026-11-12T10:00:00+08:00",\n                    "self": {\n                      "today": {\n                        "paid_count": 1,\n                        "est_fen": 269,\n          