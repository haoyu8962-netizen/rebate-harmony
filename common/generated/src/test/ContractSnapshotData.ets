},\n    {\n      "note": "X-Nonce with 31 characters",\n      "expected_reason": "nonce_length",\n      "method": "POST",\n      "path": "/v1/links/abc/open?src=agent",\n      "body_utf8": "{\\"no_rebate\\":false}",\n      "timestamp": "1790661600",\n      "server_time": 1790661600,\n      "nonce": "79b7b50d42fe5d4eb490b111e619dea",\n      "install_secret": "test-only.install.device-a",\n      "expected_sign": "1c017ff0c62699e78640972566caadfc8f0be928d416f43ba40868d20a6ef7fc"\n    },\n    {\n      "note": "X-Nonce with 33 characters",\n      "expected_reason": "nonce_length",\n      "method": "POST",\n      "path": "/v1/links/abc/open?src=agent",\n      "body_utf8": "{\\"no_rebate\\":false}",\n      "timestamp": "1790661600",\n      "server_time": 1790661600,\n      "nonce": "79b7b50d42fe5d4eb490b111e619dea80",\n      "install_secret": "test-only.install.device-a",\n      "expected_sign": "e68080275509c284ea4593303d2e3e0de46d784522a0207ee6cedb39e545633d"\n    },\n    {\n      "note": "X-Nonce of 64 lower-case hex characters (a full sha256 hex)",\n      "expected_reason": "nonce_length",\n      "method": "POST",\n      "path": "/v1/links/abc/open?src=agent",\n      "body_utf8": "{\\"no_rebate\\":false}",\n      "timestamp": "1790661600",\n      "server_time": 1790661600,\n      "nonce": "5e93aad915ff47c388acc74051a97c72910e4e6ba32d63c0a24945819fcfee9a",\n      "install_secret": "test-only.install.device-a",\n      "expected_sign": "f25e810c3766d117679c547ce503b0576f4bcc4e44a1e3be86cc0133a166e346"\n    },\n    {\n      "note": "X-Nonce with upper-case hex digits",\n      "expected_reason": "nonce_case",\n      "method": "POST",\n      "path": "/v1/links/abc/open?src=agent",\n      "body_utf8": "{\\"no_rebate\\":false}",\n      "timestamp": "1790661600",\n      "server_time": 1790661600,\n      "nonce": "79B7B50D42FE5D4EB490B111E619DEA8",\n      "install_secret": "test-only.install.device-a",\n      "expected_sign": "c8fe21fcfd3f77d4f410f5289751a2670f3a806ff9b59182a614