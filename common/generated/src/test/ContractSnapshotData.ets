  map.set('specs/client-security-baseline.json', '{\n  "version": "1",\n  "rules": [\n    {\n      "id": "CSB-01",\n      "title": "证书与主机名校验只用系统默认实现，不得被开关、远程配置或构建类型降级",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "源码出现自定义信任管理、放行全部证书或恒返回通过的主机名校验即失败；发请求的客户端只能由 Core 的 Network 创建",\n      "targets": [\n        "三端源码（含 debug 与 staging 配置）"\n      ]\n    },\n    {\n      "id": "CSB-02",\n      "title": "TrustedWebView、ExternalWebView 遇到证书错误一律取消加载并显示错误页，不提供「继续访问」",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "证书错误回调里出现继续或放行的调用即失败；桥一致性测试页（03 §5.5）有证书无效的用例",\n      "targets": [\n        "Features/Web 容器封装的证书错误回调"\n      ]\n    },\n    {\n      "id": "CSB-03",\n      "title": "两类容器只加载 https，禁止混合内容与 file 访问；ExternalWebView 不注入桥、不共享 Cookie",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "WebView 设置只能写在 Features/Web 的容器封装里，设置项与本条不一致即失败；其他模块直接创建 WebView 即失败",\n      "targets": [\n        "Features/Web 容器封装",\n        "其他模块里的 WebView 创建"\n      ]\n    },\n    {\n      "id": "CSB-04",\n      "title": "明文流量全关（iOS ATS 无例外；Android 不允许明文、不信任用户证书；鸿蒙无 http 业务地址）",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "检查最终产物配置，出现例外域名、明文许可或 http:// 业务地址即失败",\n      "targets": [\n        "Info.plist",\n        "合并后的 AndroidManifest 与网络安全配置",\n        "鸿蒙工程配置"\n      ]\n    },\n    {\n      "id": "CSB-05",\n      "title": "access_token、refresh_token、install_secret 只放系统安全存储，不写入普通 KV、文件、日志、剪贴板、埋点与崩溃附加信息",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "三样用专用包装类型保存（不可打印、不参与普通序列化），只有 Core 的 SecureStore 能取原值，别处取原值即失败",\n      "targets": [\n        "Core SecureStore 与令牌包装类型的使用点"\n      ]\n    },\n    {\n      "id": "CSB-06",\n      "title": "备份与换机迁移不带走敏感数据；安全存储条目仅本设备可用，普通文件不含 CSB-05 的内容",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "检查安全存储条目的可访问性属性与备份规则配置（写法接入时按官方文档核对）",\n      "targets": [\n        "iOS Keychain 可访问性属性",\n        "Android 备份规则文件",\n        "鸿蒙备份配置"\n      ]\n    },\n    {\n      "id": "CSB-07",\n      "title": "对外共享文件只暴露分享图缓存目录",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "检查文件共享路径配置与导出组件清单；分享调用点传入其他目录即失败",\n      "targets": [\n        "Android 文件共享路径配置",\n        "三端分享调用点"\n      ]\n    },\n    {\n      "id": "CSB-08",\n      "title": "MVP 不做证书固定（依靠系统信任链与 CSB-01～04；日后要做另写 ADR）",\n      "waivable": null,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "不检查；代码里出现固定配置时由评审按本条处理",\n      "targets": []\n    },\n    {\n      "id": "CSB-09",\n      "title": "入口组件最小化：只导出启动入口与声明了深链的入口组件；鸿蒙只有入口 Ability 声明深链",\n      "waivable": false,\n      "platforms": [\n        "android",\n        "harmony"\n      ],\n      "check": "合并后的清单里导出的、带 intent-filter 或深链声明的组件必须在 exported_components_allowed 里，否则失败",\n      "targets": [\n        "合并后的 AndroidManifest",\n        "鸿蒙模块配置"\n      ]\n    },\n    {\n      "id": "CSB-10",\n      "title": "第三方页容器不注入；TrustedWebView 只注入随包发布的桥启动脚本",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "ExternalWebView 封装出现执行脚本、用户脚本、注入样式、脚本消息通道的调用即失败；TrustedWebView 注入点引用配置或网络内容即失败；桥一致性测试页（03 §5.5）有「第三方页面里没有桥对象」的用例",\n      "targets": [\n        "Features/Web 容器封装",\n        "桥启动脚本资源"\n      ]\n    },\n    {\n      "id": "CSB-11",\n      "title": "入站声明只来自 apps.json 入站回调类的生成物；自定义 scheme 不得是系统保留、通用或第三方 App 的 scheme",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "生成物与工程文件比对；自定义 scheme 命中 forbidden_schemes，或与 apps.json 外跳目标、SDK 必需查询项里的 scheme 相同，即失败；http intent-filter、https 缺 host、带通配符、不在 own_link_hosts、无 autoVerify 即失败；Associated Domains 主机不在 own_link_hosts 即失败；鸿蒙 https 深链在 CAP-X-03 无验证结论前即失败；iOS 查询 scheme 合计超过 20 条时生成器报错",\n      "targets": [\n        "iOS URL Types 与 Associated Domains",\n        "Android 入口组件 intent-filter",\n        "鸿蒙入口 Ability 深链声明",\n        "查询声明"\n      ]\n    }\n  ],\n  "false_positives": [],\n  "forbidden_schemes": [\n    "http",\n    "https",\n    "file",\n    "content",\n    "data",\n    "javascript",\n    "about",\n    "blob",\n    "ftp",\n    "ws",\n    "wss",\n    "tel",\n    "telprompt",\n    "sip",\n    "sips",\n    "sms",\n    "smsto",\n    "mms",\n    "mmsto",\n    "mailto",\n    "facetime",\n    "facetime-audio",\n    "geo",\n    "maps",\n    "intent",\n    "market",\n    "itms",\n    "itms-apps",\n    "itms-appss",\n    "itms-services",\n    "app-settings",\n    "app-prefs",\n    "prefs",\n    "settings"\n  ],\n  "exported_components_allowed": [],\n  "own_link_hosts": []\n}\n');
  map.set('specs/events.json', '{\n  "version": "1",\n  "common_fields": {\n    "event_id": {\n      "type": "string",\n      "required": true,\n      "note": "客户端生成，服务端按它去重"\n    },\n    "name": {\n      "type": "string",\n      "required": true\n    },\n    "client_at": {\n      "type": "string",\n      "required": true,\n      "note": "客户端时刻，ISO 8601 带时区"\n    },\n    "session_id": {\n      "type": "string",\n      "required": true\n    },\n    "device_id": {\n      "type": "string",\n      "required": true\n    },\n    "user_id": {\n      "type": "string",\n      "required": false,\n      "note": "游客为空"\n    },\n    "platform": {\n      "type": "enum",\n      "required": true,\n      "values": [\n        "ios",\n        "android",\n        "harmony",\n        "h5"\n      ],\n      "note": "客户端端别（contracts/enums/platform.yaml client_platform 的端侧取值）"\n    },\n    "app_version": {\n      "type": "string",\n      "required": true\n    },\n    "channel": {\n      "type": "string",\n      "required": false,\n      "note": "安装渠道（install_channel）；H5 为空"\n    },\n    "page": {\n      "type": "string",\n      "required": true\n    },\n    "spm": {\n      "type": "string",\n      "required": false,\n      "note": "页面.模块.坑位（03 §4.7）"\n    },\n    "trace_id": {\n      "type": "string",\n      "required": false\n    }\n  },\n  "events": {\n    "link_jump": {\n      "description": "外跳的每一步结果（BR-ATTR-27 ③；BR-ATTR-21 细则「待跟单卡按实际外跳选」）；另记百川初始化失败（BR-ATTR-27 淘宝行）",\n      "source": "规划/03 §4.5、§4.7；08 BR-ATTR-21、BR-ATTR-27",\n      "fields": {\n        "phase": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "purchase",\n            "startup"\n          ],\n          "note": "purchase 是一次购买外跳的某一步；startup 只用于同意隐私政策后、还没有购买时的百川初始化失败（result=sdk_init_failed），这时没有 link 与尝试"\n        },\n        "attempt_id": {\n          "type": "string",\n          "required_when": {\n            "phase": "purchase"\n          },\n          "note": "本次 open（或 H