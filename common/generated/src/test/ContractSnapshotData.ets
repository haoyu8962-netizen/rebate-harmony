rationId": "getShareTpwd",\n        "tags": [\n          "trade"\n        ],\n        "summary": "Token of the share page for the copy-token button",\n        "description": "Called when the user taps the copy-token button on the share page: the body carries the\\ntpwd_ticket of GET /v1/share-pages/{link_id}; returns the token (BR-ATTR-10 细则). The\\nticket is bound to the link_id, valid 600 s, at most 3 exchanges. An invalid, expired or\\nused-up ticket, or a request whose User-Agent is the WeChat in-app browser or missing →\\n20001 with data.fields=[ticket], no token. Rate limited per IP × link_id\\n(share.tpwd_rate_per_min) → 42901 with Retry-After. The response carries Cache-Control:\\nno-store. Not signed. Version gate: 不判定：非三端请求 (written false, BR-ID-01 细则).\\n",\n        "x-auth": "none",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-min-version-gate": false,\n        "x-implementation": "planned",\n        "x-error-codes": [\n          20001,\n          42901\n        ],\n        "security": [],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/LinkId"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/ShareTpwdRequest"\n              },\n              "example": {\n                "ticket": "placeholder-ticket-01"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The token.",\n            "headers": {\n              "Cache-Control": {\n                "$ref": "#/components/headers/NoStore"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ShareTpwdResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "tpwd": "placeholder-tpwd"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/NoStoreTooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/NoStoreClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/NoStoreServerError"\n          }\n        }\n      }\n    }\n  },\n  "components": {\n    "securitySchemes": {\n      "bearerAuth": {\n        "type": "http",\n        "scheme": "bearer",\n        "bearerFormat": "JWT",\n        "description": "`Authorization: Bearer <access_token>`; ES256 JWT with uid, app_id, sid, device_id, scp,\\nvalid 2 hours (BR-ID-07). After login app_id is taken from the token only.\\n"\n      }\n    },\n    "parameters": {\n      "AppId": {\n        "name": "X-App-Id",\n        "in": "header",\n        "required": true,\n        "description": "App (brand) the request belongs to; before login it must match the app_id the device was registered with (10403, BR-ID-07).",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 32,\n          "pattern": "^[a-z0-9_]+$"\n        }\n      },\n      "Platform": {\n        "name": "X-Platform",\n        "in": "header",\n        "required": true,\n        "description": "Client platform (enum client_platform, 03 §4.2).",\n        "schema": {\n          "$ref": "#/components/schemas/ClientPlatformCode"\n        }\n      },\n      "AppVersion": {\n        "name": "X-App-Version",\n        "in": "header",\n        "required": true,\n        "description": "SemVer, the same number on all three apps (拍板第二批 TECH-07).",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$",\n          "maxLength": 32\n        }\n      },\n      "Build": {\n        "name": "X-Build",\n        "in": "header",\n        "required": false,\n        "description": "Build number of the client.",\n        "schema": {\n          "type": "string",\n          "maxLength": 32\n        }\n      },\n      "Channel": {\n        "name": "X-Channel",\n        "in": "header",\n        "required": false,\n        "description": "Install channel of the app package (enum install_channel); absent for H5.",\n        "schema": {\n          "$ref": "#/components/schemas/InstallChannelCode"\n        }\n      },\n      "TraceId": {\n        "name": "X-Trace-Id",\n        "in": "header",\n        "required": false,\n        "description": "Client-generated trace id, echoed as `trace_id` when well-formed.",\n        "schema": {\n          "$ref": "#/components/schemas/TraceId"\n        }\n      },\n      "DeviceId": {\n        "name": "X-Device-Id",\n        "in": "header",\n        "required": true,\n        "description": "device_id issued by POST /v1/devices; anything else is 10402 (BR-ID-09).",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "OptionalDeviceId": {\n        "name": "X-Device-Id",\n        "in": "header",\n        "required": false,\n        "description": "device_id issued by POST /v1/devices, when the device is registered.",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "Timestamp": {\n        "name": "X-Timestamp",\n        "in": "header",\n        "required": true,\n        "description": "Unix seconds; |server time − ts| ≤ 300 s (BR-ID-09).",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9]{10}$"\n        }\n      },\n      "Nonce": {\n        "name": "X-Nonce",\n        "in": "header",\n        "required": true,\n        "description": "32 lowercase hex characters; (device_id, nonce) unique within 600 s (BR-ID-09).",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9a-f]{32}$"\n        }\n      },\n      "Sign": {\n        "name": "X-Sign",\n        "in": "header",\n        "required": true,\n        "description": "lowercase_hex(HMAC-SHA256(install_secret, METHOD + \\"\\\\n\\" + path with raw query + \\"\\\\n\\" + ts\\n+ \\"\\\\n\\" + nonce + \\"\\\\n\\" + lowercase_hex(sha256(raw body)))) (BR-ID-09).\\n",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9a-f]{64}$"\n        }\n      },\n      "StepUpToken": {\n        "name": "X-Step-Up-Token",\n        "in": "header",\n        "required": false,\n        "description": "step_up_token from POST /v1/auth/step-up for the operation\'s x-step-up action (04 §5). Missing,\\nexpired or for another action → 10003 (not 20001; that is why the header is optional).\\n",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 2048\n        }\n      },\n      "TipKeyPath": {\n        "name": "tip_key",\n        "in": "path",\n        "required": true,\n        "schema": {\n          "$ref": "#/components/schemas/TipKey"\n        }\n      },\n      "IdempotencyKey": {\n        "name": "Idempotency-Key",\n        "in": "header",\n        "required": true,\n        "description": "Required on operations marked I (04 §6); missing → 20001. Same key while processing →\\n40901; same key with another body → 20901; a retry after a timeout reuses the key and gets\\nthe first result (拍板第二批 TRADE-22). On the x