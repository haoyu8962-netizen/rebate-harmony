equired": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminDictItemVersionPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminDict": {\n        "type": "object",\n        "description": "The console dictionary (BR-TEXT-25); a key `admin_dict.<enum>.<code>` is items[enum][code], split at the last dot.",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "items"\n        ],\n        "properties": {\n          "version": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "Dictionary version, equal to `version` of GET /v1/dict; \\"0\\" before the first publish."\n          },\n          "items": {\n            "type": "object",\n            "description": "Texts by enum (the key without `admin_dict.` up to its last dot), then by code (after the last dot); every key, overridden or default.",\n            "additionalProperties": {\n              "type": "object",\n              "additionalProperties": {\n                "type": "string"\n              }\n            }\n          }\n        }\n      },\n      "AdminDictResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminDict"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigItemRollbackRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "to_version",\n          "expected_version"\n        ],\n        "properties": {\n          "to_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The stored version whose value becomes the new current value; must be older than the current one."\n          },\n          "expected_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The item\'s current `version` as the console showed it; a mismatch is 20902."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminConfigReason"\n          }\n        }\n      },\n      "AdminUserRiskStateCode": {\n        "type": "string",\n        "description": "Risk state of a user (enum risk_state; BR-ID-31, BR-ID-36).",\n        "enum": [\n          "normal",\n          "frozen",\n          "appealing",\n          "banned"\n        ]\n      },\n      "AdminRiskReasonCategory": {\n        "type": "string",\n        "description": "User-visible reason category of a ban or freeze (enum risk_reason_category; BR-TEXT-23 细则\\n「原因类别」, user text from the dictionary risk_reason.<category>).\\n",\n        "enum": [\n          "malicious_rights",\n          "fraud_invite",\n          "abnormal_trade",\n          "account_security",\n          "other"\n        ]\n      },\n      "AdminUserLevel": {\n        "type": "string",\n        "description": "Distribution level of the user (enum user_level; not shown to the user, OPS-20).",\n        "enum": [\n          "L1",\n          "L2",\n          "L3"\n        ]\n      },\n      "AdminUnionBindingStatus": {\n        "type": "string",\n        "description": "Status of a union binding (enum union_binding_status; BR-ID-19, BR-ID-20).",\n        "enum": [\n          "unbound",\n          "pending_auth",\n          "active",\n          "invalid",\n          "released",\n          "blocked"\n        ]\n      },\n      "AdminUnionBindingBlockedReason": {\n        "type": "string",\n        "description": "Why a binding is blocked (enum union_binding_blocked_reason; BR-ID-20).",\n        "enum": [\n          "ban",\n          "admin_disable",\n          "deletion"\n        ]\n      },\n      "AdminRowVersion": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 0,\n        "description": "row_version of the row as read (users\' risk state, a union binding, an admin account);\\nplus 1 on every change. The CAS value `expected_row_version` of the writes.\\n"\n      },\n      "AdminUserReason": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 200,\n        "description": "Required free-text reason, kept in the audit record."\n      },\n      "AdminMaskedPhone": {\n        "type": [\n          "string",\n          "null"\n        ],\n        "maxLength": 32,\n        "description": "Phone number masked 3 + 4 (`138****5678`, BR-ID-33); null when no phone is bound."\n      },\n      "AdminUserListItem": {\n        "type": "object",\n        "description": "A user row of the list; non-sensitive fields only (04 §11.1 user.list).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "nickname",\n          "phone_masked",\n          "level",\n          "risk_state",\n          "created_at"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nickname": {\n            "type": "string"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "level": {\n            "$ref": "#/components/schemas/AdminUserLevel"\n          },\n          "risk_state": {\n            "$ref": "#/components/schemas/AdminUserRiskStateCode"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Registration time."\n          }\n        }\n      },\n      "AdminAuditLogId": {\n        "type": "string",\n        "description": "Opaque identifier of an audit record (04 §5, ids are strings). It is not the database\\nprimary key (ADR-0001: internal auto-increment keys are never exposed); clients must not\\nparse it, compare it for order or derive anything from it. Generated by the server and\\nstable for the life of the record; how it is generated is up to the implementation.\\n",\n        "minLength": 16,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z0-9_-]{16,64}$"\n      },\n      "AdminAuditValue": {\n        "description": "A before or after value as the action stored it: any JSON, null when the action recorded\\nnone. Sensitive fields are stored and shown masked.\\n"\n      },\n      "AdminAuditActorKind": {\n        "type": "string",\n        "description": "Who acted (enum audit_actor_kind). Only system rows carry it, as `system`; rows of an admin account leave it out.",\n        "enum": [\n          "admin",\n          "system"\n        ]\n      },\n      "AdminAuditSystemActor": {\n        "type": "string",\n        "description": "The system identity that acted (enum audit_system_actor, values of the form\\nsystem:<name>; more are appended later). Only system rows carry it; rows of an admin\\naccount leave it out.\\n",\n        "pattern": "^system:[a-z_]+$",\n        "enum": [\n          "system:risk",\n          "system:payout"\n        ]\n      },\n      "AdminAuditLogListItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "actor_id",\n          "action",\n          "target_type",\n          "target_id",\n          "permission",\n          "ip",\n          "at"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/AdminAuditLogId"\n          },\n          "actor_id": {\n            "description": "The admin who acted; null on a system row (no account acted).",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "actor_kind": {\n            "$ref": "#/components/schemas/AdminAuditActorKind"\n          },\n          "system_actor": {\n            "$ref": "#/components/schemas/AdminAuditSystemActor"\n          },\n          "actor_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current name of the account that acted (admin_users.display_name, else the username), null when it cannot be read; on a system row the Chinese name of `system_actor` from enum audit_system_actor.",\n            "maxLength": 64\n          },\n          "action": {\n            "type": "string",\n            "description": "Action key as the writing module recorded it (such as user_pii_reveal).",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "target_type": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object type derived from the record (free text); null when it cannot be derived.",\n            "maxLength": 64\n          },\n          "target_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object id derived from the record; null when it cannot be derived.",\n            "maxLength": 128\n          },\n          "permission": {\n            "description": "Permission point derived from the action; null when it cannot be derived.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminPermissionKey"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "ip": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Client IP of the request (IPv4 or IPv6); null when not recorded.",\n            "maxLength": 45\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time of the action."\n          }\n        }\n      },\n      "AdminAuditLog": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "actor_id",\n          "action",\n          "target_type",\n          "target_id",\n          "permission",\n          "ip",\n          "at",\n          "before",\n          "after"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/AdminAuditLogId"\n          },\n          "actor_id": {\n            "description": "The admin who acted; null on a system row (no account acted).",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "actor_kind": {\n            "$ref": "#/components/schemas/AdminAuditActorKind"\n          },\n          "system_actor": {\n            "$ref": "#/components/schemas/AdminAuditSystemActor"\n          },\n          "actor_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current name of the account that acted (admin_users.display_name, else the username), null when it cannot be read; on a system row the Chinese name of `system_actor` from enum audit_system_actor.",\n            "maxLength": 64\n          },\n          "action": {\n            "type": "string",\n            "description": "Action key as the writing module recorded it.",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "target_type": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object type derived from the record (free text); null when it cannot be derived.",\n            "maxLength": 64\n          },\n          "target_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object id derived from the record; null when it cannot be derived.",\n            "maxLength": 128\n          },\n          "permission": {\n            "description": "Permission point derived from the action; null when it cannot be derived.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminPermissionKey"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "ip": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Client IP of the request (IPv4 or IPv6); null when not recorded.",\n            "maxLength": 45\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time of the action."\n          },\n          "before": {\n            "$ref": "#/components/schemas/AdminAuditValue"\n          },\n          "after": {\n            "$ref": "#/components/schemas/AdminAuditValue"\n          }\n        }\n      },\n      "AdminAuditLogPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminAuditLogListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminAuditLogPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAuditLogPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAuditLogResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAuditLog"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminExportId": {\n        "type": "string",\n        "description": "Opaque identifier of an export task (04 §5, ids are strings). It is not the database\\nprimary key (ADR-0001: internal auto-increment keys are never exposed); clients must not\\nparse it, compare it for order or derive anything from it. Generated by the server and\\nstable for the life of the task, retries included; how it is generated is up to the\\nimplementation.\\n",\n        "minLength": 16,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z0-9_-]{16,64}$"\n      },\n      "AdminExportStatus": {\n        "type": "string",\n        "description": "Status of an export task (enum export_status; BR-ID-34 细则「后台导出任务」; names from\\nBR-TEXT-25 admin_dict.export_status). pending → running → done or failed; done → expired\\n24 hours after the file was generated; pending or running → cancelled when the creator\'s\\naccount is disabled; failed → pending by a retry.\\n",\n        "enum": [\n          "pending",\n          "running",\n          "done",\n          "failed",\n          "expired",\n          "cancelled"\n        ]\n      },\n      "AdminExportResource": {\n        "type": "string",\n        "description": "Source list of an export task (enum export_resource): users = GET /admin/v1/users\\n(needs user.list), audit_logs = GET /admin/v1/audit-logs (signed in is enough; own\\nrecords only without audit.view_all), tax_withdrawals = the quarterly tax export of\\nBR-WDR-21, which has no source list (see POST /admin/v1/exports).\\n",\n        "enum": [\n          "users",\n          "audit_logs",\n          "tax_withdrawals"\n        ]\n      },\n      "AdminExportUserFilters": {\n        "type": "object",\n        "description": "Filters of a users export, the query parameters of GET /admin/v1/users without paging.",\n        "additionalProperties": false,\n        "properties": {\n          "risk_state": {\n            "$ref": "#/components/schemas/AdminUserRiskStateCode"\n          }\n        }\n      },\n      "AdminExportAuditLogFilters": {\n        "type": "object",\n        "description": "Filters of an audit_logs export, the query parameters of GET /admin/v1/audit-logs without\\npaging, judged the same way (without audit.view_all actor_id is forced to the creator;\\nsystem rows match no actor_id filter).\\n",\n        "additionalProperties": false,\n        "properties": {\n          "actor_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "target_type": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "target_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "permission": {\n            "$ref": "#/components/schemas/AdminPermissionKey"\n          },\n          "from": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Earliest record time, inclusive."\n          },\n          "to": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Latest record time, exclusive."\n          }\n        }\n      },\n      "AdminExportTaxWithdrawalFilters": {\n        "type": "object",\n        "description": "Filters of a tax_withdrawals export (BR-WDR-21).",\n        "additionalProperties": false,\n        "required": [\n          "quarter"\n        ],\n        "properties": {\n          "quarter": {\n            "type": "string",\n            "pattern": "^\\\\d{4}-Q[1-4]$",\n            "description": "Natural quarter by paid_at at +08:00, as YYYY-Qn. The year is 2026..2100; another year\\nis 20001.\\n"\n          }\n        }\n      },\n      "AdminExportCreateUsersRequest": {\n        "type": "object",\n        "description": "Export of the users list. unmasked true asks for the full phone numbers (pii.reveal_phone,\\ntotp step-up and reason required); reason is only accepted together with unmasked true.\\n",\n        "additionalProperties": false,\n        "required": [\n          "resource",\n          "filters"\n        ],\n        "properties": {\n          "resource": {\n            "type": "string",\n            "enum": [\n              "users"\n            ]\n          },\n          "filters": {\n            "$ref": "#/components/schemas/AdminExportUserFilters"\n          },\n          "unmasked": {\n            "type": "boolean",\n            "default": false,\n            "description": "true = full values instead of the masked ones; absent or false = masked."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminExportCreateAuditLogsRequest": {\n        "type": "object",\n        "description": "Export of the audit log; always masked (audit values are stored masked), no reason.",\n        "additionalProperties": false,\n        "required": [\n          "resource",\n          "filters"\n        ],\n        "properties": {\n          "resource": {\n            "type": "string",\n            "enum": [\n              "audit_logs"\n            ]\n          },\n          "filters": {\n            "$ref": "#/components/schemas/AdminExportAuditLogFilters"\n          }\n        }\n      },\n      "AdminExportCreateTaxWithdrawalsRequest": {\n        "type": "object",\n        "description": "Quarterly tax export (BR-WDR-21, see POST /admin/v1/exports). unmasked true\\nasks for the full identity numbers (tax.export_full, totp step-up and reason required);\\nreason is only accepted together with unmasked true.\\n",\n        "additionalProperties": false,\n        "required": [\n          "resource",\n          "filters"\n        ],\n        "properties": {\n          "resource": {\n            "type": "string",\n            "enum": [\n              "tax_withdrawals"\n            ]\n          },\n          "filters": {\n            "$ref": "#/components/schemas/AdminExportTaxWithdrawalFilters"\n          },\n          "unmasked": {\n            "type": "boolean",\n            "default": false,\n            "description": "true = full values instead of the masked ones; absent or false = masked."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminExportCreateRequest": {\n        "description": "One branch per source list (enum export_resource), told apart by `resource`; `filters`\\nfollows that list\'s query parameters (`tax_withdrawals` has no list, only `quarter`).\\n",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/AdminExportCreateUsersRequest"\n          },\n          {\n            "$ref": "#/components/schemas/AdminExportCreateAuditLogsRequest"\n          },\n          {\n            "$ref": "#/components/schemas/AdminExportCreateTaxWithdrawalsRequest"\n          }\n        ]\n      },\n      "AdminExportRetryRequest": {\n        "type": "object",\n        "description": "Empty for a masked task. For an unmasked task (masked false) reason is required, with a\\nnew totp-tier X-Step-Up-Token; for a masked task reason is 20001.\\n",\n        "additionalProperties": false,\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminExport": {\n        "type": "object",\n        "description": "An export task (04 §6.6 exports; design/specs/admin-ledger.md 导出记录). Fields that only\\napply to some statuses are null otherwise.\\n",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "resource",\n          "filters_summary",\n          "masked",\n          "created_by",\n          "created_at",\n          "status",\n          "progress",\n          "failure_reason",\n          "file_name",\n          "row_count",\n          "expires_at"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/AdminExportId"\n          },\n          "resource": {\n            "$ref": "#/components/schemas/AdminExportResource"\n          },\n          "filters_summary": {\n            "type": "string",\n            "description": "Readable summary of the filters, written by the server (Chinese, for display only).",\n            "maxLength": 500\n          },\n          "masked": {\n            "type": "boolean",\n            "description": "true = the file holds masked values (the default); false = full values (step-up at creation)."\n          },\n          "created_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "created_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current name of the creator (admin_users.display_name, else the username); null when it cannot be read.",\n            "maxLength": 64\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time the task was created."\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminExportStatus"\n          },\n          "progress": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "maximum": 100,\n            "description": "Percentage generated while running; null in every other status."\n          },\n          "failure_reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Short reason written by the server when failed (such as the row limit); null otherwise."\n          },\n          "file_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 128,\n            "description": "Name of the CSV file when done or expired; null otherwise."\n          },\n          "row_count": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "description": "Data rows in the file when done or expired; null otherwise."\n          },\n          "expires_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of the download period (24 hours after the file was generated, BR-ID-30 ⑨) when\\ndone or expired; null otherwise.\\n"\n          }\n        }\n      },\n      "AdminExportResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminExport"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminExportPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminExport"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminExportPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminExportPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminExportDownload": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "url",\n          "url_expires_at"\n        ],\n        "properties": {\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048,\n            "description": "Signed link to the CSV file in the private bucket; valid until url_expires_at."\n          },\n          "url_expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "min(5 minutes after signing, the task\'s expires_at)."\n          }\n        }\n      },\n      "AdminExportDownloadResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminExportDownload"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUserListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminUserPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminInviteRewardStatus": {\n        "type": "string",\n        "description": "Status of an invite reward record (enum invite_reward_status; meanings only in BR-INV-24\\n细则「资格记录与状态」): qualified → deferred → processed, with the end states voided and\\nexpired (no qualifying own order within the locked eligibility days, BR-INV-24「有效期」).\\n",\n        "enum": [\n          "qualified",\n          "deferred",\n          "processed",\n          "voided",\n          "expired"\n        ]\n      },\n      "AdminInviteRewardPartyResult": {\n        "type": "string",\n        "description": "One party\'s result (enum invite_reward_party_result; BR-INV-24).",\n        "enum": [\n          "granted",\n          "skipped"\n        ]\n      },\n      "AdminInviteRewardSkipReason": {\n        "type": "string",\n        "description": "Why a party is not paid (enum invite_reward_skip_reason; BR-INV-24 ③): same_device,\\nsame_ip and deleted_phone_retained skip both parties, the others only the party hit.\\n",\n        "enum": [\n          "same_device",\n          "same_ip",\n          "deleted_phone_retained",\n          "multi_account",\n          "risk_restricted",\n          "deleting",\n          "minor"\n        ]\n      },\n      "AdminInviteRewardVoidReason": {\n        "type": "string",\n        "description": "Why a record is voided (enum invite_reward_void_reason; BR-INV-24 ③ ⑥).",\n        "enum": [\n          "relation_changed",\n          "order_clawed_back",\n          "order_rights"\n        ]\n      },\n      "AdminInviteRewardBindSource": {\n        "type": "string",\n        "description": "Bind channel the invitee qualified through (enum invite_reward_bind_source; BR-INV-24 ①; admin changes never qualify).",\n        "enum": [\n          "landing",\n          "register",\n          "backfill"\n        ]\n      },\n      "AdminInviteReward": {\n        "type": "object",\n        "description": "An invite reward record (04 §3.2 invite_rewards, BR-INV-24), one per invitee. Phone\\nnumbers masked; no client IP or its HMAC and no voucher ids.\\n",\n        "additionalProperties": false,\n        "required": [\n          "invitee_id",\n          "inviter_id",\n          "invitee_phone_masked",\n          "inviter_phone_masked",\n          "amount_fen",\n          "eligibility_days",\n          "bind_source",\n          "qualified_at",\n          "trigger_order_id",\n          "triggered_at",\n          "status",\n          "inviter_result",\n          "invitee_result",\n          "inviter_skip_reason",\n          "invitee_skip_reason",\n          "void_reason",\n          "granted_at"\n        ],\n        "properties": {\n          "invitee_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "inviter_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "invitee_phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "inviter_phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Amount each party gets, locked when the invitee qualified (BR-INV-24 ①)."\n          },\n          "eligibility_days": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Eligibility days locked when the invitee qualified (BR-INV-24「有效期」; config growth.invite_reward.eligibility_days at that time)."\n          },\n          "bind_source": {\n            "$ref": "#/components/schemas/AdminInviteRewardBindSource"\n          },\n          "qualified_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the invitee qualified (in the bind transaction)."\n          },\n          "trigger_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Id of the order that triggered the reward (the invitee\'s first own purchase credited, BR-INV-24 ②); null before the trigger."\n          },\n          "triggered_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the trigger happened; null before it."\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminInviteRewardStatus"\n          },\n          "inviter_result": {\n            "description": "The inviter\'s result; null until processed (and for a voided or expired record).",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminInviteRewardPartyResult"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "invitee_result": {\n            "description": "The invitee\'s result; null until processed (and for a voided or expired record).",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminInviteRewardPartyResult"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "inviter_skip_reason": {\n            "description": "Why the inviter is not paid; null unless inviter_result is skipped.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminInviteRewardSkipReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "invitee_skip_reason": {\n            "description": "Why the invitee is not paid; null unless invitee_result is skipped.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminInviteRewardSkipReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "void_reason": {\n            "description": "Why the record is voided; null unless status is voided.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminInviteRewardVoidReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "granted_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the granted amounts were posted; null when no party was paid."\n          }\n        }\n      },\n      "AdminInviteRewardBudget": {\n        "type": "object",\n        "description": "Invite reward budget used (BR-INV-24 ④), independent of the list\'s filters; the limits are\\nthe config items growth.invite_reward.daily_budget_fen and total_budget_fen.\\n",\n        "additionalProperties": false,\n        "required": [\n          "today",\n          "total"\n        ],\n        "properties": {\n          "today": {\n            "type": "object",\n            "additionalProperties": false,\n            "required": [\n              "date",\n              "granted_fen"\n            ],\n            "properties": {\n              "date": {\n                "type": "string",\n                "format": "date",\n                "description": "The current +08:00 calendar day."\n              },\n              "granted_fen": {\n                "type": "integer",\n                "format": "int64",\n                "minimum": 0,\n                "description": "Amount granted on that day (what the daily budget counts)."\n              }\n            }\n          },\n          "total": {\n            "type": "object",\n            "additionalProperties": false,\n            "required": [\n              "reserved_fen",\n              "granted_fen"\n            ],\n            "properties": {\n              "reserved_fen": {\n                "type": "integer",\n                "format": "int64",\n                "minimum": 0,\n                "description": "Amount reserved by qualified records not yet paid (both parties\' amounts each)."\n              },\n              "granted_fen": {\n                "type": "integer",\n                "format": "int64",\n                "minimum": 0,\n                "description": "Amount granted since the campaign started."\n              }\n            }\n          }\n        }\n      },\n      "AdminInviteRewardPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total",\n          "budget"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminInviteReward"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "budget": {\n            "$ref": "#/components/schemas/AdminInviteRewardBudget"\n          }\n        }\n      },\n      "AdminInviteRewardPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminInviteRewardPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminInviteRewardResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminInviteReward"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserRiskState": {\n        "type": "object",\n        "description": "The user\'s user_risk_state row as the console sees it (no rule details). A user without a\\nrow reads as state normal, nulls and row_version null; a row always has an integer\\nrow_version (0 for a first row).\\n",\n        "additionalProperties": false,\n        "required": [\n          "state",\n          "reason_category",\n          "reason",\n          "frozen_until",\n          "changed_by",\n          "changed_at",\n          "row_version"\n        ],\n        "properties": {\n          "state": {\n            "$ref": "#/components/schemas/AdminUserRiskStateCode"\n          },\n          "reason_category": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminRiskReasonCategory"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Internal reason of the last change (console only, never shown to the user)."\n          },\n          "frozen_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of a freeze; null for a freeze without end and for every other state."\n          },\n          "changed_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Admin username or `system` of the last change; null when there is no row."\n          },\n          "changed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "row_version": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "null when the user has no risk-state row yet."\n          }\n        }\n      },\n      "AdminUserRiskStateResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserRiskState"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserUnionBinding": {\n        "type": "object",\n        "description": "A union binding row of the user (union_bindings; BR-ID-19, BR-ID-20), without relation_id or\\nother union identifiers.\\n",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "status",\n          "blocked_reason",\n          "bound_at",\n          "released_at",\n          "cooldown_until",\n          "reason",\n          "row_version"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminUnionBindingStatus"\n          },\n          "blocked_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminUnionBindingBlockedReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Set when status is blocked, null otherwise."\n          },\n          "bound_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "released_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "cooldown_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of the cooldown after a release (BR-ID-19); null unless released."\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Reason of the last console change (reset, disable, enable); null when none."\n          },\n          "row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          }\n        }\n      },\n      "AdminUserUnionBindingResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserUnionBinding"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserDetail": {\n        "type": "object",\n        "description": "A user as the console sees it (04 §11.1): non-sensitive fields, the masked phone number,\\nthe risk state, the union bindings and (CT-26k, D10-517) the real-name status with the\\nmasked name and ID number and the masked current payout account (BR-ID-33). No full\\nidentity number, payout account, real name or phone number: those only through POST\\n/admin/v1/users/{user_id}/reveal. realname_status, masked_name, masked_id_no,\\npayout_account and deletion_status (the latest deletion request, BR-ID-27 / BR-ID-28) are\\noptional until their implementation is merged (implementation in a separate\\ntask); they then become required, with null as described on each.\\n",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "nickname",\n          "phone_masked",\n          "invite_code",\n          "inviter_user_id",\n          "level",\n          "register_method",\n          "registered_channel",\n          "created_at",\n          "risk",\n          "union_bindings"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nickname": {\n            "type": "string"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "invite_code": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32\n          },\n          "inviter_user_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "user_id of the current inviter (users.parent_id); null when none is bound."\n          },\n          "level": {\n            "$ref": "#/components/schemas/AdminUserLevel"\n          },\n          "register_method": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "How the account was created (users.register_method), as stored."\n          },\n          "registered_channel": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Install channel at registration (users.registered_channel), as stored."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Registration time."\n          },\n          "risk": {\n            "$ref": "#/components/schemas/AdminUserRiskState"\n          },\n          "union_bindings": {\n            "type": "array",\n            "description": "One entry per platform the user has a binding row on.",\n            "items": {\n              "$ref": "#/components/schemas/AdminUserUnionBinding"\n            }\n          },\n          "realname_status": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml realname_status (the user\'s realname row; none when the\\nuser has none). Added by CT-26k (D10-517); not returned until its implementation is\\nmerged.\\n",\n            "enum": [\n              "none",\n              "verified",\n              "failed"\n            ]\n          },\n          "masked_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Real name with only the last character kept (`**三`, BR-ID-33); null unless\\nrealname_status is verified. The full name only through the audited reveal. Added by\\nCT-26k (D10-517); not returned until its implementation is merged.\\n"\n          },\n          "masked_id_no": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 32,\n            "description": "ID number with only the first and the last character kept, the rest `*`\\n(`1****************X`, BR-ID-33); null unless realname_status is verified. The full\\nnumber only through the audited reveal. Added by CT-26k (D10-517); not returned until\\nits implementation is merged.\\n"\n          },\n          "payout_account": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/PayoutAccount"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The user\'s current payout account (payout_accounts.is_current), masked exactly as GET\\n/v1/me/payout-account returns it (BR-ID-33 细则「收款账号的脱敏格式」: masked_account,\\nmasked_payee_name, bank_name for a bank card); null when none is bound. Only a\\nverified account is ever saved (BR-WDR-02), so there is no separate verification\\nstate. The full account only through the audited reveal. Added by CT-26k (D10-517);\\nnot returned until its implementation is merged.\\n"\n          },\n          "deletion_status": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/DeletionStatus"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Status of the user\'s latest account-deletion request (BR-ID-27, BR-ID-28: cooling,\\nprocessing, done or cancelled); null when the user has never requested deletion.\\nAdded by CT-26k (D10-517); not returned until its implementation is merged.\\n"\n          }\n        }\n      },\n      "AdminUserDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserProfileEditResult": {\n        "type": "object",\n        "description": "The answer of PATCH /admin/v1/users/{user_id}/profile: the user exactly as AdminUserDetail\\n(GET /admin/v1/users/{user_id}) describes it now, every property the same, plus\\n`changed_fields` (CT-26k, D10-517). Keep the properties in step with AdminUserDetail.\\n",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "nickname",\n          "phone_masked",\n          "invite_code",\n          "inviter_user_id",\n          "level",\n          "register_method",\n          "registered_channel",\n          "created_at",\n          "risk",\n          "union_bindings"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nickname": {\n            "type": "string"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "invite_code": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32\n          },\n          "inviter_user_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "user_id of the current inviter (users.parent_id); null when none is bound."\n          },\n          "level": {\n            "$ref": "#/components/schemas/AdminUserLevel"\n          },\n          "register_method": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "How the account was created (users.register_method), as stored."\n          },\n          "registered_channel": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Install channel at registration (users.registered_channel), as stored."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Registration time."\n          },\n          "risk": {\n            "$ref": "#/components/schemas/AdminUserRiskState"\n          },\n          "union_bindings": {\n            "type": "array",\n            "description": "One entry per platform the user has a binding row on.",\n      