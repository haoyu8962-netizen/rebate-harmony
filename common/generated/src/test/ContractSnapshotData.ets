       "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminArticleList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminArticleVersion": {\n        "type": "object",\n        "description": "One version row of an article.",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "status",\n          "title",\n          "body",\n          "notice_closable",\n          "notice_content_version",\n          "notice_end_at",\n          "published_at",\n          "created_at",\n          "updated_at"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "status": {\n            "$ref": "#/components/schemas/ArticleVersionStatus"\n          },\n          "title": {\n            "type": "string"\n          },\n          "body": {\n            "type": "string",\n            "description": "tiptap JSON document as a string."\n          },\n          "notice_closable": {\n            "type": "boolean",\n            "description": "Notices only; true for other categories."\n          },\n          "notice_content_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Maintained by the server on save (BR-TEXT-13 细则「首页公告条的关闭与内容版本」)."\n          },\n          "notice_end_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of the notice\'s effective window