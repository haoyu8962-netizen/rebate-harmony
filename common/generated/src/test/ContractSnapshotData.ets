\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPagePreviewToken"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigKey": {\n        "type": "string",\n        "description": "A configuration or emergency-switch key (04 §10, §10.2): dotted segments, concrete per\\nplatform or channel (`convert.enabled.taobao`); the server\'s registry decides which keys\\nexist.\\n",\n        "minLength": 1,\n        "maxLength": 128,\n        "pattern": "^[a-z][a-z0-9_]*(\\\\.[A-Za-z0-9_]+)*$"\n      },\n      "AdminConfigValue": {\n        "description": "Any JSON value of the key\'s `value_type` (an `enum` value is one of `options`); checked by\\nthe server against the key\'s registered type and rule, a mismatch → 20001 with\\ndata.fields=[value].\\n"\n      },\n      "AdminConfigValueType": {\n        "type": "string",\n        "description": "Type of a configuration or switch value: boolean, enum (a string out of `options`), object\\n(a JSON object or array, such as a list of routes or hosts), number or string.\\n",\n        "enum": [\n          "boolean",\n          "enum",\n          "object",\n          "number",\n          "string"\n        ]\n      },\n      "AdminConfigOptions": {\n        "type": [\n          "array",\n          "null"\n        ],\n        "description": "Allowed values when `value_type` is enum; null for every other type.",\n        "items": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "AdminConfigVersionNumber": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 0,\n        "description": "Version of the key\'s current value: 0 = never written (value null, the default applies);\\nplus 1 on every change or rollback, never going back. The CAS value `expected_version`\\nof the writes.\\n"\n      },\n      "AdminConfigReason": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 200,\n        "description": "Optional free-text reason, kept in the audit record and the history version."\n      },\n      "AdminKillSwitch": {\n        "type": "object",\n        "description": "A registered emergency switch (04 §10.2) and its current value.",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "value",\n          "default",\n          "value_type",\n          "options",\n          "permissions",\n          "admin_editable",\n          "version",\n          "updated_by",\n          "updated_at"\n        ],\n        "properties": {\n          "key": {\n            "$ref": "#/components/schemas/AdminConfigKey"\n          },\n          "value": {\n            "description": "Current value; null = never written, `default` applies.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminConfigValue"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "default": {\n            "$ref": "#/components/schemas/AdminConfigValue"\n          },\n          "value_type": {\n            "$ref": "#/components/schemas/AdminConfigValueType"\n          },\n          "options": {\n            "$ref": "#/components/schemas/AdminConfigOptions"\n          },\n          "permissions": {\n            "type": "array",\n            "description": "Permission points of which any one may change the switch (04 §11.2).",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AdminPermissionKey"\n            }\n          },\n          "admin_editable": {\n            "type": "boolean",\n            "description": "false = the console shows the switch read only and a change is 20001 [key]. For\\n`withdraw.auto_payout.enabled` true means it can only be turned off: the console offers\\n`false` only and a change to `true` is 20001 [value] (BR-WDR-30).\\n"\n          },\n          "version": {\n            "$ref": "#/components/schemas/AdminConfigVersionNumber"\n          },\n          "updated_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Username of the admin who last changed it; null = never changed or set by the system."\n          },\n          "updated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminKillSwitchPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Registered switches in registry order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminKillSwitch"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminKillSwitchPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminKillSwitchPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminKillSwitchResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminKillSwitch"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminKillSwitchUpdateRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "value",\n          "expected_version"\n        ],\n        "properties": {\n          "value": {\n            "$ref": "#/components/schemas/AdminConfigValue"\n          },\n          "expected_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminConfigVersionNumber"\n              }\n            ],\n            "description": "The switch\'s `version` as the console showed it; a mismatch is 20902."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminConfigReason"\n          }\n        }\n      },\n      "AdminRiskRuleId": {\n        "type": "string",\n        "description": "A risk rule\'s business code (risk_rules.rule_id, unique per app; 04 §3.2), as the rule seed\\nregistered it (B1-03, BR-ID-36), for example `DEVICE_REGISTER_LIMIT` or `inv_08_self`.\\n",\n        "minLength": 1,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"\n      },\n      "AdminRiskRuleStatus": {\n        "type": "string",\n        "description": "contracts/enums/admin.yaml `risk_rule_status` (04 §3.2, §6.6; BR-ID-36 细则「规则清单的启停」):\\nenabled = the rule takes part in judgements; disabled = it does not and writes no\\nrisk_hits.\\n",\n        "enum": [\n          "enabled",\n          "disabled"\n        ]\n      },\n      "AdminRiskAction": {\n        "type": "string",\n        "description": "contracts/enums/admin.yaml `risk_action` (BR-ID-36), what a hit of the rule does.",\n        "enum": [\n          "pass",\n          "manual_review",\n          "block",\n          "void_commission"\n        ]\n      },\n      "AdminRiskRule": {\n        "type": "object",\n        "description": "One row of the risk rule list (04 §6.6 risk-rules, §3.2 risk_rules). The condition JSON\\nis not returned; threshold values are configuration items (/admin/v1/config-items).\\n",\n        "additionalProperties": false,\n        "required": [\n          "rule_id",\n          "scene",\n          "name",\n          "risk_action",\n          "status",\n          "threshold_keys",\n          "version",\n          "updated_at"\n        ],\n        "properties": {\n          "rule_id": {\n            "$ref": "#/components/schemas/AdminRiskRuleId"\n          },\n          "scene": {\n            "type": "string",\n            "description": "The scene code the rule seed registered (risk_rules.scene, for example `register`,\\n`login`, `withdrawal`); open text, no closed list in 04 or this contract.\\n",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "name": {\n            "type": "string",\n            "description": "Display name of the rule (risk_rules.name, from the rule seed).",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "risk_action": {\n            "$ref": "#/components/schemas/AdminRiskAction"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminRiskRuleStatus"\n          },\n          "threshold_keys": {\n            "type": "array",\n            "description": "Keys of the configuration items holding the rule\'s thresholds (registered under\\n`config.risk`), read and changed only through /admin/v1/config-items; an empty array\\nfor a rule without a threshold.\\n",\n            "uniqueItems": true,\n            "items": {\n              "$ref": "#/components/schemas/AdminConfigKey"\n            }\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The rule\'s compare-and-set value: plus 1 on every enable or disable that changes\\n`status`, unchanged when the rule already had the target status. The\\n`expected_version` of POST /admin/v1/risk-rules/{rule_id}/enable and …/disable.\\n"\n          },\n          "updated_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the row was last changed (+08:00)."\n          }\n        }\n      },\n      "AdminRiskRuleList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Every rule of the console\'s app, by scene, then rule_id; not paged.",\n            "items": {\n              "$ref": "#/components/schemas/AdminRiskRule"\n            }\n          }\n        }\n      },\n      "AdminRiskRuleListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminRiskRuleList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminRiskRuleResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminRiskRule"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminRiskRuleStatusChangeRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "expected_version"\n        ],\n        "properties": {\n          "expected_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The rule\'s `version` as GET /admin/v1/risk-rules listed it; a mismatch is 20902."\n          },\n          "reason": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Optional free-text reason, kept in the audit record."\n          }\n        }\n      },\n      "AdminAppealTargetType": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml appeal_target_type, the full set (04 §3.2 appeals): the\\nconsole lists and registers blocked_request appeals too, unlike the user-side\\nAppealTargetType.\\n",\n        "enum": [\n          "account",\n          "order",\n          "blocked_request"\n        ]\n      },\n      "AdminAppealPrevRiskState": {\n        "type": "string",\n        "description": "The penalty an account appeal is against (appeals.prev_risk_state; a subset of enum risk_state, BR-ID-36).",\n        "enum": [\n          "frozen",\n          "banned"\n        ]\n      },\n      "AdminBlockedRequestType": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml blocked_request_type (BR-ID-36 细则「被拦截请求申诉」).",\n        "enum": [\n          "register",\n          "withdraw",\n          "phone_change",\n          "payout_account"\n        ]\n      },\n      "AdminAppealSource": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml appeal_source (04 §3.2 appeals 来源).",\n        "enum": [\n          "app",\n          "admin"\n        ]\n      },\n      "AdminBlockedRequestCause": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml blocked_request_cause, the reason category of a blocked\\nrequest: blocklist (a BR-ID-31 blocklist entry; revoking removes it and needs\\nrisk.blocklist) or rule (another block rule; revoking grants the one-time pass of\\nBR-ID-36).\\n",\n        "enum": [\n          "blocklist",\n          "rule"\n        ]\n      },\n      "AdminBlocklistDimension": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml blocklist_dimension (04 §3.2 blocklist; BR-ID-31).",\n        "enum": [\n          "phone",\n          "id_no",\n          "alipay",\n          "bank_card",\n          "wechat_openid",\n          "device",\n          "relation_id",\n          "order_no_suffix",\n          "channel"\n        ]\n      },\n      "AdminRiskHitRefType": {\n        "type": "string",\n        "description": "contracts/enums/identity.yaml risk_hit_ref_type (04 §3.2 risk_hits.ref_type).",\n        "enum": [\n          "order",\n          "withdrawal",\n          "blocked_request",\n          "invite_relation",\n          "invite_reward"\n        ]\n      },\n      "AdminAppealRevokePermission": {\n        "type": "string",\n        "description": "The permission point revoking needs on top of risk.appeal (a subset of enum\\nadmin_permission; 04 §11.2 risk.appeal, 编排裁定 D10-154); each also needs a totp step-up.\\n",\n        "enum": [\n          "risk.ban",\n          "risk.freeze",\n          "risk.blocklist"\n        ]\n      },\n      "AdminAppealDecision": {\n        "type": "string",\n        "description": "How an appeal is closed (a subset of enum appeal_status; BR-ID-36).",\n        "enum": [\n          "upheld",\n          "revoked"\n        ]\n      },\n      "AdminAppealUser": {\n        "type": "object",\n        "description": "The appellant as the console shows it; the phone number only masked (BR-ID-33).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "phone_masked"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          }\n        }\n      },\n      "AdminAppealListItem": {\n        "type": "object",\n        "description": "An appeal row of the console list (04 §3.2 appeals). Not the user-side Appeal. The display\\nnumber of an appeal is its appeal_id; there is no separate appeal number.\\n",\n        "additionalProperties": false,\n        "required": [\n          "appeal_id",\n          "user",\n          "target_type",\n          "target_id",\n          "target_no",\n          "request_type",\n          "prev_risk_state",\n          "created_at",\n          "deadline_at",\n          "status",\n          "handler_id",\n          "handler_name"\n        ],\n        "properties": {\n          "appeal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user": {\n            "description": "The appellant; null for a register-type blocked_request appeal (no account).",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminAppealUser"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "target_type": {\n            "$ref": "#/components/schemas/AdminAppealTargetType"\n          },\n          "target_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "target_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The target\'s display number (对象编号): the sub-order number (orders.sub_order_id) for\\norder, the blocked request id for blocked_request, the UID for account.\\n"\n          },\n          "request_type": {\n            "description": "The blocked request\'s type; null unless target_type is blocked_request.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminBlockedRequestType"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "prev_risk_state": {\n            "description": "The penalty appealed against; null unless target_type is account.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminAppealPrevRiskState"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the appeal was submitted or registered."\n          },\n          "deadline_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "The internal time limit (BR-ID-36); past it a processing appeal is overdue."\n          },\n          "status": {\n            "$ref": "#/components/schemas/AppealStatus"\n          },\n          "handler_id": {\n            "description": "admin_id of the last claimer, the resolver once closed; null while never claimed.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "handler_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The handler\'s display name (admin_users.display_name, else the username); null when handler_id is null or the account is gone."\n          }\n        }\n      },\n      "AdminAppealCounts": {\n        "type": "object",\n        "description": "The four tab counts, counted with every filter of the request except status and overdue\\n(0 included).\\n",\n        "additionalProperties": false,\n        "required": [\n          "processing",\n          "overdue",\n          "closed",\n          "all"\n        ],\n        "properties": {\n          "processing": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Status processing."\n          },\n          "overdue": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Processing and past deadline_at (a part of processing)."\n          },\n          "closed": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Status upheld or revoked."\n          },\n          "all": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Every status."\n          }\n        }\n      },\n      "AdminAppealPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total",\n          "counts"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminAppealListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },