y_phone_masked": "138****5678",\n                        "locked_until": null,\n                        "permissions": [\n                          "fund.view",\n                          "fund.adjust"\n                        ],\n                        "created_at": "2026-10-05T09:00:00+08:00"\n                      },\n                      {\n                        "admin_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5b02",\n                        "username": "ops-yi",\n                        "is_super": false,\n                        "status": "active",\n                        "totp_bound": false,\n                        "verify_phone_masked": null,\n                        "locked_until": "2026-10-07T10:30:00+08:00",\n                        "permissions": [],\n                        "created_at": "2026-10-06T14:00:00+08:00"\n                      }\n                    ],\n                    "page": 1,\n                    "page_size": 20,\n                    "total": 2\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "Not available (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "notSuper": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "pageSizeTooLarge": {\n                    "$ref": "#/components/examples/AdminPageSizeInvalid"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  },\n                  "ipNotAllowed": {\n                    "$ref": "#/components/examples/AdminIpNotAllowed"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      },\n      "post": {\n        "operationId": "adminCreateAdmin",\n        "tags": [\n          "admin-accounts"\n        ],\n        "summary": "Create an ordinary admin account with a one-time initial password (super admin, step-up)",\n        "description": "Super admin only (04 §11 引言: creating and disabling accounts and ticking points are limited\\nto super admins, need step-up and write an audit record; any other account is 10403 with\\n`data.reason=admin_permission_denied`). Step-up: totp tier (without a valid totp-tier\\n`X-Step-Up-Token` → 10003 with `data.tier=totp`).\\nCreates an ordinary account only (`is_super=false`; super admins are not created here):\\nno permission point is ticked (they are ticked afterwards with PUT\\n/admin/v1/admins/{admin_id}/permissions), no verify phone is registered (registered\\nafterwards by the holder through PUT /admin/v1/me/verify-phone, or by a super admin\\nthrough PUT /admin/v1/admins/{admin_id}/verify-phone), the authenticator is not bound and\\nthe account is on its initial password, so its first login goes through\\n`change_password` and then `bind_totp` (POST /admin/v1/auth/login).\\n`username` (the login name, cannot be changed later) must differ from every existing\\naccount\'s, disabled accounts included (BR-ID-43「停用后台账号」: a name is never\\ngiven out again); a taken name is 20001 with `data.fields=[username]`. `display_name` is\\nrequired here (1–32 characters after trimming, else 20001 with\\n`data.fields=[display_name]`). Composition rules of the login name beyond its length are\\nnot fixed by 规划/08 and are left to the admin module task.\\nInitial password (BR-ID-43「初始密码」): generated by the server and returned in\\n`initial_password` of this response only, once; it is never readable again, never written\\nto logs or to the audit record, and the response carries `Cache-Control: no-store`. The\\nsuper admin tells it to the holder face to face or in a WeChat Work private chat only. It\\nis valid for the first login only and stops working once replaced (POST\\n/admin/v1/auth/password).\\nNo Idempotency-Key (04 §6.6): when the outcome is unknown the console looks the account\\nup in GET /admin/v1/admins instead of resending; if the account exists but its initial\\npassword never reached the holder, POST /admin/v1/admins/{admin_id}/initial-password\\nissues a new one (BR-ID-43「重新生成初始密码」).\\nAudit (BR-ID-34): action admin_account_create with the new account\'s id, username and\\ndisplay_name (never the password).\\n",\n        "x-auth": "super",\n        "x-error-codes": [\n          10001,\n          10003,\n          10403,\n          20001\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/AdminStepUpToken"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AdminCreateAdminRequest"\n              },\n              "example": {\n                "username": "cs.xiaoli",\n                "display_name": "客服小狸"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The account was created; the initial password is shown this once.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              },\n              "Cache-Control": {\n                "required": true,\n                "description": "Always no-store; the one-time initial password is not cached by any proxy or the browser.",\n                "schema": {\n                  "type": "string",\n                  "enum": [\n                    "no-store"\n                  ]\n                }\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminCreatedAccountResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "account": {\n                      "admin_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5b03",\n                      "username": "cs.xiaoli",\n                      "display_name": "客服小狸",\n                      "is_super": false,\n                      "status": "active",\n                      "totp_bound": false,\n                      "verify_phone_masked": null,\n                      "locked_until": null,\n                      "permissions": [],\n                      "created_at": "2026-10-12T10:00:00+08:00",\n                      "row_version": 0\n                    },\n                    "initial_password": "example-initial-password"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "No account created (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "stepUpRequired": {\n                    "$ref": "#/components/examples/AdminStepUpRequiredTotp"\n                  },\n                  "usernameTaken": {\n                    "$ref": "#/components/examples/AdminUsernameTaken"\n                  },\n                  "displayNameInvalid": {\n                    "$ref": "#/components/examples/AdminDisplayNameInvalid"\n                  },\n                  "notSuper": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/admin/v1/admins/{admin_id}": {\n      "get": {\n        "operationId": "adminGetAdmin",\n        "tags": [\n          "admin-accounts"\n        ],\n        "summary": "One admin account (super admin only, read-only)",\n        "description": "Same fields as a list item. Super admin only (10403 `data.reason=admin_permission_denied`\\notherwise). An unknown `admin_id` is 20001 with `data.fields=[admin_id]`. Never returns the\\npassword, its hash, the TOTP secret or the full verify phone.\\n",\n        "x-auth": "super",\n        "x-error-codes": [\n          10001,\n          10403,\n          20001\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/AdminIdPath"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The admin account.",\n          