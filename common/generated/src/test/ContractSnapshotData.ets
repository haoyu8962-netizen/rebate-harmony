  map.set('specs/client-security-baseline.json', '{\n  "version": "1",\n  "rules": [\n    {\n      "id": "CSB-01",\n      "title": "证书与主机名校验只用系统默认实现，不得被开关、远程配置或构建类型降级",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "源码出现自定义信任管理、放行全部证书或恒返回通过的主机名校验即失败；发请求的客户端只能由 Core 的 Network 创建",\n      "targets": [\n        "三端源码（含 debug 与 staging 配置）"\n      ]\n    },\n    {\n      "id": "CSB-02",\n      "title": "TrustedWebView、ExternalWebView 遇到证书错误一律取消加载并显示错误页，不提供「继续访问」",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "证书错误回调里出现继续或放行的调用即失败；桥一致性测试页（03 §5.5）有证书无效的用例",\n      "targets": [\n        "Features/Web 容器封装的证书错误回调"\n      ]\n    },\n    {\n      "id": "CSB-03",\n      "title": "两类容器只加载 https，禁止混合内容与 file 访问；ExternalWebView 不注入桥、不共享 Cookie",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "WebView 设置只能写在 Features/Web 的容器封装里，设置项与本条不一致即失败；其他模块直接创建 WebView 即失败",\n      "targets": [\n        "Features/Web 容器封装",\n        "其他模块里的 WebView 创建"\n      ]\n    },\n    {\n      "id": "CSB-04",\n      "title": "明文流量全关（iOS ATS 无例外；Android 不允许明文、不信任用户证书；鸿蒙无 http 业务地址）",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "检查最终产物配置，出现例外域名、明文许可或 http:// 业务地址即失败",\n      "targets": [\n        "Info.plist",\n        "合并后的 AndroidManifest 与网络安全配置",\n        "鸿蒙工程配置"\n      ]\n    },\n    {\n      "id": "CSB-05",\n      "title": "access_token、refresh_token、install_secret 只放系统安全存储，不写入普通 KV、文件、日志、剪贴板、埋点与崩溃附加信息",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "三样用专用包装类型保存（不可打印、不参与普通序列化），只有 Core 的 SecureStore 能取原值，别处取原值即失败",\n      "targets": [\n        "Core SecureStore 与令牌包装类型的使用点"\n      ]\n    },\n    {\n      "id": "CSB-06",\n      "title": "备份与换机迁移不带走敏感数据；安全存储条目仅本设备可用，普通文件不含 CSB-05 的内容",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "检查安全存储条目的可访问性属性与备份规则配置（写法接入时按官方文档核对）",\n      "targets": [\n        "iOS Keychain 可访问性属性",\n        "Android 备份规则文件",\n        "鸿蒙备份配置"\n      ]\n    },\n    {\n      "id": "CSB-07",\n      "title": "对外共享文件只暴露分享图缓存目录",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "检查文件共享路径配置与导出组件清单；分享调用点传入其他目录即失败",\n      "targets": [\n        "Android 文件共享路径配置",\n        "三端分享调用点"\n      ]\n    },\n    {\n      "id": "CSB-08",\n      "title": "MVP 不做证书固定（依靠系统信任链与 CSB-01～04；日后要做另写 ADR）",\n      "waivable": null,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "不检查；代码里出现固定配置时由评审按本条处理",\n      "targets": []\n    },\n    {\n      "id": "CSB-09",\n      "title": "入口组件最小化：只导出启动入口与声明了深链的入口组件；鸿蒙只有入口 Ability 声明深链",\n      "waivable": false,\n      "platforms": [\n        "android",\n        "harmony"\n      ],\n      "check": "合并后的清单里导出的、带 intent-filter 或深链声明的组件必须在 exported_components_allowed 里，否则失败",\n      "targets": [\n        "合并后的 AndroidManifest",\n        "鸿蒙模块配置"\n      ]\n    },\n    {\n      "id": "CSB-10",\n      "title": "第三方页容器不注入；TrustedWebView 只注入随包发布的桥启动脚本",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "ExternalWebView 封装出现执行脚本、用户脚本、注入样式、脚本消息通道的调用即失败；TrustedWebView 注入点引用配置或网络内容即失败；桥一致性测试页（03 §5.5）有「第三方页面里没有桥对象」的用例",\n      "targets": [\n        "Features/Web 容器封装",\n        "桥启动脚本资源"\n      ]\n    },\n    {\n      "id": "CSB-11",\n      "title": "入站声明只来自 apps.json 入站回调类的生成物；自定义 scheme 不得是系统保留、通用或第三方 App 的 scheme",\n      "waivable": false,\n      "platforms": [\n        "ios",\n        "android",\n        "harmony"\n      ],\n      "check": "生成物与工程文件比对；自定义 scheme 命中 forbidden_schemes，或与 apps.json 外跳目标、SDK 必需查询项里的 scheme 相同，即失败；http intent-filter、https 缺 host、带通配符、不在 own_link_hosts、无 autoVerify 即失败；Associated Domains 主机不在 own_link_hosts 即失败；鸿蒙 https 深链在 CAP-X-03 无验证结论前即失败；iOS 查询 scheme 合计超过 20 条时生成器报错",\n      "targets": [\n        "iOS URL Types 与 Associated Domains",\n        "Android 入口组件 intent-filter",\n        "鸿蒙入口 Ability 深链声明",\n        "查询声明"\n      ]\n    }\n  ],\n  "false_positives": [],\n  "forbidden_schemes": [\n    "http",\n    "https",\n    "file",\n    "content",\n    "data",\n    "javascript",\n    "about",\n    "blob",\n    "ftp",\n    "ws",\n    "wss",\n    "tel",\n    "telprompt",\n    "sip",\n    "sips",\n    "sms",\n    "smsto",\n    "mms",\n    "mmsto",\n    "mailto",\n    "facetime",\n    "facetime-audio",\n    "geo",\n    "maps",\n    "intent",\n    "market",\n    "itms",\n    "itms-apps",\n    "itms-appss",\n    "itms-services",\n    "app-settings",\n    "app-prefs",\n    "prefs",\n    "settings"\n  ],\n  "exported_components_allowed": [],\n  "own_link_hosts": []\n}\n');
  map.set('specs/device-hash.vectors.json', '{\n  "$comment": "Device identifier hash test vectors and the initial invalid-hash list (08 BR-ID-09 细则「设备标识的无效值」). device_hash = lowercase_hex(SHA-256(UTF-8 bytes of the identifier with leading and trailing whitespace removed and lower-cased)). Clients decide invalidity before hashing and never hash an invalid identifier; the server rejects a hash on the invalid list with 20001 (data.fields=[device_hash]). invalid_hash_seeds is the initial value of config device.invalid_hashes; operations may add to it. The vectors use ASCII whitespace only; per-identifier format checks (length, character set) are not specified by 08 and are not covered here.",\n  "version": 1,\n  "hash_cases": [\n    {\n      "input": "E621E1F8-C36C-495A-93FC-0C247A3E6E5F",\n      "id_source": "idfv",\n      "note": "IDFV, upper case",\n      "device_hash": "b693983458c90a77f7e7b8e16b6e1f77e5c2a299513bc32320f127e5cc8754f2"\n    },\n    {\n      "input": "e621e1f8-c36c-495a-93fc-0c247a3e6e5f",\n      "id_source": "idfv",\n      "note": "same IDFV, lower case: same hash",\n      "device_hash": "b693983458c90a77f7e7b8e16b6e1f77e5c2a299513bc32320f127e5cc8754f2"\n    },\n    {\n      "input": "  E621E1F8-C36C-495A-93FC-0C247A3E6E5F\\n",\n      "id_source": "idfv",\n      "note": "surrounding ASCII whitespace trimmed",\n      "device_hash": "b693983458c90a77f7e7b8e16b6e1f77e5c2a299513bc32320f127e5cc8754f2"\n    },\n    {\n      "input": "9774D56D682E549D",\n      "id_source": "android_id",\n      "note": "ANDROID_ID, upper case",\n      "device_hash": "5bfed3d9319786b0c7181a2ece549a6b3330e28ba54ddc4185a12e6f7295dd31"\n    },\n    {\n      "input": "9774d56d682e549d",\n      "id_source": "android_id",\n      "note": "ANDROID_ID, lower case: same hash",\n      "device_hash": "5bfed3d9319786b0c7181a2ece549a6b3330e28ba54ddc4185a12e6f7295dd31"\n    },\n    {\n      "input": "a1b2c3d4e5f60718",\n      "id_source": "android_id",\n      "note": "ANDROID_ID",\n      "device_hash": "b82efc46c073d9d8f6dfd0ad738a7074df7789847dd8f041c62e96000323260c"\n    },\n    {\n      "input": "3F2504E0-4F89-11D3-9A0C-0305E82C3301",\n      "id_source": "odid",\n      "note": "ODID",\n      "device_hash": "d1bfaf4aff653cb27984b7d978e51a7d406d1572df95d205c254beb18dc134d3"\n    },\n    {\n      "input": "6a2f1c9e-0b7d-4e55-8c3a-2f9d1e0b4c77",\n      "id_source": "oaid",\n      "note": "OAID (reserved: MVP does not collect OAID)",\n      "device_hash": "e0a088c73623e470b688ddf26d9567471fd91bce792b87465fd8021fe68329c9"\n    }\n  ],\n  "invalid_identifier_cases": [\n    {\n      "input": "",\n      "note": "empty",\n      "valid": false\n    },\n    {\n      "input": "   ",\n      "note": "whitespace only",\n      "valid": false\n    },\n    {\n      "input": "0",\n      "note": "single zero",\n      "valid": false\n    },\n    {\n      "input": "0000000000000000",\n      "note": "all zeros, ANDROID_ID length",\n      "valid": false\n    },\n    {\n      "input": "00000000000000000000000000000000",\n      "note": "all zeros, 32 characters",\n      "valid": false\n    },\n    {\n      "input": "00000000-0000-0000-0000-000000000000",\n      "note": "all zeros, UUID form (IDFV, OAID, ODID)",\n      "valid": false\n    },\n    {\n      "input": "----",\n      "note": "hyphens only",\n      "valid": false\n    }\n  ],\n  "invalid_hash_seeds": [\n    {\n      "source_value": "",\n      "note": "empty string",\n      "device_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"\n    },\n    {\n      "source_value": "0",\n      "note": "single zero",\n      "device_hash": "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9"\n    },\n    {\n      "source_value": "0000000000000000",\n      "note": "all zeros, 16 characters",\n      "device_hash": "fcdb4b423f4e5283afa249d762ef6aef150e91fccd810d43e5e719d14512dec7"\n    },\n    {\n      "source_value": "00000000000000000000000000000000",\n      "note": "all zeros, 32 characters",\n      "device_hash": "84e0c0eafaa95a34c293f278ac52e45ce537bab5e752a00e6959a13ae103b65a"\n    },\n    {\n      "source_value": "00000000-0000-0000-0000-000000000000",\n      "note": "all zeros, UUID form",\n      "device_hash": "12b9377cbe7e5c94e8a70d9d23929523d14afa954793130f8a3959c7b849aca8"\n    },\n    {\n      "source_value": "----",\n      "note": "hyphens only (empty once zeros and hyphens are removed)",\n      "device_hash": "bd64bb8efa5b3f27e6442f23600c3b516127ea17e23724b41e50da4c22883edd"\n    },\n    {\n      "source_value": "9774d56d682e549c",\n      "note": "ANDROID_ID shared by many Android 2.2 devices (well-known public fixed value)",\n      "device_hash": "4d853cd5e7d688e75b3dca9abc2fa52ac8bafb750b6d4dc01b78e2e7bb335f8f"\n    }\n  ]\n}\n');
  map.set('specs/events.json', '{\n  "version": "2",\n  "common_fields": {\n    "event_id": {\n      "type": "string",\n      "required": true,\n      "note": "客户端生成，服务端按它去重"\n    },\n    "name": {\n      "type": "string",\n      "required": true\n    },\n    "client_at": {\n      "type": "string",\n      "required": true,\n      "note": "客户端时刻，ISO 8601 带时区"\n    },\n    "session_id": {\n      "type": "string",\n      "required": true\n    },\n    "device_id": {\n      "type": "string",\n      "required": true\n    },\n    "user_id": {\n      "type": "string",\n      "required": false,\n      "note": "游客为空"\n    },\n    "platform": {\n      "type": "enum",\n      "required": true,\n      "values": [\n        "ios",\n        "android",\n        "harmony",\n        "h5"\n      ],\n      "note": "客户端端别（contracts/enums/platform.yaml client_platform 的端侧取值）"\n    },\n    "app_version": {\n      "type": "string",\n      "required": true\n    },\n    "channel": {\n      "type": "string",\n      "required": false,\n      "note": "安装渠道（install_channel）；H5 为空"\n    },\n    "page": {\n      "type": "string",\n      "required": true\n    },\n    "spm": {\n      "type": "string",\n      "required": false,\n      "note": "页面.模块.坑位（03 §4.7）"\n    },\n    "trace_id": {\n      "type": "string",\n      "required": false\n    }\n  },\n  "events": {\n    "link_jump": {\n      "description": "外跳的每一步结果（BR-ATTR-27 ③；BR-ATTR-21 细则「待跟单卡按实际外跳选」）；另记百川初始化失败（BR-ATTR-27 淘宝行）",\n      "source": "规划/03 §4.5、§4.7；08 BR-ATTR-21、BR-ATTR-27",\n      "fields": {\n        "phase": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "purchase",\n            "startup"\n          ],\n          "note": "purchase 是一次购买外跳的某一步；startup 只用于同意隐私政策后、还没有购买时的百川初始化失败（result=sdk_init_failed），这时没有 link 与尝试"\n        },\n        "attempt_id": {\n          "type": "string",\n          "required_when": {\n            "phase": "purchase"\n          },\n          "note": "本次 open（或 H5 经 convert）响应里的 attempt_id，购买外跳的每一步都必须带、同一次外跳的各步用同一个；服务端仍接受不带编号的上报，但只当埋点、不参与待跟单卡（BR-ATTR-21 细则）"\n        },\n        "link_id": {\n          "type": "string",\n          "required_when": {\n            "phase": "purchase"\n          }\n        },\n        "union_platform": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "taobao",\n            "jd",\n            "pdd",\n            "meituan",\n            "vip",\n            "douyin",\n            "eleme",\n            "kuaishou",\n            "suning"\n          ],\n          "note": "电商平台（contracts/enums/platform.yaml platform）"\n        },\n        "step": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "sdk",\n            "scheme",\n            "universal_link",\n            "h5",\n            "copy_tpwd"\n          ],\n          "note": "只记步骤类型，不带完整推广 URL、口令、推广位或 relation_id"\n        },\n        "result": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "launched",\n            "failed",\n            "sdk_init_failed",\n            "copied"\n          ],\n          "note": "launched 拉起了目标 App 或页面；copied 已复制口令；sdk_init_failed 百川初始化失败（与已初始化但拉起失败的 failed 分开，BR-ATTR-27 淘宝行）"\n        },\n        "sdk_open_by": {\n          "type": "enum",\n          "required": false,\n          "values": [\n            "url",\n            "code"\n          ],\n          "note": "step=sdk 且为淘宝百川打开指令时必带，取 open 响应 JumpStep.sdk.open_by 的原值（url 走我方推广链接，code 走商品 ID 由 SDK 转链）；其他步骤不带"\n        },\n        "sdk_error_code": {\n          "type": "string",\n          "required": false,\n          "note": "百川回调返回的错误码原样记录（result=failed 或 sdk_init_failed 且 SDK 给出错误码时带），用来区分 SDK 报错与目标 App 未拉起；不带错误描述里的链接或参数"\n        },\n        "duration_ms": {\n          "type": "integer",\n          "required_when": {\n            "phase": "purchase"\n          }\n        },\n        "installed": {\n          "type": "enum",\n          "required_when": {\n            "phase": "purchase"\n          },\n          "values": [\n            "true",\n            "false",\n            "unknown"\n          ],\n          "note": "请求体里 installed 的同一取值（contracts/enums/trade.yaml installed_state）"\n        }\n      }\n    },\n    "external_page_union_host": {\n      "description": "第三方页容器里命中联盟平台网页域名的导航（BR-ATTR-29 ②，每次命中一条）",\n      "source": "规划/03 §5.1；08 BR-ATTR-29",\n      "fields": {\n        "union_platform": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "taobao",\n            "jd",\n            "pdd",\n            "meituan",\n            "vip",\n            "douyin",\n            "eleme",\n            "kuaishou",\n            "suning"\n          ]\n        },\n        "category": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "product",\n            "promo",\n            "union_host"\n          ],\n          "note": "命中的链接形态类别（link_pattern_category）"\n        },\n        "frame": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "initial",\n            "main",\n            "subframe",\n            "new_window"\n          ]\n        },\n        "outcome": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "parse_ok",\n            "parse_failed",\n            "block"\n          ],\n          "note": "parse_ok / parse_failed 是交识别后成功转回原生详情或留在原页提示；block 是拦下（与 specs/external-navigation.vectors.json 的 action 对应）；不带完整 URL"\n        }\n      }\n    },\n    "external_page_nav_host": {\n      "description": "容器内文档级导航的抽样埋点（采样率 /v1/config external_page.nav_host_sample_bp；BR-ATTR-29 细则「覆盖限制与待定事项」）",\n      "source": "规划/03 §5.1；08 BR-ATTR-29",\n      "fields": {\n        "registered_domain": {\n          "type": "string",\n          "required": true,\n          "note": "只记注册域，不带路径、参数与来源页"\n        },\n        "frame": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "initial",\n            "main",\n            "subframe",\n            "new_window"\n          ]\n        },\n        "hit": {\n          "type": "boolean",\n          "required": true,\n          "note": "是否命中链接形态表"\n        }\n      }\n    },\n    "external_page_blocked_nav": {\n      "description": "第三方页容器取消的非 https 跳转与下载（只记类别）",\n      "source": "规划/03 §5.1",\n      "fields": {\n        "kind": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "http",\n            "app_scheme",\n            "intent",\n            "market",\n            "tel",\n            "sms",\n            "mailto",\n            "other_scheme",\n            "download"\n          ],\n          "note": "只记 scheme 类别（下载另记 download），不带完整 URL"\n        },\n        "frame": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "initial",\n            "main",\n            "subframe",\n            "new_window"\n          ]\n        }\n      }\n    },\n    "route_entry_blocked": {\n      "description": "深链或推送命中不允许的入口（BR-ID-10 细则「路由入口矩阵」）",\n      "source": "规划/03 §4.4；08 BR-ID-10",\n      "fields": {\n        "route": {\n          "type": "string",\n          "required": true,\n          "note": "contracts/routes.json 的路由名，不带参数"\n        },\n        "entry": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "in_app",\n            "push",\n            "deeplink"\n          ]\n        }\n      }\n    },\n    "route_params_dropped": {\n      "description": "打开不接受参数的资金与实名页面时丢弃了参数（功能对照 G-69）",\n      "source": "规划/03 §4.4；08 BR-WDR 细则「资金与实名页面不接受外部预填」",\n      "fields": {\n        "route": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "Withdraw",\n            "PayoutAccount",\n            "LaborAgreement",\n            "RealName"\n          ]\n        },\n        "dropped_count": {\n          "type": "integer",\n          "required": true,\n          "note": "只记个数，不记参数名与值"\n        }\n      }\n    },\n    "bridge_call": {\n      "description": "JSBridge 调用被拒（规划/03 §5.3；BR-ATTR-29 细则「桥方法不留没有归因的打开入口」）；当前只记拒绝，强更状态未知时以 90500 拒绝的调用要不要记待定",\n      "source": "规划/03 §5.3；08 BR-ATTR-29",\n      "fields": {\n        "method": {\n          "type": "string",\n          "required": true,\n          "note": "桥方法名（contracts/bridge.schema.json），不带参数与 url"\n        },\n        "code": {\n          "type": "integer",\n          "required": true,\n          "note": "桥错误码（90001–90500）"\n        }\n      }\n    },\n    "sdui_card_error": {\n      "description": "SDUI 卡片解码失败，只丢弃这一项（规划/03 §6 解码隔离）",\n      "source": "规划/03 §6",\n      "fields": {\n        "type": {\n          "type": "string",\n          "required": true\n        },\n        "version": {\n          "type": "integer",\n          "required": false,\n          "note": "卡片自带的版本；正是因为缺它而解码失败时不带"\n        },\n        "page_version": {\n          "type": "integer",\n          "required": true,\n          "note": "页面配置的 version（整数，规划/03 §6）"\n        },\n        "reason": {\n          "type": "string",\n          "required": true\n        }\n      }\n    },\n    "app_launch": {\n      "description": "App 启动（字段待定）",\n      "source": "规划/03 §4.7",\n      "fields": {}\n    },\n    "page_view": {\n      "description": "页面浏览（字段待定）",\n      "source": "规划/03 §4.7",\n      "fields": {}\n    },\n    "exposure": {\n      "description": "卡片曝光（字段待定）",\n      "source": "规划/03 §4.7",\n      "fields": {}\n    },\n    "click": {\n      "description": "点击（字段待定）",\n      "source": "规划/03 §4.7",\n      "fields": {}\n    },\n    "search": {\n      "description": "搜索（字段待定）",\n      "source": "规划/03 §4.7",\n      "fields": {}\n    },\n    "convert": {\n      "description": "转链（字段待定）",\n      "source": "规划/03 §4.7",\n      "fields": {}\n    },\n    "h5_white_screen": {\n      "description": "H5 白屏（字