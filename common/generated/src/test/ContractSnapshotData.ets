   "schema": {\n                "$ref": "#/components/schemas/MarkTipReadRequest"\n              },\n              "example": {\n                "platform": "taobao"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "Recorded (or already recorded).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EmptyResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {},\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/me/tips/{tip_key}": {\n      "delete": {\n        "operationId": "resetTip",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Show a tip again",\n        "description": "Settings「重新显示下单须知」: clears the read records of jump_tip on every platform. Only\\ntip_key=jump_tip is accepted (the path parameter allows only that value; another value is\\n20001). Version gate: applied.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          20001,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "name": "tip_key",\n            "in": "path",\n            "required": true,\n            "description": "Only jump_tip can be reset.",\n            "schema": {\n              "$ref": "#/components/schemas/ResettableTipKey"\n            }\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The read records are cleared.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EmptyResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {},\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/me/notification-settings": {\n      "get": {\n        "operationId": "getNotificationSettings",\n        "tags": [\n          "content"\n        ],\n        "summary": "My push settings",\n        "description": "Push switches per message category (BR-WATCH-19 ③, 拍板第二批 OPS-16): `service_push`\\n(trade and withdrawal messages are both service), `subscription_push` and\\n`marketing_push`. MVP opens only the service switch; subscription and marketing are\\nreserved and not shown by the client. A switch only affects push: with it off nothing of\\nthat category is pushed, the in-app message is still written (GET /v1/messages). A user\\nwho never saved settings gets all three true. PRD v2.1\'s /v1/notification-prefs is this\\noperation (04 §6.1). Not signed and no Idempotency-Key: 04 §6 marks neither S nor I.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "My push settings (defaults when never saved).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/NotificationSettingsResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n