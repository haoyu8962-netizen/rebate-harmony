            {\n              "type": "null"\n            }\n          ]\n        },\n        "tlj_kind": {\n          "description": "contracts/enums tlj_kind.",\n          "type": "string",\n          "enum": [\n            "ours",\n            "brand_open",\n            "third_party",\n            "unknown"\n          ]\n        }\n      }\n    },\n    "card_order_status": {\n      "description": "Order summary; fields trimmed as in the order list (BR-TEXT-02 细则「订单的检索范围与分享单的投影」), no order number. A shared order with is_other_product=true has a null title.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "order_id",\n        "platform",\n        "title",\n        "is_other_product",\n        "display_status",\n        "reason",\n        "est_rebate_fen",\n        "expected_credit_period"\n      ],\n      "properties": {\n        "order_id": {\n          "$ref": "#/$defs/entity_id"\n        },\n        "platform": {\n          "$ref": "#/$defs/platform"\n        },\n        "title": {\n          "type": [\n            "string",\n            "null"\n          ]\n        },\n        "is_other_product": {\n          "type": "boolean"\n        },\n        "display_status": {\n          "description": "contracts/enums display_status (BR-FUND-17).",\n          "type": "string",\n          "enum": [\n            "PAID",\n            "DEPOSIT_PAID",\n            "WAITING",\n            "CREDITING",\n            "REVIEWING",\n            "RIGHTS_PENDING",\n            "CREDITED",\n            "CREDITED_PART_CLAWED",\n            "NO_REBATE",\n            "INVALID",\n            "CLAWED_BACK"\n          ]\n        },\n        "reason": {\n          "description": "contracts/enums order_reason, or null.",\n          "anyOf": [\n            {\n              "type": "string",\n              "enum": [\n                "REFUND",\n                "RIGHTS",\n                "PUNISH",\n                "PRESALE_UNPAID",\n                "C