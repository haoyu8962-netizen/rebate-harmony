ditionalProperties": false,\n        "required": [\n          "keys",\n          "to_version",\n          "expected_version"\n        ],\n        "properties": {\n          "keys": {\n            "type": "array",\n            "description": "Keys of one class, each at most once.",\n            "minItems": 1,\n            "maxItems": 200,\n            "items": {\n              "$ref": "#/components/schemas/DictKey"\n            }\n          },\n          "to_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The dictionary version to restore the keys to; lower than the current one, 0 = the bundled default."\n          },\n          "expected_version": {\n            "$ref": "#/components/schemas/DictVersion"\n          },\n          "legal_confirmed_by": {\n            "$ref": "#/components/schemas/AdminDictLegalConfirmedBy"\n          }\n        }\n      },\n      "AdminDictSaveResult": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "keys"\n        ],\n        "properties": {\n          "version": {\n            "$ref": "#/components/schemas/DictVersion"\n          },\n          "keys": {\n            "type": "array",\n            "description": "The keys written at that version, in request order.",\n            "items": {\n              "$ref": "#/components/schemas/DictKey"\n            }\n          }\n        }\n      },\n      "AdminDictSaveResultResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminDictSaveResult"\n         