chema": {\n                "$ref": "#/components/schemas/LoginByHuaweiRequest"\n              },\n              "example": {\n                "attempt_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a71",\n                "authorization_code": "example-huawei-authorization-code",\n                "legal_versions": {\n                  "privacy": 3,\n                  "agreement": 2\n                },\n                "consent_at": "2026-10-02T09:30:00+08:00"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "Logged in.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/LoginResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "user_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a61",\n                    "is_new_user": false,\n                    "tokens": {\n                      "access_token": "example-access-token-one",\n                      "access_expires_at": "2026-10-02T11:30:00+08:00",\n                      "refresh_token": "example-refresh-token-one",\n                      "refresh_expires_at": "2026-11-01T09:30:00+08:00",\n                      "session_scope": "full"\n                    }\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/auth/merge": {\n      "post": {\n        "operationId": "mergeAccount",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Merge the third-party account into the phone account",\n        "description": "Merges the current third-party account without phone into the account that owns the phone\\nnumber (BR-ID-06, 拍板第二批 OPS-04). The body takes only `merge_ticket`: data.merge_ticket\\nof the 30411 returned by POST /v1/me/phone, valid for 5 minutes and once, bound to the\\ncurrent user and the target number; the SMS code was already used there and none is sent\\nagain. On success the third-party identities move to the phone account, the source account\\nis tombstoned and all its sessions are revoked, and the tokens of the phone account are\\nreturned (is_new_user=false, session_scope decided for this request as for a login). A\\nticket that is expired, used or whose conditions no longer hold is only 30411; the ticket\\nstore being unavailable is 50001 and nothing is merged. A retry with the same\\nIdempotency-Key after a lost response finds the source session revoked and gets 10002: the\\ntoken check comes before the idempotent replay (BR-ID-06 细则). Version gate: applied.\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-implementation": "planned",\n        "x-error-codes": [\n          20001,\n          30411,\n          50001,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/MergeAccountRequest"\n              },\n              "example": {\n                "merge_ticket": "example-merge-ticket"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "Merged; the tokens of the phone account.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/LoginResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "user_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a62",\n                    "is_new_user": false,\n                    "tokens": {\n                      "access_token": "example-access-token-one",\n                      "access_expires_at": "2026-10-02T11:30:00+08:00",\n                      "refresh_token": "example-refresh-token-one",\n                      "refresh_expires_at": "2026-11-01T09:30:00+08:00",\n                      "session_scope": "full"\n                    }\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/auth/step-up": {\n      "post": {\n        "operationId": "stepUp",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Second verification for a sensitive operation",\n        "description": "Returns a step_up_token bound to `action` (BR-ID-08); the client sends it as the\\nX-Step-Up-Token header of the matching operation (04 §5 step-up row). Exactly one way:\\nan SMS code (`action`, `code`; only for an account with a bound phone; 20002 wrong code,\\n20003 expired), or a new third-party authorization (`action`, `provider`, `attempt_id` and\\nthe credential fields of that provider\'s login: WeChat `code`, Apple `identity_token` and\\n`authorization_code`, Huawei `authorization_code`), which is open only to an account\\nwithout a bound phone (a bound phone → 20001). The server checks the credential as at\\nlogin and accepts only an attempt with purpose=step_up and the same user and action; an\\nidentity other than the one this account bound for that provider is 20004 with\\n`data.reason=identity_mismatch`, an invalid credential or attempt is 20004, the provider\\nbeing unavailable is 50305.\\nVersion gate (conditional): not applied when action=account_deletion; applied otherwise.\\nSession scopes: a deletion_only session is accepted only for action=account_deletion. Both\\nper BR-ID-01 细则, which wins on any difference.\\nWhen action=phone_change and the phone change switch is off, 30414 is returned early: after\\n10405 and before the SMS code (or third-party credential) is checked (BR-ID-06 细则); the\\n30414 of the phone change operation itself stays the final check.\\nBusiness summary (BR-ID-08 细则「绑定业务摘要」): for action withdraw or\\npayout_account_change the body must carry `summary` (any of the four ways); its shape pairs\\nwith the action — withdraw takes `payout_account_id` and `amount_fen`, payout_account_change\\ntakes the new account to be saved (alipay `alipay_logon_id`, bank_card `card_no`, wechat\\nthe payout_bind `attempt_id`; no payee_name, no client fingerprint: the server normalises the\\naccount and computes its HMAC). A missing summary for these two actions, a shape that does\\nnot pair with the action, or a summary with any other action (phone_change,\\naccount_deletion are not bound) → 20001 with data.fields=[summary]; the schema leaves\\n`summary` optional and the server decides. The server writes it into the token as one\\nstring claim (withdraw `w:<payout_account_id>:<amount_fen>`, payout account change\\n`p:<payout_method>:<HMAC of the normalised account>`, wechat `p:wechat:<attempt_id>`).\\nThe withdrawal or the payout account save compares it inside the business lock: a mismatch\\nis 10003, the token\'s jti reservation is released and the token is not consumed; an\\nidempotent replay is not compared.\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": false,\n        "x-min-version-gate": "conditional",\n        "x-session-scopes": [\n          "full",\n          "deletion_only"\n        ],\n        "x-error-codes": [\n          20001,\n          20002,\n          20003,\n          20004,\n          50305,\n          10405,\n          30414\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/StepUpRequest"\n              },\n              "examples": {\n                "sms": {\n                  "summary": "SMS code",\n                  "value": {\n                    "action": "withdraw",\n                    "code": "123456",\n                    "summary": {\n                      "payout_account_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a80",\n                      "amount_fen": 10000\n                    }\n                  }\n                },\n                "wechat": {\n                  "summary": "WeChat re-authorization (account without a bound phone)",\n                  "value": {\n                    "action": "account_deletion",\n                    "provider": "wechat",\n                    "attempt_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a71",\n                    "code": "example-wechat-auth-code"\n                  }\n                }\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "A step-up token for the action.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/StepUpResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "step_up_token": "example-step-up-token",\n                    "expire_at": "2026-10-02T09:35:00+08:00"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/auth/refresh": {\n      "post": {\n        "operationId": "refreshToken",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Rotate the token pair",\n        "description": "Every refresh rotates the refresh token (BR-ID-07). Resubmitting a rotated token outside\\nthe 30-second grace revokes the whole session chain and returns 10404. Clients refresh\\nsingle-flight: N concurrent 10002 trigger one refresh.\\nVersion gate: not applied (session recovery). The scope of the refreshed session is decided\\nagain from this request (X-Platform, X-Channel, X-App-Version), not inherited; the session\\nchain (sid) is unchanged (BR-ID-01 细则「受限会话」). Session scopes: accepts deletion_only.\\n",\n        "x-auth": "none",\n        "x-signed": true,\n        "x-idempotent": false,\n        "x-min-version-gate": false,\n        "x-session-scopes": [\n          "full",\n          "deletion_only"\n        ],\n        "x-error-codes": [\n          10404\n        ],\n        "security": [],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/RefreshTokenRequest"\n              },\n              "example": {\n                "refresh_token": "example-refresh-token-one"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "New token pair.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/TokenPairResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "access_token": "example-access-token-two",\n                    "access_expires_at": "2026-10-02T13:30:00+08:00",\n                    "refresh_token": "example-refresh-token-two",\n                    "refresh_expires_at": "2026-11-01T11:30:00+08:00",\n                    "session_scope": "full"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/auth/logout": {\n      "post": {\n        "operationId": "logout",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Sign out on this device",\n        "description": "Revokes the session of the access token (its sid and the refresh tokens of that chain,\\nBR-ID-07) and removes the binding between this device\'s push token and the user\\n(拍板第二批 OPS-21; push_tokens is written by the notification module). Other devices of the\\nsame user are not affected. Repeating the call with a token whose session is already\\nrevoked is answered like any revoked token (10002 / 10404 per BR-ID-07), nothing is written.\\nVersion gate: not applied (退出登录). Session scopes: accepts deletion_only (BR-ID-01 细则\\n「受限会话」).\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-min-version-gate": false,\n        "x-session-scopes": [\n          "full",\n          "deletion_only"\n        ],\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The session is revoked.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EmptyResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {},\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/consents": {\n      "post": {\n        "operationId": "recordConsent",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Record a consent or its withdrawal",\n        "description": "Inserts one consent_records row (insert only, BR-ID-12). Login is not required (04 §6.1\\n鉴权 none): with a valid access token the row is user level (user_id and this device_id);\\nwithout one it is device level (device_id from X-Device-Id, user_id empty). A device\\nwithout a registered device_id cannot record (BR-ID-12: the first-launch consent is kept\\nlocally and reported right after device registration). The current state of a subject and\\ntype is the row with the latest server_at; server_at is the server clock, client_at is the\\ntap time on the device. Withdrawing the privacy consent (type=privacy, accepted=false, the\\nprivacy center 【撤回同意】) is always a device-level row even with a token: subject is this\\ndevice, user_id is kept only as an association, other devices\' user-level state is not\\nchanged; the server then revokes this device\'s sessions and install_secret and clears its\\npush token, and the client enters basic mode (BR-ID-13). Other withdrawals (for example\\nai_third_party, BR-AI-13) follow the user / device rule above.\\ntype=clipboard_auto_import (the purpose consent for clipboard auto-recognition, BR-ID-16)\\nis likewise always a device-level row, with or without a token and for accepted true or\\nfalse: subject is this device, user_id is kept only as an association, other devices\'\\nstate is not changed (the same subject rule as withdrawing the privacy consent, BR-ID-12\\n细则); it never takes part in login_merge. Its `version` is the string\\nconfig.clipboard.consent_version; every other type takes a positive integer version. A\\ntype and version form that do not pair → 20001 with data.fields=[version]. A\\nclipboard_auto_import request must carry the device signature: the operation stays\\nx-signed false because the other types are not signed, and the server checks the\\nsignature headers (X-Timestamp, X-Nonce, X-Sign, same rules as the signing guard) inside\\nthe handler for this type only; a missing or invalid signature → 10401, a device that is\\nnot registered, revoked or not server-issued → 10402, the same codes as the signing guard.\\n`type` never takes labor_agreement (signed only through the labor agreement endpoint,\\nBR-WDR-31). `channel` never takes login_merge, h5_landing or withdraw_flow: those rows are\\nwritten by the server (login merge, landing registration, labor agreement signing).\\nA field outside these values → 20001 with data.fields.\\nVersion gate (conditional): not applied to accepted=false of any type, nor to type privacy\\nor agreement; applied otherwise. Session scopes: a deletion_only session is accepted only\\nfor the same requests (any withdrawal, and privacy or agreement records). Both per BR-ID-01\\n细则, which wins on any difference.\\n",\n        "x-auth": "optional",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-min-version-gate": "conditional",\n        "x-session-scopes": [\n          "full",\n          "deletion_only"\n        ],\n        "x-error-codes": [\n          20001,\n          10401,\n          10402,\n          10405\n        ],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/RecordConsentRequest"\n              },\n              "examples": {\n                "privacy": {\n                  "summary": "First-launch privacy consent (integer version)",\n                  "value": {\n                    "type": "privacy",\n                    "version": 3,\n                    "accepted": true,\n                    "channel": "first_launch",\n                    "client_at": "2026-10-02T09:30:00+08:00"\n                  }\n                },\n                "clipboard_auto_import": {\n                  "summary": "Clipboard auto-recognition purpose consent (string version, signed)",\n                  "value": {\n                    "type": "clipboard_auto_import",\n                    "version": "2026-10-17",\n                    "accepted": true,\n                    "channel": "privacy_center",\n                    "client_at": "2026-10-17T09:30:00+08:00"\n                  }\n                }\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The consent row is recorded.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EmptyResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {},\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/auth/h5-token": {\n      "post": {\n        "operationId": "issueH5Token",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Exchange the native session for an h5_token",\n        "description": "The native app gets an h5_token (aud=h5) for its trusted H5 pages; lifetime and scope per\\nBR-ID-32. A read_only token calling anything but GET is 10403 with\\ndata.reason=h5_read_only, decided by the server from the HTTP method. Version gate:\\napplied (BR-ID-01 细则 interface table). Session scopes: not marked, so a deletion_only\\nsession gets 10405.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/IssueH5TokenRequest"\n              },\n              "example": {\n                "scope": "standard"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "A new h5_token.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/H5TokenResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "token": "placeholder",\n                    "expire_at": "2026-10-02T10:00:00+08:00",\n                    "scope": "standard"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/unions/bindings": {\n      "get": {\n        "operationId": "listUnionBindings",\n        "tags": [\n          "union"\n        ],\n        "summary": "Authorization state per platform",\n        "description": "One item per platform. A platform with an unreleased binding gives that binding\'s status;\\notherwise released when a released binding exists, otherwise unbound. Pinduoduo reports\\nthe authorization of the self-purchase promotion slot. No released_at, cooldown_until,\\naccount name, nickname or avatar (BR-ID-17 细则「授权方式」「授权管理页」; how the page\\nshows each status is in BR-ID-17 细则).\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "Authorization state per platform.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/UnionBindingsResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "items": [\n                      {\n                        "platform": "taobao",\n                        "status": "active"\n                      },\n                      {\n                        "platform": "jd",\n                        "status": "unbound"\n                      },\n                      {\n                        "platform": "pdd",\n                        "status": "released"\n                      }\n                    ]\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/unions/{platform}/auth-url": {\n      "get": {\n        "operationId": "getUnionAuthUrl",\n        "tags": [\n          "union"\n        ],\n        "summary": "Get the authorization link of a platform",\n        "description": "Returns auth_url, state and the ordered auth_methods (Taobao: configured per platform of\\nthe device record; the client uses the first one it can run, BR-ID-17 细则「授权方式」).\\nFor platform=pdd the response carries auth_jump instead of auth_methods (executed like a\\npurchase jump plan, h5 steps in the system browser, no link_jump report). No self-service\\nrebinding or unbinding. A blocked binding of a user who is not banned is 30153 and no\\nauth_url is issued (BR-ID-17 细则「授权管理页」). For platform=taobao, while the site\'s own\\nunion authorization is unavailable the request gets the same code as a purchase would\\n(30101 for unbound, pending_auth or released, 30102 for invalid) with\\ndata.reason=auth_unavailable and no auth_url; the client only shows the notice. Pinduoduo\\nanswers 50301 with data.reason=maintenance and no auth_url (BR-ID-24 ④).\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [\n          30101,\n          30102,\n          30153,\n          50301,\n          50303\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/UnionPlatform"\n          },\n          {\n            "name": "installed",\n            "in": "query",\n            "required": false,\n            "description": "Whether the platform app is installed; when absent see BR-ID-22 细则.",\n            "schema": {\n              "$ref": "#/components/schemas/InstalledState"\n            }\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The authorization link.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/UnionAuthUrlResponse"\n                },\n                "examples": {\n                  "taobao": {\n                    "summary": "Taobao, SDK first",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "auth_url": "https://oauth.example.test/authorize?state=st_01",\n                        "state": "st_01",\n                        "auth_methods": [\n                          "sdk_token",\n                          "web_code"\n                        ]\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  },\n                  "pdd": {\n                    "summary": "Pinduoduo, with an authorization jump plan",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "auth_url": "https://auth.example.test/pdd/authorize?state=st_02",\n                        "state": "st_02",\n                        "auth_jump": {\n                          "primary": {\n                            "type": "universal_link",\n                            "value": "https://auth.example.test/pdd/authorize?state=st_02"\n                          },\n                          "fallbacks": [],\n                          "expire_at": "2026-10-02T09:40:00+08:00"\n                        }\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/unions/{platform}/bindings": {\n      "post": {\n        "operationId": "bindUnion",\n        "tags": [\n          "union"\n        ],\n        "summary": "Bind after the user authorized",\n        "description": "Taobao body: exactly one of {state, auth_method: web_code, code} and\\n{state, auth_method: sdk_token, access_token, expires_in}; no nickname, avatar or account\\nname, and any undefined field is 20001. The server checks first and consumes later: uid,\\ndevice_id, the platform of the device record (X-Platform is only a claim) and the issued\\nmethod must all match before the state is marked used; then the configured app exchanges\\nor uses the credential. A method that was not issued, is closed or does not match the\\ndevice is 30104 with data.reason=method_not_allowed (the state stays unused); an invalid\\ncredential, or one the upstream says is not for this app, is 30104 with\\ndata.reason=credential_invalid; an expired or used state is 30104 without reason. Every\\nbinding attempt (new state or new credential) uses a new Idempotency-Key; only a transport\\nretry of the same request keeps it (BR-ID-17 细则「授权方式」). While the site\'s own union\\nauthorization is unavailable the request gets 30101 (unbound, pending_auth or released) or\\n30102 (invalid) with data.reason=auth_unavailable and no auth_url (BR-ID-24 ④).\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          20001,\n          30101,\n          30102,\n          30104,\n          30151,\n          30153,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          },\n          {\n            "$ref": "#/components/parameters/UnionPlatform"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/BindUnionRequest"\n              },\n              "examples": {\n                "webCode": {\n                  "summary": "Web authorization code",\n                  "value": {\n                    "state": "st_01",\n                    "auth_method": "web_code",\n                    "code": "example-authorization-code"\n                  }\n                },\n                "sdkToken": {\n                  "summary": "Token from the Taobao SDK",\n                  "value": {\n                    "state": "st_01",\n                    "auth_method": "sdk_token",\n                    "access_token": "example-access-token",\n                    "expires_in": 86400\n                  }\n                }\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The binding state after binding.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/UnionBindingResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "platform": "taobao",\n                    "status": "active"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/orders": {\n      "get": {\n        "operationId": "listOrders",\n        "tags": [\n          "order"\n        ],\n        "summary": "My orders (self-purchase or shared)",\n        "description": "Orders of the current account in the visible range, newest paid first. scope=self gives the\\nfull order_no (copyable); scope=share gives only masked_order_no, and an item whose bought\\nproduct is not the shared one (is_other_product=true) has title and image_url null — both\\ntrimmed by the server. Shared orders exclude referral-commission orders. status_group\\ngroups display_status on the server; q matches a self-purchase order by its exact parent or\\nchild order number, otherwise titles; shared orders are matched by the visible title only.\\nGrouping, search and projection rules are only in BR-TEXT-02 细则「订单列表的状态分组与查找」\\n「订单的检索范围与分享单的投影」. earliest_visible_date is the first day in range\\n(null when unlimited; BR-ID-30 细则「订单类记录」). For a pre-sale order in DEPOSIT_PAID,\\npay_amount_fen is the deposit paid, null when the platform does not report it\\n(BR-TEXT-02 细则「预售单的付款金额」, wording pending CAP-*-07).\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "name": "scope",\n            "in": "query",\n            "required": true,\n            "description": "self = my own purchases; share = orders bought through my shares.",\n            "schema": {\n              "$ref": "#/components/schemas/OrderScope"\n            }\n          },\n          {\n            "name": "status_group",\n            "in": "query",\n            "required": false,\n            "description": "Status group (enum order_status_group); absent = all.",\n            "schema": {\n              "$ref": "#/components/schemas/OrderStatusGroup"\n            }\n          },\n          {\n            "name": "display_status",\n            "in": "query",\n            "required": false,\n            "schema": {\n              "$ref": "#/components/schemas/OrderDisplayStatus"\n            }\n          },\n          {\n            "name": "platform",\n            "in": "query",\n            "required": false,\n            "schema": {\n              "$ref": "#/components/schemas/PlatformCode"\n            }\n          },\n          {\n            "name": "q",\n            "in": "query",\n            "required": false,\n            "description": "Order number or title words, at most 40 characters (BR-TEXT-02 细则).",\n            "schema": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 40\n            }\n          },\n          {\n            "name": "paid_month",\n            "in": "query",\n            "required": false,\n            "description": "Month of payment, YYYY-MM in +08:00; only months in the visible range.",\n            "schema": {\n              "type": "string",\n              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n            }\n          },\n          {\n            "$ref": "#/components/parameters/Cursor"\n          },\n          {\n            "$ref": "#/components/parameters/Limit"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "A page of orders.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/OrderListResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "items": [\n                      {\n                        "order_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a90",\n                        "platform": "taobao",\n                        "title": "降噪蓝牙耳机",\n                        "image_url": "https://img.example.test/p/1.jpg",\n                        "pay_amount_fen": 2990,\n                        "quantity": 1,\n                        "order_no": "3712345678901234567",\n                        "display_status": "WAITING",\n                        "reason": null,\n                        "est_rebate_fen": 269,\n                        "paid_at": "2026-10-02T09:31:00+08:00",\n                        "is_other_product": false,\n                        "is_price_compare": false\n                      }\n                    ],\n                    "next_cursor": null,\n                    "earliest_visible_date": null\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/orders/claims": {\n      "post": {\n        "operationId": "createOrderClaim",\n        "tags": [\n          "order"\n        ],\n        "summary": "Submit an order claim",\n        "description": "Claims an order that was not attributed to the current account (BR-ATTR-17). The H5 form\\ncalls it through the bridge `net.signedRequest`, which signs it (bridge signed_paths). The\\ncheck order and every error code, including 30202 and 30203 `data.reason`, are only in\\nBR-ATTR-17 and BR-ATTR-19: 30203 without data is the daily limit of created claims,\\n30203 with data.reason=RISK_BLOCKED is the risk block. Orders are matched only in the app of\\nthe token. A shared order is treated as not existing: it never enters the claim, and the\\nresponse is the same 30201 (same HTTP status, msg and no data) as an unknown order number.\\nWhen no child order passes, the error of the first child order by sub_order_id ascending is\\nreturned. For pdd the hyphens are removed from both the input and the stored order numbers\\nbefore comparing. The 200 response carries only the claim that was created, whose items are\\nthe child orders that passed; acceptance and the evidence computation (BR-ATTR-18) share one\\ntransaction, so status is auto_matched or manual_review. Version gate: applied.\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          20001,\n          30201,\n          30202,\n          30203,\n          30204,\n          30205,\n          30206,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/CreateOrderClaimRequest"\n              },\n              "example": {\n                "platform": "pdd",\n                "order_no": "231006-1234567890",\n                "paid_date": "2026-10-06"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The claim that was created.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/OrderClaimResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "claim_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5aa0",\n                    "platform": "pdd",\n                    "order_no": "231006-1234567890",\n                    "paid_date": "2026-10-06",\n                    "status": "manual_review",\n                    "created_at": "2026-10-07T10:15:00+08:00",\n                    "items": [\n                      {\n                        "sub_order_id": "231006-1234567890",\n                        "decision": null,\n                        "reject_reason": null\n                      }\n                    ]\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      },\n      "get": {\n        "operationId": "listOrderClaims",\n        "tags": [\n          "order"\n        ],\n        "summary": "My order claims",\n        "description": "The claims of the current account only (app_id and user_id of the token), newest created\\nfirst, each with its child orders, their decision (null while pending) and reject reason\\n(BR-ATTR-17, BR-ATTR-18). Shared orders never appear: they were removed when the claim was\\naccepted.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n    