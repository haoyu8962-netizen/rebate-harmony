en and rebate_basis only (BR-PRICE-21); amount_unknown and login_required are\\noutside them.\\n",\n        "enum": [\n          "normal",\n          "price_compare_risk",\n          "no_rebate",\n          "amount_unknown",\n          "login_required"\n        ]\n      },\n      "Availability": {\n        "type": "string",\n        "description": "contracts/enums/trade.yaml availability.",\n        "enum": [\n          "ok",\n          "off_shelf",\n          "coupon_gone",\n          "ref_expired",\n          "price_unavailable",\n          "unknown"\n        ]\n      },\n      "InstalledState": {\n        "type": "string",\n        "description": "Whether the platform app is installed, as detected by the client (BR-ATTR-27 ①); the\\nstrings \\"true\\" / \\"false\\" / \\"unknown\\" (enum installed_state).\\n",\n        "enum": [\n          "true",\n          "false",\n          "unknown"\n        ]\n      },\n      "JumpStep": {\n        "type": "object",\n        "description": "One step of a jump plan. `sdk` is required on every type=sdk step and never present on any\\nother type; the schema keeps it optional so the already-served shape stays compatible, and\\nthe server that builds the plan (linking) guarantees the pairing, checked against the\\nexamples by the contracts-ts consistency test. For a type=sdk step the client acts on\\n`sdk` only; `value` repeats `sdk.url` (open_by=url) or `sdk.item_id` (open_by=code) for\\nlogs and compatibility.\\n",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "value"\n        ],\n        "properties": {\n          "type": {\n            "type": "string",\n            "description": "contracts/enums/trade.yaml jump_type.",\n            "enum": [\n              "sdk",\n              "scheme",\n              "universal_link",\n              "h5",\n              "copy_tpwd"\n            ]\n          },\n          "value": {\n            "type": "string",\n            "minLength": 1,\n            "description": "URL, scheme or token to execute; produced by the server only."\n          },\n          "sdk": {\n            "$ref": "#/components/schemas/BaichuanOpen"\n          }\n        }\n      },\n      "BaichuanOpen": {\n        "type": "object",\n        "description": "Taobao open instruction executed by the Baichuan SDK (docs/changes/20261003 §1; 03 §4.5).\\nThe server builds it from the link snapshot; the client passes it to the SDK unchanged and\\nnever rewrites, fills in or drops `taoke` (BR-ATTR-05). open_by=url opens our own promotion\\nlink of this user and scene and carries no commission parameter at all (BR-ATTR-27 Taobao\\nrow); open_by=code opens the item detail page and lets the SDK convert with `taoke`. A\\ncode step carries no URL, so JumpPlan.expire_at does not limit it (04 §8.4). Whether the\\nSDK returns to the app afterwards is a platform capability (CAP-TB-11), not promised here.\\nThe oneOf branches declare the properties they constrain (strict Ajv2020, ADR-0001 §4.2\\n#15).\\n",\n        "additionalProperties": false,\n        "required": [\n          "provider",\n          "open_by"\n        ],\n        "properties": {\n          "provider": {\n            "type": "string",\n            "enum": [\n              "baichuan"\n            ]\n          },\n          "open_by": {\n            "type": "string",\n            "description": "url = openByUrl with our promotion link; code = openByCode with the item ID.",\n            "enum": [\n              "url",\n              "code"\n            ]\n          },\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048,\n            "description": "Required for open_by=url; only our own promotion link of this user and scene."\n          },\n          "page": {\n            "type": "string",\n            "description": "Required for open_by=code; the page openByCode opens.",\n            "enum": [\n              "detail"\n            ]\n          },\n          "item_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Required for open_by=code; the union item ID (new string form)."\n          },\n          "sku_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Optional SKU for open_by=code."\n          },\n          "taoke": {\n            "$ref": "#/components/schemas/BaichuanTaoke"\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "open_by": {\n                "type": "string",\n                "enum": [\n                  "url"\n                ]\n              },\n              "url": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "open_by",\n              "url"\n            ],\n            "not": {\n              "type": "object",\n              "additionalProperties": true,\n              "properties": {\n                "taoke": {\n                  "$ref": "#/components/schemas/BaichuanTaoke"\n                },\n                "page": {\n                  "type": "string"\n                },\n                "item_id": {\n                  "type": "string"\n                },\n                "sku_id": {\n                  "type": "string"\n                }\n              },\n              "anyOf": [\n                {\n                  "type": "object",\n                  "properties": {\n                    "taoke": {\n                      "$ref": "#/components/schemas/BaichuanTaoke"\n                    }\n                  },\n                  "required": [\n                    "taoke"\n                  ]\n                },\n                {\n                  "type": "object",\n                  "properties": {\n                    "page": {\n                      "type": "string"\n                    }\n                  },\n                  "required": [\n                    "page"\n                  ]\n                },\n                {\n                  "type": "object",\n                  "properties": {\n                    "item_id": {\n                      "type": "string"\n                    }\n                  },\n                  "required": [\n                    "item_id"\n                  ]\n                },\n                {\n                  "type": "object",\n                  "properties": {\n                    "sku_id": {\n                      "type": "string"\n                    }\n                  },\n                  "required": [\n                    "sku_id"\n                  ]\n                }\n              ]\n            }\n          },\n          {\n            "type": "object",\n            "properties": {\n              "open_by": {\n                "type": "string",\n                "enum": [\n                  "code"\n                ]\n              },\n              "page": {\n                "type": "string",\n                "enum": [\n                  "detail"\n                ]\n              },\n              "item_id": {\n                "type": "string"\n              },\n              "taoke": {\n                "$ref": "#/components/schemas/BaichuanTaoke"\n              }\n            },\n            "required": [\n              "open_by",\n              "page",\n              "item_id",\n              "taoke"\n            ],\n            "not": {\n              "type": "object",\n              "additionalProperties": true,\n              "properties": {\n                "url": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "url"\n              ]\n            }\n          }\n        ]\n      },\n      "BaichuanTaoke": {\n        "type": "object",\n        "description": "AlibcTaokeParams of an open_by=code instruction, built by linking from the snapshot\\nidentity (BR-ATTR-05); the client must not change, fill in or drop any of it.\\n",\n        "additionalProperties": false,\n        "required": [\n          "pid"\n        ],\n        "properties": {\n          "pid": {\n            "type": "string",\n            "pattern": "^mm_\\\\d+_\\\\d+_\\\\d+$",\n            "maxLength": 64\n          },\n          "relation_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "Active binding of the snapshot user (the sharer on a share link)."\n          }\n        }\n      },\n      "JumpPlan": {\n        "type": "object",\n        "description": "Executed strictly in order; clients never build schemes or add fallbacks themselves\\n(BR-ATTR-27, 03 §4.5). The client jumps only after a user tap (BR-ATTR-21).\\n",\n        "additionalProperties": false,\n        "required": [\n          "primary",\n          "fallbacks",\n          "expire_at"\n        ],\n        "properties": {\n          "primary": {\n            "$ref": "#/components/schemas/JumpStep"\n          },\n          "fallbacks": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/JumpStep"\n            }\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Until when the returned union URL can be used directly (BR-ATTR-05); it does not\\nlimit opening the link_id again. A Taobao sdk step with open_by=code carries no URL and\\nis not limited by it (04 §8.4).\\n"\n          }\n        }\n      },\n      "IdempotencyKey": {\n        "type": "string",\n        "description": "Value of the Idempotency-Key header (04 §5「幂等」).",\n        "minLength": 8,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z0-9_-]+$"\n      },\n      "SessionScope": {\n        "type": "string",\n        "description": "scp of an access token (enum session_scope; meaning in BR-ID-01 细则「受限会话」).",\n        "enum": [\n          "full",\n          "deletion_only"\n        ]\n      },\n      "H5TokenScope": {\n        "type": "string",\n        "description": "Scope of an h5_token (enum h5_token_scope; BR-ID-32 细则「只读作用域」).",\n        "enum": [\n          "standard",\n          "read_only"\n        ]\n      },\n      "IssueH5TokenRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {\n          "scope": {\n            "$ref": "#/components/schemas/H5TokenScope",\n            "description": "Filled by the native app from its force-update state; H5 cannot choose it. The value\\nused when it is absent is set in BR-ID-32 细则「只读作用域」.\\n"\n          }\n        }\n      },\n      "H5TokenData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "token",\n          "expire_at",\n          "scope"\n        ],\n        "properties": {\n          "token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 4096\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "scope": {\n            "$ref": "#/components/schemas/H5TokenScope"\n          }\n        }\n      },\n      "H5TokenResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/H5TokenData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "StepUpAction": {\n        "type": "string",\n        "description": "Action a step_up_token is bound to; one per x-step-up operation (04 §2.5, §5).",\n        "enum": [\n          "withdraw",\n          "payout_account_change",\n          "phone_change",\n          "account_deletion"\n        ]\n      },\n      "IdempotencyAbandonOutcome": {\n        "type": "string",\n        "description": "Result of POST /v1/idempotency-keys/abandon (04 §6.1).",\n        "enum": [\n          "abandoned",\n          "completed"\n        ]\n      },\n      "AbandonIdempotencyKeyRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "idempotency_key"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "idempotency_key": {\n            "$ref": "#/components/schemas/IdempotencyKey"\n          }\n        }\n      },\n      "AbandonIdempotencyKeyData": {\n        "type": "object",\n        "description": "`original` is null exactly when `outcome=abandoned`. The oneOf branches declare the\\nproperties they constrain (strict Ajv2020, ADR-0001 §4.2 #15).\\n",\n        "additionalProperties": false,\n        "required": [\n          "outcome",\n          "original"\n        ],\n        "properties": {\n          "outcome": {\n            "$ref": "#/components/schemas/IdempotencyAbandonOutcome"\n          },\n          "original": {\n            "type": [\n              "object",\n              "null"\n            ],\n            "description": "The response envelope stored with the completed idempotency record, unchanged\\n(`code` 0 or a 3xxxx business code; 1xxxx and 2xxxx results are never stored,\\nBR-WDR-07). `data` keeps the shape of the original operation, so it is left open.\\n",\n            "additionalProperties": false,\n            "required": [\n              "code",\n              "msg"\n            ],\n            "properties": {\n              "code": {\n                "type": "integer",\n                "format": "int32",\n                "anyOf": [\n                  {\n                    "type": "integer",\n                    "format": "int32",\n                    "enum": [\n                      0\n                    ]\n                  },\n                  {\n                    "type": "integer",\n                    "format": "int32",\n                    "minimum": 30000,\n                    "maximum": 39999\n                  }\n                ]\n              },\n              "msg": {\n                "type": "string"\n              },\n              "data": {\n                "type": "object",\n                "additionalProperties": true\n              }\n            }\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "outcome": {\n                "type": "string",\n                "enum": [\n                  "abandoned"\n                ]\n              },\n              "original": {\n                "type": "null"\n              }\n            },\n            "required": [\n              "outcome",\n              "original"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "outcome": {\n                "type": "string",\n                "enum": [\n                  "completed"\n                ]\n              },\n              "original": {\n                "type": "object",\n                "additionalProperties": true\n              }\n            },\n            "required": [\n              "outcome",\n              "original"\n            ]\n          }\n        ]\n      },\n      "AbandonIdempotencyKeyResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AbandonIdempotencyKeyData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ErrorEnvelope": {\n        "type": "object",\n        "description": "Error response (04 §5, §7). `data` is present only for codes that define it; its fields\\nper code are listed in contracts/error-codes.yaml, so it is left open here.\\n",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 10000,\n            "maximum": 99999\n          },\n          "msg": {\n            "type": "string",\n            "description": "Fallback text only; clients show the dictionary text error.<code>."\n          },\n          "data": {\n            "type": "object",\n            "additionalProperties": true\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "FreeForm": {\n        "type": "object",\n        "description": "Configuration block whose inner shape is not fixed by 规划/04 yet.",\n        "additionalProperties": true\n      },\n      "ConfigBridgeOrigins": {\n        "type": "object",\n        "description": "Signed whitelist of the origins whose pages the client\'s trusted web container serves and\\nlets call the bridge (04 §10.1 可信容器白名单 + 签名; 02 §12.6; 03 §5.1 / §5.2; 12 §9 B-04;\\nD10-608 / D10-610 / D10-612). Always present.\\n\\njws is a JWS compact serialization (RFC 7515) `header.payload.signature`, each part\\nbase64url without padding:\\n- header: {\\"alg\\": \\"ES256\\", \\"kid\\": <signing key id>, \\"typ\\": \\"couli-bridge-origins+jws\\"}.\\n- payload: {\\"v\\": 1, \\"app_id\\": <the caller\'s app>, \\"env\\": \\"local\\" | \\"test\\" | \\"staging\\" |\\n  \\"prod\\", \\"version\\": <integer >= 0>, \\"origins\\": [<origin>, ...]}. Each origin is a\\n  normalized https origin: lowercase host, no path, query, fragment, credentials or\\n  wildcard, port 443 omitted, other ports kept (`https://host[:port]`). origins is non-empty\\n  and always contains the origin of h5_base_url. There is no expiry.\\n- signature: ECDSA P-256 over SHA-256 of the ASCII `header.payload`, as the raw 64-byte\\n  R‖S (IEEE P1363, RFC 7518 §3.4), not DER.\\n\\nServer: origins come from the console config item bridge_origins (an unsigned {origins});\\nversion is that item\'s version, so it grows with every save. Without the item, or when the\\nstored value is not a usable list, the server signs [origin of h5_base_url] (version 0\\nwithout the item, the item\'s version otherwise). The signature is cached per\\n(app_id, env, version, origins) and signing key (kid), so the same version answers the\\nsame jws byte for byte and the /v1/config ETag (config_version) stays stable; a new\\nversion changes both. The private key is the api entry\'s configuration signing key\\n(CONFIG_SIGN_KEY_FILE / CONFIG_SIGN_KEY_ID), separate from the JWT key.\\n\\nClient (03 §5.1 取用顺序): verify the signature with the public key that the package\\ncarries for the header\'s kid and the build\'s env, then check typ, v = 1, app_id and env\\nequal its own, and version >= the version of the last good whitelist (no rollback). Only\\nthen use origins and store it as the last good whitelist; on any failure keep the last good\\nwhitelist (or the packaged one) and never write the failed value as last good (AC-S1-180\\n②). Origins compare as in 03 §5.2: the page URL\'s normalized origin equals one entry\\nexactly.\\n\\nKey rotation: the package carries two kids per env (current + next). The server switches\\nCONFIG_SIGN_KEY_ID / CONFIG_SIGN_KEY_FILE to the next key only after the packages that\\ncarry it are released; the signature of the same version then changes once (new kid), and\\nthe old key is retired after clients that only know it are gone.\\n",\n        "additionalProperties": false,\n        "required": [\n          "jws"\n        ],\n        "properties": {\n          "jws": {\n            "type": "string",\n            "pattern": "^[A-Za-z0-9_-]+\\\\.[A-Za-z0-9_-]+\\\\.[A-Za-z0-9_-]+$",\n            "description": "JWS compact serialization signed with ES256 (see the schema description)."\n          }\n        }\n      },\n      "ConfigClipboard": {\n        "type": "object",\n        "description": "Clipboard block of /v1/config (04 §10.1). consent_version is the current version (a\\nstring) of the purpose statement for automatic clipboard recognition; the client compares\\nit with the user\'s feature consent version (BR-ID-16 门槛②). The other fields (local\\nfilter rules and so on) are typed later by the contract / native line and pass through\\nas-is for now. When the stored value does not fit this shape the server sends {} for the\\nwhole key (04 config_items 统一规则).\\n",\n        "additionalProperties": true,\n        "properties": {\n          "consent_version": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          }\n        }\n      },\n      "DeviceIdSource": {\n        "type": "string",\n        "description": "Which device identifier was hashed (enum device_id_source, BR-ID-09).",\n        "enum": [\n          "idfv",\n          "android_id",\n          "oaid",\n          "odid"\n        ]\n      },\n      "RegisterDeviceRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "device_hash",\n          "id_source"\n        ],\n        "properties": {\n          "device_hash": {\n            "type": "string",\n            "description": "lowercase_hex(SHA-256(UTF-8 bytes of the identifier, trimmed and lower-cased)) of IDFV\\n(iOS), ANDROID_ID (Android, MVP) or ODID (Harmony) (BR-ID-09 细则「设备标识的无效值」).\\n",\n            "pattern": "^[0-9a-f]{64}$"\n          },\n          "id_source": {\n            "$ref": "#/components/schemas/DeviceIdSource"\n          }\n        }\n      },\n      "RegisterDeviceData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "device_id",\n          "install_secret"\n        ],\n        "properties": {\n          "device_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "install_secret": {\n            "type": "string",\n            "description": "Signing secret, stored only in Keychain / Keystore / HUKS.",\n            "minLength": 16,\n            "maxLength": 128\n          }\n        }\n      },\n      "RegisterDeviceResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/RegisterDeviceData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "Phone": {\n        "type": "string",\n        "description": "Phone number as typed or pasted; it may carry spaces, hyphens and +86 / 0086 / 86. The\\nserver normalises it (BR-ID-05 细则「手机号规范化」); a result that is not a mainland mobile\\nnumber is 20001 with `data.fields=[phone]` and `data.reason=phone_invalid` (an empty\\nstring included). No length bound in the schema: any spacing of a valid number must reach\\nthe normaliser, and adding a bound to a request property is a breaking change (oasdiff).\\n"\n      },\n      "SendSmsCodeRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "purpose"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          },\n          "purpose": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml sms_purpose.",\n            "enum": [\n              "login",\n              "bind",\n              "step_up"\n            ]\n          },\n          "captcha_token": {\n            "type": "string",\n            "description": "Human-verification token, required after 44003 (BR-ID-05).",\n            "maxLength": 2048\n          },\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction",\n            "description": "With purpose=step_up the client always sends the action the code is for; the version\\ngate and the session scope are decided from it (BR-ID-01 细则): only\\naction=account_deletion is exempt, and a step_up request without action is gated.\\npurpose=login is exempt regardless of action; purpose=bind is gated.\\n"\n          }\n        }\n      },\n      "SendSmsCodeData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "resend_after_sec",\n          "expires_in_sec"\n        ],\n        "properties": {\n          "resend_after_sec": {\n            "type": "integer",\n            "format": "int32",\n            "description": "Seconds until another code may be requested: at least 60, the latest release among the\\nper-phone limits (BR-ID-05).\\n"\n          },\n          "expires_in_sec": {\n            "type": "integer",\n            "format": "int32",\n            "description": "Validity of the code in seconds (300, BR-ID-05)."\n          }\n        }\n      },\n      "SendSmsCodeResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/SendSmsCodeData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "LegalVersions": {\n        "type": "object",\n        "description": "Versions of the privacy policy and user agreement the user agreed to (BR-ID-04).",\n        "additionalProperties": false,\n        "required": [\n          "privacy",\n          "agreement"\n        ],\n        "properties": {\n          "privacy": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "agreement": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          }\n        }\n      },\n      "LoginBySmsRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          },\n          "code": {\n            "type": "string",\n            "pattern": "^[0-9]{6}$"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the box was ticked or the confirm dialog accepted (client clock)."\n          },\n          "invite_code": {\n            "type": "string",\n            "description": "Optional invite code; ignored for an existing account (BR-INV-06).",\n            "maxLength": 32\n          }\n        }\n      },\n      "LoginProvider": {\n        "type": "string",\n        "description": "Third-party identity provider (enum login_provider, BR-ID-04).",\n        "enum": [\n          "wechat",\n          "apple",\n          "huawei"\n        ]\n      },\n      "RecordConsentRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "version",\n          "accepted",\n          "channel",\n          "client_at"\n        ],\n        "properties": {\n          "type": {\n            "type": "string",\n            "description": "consent_type without labor_agreement (BR-ID-12, BR-WDR-31).",\n            "enum": [\n              "privacy",\n              "agreement",\n              "ai_third_party",\n              "id_verification",\n              "personalization",\n              "clipboard_auto_import"\n            ]\n          },\n          "version": {\n            "description": "The version of the text the user saw. A positive integer (legal.privacy.version and the\\nlike) for every type except clipboard_auto_import, which takes the string\\nconfig.clipboard.consent_version (BR-ID-12 细则, BR-ID-16). A form that does not pair\\nwith `type` → 20001 with data.fields=[version].\\n",\n            "oneOf": [\n              {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 1\n              },\n              {\n                "type": "string",\n                "minLength": 1,\n                "maxLength": 32\n              }\n            ]\n          },\n          "accepted": {\n            "type": "boolean",\n            "description": "true = agreed; false = withdrawn."\n          },\n          "channel": {\n            "type": "string",\n            "description": "consent_channel without the server-written login_merge, h5_landing and withdraw_flow.",\n            "enum": [\n              "first_launch",\n              "login_page",\n              "agent_sheet",\n              "realname_sheet",\n              "privacy_center"\n            ]\n          },\n          "client_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the user tapped (device clock)."\n          }\n        }\n      },\n      "OauthAttemptPurpose": {\n        "type": "string",\n        "description": "What a third-party authorization attempt is for (enum oauth_attempt_purpose).",\n        "enum": [\n          "login",\n          "step_up",\n          "payout_bind",\n          "reverify"\n        ]\n      },\n      "CreateOauthAttemptRequest": {\n        "type": "object",\n        "description": "`action` is required exactly for purpose=step_up. purpose=payout_bind is for WeChat only\\nand carries no `action`. purpose=reverify (re-verification of a recycled phone, BR-WDR-01\\n细则) carries no `action`. The oneOf branches declare the properties they constrain (strict\\nAjv2020, ADR-0001 §4.2 #15).\\n",\n        "additionalProperties": false,\n        "required": [\n          "provider",\n          "purpose"\n        ],\n        "properties": {\n          "provider": {\n            "$ref": "#/components/schemas/LoginProvider"\n          },\n          "purpose": {\n            "$ref": "#/components/schemas/OauthAttemptPurpose"\n          },\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "login"\n                ]\n              }\n            },\n            "required": [\n              "purpose"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "step_up"\n                ]\n              },\n              "action": {\n                "$ref": "#/components/schemas/StepUpAction"\n              }\n            },\n            "required": [\n              "purpose",\n              "action"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "payout_bind"\n                ]\n              },\n              "provider": {\n                "type": "string",\n                "enum": [\n                  "wechat"\n                ]\n              }\n            },\n            "required": [\n              "purpose",\n              "provider"\n            ],\n            "not": {\n              "type": "object",\n              "additionalProperties": true,\n              "properties": {\n                "action": {\n                  "$ref": "#/components/schemas/StepUpAction"\n                }\n              },\n              "required": [\n                "action"\n              ]\n            }\n          },\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "reverify"\n                ]\n              }\n            },\n            "required": [\n              "purpose"\n            ],\n            "not": {\n              "type": "object",\n              "additionalProperties": true,\n              "properties": {\n                "action": {\n                  "$ref": "#/components/schemas/StepUpAction"\n                }\n              },\n              "required": [\n                "action"\n              ]\n            }\n          }\n        ]\n      },\n      "OauthAttemptData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "nonce",\n          "expire_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nonce": {\n            "type": "string",\n            "description": "At least 128 random bits, passed to the provider SDK (BR-ID-04 细则).",\n            "minLength": 16,\n            "maxLength": 256\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "OauthAttemptResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OauthAttemptData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OauthCredential": {\n        "type": "string",\n        "description": "An authorization credential from the provider SDK; never stored or logged.",\n        "minLength": 1,\n        "maxLength": 4096\n      },\n      "LoginByWechatRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "LoginByAppleRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "identity_token",\n          "authorization_code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "identity_token": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "LoginByHuaweiRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "authorization_code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "StepUpBySmsRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "code": {\n            "type": "string",\n            "pattern": "^[0-9]{6}$"\n          },\n          "summary": {\n            "$ref": "#/components/schemas/StepUpSummary"\n          }\n        }\n      },\n      "StepUpByWechatRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "provider",\n          "attempt_id",\n          "code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "provider": {\n            "type": "string",\n            "enum": [\n              "wechat"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "summary": {\n            "$ref": "#/components/schemas/StepUpSummary"\n          }\n        }\n      },\n      "StepUpByAppleRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "provider",\n          "attempt_id",\n          "identity_token",\n          "authorization_code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "provider": {\n            "type": "string",\n            "enum": [\n              "apple"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "identity_token": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "summary": {\n            "$ref": "#/components/schemas/StepUpSummary"\n          }\n        }\n      },\n      "StepUpByHuaweiRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "provider",\n          "attempt_id",\n          "authorization_code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "provider": {\n            "type": "string",\n            "enum": [\n              "huawei"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "summary": {\n            "$ref": "#/components/schemas/StepUpSummary"\n          }\n        }\n      },\n      "StepUpSummary": {\n        "description": "The business summary bound into a withdraw or payout_account_change step-up token\\n(BR-ID-08 细则「绑定业务摘要」): a withdrawal (payout_account_id of GET\\n/v1/me/payout-account and amount_fen), or the new payout account to be saved. Which shape\\ngoes with which action is checked by the server (20001 data.fields=[summary]). No payee\\nname and no client-computed fingerprint.\\n",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/StepUpSummaryWithdraw"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpSummaryAlipay"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpSummaryBankCard"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpSummaryWechat"\n          }\n        ]\n      },\n      "StepUpSummaryWithdraw": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_account_id",\n          "amount_fen"\n        ],\n        "properties": {\n          "payout_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1\n          }\n        }\n      },\n      "StepUpSummaryAlipay": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_method",\n          "alipay_logon_id"\n        ],\n        "properties": {\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "alipay"\n            ]\n          },\n          "alipay_logon_id": {\n            "type": "string",\n            "description": "As it will be sent to PUT /v1/me/payout-account; normalised by the server.",\n            "minLength": 1,\n            "maxLength": 128\n          }\n        }\n      },\n      "StepUpSummaryBankCard": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_method",\n          "card_no"\n        ],\n        "properties": {\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "bank_card"\n            ]\n          },\n          "card_no": {\n            "type": "string",\n            "description": "As it will be sent to PUT /v1/me/payout-account; normalised by the server.",\n            "minLength": 1,\n            "maxLength": 32\n          }\n        }\n      },\n      "StepUpSummaryWechat": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "payout_method",\n          "attempt_id"\n        ],\n        "properties": {\n          "payout_method": {\n            "type": "string",\n            "enum": [\n              "wechat"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          }\n        }\n      },\n      "StepUpRequest": {\n        "type": "object",\n        "description": "Exactly one way of second verification: an SMS code, or a new authorization with one\\nprovider carrying that provider\'s login credential fields (BR-ID-08). Each branch is a\\nclosed object, so a body mixing two ways matches none.\\n",\n        "unevaluatedProperties": false,\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/StepUpBySmsRequest"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpByWechatRequest"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpByAppleRequest"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpByHuaweiRequest"\n          }\n        ]\n      },\n      "ReverifyMethod": {\n        "type": "string",\n        "description": "Re-verification method (enum reverify_method, BR-WDR-01 细则).",\n        "enum": [\n          "id_number",\n          "oauth",\n          "manual"\n        ]\n      },\n      "ReverifyStatusData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "required",\n          "method",\n          "providers",\n          "fail_limit",\n          "fail_remaining"\n        ],\n        "properties": {\n          "required": {\n            "type": "boolean",\n            "description": "false when the account has no flag or this device is already re-verified."\n          },\n          "method": {\n            "description": "The available method; null when not required.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ReverifyMethod"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "providers": {\n            "type": "array",\n            "description": "Trusted third-party identities usable when method=oauth; empty otherwise.",\n            "items": {\n              "$ref": "#/components/schemas/LoginProvider"\n            }\n          },\n          "fail_limit": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1\n          },\n          "fail_remaining": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "ReverifyStatusResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ReverifyStatusData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ReverifyByIdNumberRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "id_no"\n        ],\n        "properties": {\n          "id_no": {\n            "type": "string",\n            "description": "The resident ID number; its format is judged by the server (20001 data.fields=[id_no]).",\n            "maxLength": 32\n          }\n        }\n      },\n      "ReverifyByOauthWechat": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "provider",\n          "attempt_id",\n          "code"\n        ],\n        "properties": {\n          "provider": {\n            "type": "string",\n            "enum": [\n              "wechat"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          }\n        }\n      },\n      "ReverifyByOauthApple": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "provider",\n          "attempt_id",\n          "identity_token",\n          "authorization_code"\n        ],\n        "properties": {\n          "provider": {\n            "type": "string",\n            "enum": [\n              "apple"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "identity_tok