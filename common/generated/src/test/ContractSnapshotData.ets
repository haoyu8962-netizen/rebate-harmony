  "required": [\n              "rebate_basis"\n            ],\n            "properties": {\n              "rebate_basis": {\n                "type": "string",\n                "enum": [\n                  "normal",\n                  "price_compare_risk"\n                ]\n              }\n            }\n          },\n          "then": {\n            "type": "object",\n            "properties": {\n              "rebate_min_fen": {\n                "$ref": "#/$defs/fen"\n              },\n              "rebate_max_fen": {\n                "$ref": "#/$defs/fen"\n              }\n            }\n          }\n        },\n        {\n          "if": {\n            "type": "object",\n            "required": [\n              "rebate_basis"\n            ],\n            "properties": {\n              "rebate_basis": {\n                "type": "string",\n                "enum": [\n                  "amount_unknown",\n                  "login_required"\n                ]\n              }\n            }\n          },\n          "then": {\n            "type": "object",\n            "properties": {\n              "rebate_min_fen": {\n                "type": "null"\n              },\n              "rebate_max_fen": {\n                "type": "null"\n              }\n            }\n          }\n        },\n        {\n          "if": {\n            "type": "object",\n            "required": [\n              "benefit_tags"\n            ],\n            "properties": {\n              "benefit_tags": {\n                "type": "array",\n                "contains": {\n                  "type": "string",\n                  "enum": [\n                    "taolijin"\n                  ]\n                }\n              }\n            }\n          },\n          "then": {\n            "type": "object",\n            "properties": {\n              "tlj": {\n                "$ref": "#/$defs/product_tlj"\n              }\n            }\n          }\n        },\n        {\n          "if": {\n            "type": "object",\n            "required": [\n              "cta"\n            ],\n            "properties": {\n              "cta": {\n                "type": "object",\n                "required": [\n                  "text_key"\n                ],\n                "properties": {\n                  "text_key": {\n                    "type": "string",\n                    "pattern": "^claim_tlj"\n                  }\n                }\n              }\n            }\n          },\n          "then": {\n            "type": "object",\n            "properties": {\n              "tlj": {\n                "$ref": "#/$defs/product_tlj"\n              }\n            }\n          }\n        }\n      ]\n    },\n    "quote_material": {\n      "description": "Material parsed from text the user pasted. Untrusted, shown only on the material line (BR-AI-04, BR-PRICE-10).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "title_hint",\n        "spec",\n        "claimed_price_fen",\n        "claimed_unit_price_fen",\n        "conditions",\n        "benefits",\n        "tpwd"\n      ],\n      "properties": {\n        "title_hint": {\n          "type": [\n            "string",\n            "null"\n          ]\n        },\n        "spec": {\n          "type": [\n            "string",\n            "null"\n          ]\n        },\n        "claimed_price_fen": {\n          "description": "Price claimed by the material; untrusted, display only (BR-PRICE-10).",\n          "$ref": "#/$defs/nullable_fen"\n        },\n        "claimed_unit_price_fen": {\n          "description": "Unit price claimed by the material; untrusted, display only.",\n          "$ref": "#/$defs/nullable_fen"\n        },\n        "conditions": {\n          "description": "Conditions named by the material, e.g. 88vip, taojinbi.",\n          "type": "array",\n          "items": {\n            "type": "string",\n            "minLength": 1\n          }\n        },\n        "benefits": {\n          "type": "array",\n          "items": {\n            "type": "string",\n            "minLength": 1\n          }\n        },\n        "tpwd": {\n          "type": [\n            "string",\n            "null"\n          ]\n        }\n      }\n    },\n    "card_product_list": {\n      "description": "1–8 product cards (03 §7.4).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "result_set_id",\n        "items",\n        "layout"\n      ],\n      "properties": {\n        "result_set_id": {\n          "type": "string",\n          "minLength": 1\n        },\n        "items": {\n          "type": "array",\n          "minItems": 1,\n          "maxItems": 8,\n          "items": {\n            "$ref": "#/$defs/product_card"\n          }\n        },\n        "layout": {\n          "type": "string",\n          "enum": [\n            "list",\n            "grid"\n          ]\n        }\n      }\n    },\n    "card_rebate_quote": {\n      "description": "One product card plus the material line (null when the user sent no material) and tlj_kind.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "product",\n        "material",\n        "tlj_kind"\n      ],\n      "properties": {\n        "product": {\n          "$ref": "#/$defs/product_card"\n        },\n        "material": {\n          "anyOf": [\n            {\n              "$ref": "#/$defs/quote_material"\n            },\n            {\n              "type": "null"\n            }\n          ]\n        },\n        "tlj_kind": {\n          "description": "contracts/enums tlj_kind.",\n          "type": "string",\n          "enum": [\n            "ours",\n            "brand_open",\n            "third_party",\n            "unknown"\n          ]\n        }\n      }\n    },\n    "card_order_status": {\n      "description": "Order summary; fields trimmed as in the order list (BR-TEXT-02 细则「订单的检索范围与分享单的投影」), no order number. A shared order with is_other_product=true has a null title.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "order_id",\n        "platform",\n        "title",\n        "is_other_product",\n        "display_status",\n        "reason",\n        "est_rebate_fen",\n        "expected_credit_period"\n      ],\n      "properties": {\n        "order_id": {\n          "$ref": "#/$defs/entity_id"\n        },\n        "platform": {\n          "$ref": "#/$defs/platform"\n        },\n        "title": {\n          "type": [\n            "string",\n            "null"\n          ]\n        },\n        "is_other_product": {\n          "type": "boolean"\n        },\n        "display_status": {\n          "description": "contracts/enums display_status (BR-FUND-17).",\n          "type": "string",\n          "enum": [\n            "PAID",\n            "DEPOSIT_PAID",\n            "WAITING",\n            "CREDITING",\n            "REVIEWING",\n            "RIGHTS_PENDING",\n            "CREDITED",\n            "CREDITED_PART_CLAWED",\n            "NO_REBATE",\n            "INVALID",\n            "CLAWED_BACK"\n          ]\n        },\n        "reason": {\n          "description": "contracts/enums order_reason, or null.",\n          "anyOf": [\n            {\n              "type": "string",\n              "enum": [\n                "REFUND",\n                "RIGHTS",\n                "PUNISH",\n                "PRESALE_UNPAID",\n                "COMMISSION_ZERO",\n                "OTHER",\n                "BLACKLIST",\n                "PART_REFUND",\n                "PRICE_COMPARE",\n                "PRICE_PROTECT",\n                "SETTLE_DIFF",\n                "NOT_TRACKED",\n                "EXPIRED_CLICK",\n                "OTHER_TLJ",\n                "RELATION_INVALID",\n                "CANCELLED"\n              ]\n            },\n            {\n              "type": "null"\n            }\n          ]\n        },\n        "est_rebate_fen": {\n          "$ref": "#/$defs/nullable_fen"\n        },\n        "expected_credit_period": {\n          "description": "YYYY-MM (AI-02); null when there is no expected month.",\n          "type": [\n            "string",\n            "null"\n          ],\n          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n        }\n      },\n      "if": {\n        "type": "object",\n        "required": [\n          "is_other_product"\n        ],\n        "properties": {\n          "is_other_product": {\n            "type": "boolean",\n            "enum": [\n              true\n            ]\n          }\n        }\n      },\n      "then": {\n        "type": "object",\n        "properties": {\n          "title": {\n            "type": "null"\n          }\n        }\n      }\n    },\n    "card_claim_draft": {\n      "description": "Claim draft; submitted only when the user taps submit_action.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "platform",\n        "order_no",\n        "click_times",\n        "evidence_summary",\n        "submit_action"\n      ],\n      "properties": {\n        "platform": {\n          "$ref": "#/$defs/platform"\n        },\n        "order_no": {\n          "type": "string",\n          "minLength": 1\n        },\n        "click_times": {\n          "type": "array",\n          "items": {\n            "$ref": "#/$defs/timestamp"\n          }\n        },\n        "evidence_summary": {\n          "description": "Always null in MVP.",\n          "type": "null"\n        },\n        "submit_action": {\n          "type": "object",\n          "additionalProperties": false,\n          "required": [\n            "text_key",\n            "action"\n          ],\n          "properties": {\n            "text_key": {\n              "$ref": "#/$defs/text_key"\n            },\n            "action": {\n              "type": "string",\n              "enum": [\n                "submit_claim"\n              ]\n            }\n          }\n        }\n      }\n    },\n    "card_handoff": {\n      "description": "Customer service card (opens WeCom customer service).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "entry",\n        "summary"\n      ],\n      "properties": {\n        "entry": {\n          "type": "string",\n          "minLength": 1\n        },\n        "summary": {\n          "type": "string",\n          "minLength": 1\n        }\n      }\n    },\n    "card_auth_required": {\n      "description": "Authorization needed; the client resumes after it. resume_link_id is null when there is no link to resume. platform is null when the prompt is not about a union platform (a guest or a user without a phone asking about orders or earnings, BR-AI-01); union_auth always names the platform.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "platform",\n        "reason",\n        "resume_link_id"\n      ],\n      "properties": {\n        "platform": {\n          "anyOf": [\n            {\n              "$ref": "#/$defs/platform"\n            },\n            {\n              "type": "null"\n            }\n          ]\n        },\n        "reason": {\n          "type": "string",\n          "enum": [\n            "union_auth",\n            "login",\n            "bind_phone"\n          ]\n        },\n        "resume_link_id": {\n          "type": [\n            "string",\n            "null"\n          ],\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "if": {\n        "type": "object",\n        "required": [\n          "reason"\n        ],\n        "properties": {\n          "reason": {\n            "type": "string",\n            "enum": [\n              "union_auth"\n            ]\n          }\n        }\n      },\n      "then": {\n        "type": "object",\n        "properties": {\n          "platform": {\n            "$ref": "#/$defs/platform"\n          }\n        }\n      }\n    },\n    "card_notice": {\n      "description": "Degrade, no-result or maintenance notice; actions are quick rewrite chips (03 §7.4).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "level",\n        "text_key",\n        "actions"\n      ],\n      "properties": {\n        "level": {\n          "type": "string",\n          "enum": [\n            "info",\n            "warn"\n          ]\n        },\n        "text_key": {\n          "$ref": "#/$defs/text_key"\n        },\n        "actions": {\n          "type": "array",\n          "items": {\n            "$ref": "#/$defs/quick_reply"\n          }\n        }\n      }\n    },\n    "card_rule_ref": {\n      "description": "Published rule excerpt hit by search_rules (BR-AI-07); action opens the full article.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "chunk_id",\n        "title",\n        "excerpt",\n        "published_version",\n        "action"\n      ],\n      "properties": {\n        "chunk_id": {\n          "$ref": "#/$defs/entity_id"\n        },\n        "title": {\n          "type": "string",\n          "minLength": 1\n        },\n        "excerpt": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 200\n        },\n        "published_version": {\n          "type": "string",\n          "minLength": 1\n        },\n        "action": {\n          "$ref": "#/$defs/route_target"\n        }\n      }\n    },\n    "card_page_guide": {\n      "description": "Page guide card (D31; BR-AI-01 细则「页面引导」). route is a route name only: never a URL, params or any number. The server sends only routes in agent.page_guide.routes that are agent_guide in routes.json; the schema does not pin that list, and a client whose bundled routes.json does not mark the route agent_guide treats the card as unknown (03 §7.4). text_key is agent.guide.<route> (BR-TEXT-22) and fallback_text is the same text; the button text is agent.guide.open and the client opens the route (entry in_app, no params) only after a user tap.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "route",\n        "text_key"\n      ],\n      "properties": {\n        "route": {\n          "$ref": "#/$defs/route_name"\n        },\n        "text_key": {\n          "description": "agent.guide.<route> (BR-TEXT-22).",\n          "type": "string",\n          "pattern": "^agent\\\\.guide\\\\.[A-Z][A-Za-z0-9]*$"\n        }\n      }\n    },\n    "earnings_action_wallet": {\n      "description": "First earnings_summary button: open Wallet, no params.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "route",\n        "text_key"\n      ],\n      "properties": {\n        "route": {\n          "type": "string",\n          "enum": [\n            "Wallet"\n          ]\n        },\n        "text_key": {\n          "type": "string",\n          "enum": [\n            "agent.earnings.open_wallet"\n          ]\n        }\n      }\n    },\n    "earnings_action_records": {\n      "description": "Second earnings_summary button: open WithdrawRecords, no params.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "route",\n        "text_key"\n      ],\n      "properties": {\n        "route": {\n          "type": "string",\n          "enum": [\n            "WithdrawRecords"\n          ]\n        },\n        "text_key": {\n          "type": "string",\n          "enum": [\n            "agent.earnings.open_records"\n          ]\n        }\n      }\n    },\n    "earnings_actions": {\n      "description": "Exactly the two buttons in this order (04 §8.3); both routes are agent_guide in routes.json and open only after a user tap.",\n      "type": "array",\n      "minItems": 2,\n      "maxItems": 2,\n      "prefixItems": [\n        {\n          "$ref": "#/$defs/earnings_action_wallet"\n        },\n        {\n          "$ref": "#/$defs/earnings_action_records"\n        }\n      ],\n      "items": false\n    },\n    "earnings_latest_withdrawal": {\n      "description": "The user\'s latest withdrawal: title_key is the dictionary key of its main status title, from the same display function as the withdrawal records; amount_fen is the applied amount, labelled agent.earnings.applied_amount. No net amount, tax, fee, reason, timing or confirm deadline (04 §8.3).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "title_key",\n        "amount_fen"\n      ],\n      "properties": {\n        "title_key": {\n          "$ref": "#/$defs/text_key"\n        },\n        "amount_fen": {\n          "$ref": "#/$defs/fen"\n        }\n      }\n    },\n    "earnings_summary_live": {\n      "description": "Earnings card as sent once over SSE. The first four amounts and flags have the same names and meaning as GET /v1/wallet/summary (BR-FUND-18).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "as_of",\n        "withdrawable_fen",\n        "estimated_total_fen",\n        "next_credit_period",\n        "credit_overdue",\n        "latest_withdrawal",\n        "actions"\n      ],\n      "properties": {\n        "as_of": {\n          "description": "Time the numbers were read.",\n          "$ref": "#/$defs/timestamp"\n        },\n        "withdrawable_fen": {\n          "$ref": "#/$defs/fen"\n        },\n        "estimated_total_fen": {\n          "$ref": "#/$defs/fen"\n        },\n        "next_credit_period": {\n          "description": "YYYY-MM, or null when there is no expected month.",\n          "type": [\n            "string",\n            "null"\n          ],\n          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n        },\n        "credit_overdue": {\n          "type": "boolean"\n        },\n        "latest_withdrawal": {\n          "anyOf": [\n            {\n              "$ref": "#/$defs/earnings_latest_withdrawal"\n            },\n            {\n              "type": "null"\n            }\n          ]\n        },\n        "actions": {\n          "$ref": "#/$defs/earnings_actions"\n        }\n      }\n    },\n    "earnings_summary_history": {\n      "description": "The same card reloaded from history (GET messages, 04 §6.5): the server keeps no amounts, so only as_of and actions come back.",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "as_of",\n        "actions"\n      ],\n      "properties": {\n        "as_of": {\n          "$ref": "#/$defs/timestamp"\n        },\n        "actions": {\n          "$ref": "#/$defs/earnings_actions"\n        }\n      }\n    },\n    "card_earnings_summary": {\n      "description": "Read-only earnings card (D32; BR-AI-01 细则「收益查询」, BR-AI-04): the live shape over SSE or the history shape. fallback_text is agent.earnings.fallback, with no numbers and no mention of the card or its buttons.",\n      "type": "object",\n      "oneOf": [\n        {\n          "$ref": "#/$defs/earnings_summary_live"\n        },\n        {\n          "$ref": "#/$defs/earnings_summary_history"\n        }\n      ]\n    },\n    "page_guide_intent": {\n      "description": "Model output in a turn without tool calls that asks for a page guide (04 §8.5, D31); not a frame. The server accepts guide_route only when it is in agent.page_guide.routes and otherwise records agent_runs.page_guide_reject_reason (contracts/enums page_guide_reject_reason).",\n      "type": "object",\n      "additionalProperties": false,\n      "required": [\n        "agent_intent",\n        "guide_route"\n      ],\n      "properties": {\n        "agent_intent": {\n          "type": "string",\n          "enum": [\n            "page_guide"\n          ]\n        },\n        "guide_route": {\n          "type": "string"\n        }\n      }\n    },\n    "get_my_earnings_args": {\n      "description": "Arguments of the read-only tool get_my_earnings (04 §8.5, D32): an empty object; any field is invalid_args (BR-AI-03). Identity is injected by the server.",\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {},\n      "required": []\n    },\n    "get_my_earnings_result": {\n      "description": "What get_my_earnings returns to the model (04 §8.5, D32): a card reference, or unavailable when the numbers could not be read (no card then). Never amounts, months or withdrawal status.",\n      "type": "object",\n      "oneOf": [\n        {\n          "type": "object",\n          "additionalProperties": false,\n          "required": [\n            "card_id",\n            "status"\n          ],\n          "properties": {\n            "card_id": {\n              "$ref": "#/$defs/card_id"\n            },\n            "status": {\n              "type": "string",\n              "enum": [\n                "shown"\n              ]\n            }\n          }\n        },\n        {\n          "type": "object",\n          "additionalProperties": false,\n          "required": [\n            "status"\n          ],\n          "properties": {\n            "status": {\n              "type": "string",\n              "enum": [\n                "unavailable"\n              ]\n            }\n          }\n        }\n      ]\n    }\n  }\n}\n');
  map.set('contracts/apps.json', '{\n  "$comment": "Three kinds of entries (规划/04 §9「apps.json 的条目形状」, 规划/03 §4.5, CSB-11). apps: external target apps, the only targets of ext.openApp and of installed detection (BR-ATTR-27 ①); trade_only (required) is true for shopping platforms, and ext.openApp answers 90403 for them so H5 uses trade.convertAndOpen (BR-ATTR-29 细则). sdk_queries: query entries an SDK needs ({source_sdk, ios_scheme, android_package, harmony_scheme}, null where a platform has none). inbound: inbound callbacks, kind custom_scheme {scheme} or verified_link {host, path_prefix, verified: true}, both with purpose, source_sdk (null for our own) and platforms. iOS LSApplicationQueriesSchemes (apps + sdk_queries, ≤ 20), Android <queries>, Harmony querySchemes and every inbound declaration are generated from this file by CT-05; nothing is written by hand. Nothing here is verified yet: app values are candidates from 规划/09 CAP-TB-11, CAP-JD-11, CAP-PDD-11 and CAP-X-04; sdk_queries and inbound stay empty until values are given (our own scheme and domains: 规划/06; the WeChat verified link waits for 06 Q-C12; the Baichuan callback uses our own scheme, CAP-TB-11). Clients never build jump URLs from these values: the server sends primary / fallbacks.",\n  "version": 1,\n  "apps": {\n    "taobao": {\n      "name": "淘宝",\n      "platform": "taobao",\n      "status": "candidate",\n      "trade_only": true,\n      "source": "规划/09 CAP-TB-11（taobao:// / tbopen:// scheme 为候选，以官方为准）；鸿蒙走百川 HarmonyOS SDK，见 CAP-X-04",\n      "ios": {\n        "query_schemes": [\n          "taobao",\n          "tbopen"\n        ]\n      },\n      "android": {\n        "packages": []\n      },\n      "harmony": {\n        "query_schemes": []\n      }\n    },\n    "jd": {\n      "name": "京东",\n      "platform": "jd",\n      "status": "candidate",\n      "trade_only": true,\n      "source": "规划/09 CAP-JD-11（openApp.jdMobile scheme，无官方公开文档）",\n      "ios": {\n        "query_schemes": [\n          "openApp.jdMobile"\n        ]\n      },\n      "android": {\n        "packages": []\n      },\n      "harmony": {\n        "query_schemes": []\n      }\n    },\n    "pdd": {\n      "name": "拼多多",\n      "platform": "pdd",\n      "status": "candidate",\n      "trade_only": true,\n      "source": "规划/09 CAP-PDD-11（schema_url 由转链返回，三端须静态声明要检测的 scheme，取值待实测）",\n      "ios": {\n        "query_schemes": []\n      },\n      "android": {\n        "packages": []\n      },\n      "harmony": {\n        "query_schemes": []\n      }\n    }\n  },\n  "sdk_queries": [],\n  "inbound": []\n}\n');
  map.set('contracts/bridge.schema.json', '{\n  "$comment": "JSBridge contract (CT-03). Methods: 规划/04 §9; protocol, levels, error codes: 规划/03 §5.3. Generated types: packages/contracts-ts/src/bridge.gen.ts. Clients call has() before any method (拍板第二批 TECH-28). Besides level and gesture, every call passes the force-update guard of 03 §4.4 (04 §9 header): while the update check is unknown, read-only methods run as usual, nav.open (and trade.openProduct) only opens the read-only pages of the BR-ID-10 细则「路由入口矩阵」, and every other method ends with 90500; below the minimum version the 03 §4.4 state table applies. A method added later belongs to the third class (90500) unless 03 §4.4 lists it. gesture_required: a non-L2 method that still needs a user click within the last 1 second (same check as L2; missing → 90404). whitelist_90403: the method\'s own whitelist rejection, answered with 90403 at the same place as the origin, frame and level checks (03 §5.3).",\n  "version": 1,\n  "envelope": {\n    "request": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {\n        "v": {\n          "type": "integer",\n          "enum": [\n            1\n          ]\n        },\n        "id": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        },\n        "method": {\n          "type": "string",\n          "minLength": 1\n        },\n        "params": {\n          "type": "object",\n          "additionalProperties": true\n        }\n      },\n      "required": [\n        "v",\n        "id",\n        "method"\n      ]\n    },\n    "response": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {\n        "id": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        },\n        "code": {\n          "type": "integer",\n          "description": "0 = success; bridge errors use 90001–90500"\n        },\n        "msg": {\n          "type": "string"\n        },\n        "data": {\n          "type": "object",\n          "additionalProperties": true\n        }\n      },\n      "required": [\n        "id",\n        "code",\n        "msg"\n      ]\n    },\n    "event": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {\n        "event": {\n          "type": "string",\n          "minLength": 1\n        },\n        "data": {\n          "type": "object",\n          "additionalProperties": true,\n          "description": "Event data never carries clipboard content, tokens, signing material or device identifiers (04 §9 事件; BR-ID-16, BR-ID-32 细则)"\n        }\n      },\n      "required": [\n        "event"\n      ]\n    }\n  },\n  "levels": {\n    "L0": "Whitelisted origin, main frame",\n    "L1": "L0 + logged in",\n    "L2": "L1 + user gesture within the last 1 second"\n  },\n  "errors": {\n    "90001": "Method does not exist or is not supported",\n    "90002": "Invalid params",\n    "90003": "Timeout",\n    "90004": "Cancelled by the user",\n    "90401": "Not logged in",\n    "90403": "Origin or frame not allowed, method + path outside signed_paths, or the method\'s own whitelist rejection (methods with whitelist_90403: ext.openApp trade_only targets, ext.openBrowser addresses matching link_patterns, share.open links outside the allowed range; 03 §5.3)",\n    "90404": "User gesture missing",\n    "90500": "Native internal error; also for calls not executed under the force-update guard (03 §4.4)"\n  },\n  "signed_paths": [\n    {\n      "method": "POST",\n      "path": "/v1/orders/claims"\n    }\n  ],\n  "not_exposed": [\n    "withdrawal",\n    "payout account change",\n    "labor agreement signing",\n    "real-name verification",\n    "account deletion",\n    "phone number change"\n  ],\n  "events": {\n    "app.resume": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {},\n      "required": []\n    },\n    "app.pause": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {},\n      "required": []\n    },\n    "auth.changed": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {\n        "logged_in": {\n          "type": "boolean"\n        }\n      },\n      "required": [\n        "logged_in"\n      ]\n    },\n    "page.visible": {\n      "type": "object",\n      "additionalProperties": false,\n      "properties": {\n        "visible": {\n          "type": "boolean"\n        }\n      },\n      "required": [\n        "visible"\n      ]\n    }\n  },\n  "methods": {\n    "app.getEnv": {\n      "level": "L0",\n      "model": "sync",\n      "timeout_ms": null,\n      "phase": "M-内测",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "note": "No flag such as \'in review\' or \'hide rebates\' is or will be returned; H5 never hides rebates, withdrawal or similar content by an equality check on app_version (04 §9; 02 §10)",\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {},\n        "required": []\n      },\n      "result": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {\n          "platform": {\n            "type": "string",\n            "enum": [\n              "ios",\n              "android",\n              "harmony"\n            ]\n          },\n          "app_version": {\n            "type": "string",\n            "description": "SemVer, same number on all apps (拍板第二批 TECH-07)"\n          },\n          "build": {\n            "type": "string"\n          },\n          "os_version": {\n            "type": "string"\n          },\n          "bridge_version": {\n            "type": "integer",\n            "minimum": 1\n          },\n          "safe_area": {\n            "type": "object",\n            "additionalProperties": false,\n            "description": "Insets in points",\n            "properties": {\n              "top": {\n                "type": "integer",\n                "minimum": 0\n              },\n              "bottom": {\n                "type": "integer",\n                "minimum": 0\n              },\n              "left": {\n                "type": "integer",\n                "minimum": 0\n              },\n              "right": {\n                "type": "integer",\n                "minimum": 0\n              }\n            },\n            "required": [\n              "top",\n              "bottom",\n              "left",\n              "right"\n            ]\n          },\n          "channel": {\n            "type": "string",\n            "enum": [\n              "appstore",\n              "official",\n              "huawei",\n              "agc"\n            ],\n            "description": "contracts/enums install_channel"\n          }\n        },\n        "required": [\n          "platform",\n          "app_version",\n          "build",\n          "os_version",\n          "bridge_version",\n          "safe_area",\n          "channel"\n        ]\n      }\n    },\n    "app.getConfig": {\n      "level": "L0",\n      "model": "sync",\n      "timeout_ms": null,\n      "phase": "M-内测",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {\n          "keys": {\n            "type": "array",\n            "items": {\n              "type": "string",\n              "minLength": 1\n            },\n            "minItems": 1,\n            "maxItems": 50\n          }\n        },\n        "required": [\n          "keys"\n        ]\n      },\n      "result": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {\n          "values": {\n            "type": "object",\n            "description": "Subset of /v1/config limited to the