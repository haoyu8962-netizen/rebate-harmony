"schema": {\n                "$ref": "#/components/schemas/BindUnionRequest"\n              },\n              "examples": {\n                "webCode": {\n                  "summary": "Web authorization code",\n                  "value": {\n                    "state": "st_01",\n                    "auth_method": "web_code",\n                    "code": "example-authorization-code"\n                  }\n                },\n                "sdkToken": {\n                  "summary": "Token from the Taobao SDK",\n                  "value": {\n                    "state": "st_01",\n                    "auth_method": "sdk_token",\n                    "access_token": "example-access-token",\n                    "expires_in": 86400\n                  }\n                }\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The binding state after binding.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/UnionBindingResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "platform": "taobao",\n                    "status": "active"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/orders": {\n      "get": {\n        "operationId": "listOrders",\n        "tags": [\n          "order"\n        ],\n        "summary": "My orders (self-purchase or shared)",\n        "description": "Orders of the current account in the visible range, newest paid first. scope=self gives the\\nfull order_no (copyable); scope=share gives only masked_order_no, and an item whose bought\\nproduct is not the shared one (is_other_product=true) has title and image_url null — both\\ntrimmed by the server. Shared orders exclude referral-commission orders. status_group\\ngroups display_status on the server; q matches a self-purchase order by its exact parent or\\nchild order number, otherwise titles; shared orders are matched by the visible title only.\\nGrouping, search and projection rules are only in BR-TEXT-02 细则「订单列表的状态分组与查找」\\n「订单的检索范围与分享单的投影」. earliest_visible_date is the first day in range\\n(null when unlimited; BR-ID-30 细则「订单类记录」). For a pre-sale order in DEPOSIT_PAID,\\npay_amount_fen is the deposit paid, null when the platform does not report it\\n(BR-TEXT-02 细则「预售单的付款金额」, wording pending CAP-*-07).\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "name": "scope",\n            "in": "query",\n            "required": true,\n            "description": "self = my own purchases; share = orders bought through my shares.",\n            "schema": {\n              "$ref": "#/components/schemas/OrderScope"\n            }\n          },\n          {\n            "name": "status_group",\n            "in": "query",\n            "required": false,\n            "description": "Status group (enum order_status_group); absent = all.",\n            "schema": {\n              "$ref": "#/components/schemas/OrderStatusGroup"\n            }\n          },\n          {\n            "name": "display_status",\n            "in": "query",\n            "required": false,\n            "schema": {\n              "$ref": "#/components/schemas/OrderDisplayStatus"\n            }\n          },\n          {\n            "name": "platform",\n            "in": "query",\n            "required": false,\n            "schema": {\n              "$ref": "#/components/schemas/PlatformCode"\n            }\n          },\n          {\n            "name": "q",\n            "in": "query",\n            "required": false,\n            "description": "Order number or title words, at most 40 characters (BR-TEXT-02 细则).",\n            "schema": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 40\n            }\n          },\n          {\n            "name": "paid_month",\n            "in": "query",\n            "required": false,\n            "description": "Month of payment, YYYY-MM in +08:00; only months in the visible range.",\n            "schema": {\n              "type": "string",\n              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n            }\n          },\n          {\n            "$ref": "#/components/parameters/Cursor"\n          },\n          {\n            "$ref": "#/components/parameters/Limit"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "A page of orders.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/OrderListResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "items": [\n                      {\n                        "order_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a90",\n                        "platform": "taobao",\n                        "title": "降噪蓝牙耳机",\n                        "image_url": "https://img.example.test/p/1.jpg",\n                        "pay_amount_fen": 2990,\n                        "quantity": 1,\n                        "order_no": "3712345678901234567",\n                        "display_status": "WAITING",\n                        "reason": null,\n                        "est_rebate_fen": 269,\n                        "paid_at": "2026-10-02T09:31:00+08:00",\n                        "is_other_product": false\n                      }\n                    ],\n                    "next_cursor": null,\n                    "earliest_visible_date": null\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/orders/claims": {\n      "post": {\n        "operationId": "createOrderClaim",\n        "tags": [\n          "order"\n        ],\n        "summary": "Submit an order claim",\n        "description": "Claims an order that was not attributed to the current account (BR-ATTR-17). The H5 form\\ncalls it through the bridge `net.signedRequest`, which signs it (bridge signed_paths). The\\ncheck order and every error code, including 30202 and 30203 `data.reason`, are only in\\nBR-ATTR-17 and BR-ATTR-19: 30203 without data is the daily limit of created claims,\\n30203 with data.reason=RISK_BLOCKED is the risk block. Orders are matched only in the app of\\nthe token. A shared order is treated as not existing: it never enters the claim, and the\\nresponse is the same 30201 (same HTTP status, msg and no data) as an unknown order number.\\nWhen no child order passes, the error of the first child order by sub_order_id ascending is\\nreturned. For pdd the hyphens are removed from both the input and the stored order numbers\\nbefore comparing. The 200 response carries only the claim that was created, whose items are\\nthe child orders that passed; acceptance and the evidence computation (BR-ATTR-18) share one\\ntransaction, so status is auto_matched or manual_review. Version gate: applied.\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          20001,\n          30201,\n          30202,\n          30203,\n          30204,\n          30205,\n          30206,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/CreateOrderClaimRequest"\n              },\n              "example": {\n                "platform": "pdd",\n                "order_no": "231006-1234567890",\n                "paid_date": "2026-10-06"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The claim that was created.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/OrderClaimResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "claim_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5aa0",\n                    "platform": "pdd",\n                    "order_no": "231006-1234567890",\n                    "paid_date": "2026-10-06",\n                    "status": "manual_review",\n                    "created_at": "2026-10-07T10:15:00+08:00",\n                    "items": [\n                      {\n                        "sub_order_id": "231006-1234567890",\n                        "decision": null,\n                        "reject_reason": null\n                      }\n                    ]\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      },\n      "get": {\n        "operationId": "listOrderClaims",\n        "tags": [\n          "order"\n        ],\n        "summary": "My order claims",\n        "description": "The claims of the current account only (app_id and user_id of the token), newest created\\nfirst, each with its child orders, their decision (null while pending) and reject reason\\n(BR-ATTR-17, BR-ATTR-18). Shared orders never appear: they were removed when the claim was\\naccepted.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Cursor"\n          },\n          {\n            "$ref": "#/components/parameters/Limit"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "A page of claims.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/OrderClaimListResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "items": [\n                      {\n                        "claim_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5aa0",\n                        "platform": "pdd",\n                        "order_no": "231006-1234567890",\n                        "paid_date": "2026-10-06",\n                        "status": "rejected",\n                        "created_at": "2026-10-07T10:15:00+08:00",\n                        "items": [\n                          {\n                            "sub_order_id": "231006-1234567890",\n                            "decision": "rejected",\n                            "reject_reason": "NO_EVIDENCE"\n                          }\n                        ]\n                      }\n                    ],\n                    "next_cursor": null\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/orders/pending-tracks": {\n      "get": {\n        "operationId": "listPendingTracks",\n        "tags": [\n          "order"\n        ],\n        "summary": "Pending-track cards",\n        "description": "One card per platform at most, chosen per open attempt (link_open_attempts): attempts with\\na jump report first, the latest open wins; jumped_at is that attempt\'s open time; whether a\\