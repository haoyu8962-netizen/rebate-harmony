ity.yaml risk_state.",\n            "enum": [\n              "normal",\n              "frozen",\n              "appealing",\n              "banned"\n            ]\n          },\n          "reason_category": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "User-visible reason category (BR-ID-31); null when state=normal."\n          },\n          "frozen_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "Me": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "nickname",\n          "avatar_url",\n          "invite_code",\n          "inviter_bound",\n          "invite_backfill",\n          "identity_level",\n          "phone_bound",\n          "balance",\n          "union_bindings",\n          "realname_status",\n          "need_reconsent",\n          "risk"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nickname": {\n            "type": "string"\n          },\n          "avatar_url": {\n            "type": "string",\n            "format": "uri"\n          },\n          "invite_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Null when the user cannot invite."\n          },\n          "inviter_bound": {\n            "type": "boolean",\n            "description": "Only whether an inviter is bound, never who."\n          },\n          "invite_backfill": {\n            "$ref": "#/components/schemas/InviteBackfill"\n          },\n          "identity_level": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml identity_level (BR-ID-01).",\n            "enum": [\n              "basic",\n              "guest",\n        