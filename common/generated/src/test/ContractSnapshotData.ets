nPlatformIconVersion"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminPlatformIconVersionPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPlatformIconVersionPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPlatformIconUploadRequest": {\n        "type": "object",\n        "description": "multipart/form-data body of a platform mark upload; one part `file`.",\n        "additionalProperties": false,\n        "required": [\n          "file"\n        ],\n        "properties": {\n          "file": {\n            "type": "string",\n            "contentMediaType": "application/octet-stream",\n            "description": "The SVG or PNG file as uploaded (BR-TEXT-24 细则「上传与发布」)."\n          }\n        }\n      },\n      "AdminPlatformIconUpload": {\n        "type": "object",\n        "description": "The cleaned file of an upload, not yet a version. Saved with POST\\n/admin/v1/platform-icons/{key}/versions until `expires_at`.\\n",\n        "additionalProperties": false,\n        "required": [\n          "upload_id",\n          "url",\n          "sha256",\n          "format",\n          "bytes",\n          "sanitized",\n          "expires_at"\n        ],\n        "properties": {\n          "upload_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "url": {\n            "$ref": "#/components/schemas/AdminPlatformIconUrl"\n          },\n          "sha256": {\n            "$ref": "#/components/schemas/AdminPlatformIconSha256"\n          },\n          "format": {\n            "$ref": "#/components/schemas/AdminPlatformIconFormat"\n          },\n          "bytes": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Size of the cleaned file."\n          },\n          "sanitized": {\n            "type": "boolean",\n            "description": "true = the cleaned file differs from the original: the console shows 「已清除不安全内容」\\nand saving needs sanitized_confirmed=true.\\n"\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPlatformIconUploadResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPlatformIconUpload"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPlatformIconVersionCreateRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "upload_id"\n        ],\n        "properties": {\n          "upload_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "sanitized_confirmed": {\n            "type": "boolean",\n            "description": "The operator confirmed the cleaned preview; absent means false. Must be true when the\\nupload has sanitized=true.\\n"\n          },\n          "source_url": {\n            "$ref": "#/components/schemas/AdminPlatformIconSourceUrl"\n          },\n          "downloaded_on": {\n            "type": "string",\n            "format": "date"\n          }\n        }\n      },\n      "AdminPlatformIconSourceRequest": {\n        "type": "object",\n        "description": "The version\'s revision as shown plus at least one of the two registrations.",\n        "additionalProperties": false,\n        "required": [\n          "expected_revision"\n        ],\n        "minProperties": 2,\n        "properties": {\n          "expected_revision": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The version\'s `revision` as the console showed it; a mismatch is 20902."\n          },\n          "source_url": {\n            "$ref": "#/components/schemas/AdminPlatformIconSourceUrl"\n          },\n          "downloaded_on": {\n            "type": "string",\n            "format": "date"\n          }\n        }\n      },\n      "AdminPlatformIconPublishRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "expected_revision"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Version to publish; older than the current one = rollback."\n          },\n          "expected_revision": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The mark\'s `revision` as the console showed it; a mismatch is 20902."\n          }\n        }\n      },\n      "AdminPlatformIconRestoreRequest": {\n        "type": "object",\n       