#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/links/convert": {\n      "post": {\n        "operationId": "convertLink",\n        "tags": [\n          "trade"\n        ],\n        "summary": "Register and convert in one call (entries without a link_id)",\n        "description": "Only for entries that have no link_id, such as the H5 bridge method\\n`trade.convertAndOpen` (scene=h5): registers the link and then\\nre-checks and converts exactly like open, returning `link_id` plus the open result\\n(拍板第二批 TRADE-03). Pass `product_key` with the tapped card\'s `item_ref` (a missing\\nitem_ref is not an error, BR-PROD-11), or `url`. A url whose product key cannot be\\nderived is 30131 and nothing is registered (BR-PROD-03). A missing or invalid `scene`\\nis 20001 (BR-ATTR-08). Writes a link_log `convert` row (BR-ATTR-14).\\nA request stopped by 30101, 30102 or 30111 and sent again after the user authorized is a\\nnew request with a new Idempotency-Key; the original key is only for retrying the same\\nrequest (BR-ID-10 细则). 30101 / 30102 carry auth_url, state and auth_methods; 30111\\ncarries auth_jump.\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          30101,\n          30102,\n          30103,\n          30111,\n          30121,\n          30131,\n          30141,\n          30143,\n          30151,\n          30153,\n          50301,\n          50303,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/ConvertLinkRequest"\n              },\n              "example": {\n                "platform": "jd",\n                "product_key": "jd:i_100012043978",\n                "item_ref": "v1.Zm9vYmFyLmJhei5xdXg",\n                "scene": "h5",\n                "spm": "h5_activity.banner.1",\n                "installed": "unknown"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The registered link and its jump plan.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ConvertLinkResponse"\n                },\n                "examples": {\n                  "ok": {\n                    "$ref": "#/components/examples/ConvertLinkOk"\n                  }\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          