onents/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/products/{product_key}/feedback": {\n      "post": {\n        "operationId": "submitProductFeedback",\n        "tags": [\n          "trade"\n        ],\n        "summary": "Report a wrong price, rebate or product info on the detail page",\n        "description": "Product feedback from the detail page (01 F-PROD-15, 04 §6.3). Guests who accepted the\\nprivacy policy and logged-in users may submit; the record is counted by device and also\\nkeeps user_id when logged in (BR-ID-02 细则「商品反馈与进店」). Basic mode shows no entry and\\nsends no request (BR-ID-11). The body carries only what BR-ID-30 细则「商品反馈记录」 lists:\\nno contact fields, and any undefined field is 20001. link_id is the detail card\'s link,\\nfrom which the server reads the quote snapshot; a link_id that does not exist or does not\\nbelong to the app is 30144. A device submitting more than feedback.daily_limit_per_device\\n(default 20) in one natural day (+08:00) gets 42901 and nothing is written. With\\nfeedback.enabled off (features.flags.product_feedback=false) the client shows no entry and\\nthe server answers 30145. Version gate: applied.\\n",\n        "x-auth": "optional",\n        "x-signed": true,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-implementation": "planned",\n        "x-error-codes": [\n          30145,\n          20001,\n          30144,\n          42901,\n          10405\n        ],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          },\n          {\n            "$ref": "#/components/parameters/ProductKey"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/ProductFeedbackRequest"\n              },\n              "example": {\n                "platform": "jd",\n                "link_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a70",\n                "shown_final_price_fen": 12900,\n                "shown_rebate_fen": 350,\n                "quoted_at": "2026-11-06T10:15:00+08:00",\n                "reason": "price",\n                "note": null\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The feedback is recorded.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ProductFeedbackResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "feedback_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5b10"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\