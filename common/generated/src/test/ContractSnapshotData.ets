s/AdminPermissionKey"\n              }\n            ],\n            "description": "The config.* point that guards changing the item, and so its step-up tier."\n          },\n          "admin_editable": {\n            "type": "boolean",\n            "description": "false = the console shows the item read only and a change is 20001 [key]."\n          },\n          "version": {\n            "$ref": "#/components/schemas/AdminConfigVersionNumber"\n          },\n          "updated_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Username of the admin who last changed it; null = never changed or set by the system."\n          },\n          "updated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminConfigItemPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Registered configuration items in registry order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminConfigItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminConfigItemPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminConfigItemPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigItemResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminConfigItem"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigItemList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Every item of the batch, in request order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminConfigItem"\n            }\n          }\n        }\n      },\n      "AdminConfigItemListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminConfigItemList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigItemVersion": {\n        "type": "object",\n        "description": "One stored version of a configuration item (config_item_versions).",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "value",\n          "updated_by",\n          "reason",\n          "created_at"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "value": {\n            "$ref": "#/components/schemas/AdminConfigValue"\n          },\n          "updated_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Username of the admin who wrote the version; null = written by the system."\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminConfigItemVersionPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Newest version first.",\n            "items": {\n              "$ref": "#/components/schemas/AdminConfigItemVersion"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n        