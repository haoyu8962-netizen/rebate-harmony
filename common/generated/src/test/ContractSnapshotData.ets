latform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/AgentMessageId"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AgentFeedbackRequest"\n              },\n              "example": {\n                "feedback": "down"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The feedback is recorded.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EmptyResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {},\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/agent/messages/{message_id}/report": {\n      "post": {\n        "operationId": "reportAgentMessage",\n        "tags": [\n          "agent"\n        ],\n        "summary": "Report a reply",\n        "description": "Writes agent_messages.reported and report_reason (04 §6.5, BR-AI-19). reason is free text\\nof 1–200 characters: 08 has not fixed a set of report reasons, so the contract has no enum\\nfor it. A malformed body (reason missing, empty or too long, unknown fields) is 20001.\\nAfter BR-ID-01 ①–⑦ the checks of BR-AI-23 ①–③ apply: 30501 → 10001 / 10005 → 10004; then\\n30504 without data when the message does not exist or its session is not the caller\'s\\n(never told apart, BR-AI-20). Version gate: applied.\\n",\n        "x-auth": "optional",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-min-version-gate": true,\n        "x-implementation": "planned",\n        "x-error-codes": [\n          30501,\n          10001,\n          10005,\n          10004,\n          30504,\n          20001,\n          10405\n        ],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/AgentMessageId"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AgentReportRequest"\n              },\n              "example": {\n                "reason": "回答内容与事实不符"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The report is recorded.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/EmptyResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {},\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    }\n  },\n  "components": {\n    "securitySchemes": {\n      "bearerAuth": {\n        "type": "http",\n        "scheme": "bearer",\n        "bearerFormat": "JWT",\n        "description": "`Authorization: Bearer <access_token>`; ES256 JWT with uid, app_id, sid, device_id, scp,\\nvalid 2 hours (BR-ID-07). After login app_id is taken from the token only.\\n"\n      },\n      "adminBearerAuth": {\n        "type": "http",\n        "scheme": "bearer",\n        "bearerFormat": "JWT",\n        "description": "`Authorization: Bearer <admin_token>` on every /admin/v1 operation after login (CT-02f).\\nadmin_token is a JWT signed with its own key (aud=admin, not accepted on /v1), valid\\n8 hours and expiring after 30 minutes without activity (BR-ID-34); expired or idle → 10001\\nwithout reason. The console keeps it only in memory and sessionStorage and sends it only in\\nthis header; it is never a cookie, so requests carry no ambient credential and need no\\nCSRF token. The admin API allows CORS only from the exact admin console origin (02 §3.4).\\nThe step-up token of an operation goes in the `X-Step-Up-Token` header (04 §5).\\n"\n      }\n    },\n    "parameters": {\n      "AppId": {\n        "name": "X-App-Id",\n        "in": "header",\n        "required": true,\n        "description": "App (brand) the request belongs to; before login it must match the app_id the device was registered with (10403, BR-ID-07).",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 32,\n          "pattern": "^[a-z0-9_]+$"\n        }\n      },\n      "Platform": {\n        "name": "X-Platform",\n        "in": "header",\n        "required": true,\n        "description": "Client platform (enum client_platform, 03 §4.2).",\n        "schema": {\n          "$ref": "#/components/schemas/ClientPlatformCode"\n        }\n      },\n      "AppVersion": {\n        "name": "X-App-Version",\n        "in": "header",\n        "required": true,\n        "description": "SemVer, the same number on all three apps (拍板第二批 TECH-07).",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$",\n          "maxLength": 32\n        }\n      },\n      "Build": {\n        "name": "X-Build",\n        "in": "header",\n        "required": false,\n        "description": "Build number of the client.",\n        "schema": {\n          "type": "string",\n          "maxLength": 32\n        }\n      },\n      "Channel": {\n        "name": "X-Channel",\n        "in": "header",\n        "required": false,\n        "description": "Install channel of the app package (enum install_channel); absent for H5.",\n        "schema": {\n          "$ref": "#/components/schemas/InstallChannelCode"\n        }\n      },\n      "TraceId": {\n        "name": "X-Trace-Id",\n        "in": "header",\n        "required": false,\n        "description": "Client-generated trace id, echoed as `trace_id` when well-formed.",\n        "schema": {\n          "$ref": "#/components/schemas/TraceId"\n        }\n      },\n      "DeviceId": {\n        "name": "X-Device-Id",\n        "in": "header",\n        "required": true,\n        "description": "device_id issued by POST /v1/devices; anything else is 10402 (BR-ID-09).",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "PayOrderId": {\n        "name": "pay_order_id",\n        "in": "path",\n        "required": true,\n        "description": "pay_orders.id of one of the caller\'s pay orders (UUIDv7).",\n        "schema": {\n          "type": "string",\n          "format": "uuid"\n        }\n      },\n      "OptionalDeviceId": {\n        "name": "X-Device-Id",\n        "in": "header",\n        "required": false,\n        "description": "device_id issued by POST /v1/devices, when the device is registered.",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "IfNoneMatch": {\n        "name": "If-None-Match",\n        "in": "header",\n        "required": false,\n        "description": "The ETag of the client\'s last good response (LKG); a match gets 304.",\n        "schema": {\n          "type": "string",\n          "maxLength": 512\n        }\n      },\n      "Timestamp": {\n        "name": "X-Timestamp",\n        "in": "header",\n        "required": true,\n        "description": "Unix seconds; |server time − ts| ≤ 300 s (BR-ID-09).",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9]{10}$"\n        }\n      },\n      "Nonce": {\n        "name": "X-Nonce",\n        "in": "header",\n        "required": true,\n        "description": "32 lowercase hex characters; (device_id, nonce) unique within 600 s (BR-ID-09).",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9a-f]{32}$"\n        }\n      },\n      "Sign": {\n        "name": "X-Sign",\n        "in": "header",\n        "required": true,\n        "description": "lowercase_hex(HMAC-SHA256(install_secret, METHOD + \\"\\\\n\\" + path with raw query + \\"\\\\n\\" + ts\\n+ \\"\\\\n\\" + nonce + \\"\\\\n\\" + lowercase_hex(sha256(raw body)))) (BR-ID-09).\\n",\n        "schema": {\n          "type": "string",\n          "pattern": "^[0-9a-f]{64}$"\n        }\n      },\n      "StepUpToken": {\n        "name": "X-Step-Up-Token",\n        "in": "header",\n        "required": false,\n        "description": "step_up_token from POST /v1/auth/step-up for the operation\'s x-step-up action (04 §5). Missing,\\nempty, expired or for another action → 10003 (not 20001; that is why the header is optional\\nand has no minimum length). A replay of a finished Idempotency-Key never looks at it\\n(BR-WDR-01 细则, BR-ID-08).\\n",\n        "schema": {\n          "type": "string",\n          "maxLength": 2048\n        }\n      },\n      "TipKeyPath": {\n        "name": "tip_key",\n        "in": "path",\n        "required": true,\n        "schema": {\n          "$ref": "#/components/schemas/TipKey"\n        }\n      },\n      "IdempotencyKey": {\n        "name": "Idempotency-Key",\n        "in": "header",\n        "required": true,\n        "description": "Required on operations marked I (04 §6); missing → 20001. Same key while processing →\\n40901; same key with another body → 20901; a retry after a timeout reuses the key and gets\\nthe first result (拍板第二批 TRADE-22). On the x-step-up operations a key abandoned through\\nPOST /v1/idempotency-keys/abandon → 20903, without comparing the body (04 §5「幂等」).\\n",\n        "schema": {\n          "$ref": "#/components/schemas/IdempotencyKey"\n        }\n      },\n      "UnionPlatform": {\n        "name": "platform",\n        "in": "path",\n        "required": true,\n        "description": "Platform code (enum platform).",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "PendingTrackLinkId": {\n        "name": "link_id",\n        "in": "path",\n        "required": true,\n        "description": "link_id of the pending-track card. Unlike other link operations an unknown link, or one that\\ndoes not own the attempt_id in the body, is 20001 with data.fields=[attempt_id] (no 30144).\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "LinkId": {\n        "name": "link_id",\n        "in": "path",\n        "required": true,\n        "description": "link_id from a card; unknown or of another app → 30144.",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "ProductKey": {\n        "name": "product_key",\n        "in": "path",\n        "required": true,\n        "description": "Opaque product key, URL-encoded by the client (BR-PROD-02).",\n        "schema": {\n          "$ref": "#/components/schemas/ProductKey"\n        }\n      },\n      "Cursor": {\n        "name": "cursor",\n        "in": "query",\n        "required": false,\n        "description": "Opaque cursor from `next_cursor`; absent for the first page.",\n        "schema": {\n          "type": "string",\n          "maxLength": 512\n        }\n      },\n      "Limit": {\n        "name": "limit",\n        "in": "query",\n        "required": false,\n        "description": "Page size, at most 50 (04 §5).",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1,\n          "maximum": 50,\n          "default": 20\n        }\n      },\n      "AdminPage": {\n        "name": "page",\n        "in": "query",\n        "required": false,\n        "description": "Page number of an admin list, from 1 (04 §5 后台分页).",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1,\n          "default": 1\n        }\n      },\n      "AdminPageSize": {\n        "name": "page_size",\n        "in": "query",\n        "required": false,\n        "description": "Page size of an admin list, at most 200 (04 §5 后台分页); above that → 20001.",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1,\n          "maximum": 200,\n          "default": 20\n        }\n      },\n      "AdminIdPath": {\n        "name": "admin_id",\n        "in": "path",\n        "required": true,\n        "description": "Id of an admin account; unknown → 20001 with data.fields=[admin_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUserIdPath": {\n        "name": "user_id",\n        "in": "path",\n        "required": true,\n        "description": "user_id of an app user of the console\'s app; unknown → 20001 with data.fields=[user_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminExportIdPath": {\n        "name": "id",\n        "in": "path",\n        "required": true,\n        "description": "opaque id of an export task (as listed); unknown, of another app, created by another\\naccount, or (for a download) whose creator no longer holds the needed points → 20001 with\\ndata.fields=[id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/AdminExportId"\n        }\n      },\n      "AdminDataExportIdPath": {\n        "name": "export_id",\n        "in": "path",\n        "required": true,\n        "description": "export_id of a personal information copy request of the user in the path, as GET\\n/admin/v1/users/{user_id}/data-exports lists it; unknown, of another user or app, an\\nin_app_sms request, or registered by another account → 20001 with data.fields=[export_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUserUnionPlatformPath": {\n        "name": "platform",\n        "in": "path",\n        "required": true,\n        "description": "Platform of the user\'s union binding (enum platform). Only platforms with user\\nauthorization have bindings (BR-ID-17); another platform, such as jd, → 20001 with\\ndata.fields=[platform].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "AdminUserRiskStateFilter": {\n        "name": "risk_state",\n        "in": "query",\n        "required": false,\n        "description": "Only users in this risk state (enum risk_state; no row counts as normal); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminUserRiskStateCode"\n        }\n      },\n      "AdminUserLookupUid": {\n        "name": "uid",\n        "in": "query",\n        "required": false,\n        "description": "The user_id to look up; give exactly one of uid and phone (else 20001 with data.fields=[uid, phone]).",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminSearchQuery": {\n        "name": "q",\n        "in": "query",\n        "required": true,\n        "description": "A full order number, withdrawal number, phone number or UID. Trimmed of surrounding\\nwhitespace, then 1–64 characters, else 20001 with data.fields=[q]; the bound is checked\\nafter trimming, so the schema carries none.\\n",\n        "schema": {\n          "type": "string"\n        }\n      },\n      "AdminUserLookupPhone": {\n        "name": "phone",\n        "in": "query",\n        "required": false,\n        "description": "The full phone number to look up, normalised as in BR-ID-05 细则「手机号规范化」 (not a\\nmainland mobile number → 20001 with data.fields=[phone] and data.reason=phone_invalid);\\ngive exactly one of uid and phone.\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Phone"\n        }\n      },\n      "AdminOrderIdPath": {\n        "name": "order_id",\n        "in": "path",\n        "required": true,\n        "description": "order_id of the sub-order (orders / order_keys, a UUID; the id of a list row and of an order\\nhit of the top-bar search); unknown, of another app, or (with user_id) attributed to another\\nuser or to nobody → 20001 with data.fields=[order_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminOrderPlatformFilter": {\n        "name": "platform",\n        "in": "query",\n        "required": false,\n        "description": "Only sub-orders of this platform (enum platform); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "AdminOrderPlatformStatusFilter": {\n        "name": "platform_status",\n        "in": "query",\n        "required": false,\n        "description": "Only sub-orders in this union status (enum platform_status); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminOrderPlatformStatus"\n        }\n      },\n      "AdminOrderRebateStatusFilter": {\n        "name": "rebate_status",\n        "in": "query",\n        "required": false,\n        "description": "Only sub-orders in this rebate status (enum rebate_status); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminOrderRebateStatus"\n        }\n      },\n      "AdminOrderFlagFilter": {\n        "name": "flag",\n        "in": "query",\n        "required": false,\n        "description": "Only sub-orders whose flag of this name is true (enum admin_order_flag, the keys of a row\'s flags); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminOrderFlag"\n        }\n      },\n      "AdminOrderUserFilter": {\n        "name": "user_id",\n        "in": "query",\n        "required": false,\n        "description": "Only sub-orders attributed to this user (the user_id; UID and phone lookups go through the\\ntop-bar search). Required for an account holding user.lookup but not order.view (else\\n10403 with data.reason=admin_permission_denied).\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminOrderQuery": {\n        "name": "q",\n        "in": "query",\n        "required": false,\n        "description": "A sub-order number or a parent order number, matched exactly. Trimmed and with spaces\\nremoved, then 1–64 characters, else 20001 with data.fields=[q]; the bound is checked after\\ntrimming, so the schema carries none.\\n",\n        "schema": {\n          "type": "string"\n        }\n      },\n      "AdminOrderPaidFrom": {\n        "name": "paid_from",\n        "in": "query",\n        "required": false,\n        "description": "Earliest paid_at, inclusive (ISO 8601 with offset); later than paid_to → 20001 with data.fields=[paid_from, paid_to].",\n        "schema": {\n          "type": "string",\n          "format": "date-time"\n        }\n      },\n      "AdminOrderPaidTo": {\n        "name": "paid_to",\n        "in": "query",\n        "required": false,\n        "description": "Latest paid_at, exclusive (ISO 8601 with offset).",\n        "schema": {\n          "type": "string",\n          "format": "date-time"\n        }\n      },\n      "AdminRightsImportIdPath": {\n        "name": "import_id",\n        "in": "path",\n        "required": true,\n        "description": "import_id of an Excel import task; unknown or of another app → 20001 with data.fields=[import_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminClaimIdPath": {\n        "name": "claim_id",\n        "in": "path",\n        "required": true,\n        "description": "claim_id of the claim (also its display number); unknown, of another app, or (with\\nuser_id) of another applicant → 20001 with data.fields=[claim_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminClaimPlatformFilter": {\n        "name": "platform",\n        "in": "query",\n        "required": false,\n        "description": "Only claims of this platform (enum platform); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "AdminClaimEvidenceLevelFilter": {\n        "name": "evidence_level",\n        "in": "query",\n        "required": false,\n        "description": "Only claims of this evidence level (enum claim_evidence_level; the claim\'s weakest child order); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n        }\n      },\n      "AdminClaimStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only claims in this status (enum claim_status); absent = all. The counts ignore it.",\n        "schema": {\n          "$ref": "#/components/schemas/ClaimStatus"\n        }\n      },\n      "AdminClaimUserFilter": {\n        "name": "user_id",\n        "in": "query",\n        "required": false,\n        "description": "Only claims of this applicant (the user_id; UID and phone lookups go through the top-bar\\nsearch). Required for an account holding user.lookup but not order.claim (else 10403\\nwith data.reason=admin_permission_denied).\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminClaimQuery": {\n        "name": "q",\n        "in": "query",\n        "required": false,\n        "description": "A claim_id, the order number as submitted, or a child order number, matched exactly.\\nTrimmed and with spaces removed, then 1–64 characters, else 20001 with data.fields=[q];\\nthe bound is checked after trimming, so the schema carries none.\\n",\n        "schema": {\n          "type": "string"\n        }\n      },\n      "AdminClaimItemIdPath": {\n        "name": "item_id",\n        "in": "path",\n        "required": true,\n        "description": "item_id of one child order of the claim (claim_items); unknown, or of another claim →\\n20001 with data.fields=[item_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "PlatformIconKeyPath": {\n        "name": "key",\n        "in": "path",\n        "required": true,\n        "description": "Platform mark key (enum platform_icon_key); another value → 20001 with data.fields=[key].",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformIconKey"\n        }\n      },\n      "PlatformIconVersionPath": {\n        "name": "version",\n        "in": "path",\n        "required": true,\n        "description": "Version of the mark, counted per mark from 1; unknown → 20001 with data.fields=[version].",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1\n        }\n      },\n      "AgreementTypePath": {\n        "name": "type",\n        "in": "path",\n        "required": true,\n        "description": "Agreement type (privacy, agreement, labor_agreement, sdk_list or collect_list); another value → 20001 with data.fields=[type].",\n        "schema": {\n          "$ref": "#/components/schemas/AgreementType"\n        }\n      },\n      "AgreementVersionPath": {\n        "name": "version",\n        "in": "path",\n        "required": true,\n        "description": "Version of the agreement, counted per type from 1.",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1\n        }\n      },\n      "AppVersionPlatformPath": {\n        "name": "platform",\n        "in": "path",\n        "required": true,\n        "description": "Client platform of the row; another value → 20001 with data.fields=[platform].",\n        "schema": {\n          "$ref": "#/components/schemas/ClientPlatformCode"\n        }\n      },\n      "AppVersionEditablePlatformPath": {\n        "name": "platform",\n        "in": "path",\n        "required": true,\n        "description": "Client platform of the row, one the console may save (ios, android or harmony); another value → 20001 with data.fields=[platform].",\n        "schema": {\n          "$ref": "#/components/schemas/AppVersionEditablePlatform"\n        }\n      },\n      "AppVersionChannelPath": {\n        "name": "channel",\n        "in": "path",\n        "required": true,\n        "description": "Install channel of the row; another value → 20001 with data.fields=[channel].",\n        "schema": {\n          "$ref": "#/components/schemas/InstallChannelCode"\n        }\n      },\n      "PageKeyPath": {\n        "name": "page_key",\n        "in": "path",\n        "required": true,\n        "description": "Page key: `home` or `custom:<name>` with name of 1..57 characters from [a-z0-9_-] (编排者默认);\\nanother shape → 20001 with data.fields=[page_key].\\n",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64,\n          "pattern": "^(home|custom:[a-z0-9_-]{1,57})$"\n        }\n      },\n      "PageVersionPath": {\n        "name": "version",\n        "in": "path",\n        "required": true,\n        "description": "Version of the page, counted per page from 1.",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1\n        }\n      },\n      "AdminArticleIdPath": {\n        "name": "article_id",\n        "in": "path",\n        "required": true,\n        "description": "Article id, a lowercase canonical UUID (04 §6.2 articles); any other spelling, or an id that\\ndoes not exist → 30701.\\n",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "AdminPoolIdPath": {\n        "name": "pool_id",\n        "in": "path",\n        "required": true,\n        "description": "Product pool id, a lowercase canonical UUID; any other spelling, or an id that does not\\nexist → 30701.\\n",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "ConfigKeyPath": {\n        "name": "key",\n        "in": "path",\n        "required": true,\n        "description": "A configuration or emergency-switch key as registered by the server (04 §10, §10.2), dotted\\nand concrete (`convert.enabled.taobao`, not `convert.enabled.<platform>`); an unregistered\\nkey → 20001 with data.fields=[key].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/AdminConfigKey"\n        }\n      },\n      "AdminRiskRuleIdPath": {\n        "name": "rule_id",\n        "in": "path",\n        "required": true,\n        "description": "rule_id of a risk rule of the console\'s app, as GET /admin/v1/risk-rules lists it; unknown\\nor of another app → 20001 with data.fields=[rule_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/AdminRiskRuleId"\n        }\n      },\n      "AdminAppealIdPath": {\n        "name": "appeal_id",\n        "in": "path",\n        "required": true,\n        "description": "appeal_id of the appeal (also its display number); unknown or of another app → 20001 with\\ndata.fields=[appeal_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminAppealStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only appeals in this status (enum appeal_status); absent = all. The counts ignore it.",\n        "schema": {\n          "$ref": "#/components/schemas/AppealStatus"\n        }\n      },\n      "AdminAppealOverdueFilter": {\n        "name": "overdue",\n        "in": "query",\n        "required": false,\n        "description": "true = only appeals still processing whose deadline_at has passed (BR-ID-36); false or\\nabsent = no such filter. The counts ignore it.\\n",\n        "schema": {\n          "type": "boolean"\n        }\n      },\n      "AdminAppealTargetTypeFilter": {\n        "name": "target_type",\n        "in": "query",\n        "required": false,\n        "description": "Only appeals on this kind of target (enum appeal_target_type); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminAppealTargetType"\n        }\n      },\n      "AdminAppealQuery": {\n        "name": "q",\n        "in": "query",\n        "required": false,\n        "description": "An appeal_id or the appellant\'s UID (user_id), matched exactly. Trimmed, then 1–64\\ncharacters, else 20001 with data.fields=[q]; the bound is checked after trimming, so the\\nschema carries none.\\n",\n        "schema": {\n          "type": "string"\n        }\n      },\n      "AdminBlockedRequestPhone": {\n        "name": "phone",\n        "in": "query",\n        "required": false,\n        "description": "The full phone number, normalised as in BR-ID-05 细则「手机号规范化」 (not a mainland mobile\\nnumber → 20001 with data.fields=[phone] and data.reason=phone_invalid); give exactly one\\nof phone, user_id and blocked_request_id.\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Phone"\n        }\n      },\n      "AdminBlockedRequestUserFilter": {\n        "name": "user_id",\n        "in": "query",\n        "required": false,\n        "description": "The UID (user_id) whose blocked requests to list; give exactly one of phone, user_id and blocked_request_id.",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminBlockedRequestIdFilter": {\n        "name": "blocked_request_id",\n        "in": "query",\n        "required": false,\n        "description": "The blocked request id (拦截请求编号) shown in the 44001 dialog, matched exactly; give\\nexactly one of phone, user_id and blocked_request_id.\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminStepUpToken": {\n        "name": "X-Step-Up-Token",\n        "in": "header",\n        "required": false,\n        "description": "step_up_token from POST /admin/v1/auth/step-up, whose tier the operation checks (BR-ID-34;\\ntier per permission point in GET /admin/v1/me/permissions). Missing, expired or of a lower\\ntier than the operation needs → 10003 with data.tier (not 20001; that is why the header is\\noptional). Only on admin console operations; app operations use StepUpToken.\\n",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 2048\n        }\n      },\n      "AdminNotifyTemplateCodePath": {\n        "name": "code",\n        "in": "path",\n        "required": true,\n        "description": "Template code (code of GET /admin/v1/notify-channels); not a template code of the app → 20001 with data.fields=[code].",\n        "schema": {\n          "$ref": "#/components/schemas/AdminNotifyTemplateCode"\n        }\n      },\n      "AdminNotifyTemplateVariantQuery": {\n        "name": "variant",\n        "in": "query",\n        "required": false,\n        "description": "The variant of the code (sms_registrations[].variant of GET /admin/v1/notify-channels); default when absent; not a variant of the code → 20001 with data.fields=[variant].",\n        "schema": {\n          "$ref": "#/components/schemas/AdminNotifyTemplateVariant"\n        }\n      },\n      "AgentSessionId": {\n        "name": "id",\n        "in": "path",\n        "required": true,\n        "description": "session_id. A session that does not exist or is not the caller\'s is 30504 either way (BR-AI-20).",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AgentRunId": {\n        "name": "run_id",\n        "in": "path",\n        "required": true,\n        "description": "run_id from meta.run_id or a history turn.",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AgentMessageId": {\n        "name": "message_id",\n        "in": "path",\n        "required": true,\n        "description": "message_id from meta.message_id or a history item. A message that does not exist or whose\\nsession is not the caller\'s is 30504 either way (BR-AI-20).\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUnionAccountIdPath": {\n        "name": "union_account_id",\n        "in": "path",\n        "required": true,\n        "description": "union_account_id from GET /admin/v1/union-accounts; unknown or of another app → 20001 with data.fields=[union_account_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUnionSessionIdPath": {\n        "name": "session_id",\n        "in": "path",\n        "required": true,\n        "description": "session_id from POST …/reauthorize or POST /admin/v1/union-accounts/oauth/callback; unknown or of another account → 20001 with data.fields=[session_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUnionPidIdPath": {\n        "name": "pid_id",\n        "in": "path",\n        "required": true,\n        "description": "pid_id from GET /admin/v1/union-pids; unknown or of another app → 20001 with data.fields=[pid_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUnionAccountPlatformFilter": {\n        "name": "platform",\n        "in": "query",\n        "required": false,\n        "description": "Only union accounts of this platform (enum platform); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "AdminPayOrderIdPath": {\n        "name": "pay_order_id",\n        "in": "path",\n        "required": true,\n        "description": "The pay order (pay_orders.id) as a list row carries it; unknown or of another app → 20001 with data.fields=[pay_order_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminPayRefundIdPath": {\n        "name": "pay_refund_id",\n        "in": "path",\n        "required": true,\n        "description": "The refund (pay_refunds.id); unknown or of another app → 20001 with data.fields=[pay_refund_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminPayAnomalyIdPath": {\n        "name": "pay_anomaly_id",\n        "in": "path",\n        "required": true,\n        "description": "The pay anomaly (pay_anomalies.id); unknown or of another app → 20001 with data.fields=[pay_anomaly_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminPayOrderStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only pay orders in this status (enum pay_order_status); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminPayOrderStatus"\n        }\n      },\n      "AdminPayChannelFilter": {\n        "name": "pay_channel",\n        "in": "query",\n        "required": false,\n        "description": "Only rows of this pay channel (enum pay_channel); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminPayChannel"\n        }\n      },\n      "AdminPayBizTypeFilter": {\n        "name": "biz_type",\n        "in": "query",\n        "required": false,\n        "description": "Only pay orders of this business type (pay_orders.biz_type, exact match); absent = all.",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "AdminPayUserFilter": {\n        "name": "user_id",\n        "in": "query",\n        "required": false,\n        "description": "Only pay orders of this user of ours (pay_orders.user_id); a user_id that names no user is an empty page.",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminPayOutTradeNoFilter": {\n        "name": "out_trade_no",\n        "in": "query",\n        "required": false,\n        "description": "Only the pay order with this merchant order number (exact match).",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "AdminPayNeedsManualFilter": {\n        "name": "needs_manual",\n        "in": "query",\n        "required": false,\n        "description": "true = only pay orders waiting for manual settlement (BR-PAY-05 ③); false = only the others; absent = all.",\n        "schema": {\n          "type": "boolean"\n        }\n      },\n      "AdminPayCreatedFrom": {\n        "name": "created_from",\n        "in": "query",\n        "required": false,\n        "description": "Earliest created_at, inclusive (ISO 8601 with offset); later than created_to → 20001 with data.fields=[created_from, created_to].",\n        "schema": {\n          "type": "string",\n          "format": "date-time"\n        }\n      },\n      "AdminPayCreatedTo": {\n        "name": "created_to",\n        "in": "query",\n        "required": false,\n        "description": "Latest created_at, exclusive (ISO 8601 with offset).",\n        "schema": {\n          "type": "string",\n          "format": "date-time"\n        }\n      },\n      "AdminPayRefundStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only refunds in this status (enum pay_refund_status); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminPayRefundStatus"\n        }\n      },\n      "AdminPayRefundTargetTypeFilter": {\n        "name": "target_type",\n        "in": "query",\n        "required": false,\n        "description": "Only refunds of pay orders or of pay anomalies (enum pay_refund_target_type); absent = both.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminPayRefundTargetType"\n        }\n      },\n      "AdminPayRefundReasonFilter": {\n        "name": "reason_code",\n        "in": "query",\n        "required": false,\n        "description": "Only refunds with this reason code (enum pay_refund_reason); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminPayRefundReason"\n        }\n      },\n      "AdminPayReconDiffTypeFilter": {\n        "name": "type",\n        "in": "query",\n        "required": false,\n        "description": "Only differences of this R4 type (pay_mismatch or pay_anomaly); absent = both.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminPayReconDiffType"\n        }\n      },\n      "AdminPayReconDiffStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only differences in this status (enum recon_diff_status); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminReconDiffStatus"\n        }\n      },\n      "AdminReconDiffTypeFilter": {\n        "name": "type",\n        "in": "query",\n        "required": false,\n        "description": "Only differences of this R1–R3 type (AdminReconDiffType); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminReconDiffType"\n        }\n      },\n      "AdminReconDiffSourceFilter": {\n        "name": "source",\n        "in": "query",\n        "required": false,\n        "description": "Only differences of this source (R1, R2 or R3; R4 is not accepted here); absent = all three.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminReconDiffSource"\n        }\n      },\n      "AdminReconDiffStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only differences in this status (enum recon_diff_status); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminReconDiffStatus"\n        }\n      },\n      "AdminReconDiffPeriodFrom": {\n        "name": "period_from",\n        "in": "query",\n        "required": false,\n        "description": "Smallest period, inclusive, compared with `period` as a string (YYYY-MM or YYYY-MM-DD); greater than period_to → 20001 with data.fields=[period_from, period_to].",\n        "schema": {\n          "$ref": "#/components/schemas/AdminReconDiffPeriod"\n        }\n      },\n      "AdminReconDiffPeriodTo": {\n        "name": "period_to",\n        "in": "query",\n        "required": false,\n        "description": "Largest period, inclusive, compared with `period` as a string (YYYY-MM or YYYY-MM-DD).",\n        "schema": {\n          "$ref": "#/components/schemas/AdminReconDiffPeriod"\n        }\n      },\n      "AdminReconDiffRefIdFilter": {\n        "name": "ref_id",\n        "in": "query",\n        "required": false,\n        "description": "Only differences referring to this ref_id (exact match); absent = all.",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 128\n        }\n      },\n      "AdminReconDiffIdPath": {\n        "name": "recon_diff_id",\n        "in": "path",\n        "required": true,\n        "description": "The reconciliation difference (recon_diffs.id) as a list row carries it; unknown, of another app or of source R4 → 20001 with data.fields=[recon_diff_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminAdjustmentIdPath": {\n        "name": "adjust_id",\n        "in": "path",\n        "required": true,\n        "description": "The adjustment form (admin_adjustments.adjust_id) as a list row carries it; unknown or of another app → 20001 with data.fields=[adjust_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminAdjustmentReasonCodeFilter": {\n        "name": "reason_code",\n        "in": "query",\n        "required": false,\n        "description": "Only forms with this reason code.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminAdjustmentReasonCode"\n        }\n      },\n      "AdminAdjustmentStatusFilter": {\n        "name": "status",\n  