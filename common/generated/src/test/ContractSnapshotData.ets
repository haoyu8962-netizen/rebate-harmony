c21\\necf0347e0739fe7acc58ab7e16d7b2f7ed537430da4e3897b5c37b9e2176daa9",\n      "expected_sign": "4d1b29a030a24a26bea53b6500e970497233aef7d935f1d0a9e89ffe10b97a2c"\n    },\n    {\n      "note": "PUT is signed too: save payout account (x-signed: true), non-ASCII JSON body",\n      "method": "PUT",\n      "path": "/v1/me/payout-account",\n      "body_utf8": "{\\"payout_method\\":\\"alipay\\",\\"alipay_logon_id\\":\\"test-payee@example.com\\",\\"payee_name\\":\\"测试用户\\"}",\n      "timestamp": "1790661600",\n      "server_time": 1790661600,\n      "nonce": "dd0afc76e0e9a9de733e3315497fcb7e",\n      "install_secret": "test-only.install.device-b",\n      "expected_signing_string": "PUT\\n/v1/me/payout-account\\n1790661600\\ndd0afc76e0e9a9de733e3315497fcb7e\\n6ebdfc7ef5aff8ab8bcb7abb8234aa478bbb347dbc7b083bcba9c80466dee82b",\n      "expected_sign": "54d21ed682bc1c31a2e7f0f121520dbb807868ee017a41d38cadd9bf0d981a24"\n    },\n    {\n      "note": "install_secret longer than the 64-byte HMAC block (key is hashed first per RFC 2104)",\n      "method": "POST",\n      "path": "/v1/auth/refresh",\n      "body_utf8": "",\n      "timestamp": "1790661600",\n      "server_time": 1790661600,\n      "nonce": "ec7e1848879d741def3a23c93432acf2",\n      "install_secret": "test-only.install.key.longer.than.the.sixty-four.byte.hmac.block.size.so.it.is.hashed.first",\n      "expected_signing_string": "POST\\n/v1/auth/refresh\\n1790661600\\nec7e1848879d741def3a23c93432acf2\\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",\n      "expected_sign": "c082952ce98e6d897a86c4b9c836cd082c5e438d342f4f88416131452ec93abb"\n    }\n  ],\n  "invalid_cases": [\n    {\n      "note": "server_time - ts = +301 (client clock 301 s slow)",\n      "expected_reason": "time_skew",\n      "method": "POST",\n      "path": "/v1/links/abc/open?src=agent",\n      "body_utf8": "{\\"no_rebate\\":false}",\n      "timestamp": "1790661600",\n      "server_time": 1790661901,\n      "nonce": "bbec2abe48fcdc9ed