"\n          }\n        }\n      },\n      "AdminPagePreviewToken": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "token",\n          "page_key",\n          "version",\n          "expire_at"\n        ],\n        "properties": {\n          "token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 256,\n            "description": "Preview token for GET /v1/pages/{page_key}/preview; the QR code carries only it and page_key."\n          },\n          "page_key": {\n            "$ref": "#/components/schemas/AdminPageKey"\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "10 minutes after issue."\n          }\n        }\n      },\n      "AdminPagePreviewTokenResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPagePreviewToken"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigKey": {\n        "type": "string",\n        "description": "A configuration or emergency-switch key (04 §10, §10.2): dotted segments, concrete per\\nplatform or channel (`convert.enabled.taobao`); the server\'s registry decides which keys\\nexist.\\n",\n        "minLength": 1,\n        "maxLength": 128,\n        "pattern": "^[a-z][a-z0-9_]*(\\\\.[A-Za-z0-9_]+)*$"\n      },\n      "AdminConfigValue": {\n        "description": "Any JSON value of the key\'s `value_type` (an `enum` value is one of `options`); checked by\\nthe server against the key\'s registered type and rule, a mismatch → 20001 with\\ndata.fields=[value].\\n"\n      },\n      "AdminConfigValueType": {\n        "type": "string",\n        "description": "Type of a configuration or switch value: boolean, enum (a string out of `options`), object\\n(a JSON object or array, such as a list of routes or hosts), number or string.\\n",\n        "enum": [\n          "boolean",\n          "enum",\n          "object",\n          "number",\n          "string"\n        ]\n      },\n      "AdminConfigOptions": {\n        "type": [\n          "array",\n          "null"\n        ],\n        "description": "Allowed values when `value_type` is enum; null for every other type.",\n        "items": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64\n        }\n      },\n      "AdminConfigVersionNumber": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 0,\n        "description": "Version of the key\'s current value: 0 = never written (value null, the default applies);\\nplus 1 on every change or rollback, never going back. The CAS value `expected_version`\\nof the writes.\\n"\n      },\n      "AdminConfigReason": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 200,\n        "description": "Optional free-text reason, kept in the audit record and the history version."\n      },\n      "AdminKillSwitch": {\n        "type": "object",\n        "description": "A registered emergency switch (04 §10.2) and its current value.",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "value",\n          "default",\n          "value_type",\n          "options",\n          "permissions",\n          "admin_editable",\n          "version",\n          "updated_by",\n          "updated_at"\n        ],\n        "properties": {\n          "key": {\n            "$ref": "#/components/schemas/AdminConfigKey"\n          },\n          "value": {\n            "description": "Current value; null = never written, `default` applies.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminConfigValue"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "default": {\n            "$ref": "#/components/schemas/AdminConfigValue"\n          },\n          "value_type": {\n            "$ref": "#/components/schemas/AdminConfigValueType"\n          },\n          "options": {\n            "$ref": "#/components/schemas/AdminConfigOptions"\n          },\n          "permissions": {\n            "type": "array",\n            "description": "Permission points of which any one may change the switch (04 §11.2).",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AdminPermissionKey"\n            }\n          },\n          "admin_editable": {\n            "type": "boolean",\n            "description": "false = the console shows the switch read only and a change is 20001 [key]. For\\n`withdraw.auto_payout.enabled` true means it can only be turned off: the console offers\\n`false` only and a change to `true` is 20001 [value] (BR-WDR-30).\\n"\n          },\n          "version": {\n            "$ref": "#/components/schemas/AdminConfigVersionNumber"\n          },\n          "updated_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Username of the admin who last changed it; null = never changed or set by the system."\n          },\n          "updated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminKillSwitchPage": {\n        "type": "object",\n       