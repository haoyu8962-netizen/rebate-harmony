ersion"\n            }\n          }\n        }\n      },\n      "AdminArticleResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminArticle"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminArticleCreateRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "article_id",\n          "category",\n          "title",\n          "body"\n        ],\n        "properties": {\n          "article_id": {\n            "$ref": "#/components/schemas/Id",\n            "description": "Client-generated UUIDv7 (lowercase canonical form), generated once per new article and\\nreused on every retry of the same create. An id that already exists → 20902\\n`data.resource=article` (no second article); read it back with GET\\n/admin/v1/articles/{article_id}.\\n"\n          },\n          "category": {\n            "$ref": "#/components/schemas/ArticleCategory"\n          },\n          "title": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 100\n          },\n          "body": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200000,\n            "description": "tiptap JSON document as a string."\n          },\n          "notice_closable": {\n            "type": "boolean",\n            "description": "Notices only (default true); ignored for other categories."\n          },\n          "notice_end_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Notices only; required when notice_closable is false. Ignored for other categories."\n          }\n        }\n      },\n      "AdminArticleDraftRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "title",\n          "body",\n          "expected_row_version"\n        ],\n        "properties": {\n          "title": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 100\n          },\n          "body": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200000,\n            "description": "tiptap JSON document as a string."\n          },\n          "notice_closable": {\n            "type": "boolean",\n            "description": "Notices only (default true); ignored for other categories."\n          },\n          "notice_end_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Notices only; required when notice_closable is false. Ignored for other categories."\n          },\n          "expected_row_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The article\'s `row_version` as the console showed it; a mismatch is 20902."\n          }\n        }\n      },\n      "AdminArticlePublishRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "expected_row_version"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The newest version, in status draft."\n          },\n          "published_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When t