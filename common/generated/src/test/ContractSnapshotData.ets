lid"\n                  },\n                  "codeExpired": {\n                    "$ref": "#/components/examples/AdminVerifyPhoneCodeExpired"\n                  },\n                  "phoneInvalid": {\n                    "$ref": "#/components/examples/AdminUserLookupPhoneInvalid"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  },\n                  "ipNotAllowed": {\n                    "$ref": "#/components/examples/AdminIpNotAllowed"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/admin/v1/dashboard": {\n      "get": {\n        "operationId": "adminGetDashboard",\n        "tags": [\n          "admin-dashboard"\n        ],\n        "summary": "The console workbench — to-do counts, yesterday\'s overview and system status",\n        "description": "Permission point `dashboard.view` (04 §11.1; read only, no step-up); without it the\\noperation is 10403 with `data.reason=admin_permission_denied` and the console lands on the\\nfirst menu the account may open (01 F-ADM-26, 04 §6.6 dashboard). A super admin holds every\\npoint. Read-only aggregate: nothing is written here, every card links to its own page.\\n\\nThe server trims the response to the account\'s permission points; the console renders only\\nwhat comes back (no greyed-out cards):\\n- `todo[]`: one entry per to-do card (`key`, enum admin_dashboard_todo_key) the account\\n  holds the card\'s point for — withdraw_review_pending `withdraw.review`,\\n  claim_review_pending `order.claim`, settle_bill_pending `settle.bill`, recon_diff_open\\n  `fund.recon`, appeal_pending `risk.appeal`, agent_report_overdue `agent.report`,\\n  beneficiary_held_overdue `risk.freeze`, union_auth_expiring `union.account_auth` (counting\\n  rules in the BR each enum value names). A card the account may see is returned with\\n  `count=0` when nothing is waiting (the card still shows). A card whose module has not\\n  shipped yet is left out exactly like a card without the point: the three fund cards\\n  (withdraw_review_pending, settle_bill_pending, recon_diff_open) appear once the fund\\n  line\'s console tasks ship. `route` is the console route the card opens, with its\\n  filter; `oldest_at` (optional, nullable) is the earliest waiting item\'s time;\\n  `breakdown` (optional) splits the count by a card-specific sub-key (for\\n  claim_review_pending `auto_matched` and `manual_review`); clients ignore keys they do\\n  not know.\\n- `yesterday`: always returned with `dashboard.view`. Yesterday\'s whole accounting day\\n  (`date`), aggregated daily with the report rules, not live (01 F-ADM-26 ②): `links`\\n  (link_logs created that day), `orders` (sub-orders with paid_at that day, not reduced by\\n  later invalidation), `est_rebate_fen` (users\' share of those sub-orders still\\n  rebate_status=ESTIMATED and platform_status≠DEPOSIT_PAID at aggregation time, BR-TEXT-21),\\n  `new_users` (users registered that day); `as_of` is the aggregation time.\\n- `status`: only with `fund.view`, otherwise the whole object is absent: payout queue\\n  paused (`payout.queue_paused`), the payout channels paused one by one\\n  (`payout.channel_paused.<channel>`), monthly auto settlement (`settle.auto.enabled`) and\\n  whether the enterprise Alipay balance W is expired (BR-WDR-18; null until W entry ships\\n  with the fund line).\\nNo open-alerts count is returned (alert records and closing rules are not defined yet;\\n负责人 2026-10-18 后台第 1 批定稿 ①).\\n",\n        "x-auth": "admin",\n        "x-implementation": "planned",\n        "x-error-codes": [\n          10001,\n          10403\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The workbench, trimmed to the account\'s permission points.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminDashboardResponse"\n                },\n                "examples": {\n                  "superAdmin": {\n                    "summary": "Super admin with the cards whose modules have shipped",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "todo": [\n                          {\n                            "key": "claim_review_pending",\n                            "count": 7,\n                            "route": "/claims?status=manual_review",\n                            "oldest_at": "2026-10-17T09:12:00+08:00",\n                            "breakdown": [\n                              {\n                                "key": "auto_matched",\n                                "count": 4\n                              },\n                              {\n                                "key": "manual_review",\n                                "count": 3\n                              }\n                            ]\n                          },\n                          {\n                            "key": "appeal_pending",\n                            "count": 2,\n                            "route": "/risk/appeals?status=processing",\n                            "oldest_at": "2026-10-18T15:40:00+08:00"\n                          },\n                          {\n                            "key": "agent_report_overdue",\n                            "count": 0,\n                            "route": "/agent/reports?overdue=true",\n                            "oldest_at": null\n                          },\n                          {\n                            "key": "beneficiary_held_overdue",\n                            "count": 1,\n                            "route": "/risk/held-alerts"\n                          },\n                          {\n                            "key": "union_auth_expiring",\n                            "count": 1,\n                            "route": "/union/accounts?auth=expiring"\n                          }\n                        ],\n                        "yesterday": {\n                          "date": "2026-10-18",\n                          "links": 1284,\n                          "orders": 312,\n                          "est_rebate_fen": 158600,\n                          "new_users": 46,\n                          "as_of": "2026-10-19T00:30:00+08:00"\n                        },\n                        "status": {\n                          "payout_queue_paused": false,\n                          "payout_channel_paused": [\n                            "bank_card"\n                          ],\n                          "settle_auto_enabled": true,\n                          "balance_w_expired": null\n                        }\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  },\n                  "noFundView": {\n                    "summary": "Account with dashboard.view and order.claim only (no status)",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "todo": [\n                          {\n                            "key": "claim_review_pending",\n                            "count": 0,\n                            "route": "/claims?status=manual_review",\n                            "oldest_at": null\n                          }\n                        ],\n                        "yesterday": {\n                          "date": "2026-10-18",\n                          "links": 1284,\n                          "orders": 312,\n                          "est_rebate_fen": 158600,\n                          "new_users": 46,\n                          "as_of": "2026-10-19T00:30:00+08:00"\n                        }\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "Not available (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "noPermission": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  },\n                  "ipNotAllowed": {\n                    "$ref": "#/components/examples/AdminIpNotAllowed"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/admin/v1/admins": {\n      "get": {\n        "operationId": "adminListAdmins",\n        "tags": [\n          "admin-accounts"\n        ],\n        "summary": "List admin accounts (super admin only, read-only)",\n        "descriptio