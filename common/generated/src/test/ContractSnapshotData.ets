n    "/v1/me/favorites/{platform}/{product_key}": {\n      "put": {\n        "operationId": "addFavorite",\n        "tags": [\n          "trade"\n        ],\n        "summary": "Add a favorite",\n        "description": "Favorites one product (规划/01 F-PROD-12). Unique per (app, user, platform, product_key):\\nwhen the product is already a favorite the original record is returned and no row is\\nadded. Adding a new one when the user already has `favorites.max_per_user` favorites is\\n20001 with data.reason=favorites_full (client shows error.20001.favorites_full as a light\\nhint, no dialog); an existing favorite is returned even at the limit. Only the product\\nreference and the time are stored. A product key that does not belong to `platform` is\\n20001 with data.fields=[product_key]. Version gate: applied.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          20001,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          },\n          {\n            "$ref": "#/components/parameters/UnionPlatform"\n          },\n          {\n            "$ref": "#/components/parameters/ProductKey"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The favorite, new or the one already recorded.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/FavoriteResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "platform": "taobao",\n                    "product_key": "tb:7Kq9LmN3pQ",\n                    "favorited_at": "2026-10-05T09:30:00+08:00"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      },\n      "delete": {\n        "operationId": "removeFavorite",\n        "tags": [\n          "trade"\n        ],\n        "summary": "Remove a favorite",\n        "description": "Removes one favorite; the row is physically deleted (规划/01 F-PROD-12). A product that is\\nnot a favorite is success as well. A product key that does not belong to `platform` is\\n20001 with data.fields=[product_key]. Version gate: applied.\\n",\n        "x-auth": "login",\n        "x-signed": false,\n        "x-idempotent": true,\n        "x-min-version-gate": true,\n        "x-error-codes": [\n          20001,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {