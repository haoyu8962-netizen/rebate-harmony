e",\n            "description": "When the request was blocked."\n          },\n          "cause": {\n            "$ref": "#/components/schemas/AdminBlockedRequestCause"\n          },\n          "blocklist_dimension": {\n            "description": "The blocklist dimension that was hit for cause blocklist; null for cause rule.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminBlocklistDimension"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "amount_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "minimum": 1,\n            "description": "The amount asked for, in fen, for request type withdraw; null otherwise."\n          },\n          "processing_appeal_id": {\n            "description": "The appeal processing on this request (for the register type also one on the same\\nrelated phone number); null when none.\\n",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AdminBlockedRequestPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminBlockedRequest"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "