  "format": "date",\n            "description": "The day the money arrived (YYYY-MM-DD), not later than the current accounting day."\n          },\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1,\n            "description": "Integer fen above 0, the amount of BR-FUND-20."\n          },\n          "cash_account": {\n            "$ref": "#/components/schemas/AdminUnionReceiptCashAccount"\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 500,\n            "description": "Optional, at most 500 characters, not blank after trimming."\n          }\n        }\n      },\n      "AdminUnionReceiptReverseRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/union-receipts/{receipt_id}/reverse.",\n        "additionalProperties": false,\n        "required": [\n          "reason"\n        ],\n        "properties": {\n          "reason": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Why the record is reversed; 1–200 characters after trimming, else 20001 with data.fields=[reason]. Kept in the audit record."\n          }\n        }\n      },\n      "AdminUnionReceipt": {\n        "type": "object",\n        "description": "One union collection record (BR-FUND-20 细则「联盟回款凭证」; 04 §3.2 union_receipts, written by settlement).",\n        "additionalProperties": false,\n        "required": [\n          "receipt_id",\n          "platform",\n          "receipt_date",\n          "amount_fen",\n          "method",\n          "cash_account",\n          "voucher_id",\n          "note",\n          "created_by",\n          "created_by_name",\n          "created_at",\n          "reversed_at",\n          "reversed_by",\n          "reversed_by_name",\n          "reversal_voucher_id"\n        ],\n        "properties": {\n          "receipt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "receipt_date": {\n            "type": "string",\n            "format": "date",\n            "description": "The day the money arrived (YYYY-MM-DD)."\n          },\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1,\n            "description": "Integer fen, the amount of BR-FUND-20. It stays as entered after a reversal."\n          },\n          "method": {\n            "$ref": "#/components/schemas/AdminUnionReceiptMethod"\n          },\n          "cash_account": {\n            "$ref": "#/components/schemas/AdminUnionReceiptCashAccount"\n          },\n          "voucher_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "note": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 500\n          },\n          "created_by": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The admin who entered the record; null for a record confirmed by R1 without an operator."\n          },\n          "created_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Current name of the creator (admin_users.display_name, else the username); null when there is none or it cannot be read."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "reversed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the record was reversed; null until then."\n          },\n          "reversed_by": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The admin who reversed the record; null until then."\n          },\n          "reversed_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Current name of the reverser (admin_users.display_name, else the username), derived when read; null until the record is reversed, or when it cannot be read."\n          },\n          "reversal_voucher_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The reversal voucher (BR-FUND-16, BR-FUND-20 细则); null until the record is reversed."\n          }\n        }\n      },\n      "AdminUnionReceiptPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUnionReceipt"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminUnionReceiptPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionReceiptPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionReceiptResult": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "receipt"\n        ],\n        "properties": {\n          "receipt": {\n            "$ref": "#/components/schemas/AdminUnionReceipt"\n          }\n        }\n      },\n      "AdminUnionReceiptCreateResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionReceiptResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionReceiptReverseResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionReceiptResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminFundLedgerReceivable": {\n        "type": "object",\n        "description": "The 已入账未回款 of one platform at the moment of reading (BR-FUND-20).",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "union_receivable_fen"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "union_receivable_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Balance in fen of UNION_RECEIVABLE:{platform} over all the entries posted so far; below 0 after a collection above the receivable."\n          }\n        }\n      },\n      "AdminPayoutWatermarkChannel": {\n        "type": "string",\n        "description": "The channels whose W can be entered (D10-592); bank_card opens with its channel.",\n        "enum": [\n          "alipay",\n          "wechat"\n        ]\n      },\n      "AdminPayoutWatermarkCreateRequest": {\n        "type": "object",\n        "description": "One reading of a channel\'s balance; see POST /admin/v1/payout-watermarks.",\n        "additionalProperties": false,\n        "required": [\n          "channel",\n          "available_fen",\n          "measured_at"\n        ],\n        "properties": {\n          "channel": {\n            "$ref": "#/components/schemas/AdminPayoutWatermarkChannel"\n          },\n          "available_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Integer fen, 0 or above, the balance read off the account (BR-WDR-18 W)."\n          },\n          "measured_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When W was read off the account (t_W), checked against the injected Clock."\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 500,\n            "description": "Optional, at most 500 characters, not blank after trimming; kept in the audit record."\n          }\n        }\n      },\n      "AdminPayoutWatermark": {\n        "type": "object",\n        "description": "One row of 04 §3.2 payout_watermarks.",\n        "additionalProperties": false,\n        "required": [\n          "watermark_id",\n          "channel",\n          "available_fen",\n          "measured_at",\n          "entered_by",\n          "entered_by_name",\n          "created_at"\n        ],\n        "properties": {\n          "watermark_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "channel": {\n            "$ref": "#/components/schemas/AdminPayoutWatermarkChannel"\n          },\n          "available_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "measured_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "entered_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "entered_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Current name of that admin (admin_users.display_name, else the username)."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayoutWatermarkResult": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "watermark"\n        ],\n        "properties": {\n          "watermark": {\n            "$ref": "#/components/schemas/AdminPayoutWatermark"\n          }\n        }\n      },\n      "AdminPayoutWatermarkCreateResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayoutWatermarkResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayoutBatchCreateRequest": {\n        "type": "object",\n        "description": "The withdrawals to execute; see POST /admin/v1/payout-batches.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_ids"\n        ],\n        "properties": {\n          "withdrawal_ids": {\n            "type": "array",\n            "minItems": 1,\n            "maxItems": 200,\n            "items": {\n              "$ref": "#/components/schemas/Id"\n            }\n          }\n        }\n      },\n      "AdminPayoutBatchLeftItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "reason"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "reason": {\n            "type": "string",\n            "enum": [\n              "not_approved",\n              "member_blocked",\n              "has_transfer_attempt",\n              "channel_disabled",\n              "watermark_stale",\n              "watermark_below_forecast",\n              "watermark_usable_exceeded"\n            ]\n          }\n        }\n      },\n      "AdminPayoutBatchResult": {\n        "type": "object",\n        "description": "Whether the batch ran. On `rejected` nothing moved; see POST /admin/v1/payout-batches.",\n        "additionalProperties": false,\n        "required": [\n          "outcome",\n          "batch_id",\n          "reason",\n          "channel",\n          "paying",\n 