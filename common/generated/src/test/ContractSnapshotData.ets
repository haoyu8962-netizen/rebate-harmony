        "$ref": "#/components/schemas/AdminDictSaveResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminDictItemVersion": {\n        "type": "object",\n        "description": "One stored dictionary row (dict_items).",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "version",\n          "text",\n          "created_by",\n          "created_at"\n        ],\n        "properties": {\n          "key": {\n            "$ref": "#/components/schemas/DictKey"\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "text": {\n            "$ref": "#/components/schemas/DictText"\n          },\n          "created_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminDictItemVersionPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Dictionary rows, newest first.",\n            "items": {\n              "$ref": "#/components/schemas/AdminDictItemVersion"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminDictItemVersionPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminDictItemVersionPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminConfigItemRollbackRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "to_version",\n          "expected_version"\n        ],\n        "properties": {\n          "to_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The stored version whose value becomes the new current value; must be older than the current one."\n          },\n          "expected_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The item\'s current `version` as the console showed it; a mismatch is 20902."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminConfigReason"\n          }\n        }\n      },\n      "AdminUserRiskStateCode": {\n        "type": "string",\n        "description": "Risk state of a user (enum risk_state; BR-ID-31, BR-ID-36).",\n        "enum": [\n          "normal",\n          "frozen",\n          "appealing",\n          "banned"\n        ]\n      },\n      "AdminRiskReasonCategory": {\n        "type": "string",\n        "description": "User-visible reason category of a ban or freeze (enum risk_reason_category; BR-TEXT-23 细则\\n「原因类别」, user text from the dictionary risk_reason.<category>).\\n",\n        "enum": [\n          "malicious_rights",\n          "fraud_invite",\n          "abnormal_trade",\n          "account_security",\n          "other"\n        ]\n      },\n      "AdminUserLevel": {\n        "type": "string",\n        "description": "Distribution level of the user (enum user_level; not shown to the user, OPS-20).",\n        "enum": [\n          "L1",\n          "L2",\n          "L3"\n        ]\n      },\n      "AdminUnionBindingStatus": {\n        "type": "string",\n        "description": "Status of a union binding (enum union_binding_status; BR-ID-19, BR-ID-20).",\n        "enum": [\n          "unbound",\n          "pending_auth",\n          "active",\n          "invalid",\n          "released",\n          "blocked"\n        ]\n      },\n      "AdminUnionBindingBlockedReason": {\n        "type": "string",\n        "description": "Why a binding is blocked (enum union_binding_blocked_reason; BR-ID-20).",\n        "enum": [\n          "ban",\n          "admin_disable",\n          "deletion"\n        ]\n      },\n      "AdminRowVersion": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 0,\n        "description": "row_version of the row as read (users\' risk state, a union binding); plus 1 on every\\nchange. The CAS value `expected_row_version` of the writes.\\n"\n      },\n      "AdminUserReason": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 200,\n        "description": "Required free-text reason, kept in the audit record."\n      },\n      "AdminMaskedPhone": {\n        "type": [\n          "string",\n          "null"\n        ],\n        "maxLength": 32,\n        "description": "Phone number masked 3 + 4 (`138****5678`, BR-ID-33); null when no phone is bound."\n      },\n      "AdminUserListItem": {\n        "type": "object",\n        "description": "A user row of the list; non-sensitive fields only (04 §11.1 user.list).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "nickname",\n          "phone_masked",\n          "level",\n          "risk_state",\n          "created_at"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nickname": {\n            "type": "string"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "level": {\n            "$ref": "#/components/schemas/AdminUserLevel"\n          },\n          "risk_state": {\n            "$ref": "#/components/schemas/AdminUserRiskStateCode"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Registration time."\n          }\n        }\n      },\n      "AdminAuditLogId": {\n        "type": "string",\n        "description": "Opaque identifier of an audit record (04 §5, ids are strings). It is not the database\\nprimary key (ADR-0001: internal auto-increment keys are never exposed); clients must not\\nparse it, compare it for order or derive anything from it. Generated by the server and\\nstable for the life of the record; how it is generated is up to the implementation.\\n",\n        "minLength": 16,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z0-9_-]{16,64}$"\n      },\n      "AdminAuditValue": {\n        "description": "A before or after value as the action stored it: any JSON, null when the action recorded\\nnone. Sensitive fields are stored and shown masked.\\n"\n      },\n      "AdminAuditLogListItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "actor_id",\n          "action",\n          "target_type",\n          "target_id",\n          "permission",\n          "ip",\n          "at"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/AdminAuditLogId"\n          },\n          "actor_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "actor_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current username of the account that acted; null when it cannot be read.",\n            "maxLength": 64\n          },\n          "action": {\n            "type": "string",\n            "description": "Action key as the writing module recorded it (such as user_pii_reveal).",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "target_type": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object type derived from the record (free text); null when it cannot be derived.",\n            "maxLength": 64\n          },\n          "target_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object id derived from the record; null when it cannot be derived.",\n            "maxLength": 128\n          },\n          "permission": {\n            "description": "Permission point derived from the action; null when it cannot be derived.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminPermissionKey"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "ip": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Client IP of the request (IPv4 or IPv6); null when not recorded.",\n            "maxLength": 45\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time of the action."\n          }\n        }\n      },\n      "AdminAuditLog": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "actor_id",\n          "action",\n          "target_type",\n          "target_id",\n          "permission",\n          "ip",\n          "at",\n          "before",\n          "after"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/AdminAuditLogId"\n          },\n          "actor_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "actor_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current username of the account that acted; null when it cannot be read.",\n            "maxLength": 64\n          },\n          "action": {\n            "type": "string",\n            "description": "Action key as the writing module recorded it.",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "target_type": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object type derived from the record (free text); null when it cannot be derived.",\n            "maxLength": 64\n          },\n          "target_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Object id derived from the record; null when it cannot be derived.",\n            "maxLength": 128\n          },\n          "permission": {\n            "description": "Permission point derived from the action; null when it cannot be derived.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminPermissionKey"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "ip": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Client IP of the request (IPv4 or IPv6); null when not recorded.",\n            "maxLength": 45\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time of the action."\n          },\n          "before": {\n            "$ref": "#/components/schemas/AdminAuditValue"\n          },\n          "after": {\n            "$ref": "#/components/schemas/AdminAuditValue"\n          }\n        }\n      },\n      "AdminAuditLogPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminAuditLogListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminAuditLogPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAuditLogPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAuditLogResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAuditLog"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminExportId": {\n        "type": "string",\n        "description": "Opaque identifier of an export task (04 §5, ids are strings). It is not the database\\nprimary key (ADR-0001: internal auto-increment keys are never exposed); clients must not\\nparse it, compare it for order or derive anything from it. Generated by the server and\\nstable for the life of the task, retries included; how it is generated is up to the\\nimplementation.\\n",\n        "minLength": 16,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z0-9_-]{16,64}$"\n      },\n      "AdminExportStatus": {\n        "type": "string",\n        "description": "Status of an export task (enum export_status; BR-ID-34 细则「后台导出任务」; names from\\nBR-TEXT-25 admin_dict.export_status). pending → running → done or failed; done → expired\\n24 hours after the file was generated; pending or running → cancelled when the creator\'s\\naccount is disabled; failed → pending by a retry.\\n",\n        "enum": [\n          "pending",\n          "running",\n          "done",\n          "failed",\n          "expired",\n          "cancelled"\n        ]\n      },\n      "AdminExportResource": {\n        "type": "string",\n        "description": "Source list of an export task (enum export_resource): users = GET /admin/v1/users\\n(needs user.list), audit_logs = GET /admin/v1/audit-logs (signed in is enough; own\\nrecords only without audit.view_all).\\n",\n        "enum": [\n          "users",\n          "audit_logs"\n        ]\n      },\n      "AdminExportUserFilters": {\n        "type": "object",\n        "description": "Filters of a users export, the query parameters of GET /admin/v1/users without paging.",\n        "additionalProperties": false,\n        "properties": {\n          "risk_state": {\n            "$ref": "#/components/schemas/AdminUserRiskStateCode"\n          }\n        }\n      },\n      "AdminExportAuditLogFilters": {\n        "type": "object",\n        "description": "Filters of an audit_logs export, the query parameters of GET /admin/v1/audit-logs without\\npaging, judged the same way (without audit.view_all actor_id is forced to the creator).\\n",\n        "additionalProperties": false,\n        "properties": {\n          "actor_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "target_type": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "target_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "permission": {\n            "$ref": "#/components/schemas/AdminPermissionKey"\n          },\n          "from": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Earliest record time, inclusive."\n          },\n          "to": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Latest record time, exclusive."\n          }\n        }\n      },\n      "AdminExportCreateUsersRequest": {\n        "type": "object",\n        "description": "Export of the users list. unmasked true asks for the full phone numbers (pii.reveal_phone,\\ntotp step-up and reason required); reason is only accepted together with unmasked true.\\n",\n        "additionalProperties": false,\n        "required": [\n          "resource",\n          "filters"\n        ],\n        "properties": {\n          "resource": {\n            "type": "string",\n            "enum": [\n              "users"\n            ]\n          },\n          "filters": {\n            "$ref": "#/components/schemas/AdminExportUserFilters"\n          },\n          "unmasked": {\n            "type": "boolean",\n            "default": false,\n            "description": "true = full values instead of the masked ones; absent or false = masked."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminExportCreateAuditLogsRequest": {\n        "type": "object",\n        "description": "Export of the audit log; always masked (audit values are stored masked), no reason.",\n        "additionalProperties": false,\n        "required": [\n          "resource",\n          "filters"\n        ],\n        "properties": {\n          "resource": {\n            "type": "string",\n            "enum": [\n              "audit_logs"\n            ]\n          },\n          "filters": {\n            "$ref": "#/components/schemas/AdminExportAuditLogFilters"\n          }\n        }\n      },\n      "AdminExportCreateRequest": {\n        "description": "One branch per source list (enum export_resource), told apart by `resource`; `filters`\\nfollows that list\'s query parameters.\\n",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/AdminExportCreateUsersRequest"\n          },\n          {\n            "$ref": "#/components/schemas/AdminExportCreateAuditLogsRequest"\n          }\n        ]\n      },\n      "AdminExportRetryRequest": {\n        "type": "object",\n        "description": "Empty for a masked task. For an unmasked task (masked false) reason is required, with a\\nnew totp-tier X-Step-Up-Token; for a masked task reason is 20001.\\n",\n        "additionalProperties": false,\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminExport": {\n        "type": "object",\n        "description": "An export task (04 §6.6 exports; design/specs/admin-ledger.md 导出记录). Fields that only\\napply to some statuses are null otherwise.\\n",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "resource",\n          "filters_summary",\n          "masked",\n          "created_by",\n          "created_at",\n          "status",\n          "progress",\n          "failure_reason",\n          "file_name",\n          "row_count",\n          "expires_at"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/AdminExportId"\n          },\n          "resource": {\n            "$ref": "#/components/schemas/AdminExportResource"\n          },\n          "filters_summary": {\n            "type": "string",\n            "description": "Readable summary of the filters, written by the server (Chinese, for display only).",\n            "maxLength": 500\n          },\n          "masked": {\n            "type": "boolean",\n            "description": "true = the file holds masked values (the default); false = full values (pii step-up at creation)."\n          },\n          "created_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "created_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current username of the creator; null when it cannot be read.",\n            "maxLength": 64\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time the task was created."\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminExportStatus"\n          },\n          "progress": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "maximum": 100,\n            "description": "Percentage generated while running; null in every other status."\n          },\n          "failure_reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Short reason written by the server when failed (such as the row limit); null otherwise."\n          },\n          "file_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 128,\n            "description": "Name of the CSV file when done or expired; null otherwise."\n          },\n          "row_count": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "description": "Data rows in the file when done or expired; null otherwise."\n          },\n          "expires_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of the download period (24 hours after the file was generated, BR-ID-30 ⑨) when\\ndone or expired; null otherwise.\\n"\n          }\n        }\n      },\n      "AdminExportResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminExport"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminExportPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminExport"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminExportPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminExportPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminExportDownload": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "url",\n          "url_expires_at"\n        ],\n        "properties": {\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048,\n            "description": "Signed link to the CSV file in the private bucket; valid until url_expires_at."\n          },\n          "url_expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "min(5 minutes after signing, the task\'s expires_at)."\n          }\n        }\n      },\n      "AdminExportDownloadResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminExportDownload"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUserListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminUserPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserRiskState": {\n        "type": "object",\n        "description": "The user\'s user_risk_state row as the console sees it (no rule details). A user without a\\nrow reads as state normal, nulls and row_version null; a row always has an integer\\nrow_version (0 for a first row).\\n",\n        "additionalProperties": false,\n        "required": [\n          "state",\n          "reason_category",\n          "reason",\n          "frozen_until",\n          "changed_by",\n          "changed_at",\n          "row_version"\n        ],\n        "properties": {\n          "state": {\n            "$ref": "#/components/schemas/AdminUserRiskStateCode"\n          },\n          "reason_category": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminRiskReasonCategory"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Internal reason of the last change (console only, never shown to the user)."\n          },\n          "frozen_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of a freeze; null for a freeze without end and for every other state."\n          },\n          "changed_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Admin username or `system` of the last change; null when there is no row."\n          },\n          "changed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "row_version": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "null when the user has no risk-state row yet."\n          }\n        }\n      },\n      "AdminUserRiskStateResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserRiskState"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserUnionBinding": {\n        "type": "object",\n        "description": "A union binding row of the user (union_bindings; BR-ID-19, BR-ID-20), without relation_id or\\nother union identifiers.\\n",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "status",\n          "blocked_reason",\n          "bound_at",\n          "released_at",\n          "cooldown_until",\n          "reason",\n          "row_version"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminUnionBindingStatus"\n          },\n          "blocked_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminUnionBindingBlockedReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Set when status is blocked, null otherwise."\n          },\n          "bound_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "released_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "cooldown_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of the cooldown after a release (BR-ID-19); null unless released."\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Reason of the last console change (reset, disable, enable); null when none."\n          },\n          "row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          }\n        }\n      },\n      "AdminUserUnionBindingResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserUnionBinding"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserDetail": {\n        "type": "object",\n        "description": "A user as the console sees it (04 §11.1): non-sensitive fields, the masked phone number,\\nthe risk state and the union bindings. No identity number, payout account or real name.\\n",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "nickname",\n          "phone_masked",\n          "invite_code",\n          "inviter_user_id",\n          "level",\n          "register_method",\n          "registered_channel",\n          "created_at",\n          "risk",\n          "union_bindings"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nickname": {\n            "type": "string"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          },\n          "invite_code": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32\n          },\n          "inviter_user_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "user_id of the current inviter (users.parent_id); null when none is bound."\n          },\n          "level": {\n            "$ref": "#/components/schemas/AdminUserLevel"\n          },\n          "register_method": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "How the account was created (users.register_method), as stored."\n          },\n          "registered_channel": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Install channel at registration (users.registered_channel), as stored."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Registration time."\n          },\n          "risk": {\n            "$ref": "#/components/schemas/AdminUserRiskState"\n          },\n          "union_bindings": {\n            "type": "array",\n            "description": "One entry per platform the user has a binding row on.",\n            "items": {\n              "$ref": "#/components/schemas/AdminUserUnionBinding"\n            }\n          }\n        }\n      },\n      "AdminUserDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminClaimEvidenceLevel": {\n        "type": "string",\n        "description": "Evidence level of a claim or of one child order (contracts/enums/order.yaml claim_evidence_level; BR-ATTR-18).",\n        "enum": [\n          "strong",\n          "weak",\n          "none"\n        ]\n      },\n      "AdminClaimMatchField": {\n        "type": "string",\n        "description": "Field compared between what the user submitted and what the union reported (enum admin_claim_match_field).",\n        "enum": [\n          "order_no",\n          "paid_date"\n        ]\n      },\n      "AdminClaimEvidenceScene": {\n        "type": "string",\n        "description": "Scene of a link record counted as evidence (contracts/enums/trade.yaml scene).",\n        "enum": [\n          "search",\n          "detail",\n          "home_card",\n          "feed",\n          "clipboard",\n          "agent",\n          "share",\n          "h5",\n          "push",\n          "taolijin",\n          "watch_alert",\n          "share_ext",\n          "wechat_bot",\n          "mcp"\n        ]\n      },\n      "AdminClaimApplicant": {\n        "type": "object",\n        "description": "The applicant of a claim as the console shows it; the phone number only masked (BR-ID-33).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "phone_masked"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          }\n        }\n      },\n      "AdminClaimListItem": {\n        "type": "object",\n        "description": "A claim row of the review list (04 §3.2 claims). Not the user-side OrderClaim. The display\\nnumber of a claim is its claim_id (展示编号即 claim_id); there is no separate claim number.\\n",\n        "additionalProperties": false,\n        "required": [\n          "claim_id",\n          "order_no",\n          "platform",\n          "user",\n          "paid_date",\n          "submitted_at",\n          "evidence_level",\n          "status"\n        ],\n        "properties": {\n          "claim_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The order number as the user submitted it, spaces removed."\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminClaimApplicant"\n          },\n          "paid_date": {\n            "type": "string",\n            "format": "date",\n            "description": "Payment date as the user submitted it, YYYY-MM-DD in +08:00."\n          },\n          "submitted_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the claim was submitted."\n          },\n          "evidence_level": {\n            "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n          },\n          "status": {\n            "$ref": "#/components/schemas/ClaimStatus"\n          }\n        }\n      },\n      "AdminClaimStatusCounts": {\n        "type": "object",\n        "description": "Number of claims per claim_status value, counted with every filter of the request except\\nstatus (0 included).\\n",\n        "additionalProperties": false,\n        "required": [\n          "submitted",\n          "auto_matched",\n          "manual_review",\n          "approved",\n          "rejected",\n          "cancelled"\n        ],\n        "properties": {\n          "submitted": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "auto_matched": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "manual_review": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "approved": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "rejected": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "cancelled": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminClaimPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total",\n          "counts"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "counts": {\n            "$ref": "#/components/schemas/AdminClaimStatusCounts"\n          }\n        }\n      },\n      "AdminClaimPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminClaimPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminClaimMatch": {\n        "type": "object",\n        "description": "One field of the evidence view, the user\'s value against the union\'s.",\n        "additionalProperties": false,\n        "required": [\n          "field",\n          "user_value",\n          "union_value",\n          "matched"\n        ],\n        "properties": {\n          "field": {\n            "$ref": "#/components/schemas/AdminClaimMatchField"\n          },\n          "user_value": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "What the user submitted, in the contract\'s format (a date as YYYY-MM-DD)."\n          },\n          "union_value": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "What the union reported for this child order, same format; null when the union gave none."\n          },\n          "matched": {\n            "type": "boolean",\n            "description": "The server\'s verdict whether the two agree (for order_no after the same normalisation as BR-ATTR-17)."\n          }\n        }\n      },\n      "AdminClaimEvidenceLink": {\n        "type": "object",\n        "description": "A link record counted as evidence; its time and scene only, no product, shop, promotion or raw union data.",\n        "additionalProperties": false,\n        "required": [\n          "at",\n          "scene"\n        ],\n        "properties": {\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "scene": {\n            "$ref": "#/components/schemas/AdminClaimEvidenceScene"\n          }\n        }\n      },\n      "AdminClaimItem": {\n        "type": "object",\n        "description": "One child order of a claim (04 §3.2 claim_items). Not the user-side OrderClaimItem.",\n        "additionalProperties": false,\n        "required": [\n          "item_id",\n          "sub_order_id",\n          "evidence",\n          "decision",\n          "reject_reason",\n          "decided_at",\n          "decided_by",\n          "decided_by_name",\n          "row_version",\n          "matches",\n          "evidence_links"\n        ],\n        "properties": {\n          "item_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "sub_order_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The child order number."\n          },\n          "evidence": {\n            "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n          },\n          "decision": {\n            "description": "null while pending.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ClaimItemDecision"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reject_reason": {\n            "description": "Set with a rejection only, else null.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ClaimRejectReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "decided_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the decision was made; null while pending."\n          },\n          "decided_by": {\n            "description": "admin_id of the reviewer; null while pending or when the system decided.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "decided_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The reviewer\'s display name (admin_users.display_name, else the username); null when decided_by is null or the account is gone."\n          },\n          "row_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "CAS value; the expected_row_version of the approve and reject operations."\n          },\n          "matches": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimMatch"\n            }\n          },\n          "evidence_links": {\n            "type": "array",\n            "description": "Newest first; empty for evidence none.",\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimEvidenceLink"\n            }\n          }\n        }\n      },\n      "AdminClaimDetail": {\n        "type": "object",\n        "description": "A claim as the review page sees it: the list row\'s fields plus the latest note and the\\nchild orders. The display number is the claim_id. Not the user-side OrderClaim.\\n",\n        "additionalProperties": false,\n        "required": [\n          "claim_id",\n          "order_no",\n          "platform",\n          "user",\n          "paid_date",\n          "submitted_at",\n          "evidence_level",\n          "status",\n          "reason",\n          "items"\n        ],\n        "properties": {\n          "claim_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The order number as the user submitted it, spaces removed."\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminClaimApplicant"\n          },\n          "paid_date": {\n            "type": "string",\n            "format": "date"\n          },\n          "submitted_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "evidence_level": {\n            "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n          },\n          "status": {\n            "$ref": "#/components/schemas/ClaimStatus"\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Note of the latest approval or rejection (claims.reason); null before any."\n          },\n          "items": {\n            "type": "array",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimItem"\n            }\n          }\n        }\n      },\n      "AdminClaimDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminClaimDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminClaimReviewReason": {\n        "type": "string",\n        "minLength": 5,\n        "maxLength": 200,\n        "description": "The review note, required for approval and rejection (BR-ATTR-20: at least 5\\ncharacters); at least 5 characters also after trimming surrounding whitespace, stored\\ntrimmed in claims.reason and the audit log.\\n"\n      },\n      "AdminClaimStaffRejectReason": {\n        "type": "string",\n        "description": "The reject reasons a reviewer may choose (enum claim_reject_reason, its first six codes;\\nBR-ATTR-18). NOT_IN_POOL and ORDER_INVALID are set by the system only.\\n",\n        "enum": [\n          "NO_EVIDENCE",\n          "EXPIRED_CLICK",\n          "NOT_TRACKED",\n          "OTHER_TLJ",\n          "FRAUD",\n          "OTHER"\n        ]\n      },\n      "AdminApproveClaimItemRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version",\n          "reason"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              }\n            ],\n            "description": "The child order\'s row_version as the console showed it; a mismatch is 20902 (claim_item)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminClaimReviewReason"\n          }\n        }\n      },\n      "AdminRejectClaimItemRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version",\n          "reason",\n          "reject_reason"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              }\n            ],\n            "description": "The child order\'s row_version as the console showed it; a mismatch is 20902 (claim_item)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminClaimReviewReason"\n          },\n          "reject_reason": {\n            "$ref": "#/components/schemas/AdminClaimStaffRejectReason"\n          }\n        }\n      },\n      "AdminSearchHitType": {\n        "type": "string",\n        "description": "Type of a search hit (enum admin_search_hit_type); each is returned only to accounts holding\\nits permission point: order order.view, user user.lookup, withdrawal fund.view.\\n",\n        "enum": [\n          "order",\n          "user",\n          "withdrawal"\n        ]\n      },\n      "AdminSearchItem": {\n        "type": "object",\n        "description": "One hit of the top-bar search.",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "id",\n          "summary"\n        ],\n        "properties": {\n          "type": {\n            "$ref": "#/components/schemas/AdminSearchHitType"\n          },\n          "id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "summary": {\n            "type": "string",\n            "description": "Masked one-line summary for the candidate list (phone masked 3 + 4, BR-ID-33); never a\\nfull phone, identity or payout account number. Display only, not parsed by clients.\\n",\n            "minLength": 1,\n            "maxLength": 200\n          }\n        }\n      },\n      "AdminSearch": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "truncated"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Hits the account may see, at most 10; an order or withdrawal is followed by its owner.",\n            "maxItems": 10,\n            "items": {\n              "$ref": "#/components/schemas/AdminSearchItem"\n            }\n          },\n          "truncated": {\n            "type": "boolean",\n            "description": "True when there were more than 10 hits and only the first 10 are returned."\n          }\n        }\n      },\n      "AdminSearchResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSearch"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserRevealField": {\n        "type": "string",\n        "description": "The sensitive field to show in full. Only phone (permission point pii.reveal_phone) for\\nnow; the identity number and payout account (pii.reveal_identity) come later.\\n",\n        "enum": [\n          "phone"\n        ]\n      },\n      "AdminUserRevealRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "field",\n          "reason"\n        ],\n        "properties": {\n          "field": {\n            "$ref": "#/components/schemas/AdminUserRevealField"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminUserReveal": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "field",\n          "value"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "field": {\n            "$ref": "#/components/schemas/AdminUserRevealField"\n          },\n          "value": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The full value (for phone, the normalised 11-digit number)."\n          }\n        }\n      },\n      "AdminUserRevealResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserReveal"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserRiskStateAction": {\n        "type": "string",\n        "description": "ban and unban (permission point risk.ban), freeze and unfreeze (risk.freeze); 04 §11.2,\\nBR-ID-31, BR-ID-36.\\n",\n        "enum": [\n          "ban",\n          "unban",\n          "freeze",\n          "unfreeze"\n        ]\n      },\n      "AdminUserRiskStateUpdateRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "reason",\n          "expected_row_version"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/AdminUserRiskStateAction"\n          },\n          "reason_category": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRiskReasonCategory"\n              }\n            ],\n            "description": "Required for ban and freeze; not accepted for unban and unfreeze (20001)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          },\n          "frozen_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Only for freeze: end of the freeze, later than the server\'s current time; null or\\nabsent = without end (BR-ID-36). Given with another action → 20001.\\n"\n          },\n          "expected_row_version": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "risk.row_version as the console showed it; null = no row seen, only accepted while the\\nuser still has no row. Any mismatch (null against an existing row, an integer against\\nno row or another version) is 20902.\\n"\n          }\n        }\n      },\n      "AdminUserUnionBindingActionRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "reason",\n          "expected_row_version"\n        ],\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          },\n          "expected_row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              }\n            ],\n            "description": "The binding\'s row_version as the console showed it; a mismatch is 20902."\n          }\n        }\n      },\n      "AgentSession": {\n        "type": "object",\n        "description": "An Agent conversation (agent_sessions; owner and expiry per BR-AI-20).",\n        "additionalProperties": false,\n        "required": [\n          "session_id",\n          "started_at",\n          "last_active_at"\n        ],\n        "properties": {\n          "session_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "started_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "last_active_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time of the last accepted message; expiry counts from it (BR-AI-20)."\n          }\n        }\n      },\n      "AgentSessionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgentSession"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AgentCurrentSessionData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "session"\n        ],\n        "properties": {\n          "session": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AgentSession"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AgentCurrentSessionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgentCurrentSessionData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AgentMessageRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "client_msg_id",\n          "text"\n        ],\n        "properties": {\n          "client_msg_id": {\n            "type": "string",\n            "description": "Generated by the client, unique in the session; a repeat returns the original run (BR-AI-23 ⑥).",\n            "minLength": 8,\n            "maxLength": 64,\n            "pattern": "^[A-Za-z0-9_-]+$"\n          },\n          "text": {\n            "type": "string",\n            "minLength": 1,\n            "description": "The message. Its length limit is step ⑤ of BR-AI-23 (20001, data.fields=[text]), checked\\nafter ①–④, so the schema sets no maxLength.\\n"\n          },\n          "context": {\n            "$ref": "#/components/schemas/AgentMessageContext"\n          }\n        }\n      },\n      "AgentMessageContext": {\n        "description": "Entry context of 01 §4 情境入口, exactly one of product_key, order_id or text.",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/AgentContextProduct"\n          },\n          {\n            "$ref": "#/components/schemas/AgentContextOrder"\n          },\n          {\n            "$ref": "#/components/schemas/AgentContextText"\n          }\n        ]\n      },\n      "AgentContextProduct": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "product_key"\n        ],\n        "properties": {\n          "product_key": {\n            "$ref": "#/components/schemas/ProductKey"\n          }\n        }\n      },\n      "AgentContextOrder": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "order_id"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          }\n        }\n      },\n      "AgentContextText": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "text"\n        ],\n        "properties": {\n          "text": {\n            "type": "string",\n            "description": "Clipboard text, untrusted (BR-AI-05).",\n            "minLength": 1,\n            "maxLength": 2000\n          }\n        }\n      },\n      "AgentFinishReason": {\n        "type": "string",\n        "description": "finish_reason of the done frame (contracts/enums agent_finish_reason, 04 §8.2).",\n        "enum": [\n          "stop",\n          "cancelled",\n          "limit",\n          "budget",\n          "error",\n          "auth_required",\n          "safety",\n          "fallback",\n          "timeout"\n        ]\n      },\n      "AgentHistoryCard": {\n        "type": "object",\n        "description": "A card frame as it was sent, without seq (04 §6.5). data follows\\ncontracts/agent-stream.schema.json card_<type> (earnings_summary: earnings_summary_history\\nonly); an unknown type is shown as fallback_text (03 §7.4).\\n",\n        "additionalProperties": false,\n        "required": [\n          "card_id",\n          "type",\n          "schema_version",\n          "data",\n          "fallback_text"\n        ],\n        "properties": {\n          "card_id": {\n            "type": "string",\n            "description": "Card id inside the session (c1, c2…, BR-AI-05).",\n            "pattern": "^c[1-9][0-9]*$"\n          },\n          "type": {\n            "type": "string",\n            "description": "Card type (contracts/enums agent_card_type); a newer type stays valid for an older client.",\n            "minLength": 1\n          },\n          "schema_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "data": {\n            "type": "object",\n            "description": "Shape per type in contracts/agent-stream.schema.json (contracts/README.md 书写规则第 12 条).",\n            "additionalProperties": true\n          },\n          "fallback_text": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "AgentHistoryMessage": {\n        "type": "object",\n        "description": "One agent_messages row (04 §6.5 会话历史响应的形状).",\n        "additionalProperties": false,\n        "required": [\n          "message_id",\n          "role",\n          "created_at",\n          "text",\n          "cards",\n          "finish_reason"\n        ],\n        "properties": {\n          "message_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "role": {\n            "type": "string",\n            "description": "agent_messages.role (04 §3.2).",\n            "enum": [\n              "user",\n              "assistant"\n            ]\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "text": {\n            "type": "string",\n            "description": "user, the text as sent; assistant, the text after OutputGuard (\'\' while nothing has been written)."\n          },\n          "cards": {\n            "type": "array",\n            "description": "Always empty for user.",\n            "items": {\n              "$ref": "#/components/schemas/AgentHistoryCard"\n            }\n          },\n          "finish_reason": {\n            "description": "assistant once the run has ended; null for user and for a run still going.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AgentFinishReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AgentHistoryData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor",\n          "expired"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Oldest first within the page.",\n            "items": {\n              "$ref": "#/components/schemas/AgentHistoryMessage"\n            }\n          },\n          "next_cursor": {\n            "description": "Cursor of the earlier page; null when there are no earlier messages.",\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "expired": {\n            "type": "boolean",\n            "description": "true when the session has expired; the history is then read-only (BR-AI-20)."\n          }\n        }\n      },\n      "AgentHistoryResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgentHistoryData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AgentFeedbackRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "feedback"\n        ],\n        "properties": {\n          "feedback": {\n            "type": "string",\n            "description": "agent_messages.feedback (04 §3.2); down marks a badcase (BR-AI-19).",\n            "enum": [\n              "up",\n              "down"\n            ]\n          }\n        }\n      },\n      "AgentReportRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "reason"\n        ],\n        "properties": {\n          "reason": {\n            "type": "string",\n            "description": "Free text kept in agent_messages.report_reason; 08 has no reason set yet, so no enum.",\n            "minLength": 1,\n            "maxLength": 200\n          }\n        }\n      }\n    }\n  }\n}\n');
  map.set('contracts/routes.json', '{\n  "$comment": "Route table (CT-03): route name → native page or H5 path (规划/01 §4.2, 03 §4.4). Every jump is {route, params} (拍板第二批 TECH-04); external links use {route: ExternalPage, params: {url}}. since is per platform (拍板第二批 TECH-07): null = not shipped on that platform yet; an unknown route or a since above the app version opens the upgrade page. h5_path is relative to config.h5_base_url. InvitedFriends and LevelUpgrade are P1 with since null (the bridge answers unsupported); CustomPage, MyWatches and WatchLanding are added when they ship. debug_only routes open only in debug / staging builds (TECH-11). entry lists where a route may be opened from (route_entry: in_app, push, deeplink; values only from 规划/08 BR-ID-10 细则「路由入口矩阵」; InvitedFriends and LevelUpgrade are not in the matrix and are in_app only, orchestrator decision D-13). push means a route the server returned for a message id; any route carried directly in launch parameters is checked as deeplink. agent_guide (boolean, default false; 规划/04 §10, D31): true only on the candidate routes of 规划/08 BR-AI-01 细则「页面引导」 (Wallet, WithdrawRecords, AuthManage, OrderList, InviteShare, Messages); an Agent page_guide card and the two earnings_summary buttons may open only these, and entry stays as in BR-ID-10. agent_guide_account (phone | delete | fund) marks the account-security routes the Agent never guides to and answers with an agent.guide.account.* text instead (BR-TEXT-22); such routes are never agent_guide.",\n  "version": 1,\n  "routes": {\n    "Launch": {\n      "page": "启动与隐私首启弹窗",\n      "kind": "native",\n      "auth": "none",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "phase": "M-内测",\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {},\n        "required": []\n      },\n      "entry": [\n        "in_app"\n      ]\n    },\n    "BasicMode": {\n      "page": "基本模式",\n      "kind": "native",\n      "auth": "none",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "phase": "M-内测",\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {},\n        "required": []\n      },\n      "entry": [\n        "in_app"\n      ]\n    },\n    "Login": {\n      "page": "登录",\n      "kind": "native",\n      "auth": "none",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "phase": "M-内测",\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {},\n        "required": []\n      },\n      "entry": [\n        "in_app"\n      ]\n    },\n    "BindPhone": {\n      "page": "绑定手机号",\n      "kind": "native",\n      "auth": "login",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "phase": "M-内测",\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {},\n        "required": []\n      },\n      "entry": [\n        "in_app"\n      ],\n      "agent_guide_account": "phone"\n    },\n    "Home": {\n      "page": "首页",\n      "kind": "native",\n      "auth": "none",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "phase": "M-内测",\n      "params": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {},\n        "required": []\n      },\n      "entry": [\n        "in_app",\n        "push",\n        "deeplink"\n      ]\n    },\n    "Search": {\n      "page": "搜索与结果",\n      "kind": "native",\n      "auth": "none",\n      "since": {\n        "ios": "1.0.0",\n        "android": "1.0.0",\n        "harmony": "1.0.0"\n      },\n      "phase": "M-内测",\n      "params": {\n     