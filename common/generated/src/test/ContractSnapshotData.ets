       }\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "UnionBindingsData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/UnionBindingState"\n            }\n          }\n        }\n      },\n      "UnionBindingsResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/UnionBindingsData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "UnionAuthUrlData": {\n        "type": "object",\n        "description": "Exactly one of auth_methods (Taobao, ordered) and auth_jump (Pinduoduo); the oneOf branches\\ndeclare the property they require (strict Ajv2020).\\n",\n        "additionalProperties": false,\n        "required": [\n          "auth_url",\n          "state"\n        ],\n        "properties": {\n          "auth_url": {\n            "type": "string",\n            "format": "uri"\n          },\n          "state": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "auth_methods": {\n            "type": "array",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AuthMethod"\n            }\n          },\n          "auth_jump": {\n            "$ref": "#/components/schemas/AuthJumpPlan"\n    