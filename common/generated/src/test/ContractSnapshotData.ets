mponents/schemas/LoginData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "RefreshTokenRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "refresh_token"\n        ],\n        "properties": {\n          "refresh_token": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "TokenPairResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/TokenPair"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "MeBalance": {\n        "type": "object",\n        "description": "Summary of the single balance (拍板第二批 §8 ADD-06); meanings per BR-FUND-18.",\n        "additionalProperties": false,\n        "required": [\n          "available_fen",\n          "withdrawable_fen",\n          "estimated_total_fen"\n        ],\n        "properties": {\n          "available_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "withdrawable_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "estimated_total_fen": {\n            "$ref": "#/components/schemas/Fen"\n          }\n        }\n      },\n      "UnionBindingState": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "status"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n    