#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/pages/{page_key}/preview": {\n      "get": {\n        "operationId": "previewPage",\n        "tags": [\n          "content"\n        ],\n        "summary": "Draft page preview (test builds only)",\n        "description": "Read-only preview of a draft, allowed only by an admin-issued preview token (10 minutes)\\nand never by a user token. The token is valid only in the environment that issued it;\\ninvalid, expired or issued elsewhere → 30701. Only the HomePreview route of test builds\\ncalls it; release builds have no route or code for it (03 §3.6). The QR code carries only\\ntoken and page_key, no host name. sections follow contracts/home-schema.json.\\n",\n        "x-auth": "none",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [\n          30701\n        ],\n        "security": [],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "name": "page_key",\n            "in": "path",\n            "required": true,\n            "schema": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 64\n            }\n          },\n          {\n            "name": "token",\n            "in": "query",\n            "required": true,\n            "schema": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 256\n            }\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The draft page.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/PagePreviewResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "page_key": "home",\n                    "version": 7,\n                    "sections": []\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/pages/{page_key}/sections/{section_id}/items": {\n      "get": {\n        "operationId": "listPageSectionItems",\n        "tags": [\n          "content"\n        ],\n        "summary": "One page of a section\'s product data source (union_material, product_pool)",\n        "description": "Paged items of a section whose cards are fetched by the card itself (04 §6 卡片数据源分页;\\n03 §6.2 item 3; BR-TEXT-17 细则「联盟物料频道」). This version covers the `union_material`\\nand `product_pool` data sources and the fall-back to the product pool on a union failure\\n(02 §14). The rules below are 编排者默认 (D10-452).\\n\\nWhich version is read: the same rule as getPage. With X-Device-Id the device is bucketed\\nand gets the gray version when its bucket is in range; without it (basic mode) it gets the\\nfully released version. Drafts are never read. The section\'s min_app_version is compared with X-Platform\\nand X-App-Version as in getPage, and a section filtered out by it counts as not being in\\nthe version. `condition` is not evaluated: the caller got the section from getPage, which\\nhas evaluated it. `x-auth` is optional although 04 §6 lists none: cards are computed for\\nthe current user and links are registered per user (BR-PRICE-11, BR-PRICE-12; 08 wins over\\n04, as searchProducts).\\n\\n30701: the page_key does not exist, it has no published version, that version has no such\\nsection, or the section\'s data source kind is neither `union_material` nor `product_pool`.\\n20001: `cursor` is invalid or does not belong to this page and section, with\\ndata.fields=[cursor]; a page_key or section_id of the wrong shape gives data.fields=[page_key]\\nor [section_id].\\n\\nFetching `union_material`: before every fetch the server checks every channel of the data\\nsource against specs/material-channels.yaml. If any channel is missing or no longer selectable the data\\nsource is not fetched at all, the block counts as having no data and an alert is raised\\n(BR-TEXT-17 细则「取数时再查一次」). Several channels are always interleaved in the order of\\n`channels`, with or without `mix`; the order inside a channel is kept and no commission or\\nrebate weight is added. Items in a blocked category, with an abnormal price or with\\nrebate_basis=no_rebate are not sent (BR-PRICE-08). When filtering leaves fewer than a page,\\nat most one more round of upstream pages is fetched per request to top it up, and what is\\nleft is returned as it is. `has_more` is true while any channel still reports more or\\none channel failed while another answered, and `cursor` records each channel\'s upstream\\npage, never a filtered offset (BR-PRICE-08); that failed channel keeps its page and is\\ntried again on the next request. `ad_label` is null on every card.\\n\\nA union failure of one channel only drops that channel from this page. Failure of every\\nchannel, no data from any channel and a refused data source all answer 200 with\\n`items: []`, `next_cursor: null` and `has_more: false`, never 50304. When a list ends with\\nno card shown at all, the client hides the card (03 §6.2). A later page ends the list only\\nwhen `next_cursor` is null and keeps the cards already shown; `items: []` with a cursor\\nmeans fetch on. Page size is the server constant 20 (no limit parameter, as getHotRank).\\n`cursor` is opaque: the client sends `next_cursor` back unchanged.\\n\\nUnion fall-back (02 §14): when every channel of a `union_material` first page (no\\n`cursor`) failed at the union, the server reads the pool named by config key\\n`feed.fallback_pool_id` (编排者默认) under the `product_pool` rules below, its `next_cursor`\\npages on through that pool, and every card has `stale=true` and `ad_label`「推广」. With the\\nkey unset, or that pool missing or disabled, the answer stays the empty list above. A later\\n`union_material` page, no data from any channel and a refused data source do not fall back.\\n\\nFetching `product_pool`: a `pool_id` that does not exist or is disabled answers 200 with the\\nempty list above, never 30701. The rows are the pool\'s items with status online and now\\nwithin `start_at`..`end_at`, `sort` ascending then product_key. Prices are the pool\'s\\nrefreshed values, `quoted_at` is the last successful refresh and `stale` is false outside the\\nfall-back (BR-PRICE-11); an item last refreshed more than 7200 seconds ago\\n(`pool.max_age_sec`) is not sent, and neither is one with rebate_basis=no_rebate\\n(BR-PRICE-08). One page reads at most the smaller of the data source\'s `limit` and the page\\nsize 20 rows, `cursor` records the row offset of that list, so a page shortened by the\\nno_rebate filter can be shorter than that or empty, and `has_more` is true while rows\\nremain. `ad_label` is「推广」on every card (BR-TEXT-17).\\n",\n        "x-auth": "optional",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-error-codes": [\n          20001,\n          30701\n        ],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/OptionalDeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/PageKeyPath"\n          },\n          {\n            "name": "section_id",\n            "in": "path",\n            "required": true,\n            "description": "Section id, the `id` of the section in contracts/home-schema.json.",\n            "schema": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 64,\n              "pattern": "^[A-Za-z0-9_-]+$"\n            }\n          },\n          {\n            "$ref": "#/components/parameters/Cursor"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "One page of the section\'s items; empty when there is nothing to show.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/PageSectionItemsResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                