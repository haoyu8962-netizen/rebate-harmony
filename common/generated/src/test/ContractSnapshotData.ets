"trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "No link (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "unknownTask": {\n                    "$ref": "#/components/examples/AdminUnknownExport"\n                  },\n                  "expired": {\n                    "$ref": "#/components/examples/AdminExportNotAllowed"\n                  },\n                  "noPermission": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/admin/v1/exports/{id}/retry": {\n      "post": {\n        "operationId": "adminRetryExport",\n        "tags": [\n          "admin-exports"\n        ],\n        "summary": "Retry one\'s own failed export task",\n        "description": "Permission point `export` (04 §11.1); lacking it is 10403 with\\n`data.reason=admin_permission_denied`. Only the creator of the task can retry it, even with\\n`audit.view_all`: another account\'s task, an unknown id or a task of another app is 20001\\nwith `data.fields=[id]` (no probing; BR-ID-34 细则「后台导出任务」).\\nOnly a failed task can be retried; any other status is 30417 with `data.status` (pending,\\nrunning, done, expired, cancelled; the same code as a download in the wrong status).\\nThe checks of creating are made again on the caller\'s current points: the permission of\\nthe source list (`users` → `user.list`) and, for an unmasked task (`masked=false`),\\n`pii.reveal_phone`, both 10403 when lacking. An unmasked task also needs a new totp-tier\\n`X-Step-Up-Token` (missing, expired or lower → 10003 with `data.tier=totp`) and a new\\n`reason` (1–200 characters; missing → 20001 with `data.fields=[reason]`): every\\ngeneration of a file with full values is verified anew. A masked task takes an empty body;\\n`reason` there is 20001 with `data.fields=[reason]` and no step-up token is checked.\\nThe task keeps its id, resource, filters and masked flag and goes back to pending\\n(`progress`, `failure_reason` cleared); the response is the task as it is now. Retrying\\nwrites an audit record (action export_retry: task id, resource, masked), and an unmasked\\ntask its own record with the new reason (action export_unmasked). No Idempotency-Key\\n(04 §6.6): a second call while the task is pending again is 30417.\\n",\n        "x-auth": "admin",\n        "x-implementation": "planned",\n        "x-error-codes": [\n          10001,\n          10003,\n          10403,\n          20001,\n          30417\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/AdminExportIdPath"\n          },\n          {\n            "$ref": "#/components/parameters/AdminStepUpToken"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AdminExportRetryRequest"\n              },\n              "examples": {\n                "masked": {\n                  "summary": "Retry a masked task",\n                  "value": {}\n                },\n                "unmasked": {\n                  "summary": "Retry an unmasked task (step-up and a new reason)",\n                  "value": {\n                    "reason": "上次生成失败，重新导出封禁账号的注册手机号"\n                  }\n                }\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The task, back in status pending.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminExportResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "id": "exp_Ra4Fz9Ux2Nh6Qc1B",\n                    "resource": "audit_logs",\n                    "filters_summary": "时间：2026-10-18 00:00 至 2026-10-19 00:00",\n                    "masked": true,\n                    "created_by": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5b02",\n                    "created_by_name": "ops02",\n                    "created_at": "2026-10-19T08:00:00+08:00",\n                    "status": "pending",\n                    "progress": null,\n                    "failure_reason": null,\n                    "file_name": null,\n                    "row_count": null,\n                    "expires_at": null\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "Not retried (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "unknownTask": {\n                    "$ref": "#/components/examples/AdminUnknownExport"\n                  },\n                  "notFailed": {\n                    "$ref": "#/components/examples/AdminExportNotAllowed"\n                  },\n                  "stepUpRequired": {\n                    "$ref": "#/components/examples/AdminStepUpRequiredTotp"\n                  },\n                  "reasonMissing": {\n                    "$ref": "#/components/examples/AdminExportReasonInvalid"\n                  },\n                  "noPermission": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/admin/v1/users": {\n      "get": {\n        "operationId": "adminListUsers",\n        "tags": [\n          "admin-users"\n        ],\n        "summary": "Browse and filter users (non-sensitive fields only)",\n        "description": "Permission point `user.list` (04 §11.1; read only, no step-up); without it the console can\\nonly look users up one by one through GET /admin/v1/users/lookup (`user.lookup`), and this\\nlist is 10403 with `data.reason=admin_permission_denied`. Users of the console\'s app, newest\\nregistration first, page by page (`page`, `page_size` ≤ 200), optionally filtered by\\n`risk_state`. Rows hold non-sensitive fields only: the phone number is masked 3 + 4\\n(`138****5678`, BR-ID-33) and the full number is only shown through POST\\n/admin/v1/users/{user_id}/reveal; no identity number, payout account, real name or raw\\nrisk reason. Balances, orders and withdrawals of a user are not part of this contract yet.\\n",\n        "x-auth": "admin",\n        "x-error-codes": [\n          10001,\n          10403,\n          20001\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/AdminPage"\n          },\n          {\n            "$ref": "#/components/parameters/AdminPageSize"\n          },\n          {\n            "$ref": "#/components/parameters/AdminUserRiskStateFilter"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "One page of users, newest registration first.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminUserPageResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "items": [\n                      {\n                        "user_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5c01",\n                        "nickname": "凑狸用户5678",\n                        "phone_masked": "138****5678",\n                        "level": "L1",\n                        "risk_state": "normal",\n                        "created_at": "2026-10-12T09:00:00+08:00"\n                      },\n                      {\n                        "user_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5c02",\n                    