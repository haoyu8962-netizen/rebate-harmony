 []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/AdminArticleIdPath"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AdminArticlePublishRequest"\n              },\n              "examples": {\n                "now": {\n                  "summary": "Publish version 3 now",\n                  "value": {\n                    "version": 3,\n                    "expected_row_version": 5\n                  }\n                },\n                "scheduled": {\n                  "summary": "Publish version 3 at a set time",\n                  "value": {\n                    "version": 3,\n                    "published_at": "2026-10-20T09:00:00+08:00",\n                    "expected_row_version": 5\n                  }\n                }\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The article after publishing.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminArticleResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "article_id": "00000000-0000-4000-8000-000000000001",\n                    "category": "help",\n                    "row_version": 6,\n                    "current_version": 3,\n                    "versions": [\n                      {\n                        "version": 3,\n                        "status": "publi