ionalProperties": false,\n        "required": [\n          "step_up_token",\n          "expire_at"\n        ],\n        "properties": {\n          "step_up_token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 2048\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "StepUpResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/StepUpData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "TokenPair": {\n        "type": "object",\n        "description": "Token pair of a login or a refresh. session_scope is the scp of the access token, decided\\nfrom this request (BR-ID-01 细则「受限会话」): deletion_only when the client is below the\\nminimum supported version.\\n",\n        "additionalProperties": false,\n        "required": [\n          "access_token",\n          "access_expires_at",\n          "refresh_token",\n          "refresh_expires_at",\n          "session_scope"\n        ],\n        "properties": {\n          "session_scope": {\n            "$ref": "#/components/schemas/SessionScope"\n          },\n          "access_token": {\n            "type": "string",\n            "minLength": 1\n          },\n          "access_expires_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "refresh_token": {\n            "type": "string",\n            "minLength": 1\n          },\n          "refresh_expires_at": {\n            "type": "string",\