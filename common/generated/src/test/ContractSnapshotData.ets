  map.set('specs/events.json', '{\n  "version": "2",\n  "common_fields": {\n    "event_id": {\n      "type": "string",\n      "required": true,\n      "note": "客户端生成，服务端按它去重"\n    },\n    "name": {\n      "type": "string",\n      "required": true\n    },\n    "client_at": {\n      "type": "string",\n      "required": true,\n      "note": "客户端时刻，ISO 8601 带时区"\n    },\n    "session_id": {\n      "type": "string",\n      "required": true\n    },\n    "device_id": {\n      "type": "string",\n      "required": true\n    },\n    "user_id": {\n      "type": "string",\n      "required": false,\n      "note": "游客为空"\n    },\n    "platform": {\n      "type": "enum",\n      "required": true,\n      "values": [\n        "ios",\n        "android",\n        "harmony",\n        "h5"\n      ],\n      "note": "客户端端别（contracts/enums/platform.yaml client_platform 的端侧取值）"\n    },\n    "app_version": {\n      "type": "string",\n      "required": true\n    },\n    "channel": {\n      "type": "string",\n      "required": false,\n      "note": "安装渠道（install_channel）；H5 为空"\n    },\n    "page": {\n      "type": "string",\n      "required": true\n    },\n    "spm": {\n      "type": "string",\n      "required": false,\n      "note": "页面.模块.坑位（03 §4.7）"\n    },\n    "trace_id": {\n      "type": "string",\n      "required": false\n    }\n  },\n  "events": {\n    "link_jump": {\n      "description": "外跳的每一步结果（BR-ATTR-27 ③；BR-ATTR-21 细则「待跟单卡按实际外跳选」）；另记百川初始化失败（BR-ATTR-27 淘宝行）",\n      "source": "规划/03 §4.5、§4.7；08 BR-ATTR-21、BR-ATTR-27",\n      "fields": {\n        "phase": {\n          "type": "enum",\n          "required": true,\n          "values": [\n            "purchase",\n            "startup"\n          ],\n          "note": "purchase 是一次购买外跳的某一步；startup 只用于同意隐私政策后、还没有购买时的百川初始化失败（result=sdk_init_failed），这时没有 link 与尝试"\n        },\n        "attempt_id": {\n          "type": "string",\n          "required_when": {\n            "phase": "purchase"\n          },\n          "note": "本次 open（或 H