f": "#/components/schemas/SearchProductsResponse"\n                },\n                "examples": {\n                  "ok": {\n                    "$ref": "#/components/examples/SearchProductsOk"\n                  }\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/products/{product_key}": {\n      "get": {\n        "operationId": "getProduct",\n        "tags": [\n          "trade"\n        ],\n        "summary": "Product detail",\n        "description": "Coupon, final price, estimated rebate and quote time of one product (BR-PRICE-05,\\nBR-PRICE-11), with a freshly registered `link_id` (BR-PRICE-12). On union failure the\\nserver may answer with the product-pool price and `stale=true` (拍板第二批 TRADE-12).\\nA response whose derived key differs from the requested one, or cannot be derived, is\\n30143 ref_expired (BR-PROD-03, BR-PROD-05). `item_ref` of the card the user tapped is\\npassed through unchanged (BR-PROD-11). x-auth optional for the same reason as search.\\n",\n        "x-auth": "optional",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-implementation": "planned",\n        "x-error-codes": [\n          30141,\n          30143\n        ],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n    