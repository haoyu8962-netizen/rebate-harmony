arameters/AdminArticleIdPath"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AdminArticleOfflineRequest"\n              },\n              "example": {\n                "expected_row_version": 6\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The article after going offline.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminArticleResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "article_id": "00000000-0000-4000-8000-000000000001",\n                    "category": "help",\n                    "row_version": 7,\n                    "current_version": null,\n                    "versions": [\n                      {\n                        "version": 3,\n                        "status": "offline",\n                        "title": "什么是比价订单",\n                        "body": "{\\"type\\":\\"doc\\",\\"content\\":[]}",\n                        "notice_closable": true,\n                        "notice_content_version": 1,\n                        "notice_end_at": null,\n                        "published_at": "2026-10-17T12:00:00+08:00",\n                        "created_at": "2026-10-17T10:00:00+08:00",\n                        "updated_at": "2026-10-17T13:00:00+08:00"\n                      }\n                    ]\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "Not taken offline (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "notPublished": {\n                    "$ref": "#/components/examples/AdminArticleNotPublished"\n                  },\n                  "categoryReadOnly": {\n                    "$ref": "#/components/examples/AdminArticleCategoryReadOnly"\n                  },\n                  "conflict": {\n                    "$ref": "#/components/examples/AdminArticleConflict"\n                  },\n                  "notFound": {\n                    "$ref": "#/components/examples/AdminArticleNotFound"\n                  },\n                  "noPermission": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/admin/v1/dict-items": {\n      "get": {\n        "operationId": "adminListDictItems",\n        "tags": [\n          "admin-content"\n        ],\n        "summary": "Dictionary keys with their bundled default and current text",\n        "description": "Permission point: any of `config.general`, `content.fund_terms` or `content.agreement`\\n(04 §11.2; read only, no step-up). One row per key of contracts/texts.default.json (the\\nkeys the dictionary may override, 编排者默认), in key order, page by page (`page`,\\n`page_size` ≤ 200), optionally narrowed by `class` and `key_prefix`: the key\'s class (which\\npermission point writes it, BR-TEXT-12 细则: `fund_terms` = a fund term key, `agreement`\\n= privacy and permission texts of table D (`privacy.`, `perm.`), `general` = every other\\nkey), the bundled default, the current override (null = the bundled default applies) and\\nthe version of the key\'s current row (null = never written). `dict_version` is the\\ndictionary\'s current version (\\"0\\" before the first publish), the `expected_version` of\\nthe writes.\\n",\n        "x-auth": "admin",\n        "x-implementation": "planned",\n        "x-error-codes": [\n          10001,\n          10403,\n          20001\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "name": "class",\n            "in": "query",\n            "required": false,\n            "description": "Only keys of this class.",\n            "schema": {\n              "$ref": "#/components/schemas/DictKeyClass"\n            }\n          },\n          {\n            "name": "key_prefix",\n            "in": "query",\n            "required": false,\n            "description": "Only keys starting with this text.",\n            "schema": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 128\n            }\n          },\n          {\n            "$ref": "#/components/parameters/AdminPage"\n          },\n          {\n            "$ref": "#/components/parameters/AdminPageSize"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "One page of dictionary keys.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminDictItemPageResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "items": [\n                      {\n                        "key": "order_status_group.credited",\n                        "class": "general",\n                        "default_text": "已结算",\n                        "text": "已到账",\n                        "version": 3\n                      },\n                      {\n                        "key": "order_status_group.estimating",\n                        "class": "general",\n                        "default_text": "预估中",\n                        "text": null,\n                        "version": null\n                      }\n                    ],\n                    "page": 1,\n                    "page_size": 20,\n                    "total": 2,\n                    "dict_version": "3"\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "Not available (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "pageSizeTooLarge": {\n                    "$ref": "#/components/examples/AdminPageSizeInvalid"\n                  },\n                  "noPermission": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      },\n      "put": {\n        "operationId": "adminSaveDictItems",\n        "tags": [\n          "admin-content"\n        ],\n        "summary": "Save and publish dictionary texts",\n        "description": "Saving publishes (no separate draft step, 编排者默认): the changed keys take effect as a new\\ndictionary version (BR-TEXT-12 细则). One request changes keys of one class only, and the\\nclass picks the permission point and step-up (04 §11.2, BR-ID-34): `general` →\\n`config.general`, no step-up; `fund_terms` → `content.fund_terms`, totp tier every time;\\n`agreement` → `content.agreement`, totp tier, and `legal_confirmed_by` is required. Keys\\nof more than one class → 20001 with `data.fields=[changes]`; lacking the class\'s point →\\n10403 with `data.reason=admin_permission_denied`; without a valid totp-tier\\n`X-Step-Up-Token` where needed → 10003 with `data.tier=totp`. A key the server cannot\\nclassify counts as a fund term key (BR-TEXT-12 细则). Every change is checked first, and\\nany failure is 20001 with nothing saved: a key not in contracts/texts.default.json, a key\\nlisted twice, or a text equal to the current one → `data.fields` names\\n`changes[<i>].key`; a text whose variables (`{name}` placeholders) differ from the\\nbundled default\'s, or that contains a forbidden word → `data.fields` names\\n`changes[<i>].text` followed by the forbidden words found; an `agreement` change without\\n`legal_confirmed_by` → `data.fields=[legal_confirmed_by]`. Only then is\\n`expected_version` compared with the current dictionary version, and a mismatch is 20902\\nwith `data.resource=dict_item` and nothing saved (04 §6.6). On success every changed key\\ngets a new row (text null = back to the bundled default) at the new version (current\\nplus 1), dict_version moves to it in the same transaction, and the audit log records\\nthe keys with before and after texts, whether they are fund terms and the legal\\nconfirmer. Clients see the change when their GET /v1/dict cache refreshes. No\\nIdempotency-Key (04 §6.6).\\n",\n        "x-auth": "admin",\n        "x-implementation": "planned",\n        "x-error-codes": [\n          10001,\n          10003,\n          10403,\n          20001,\n          20902\n        ],\n        "security": [\n          {\n            "adminBearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/AdminStepUpToken"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AdminDictSaveRequest"\n              },\n              "example": {\n                "changes": [\n                  {\n                    "key": "order_status_group.credited",\n                    "text": "已到账"\n                  },\n                  {\n                    "key": "order_status_group.estimating",\n                    "text": null\n                  }\n                ],\n                "expected_version": "2"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The new dictionary version and the keys written.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminDictSaveResultResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "version": "3",\n                    "keys": [\n                      "order_status_group.credited",\n                      "order_status_group.estimating"\n                    ]\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "description": "Nothing saved (codes in contracts/error-codes.yaml).",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ErrorEnvelope"\n                },\n                "examples": {\n                  "stepUpRequired": {\n                    "$ref": "#/components/examples/AdminStepUpRequiredTotp"\n                  },\n                  "mixedClasses": {\n                    "$ref": "#/components/examples/AdminDictMixedClasses"\n                  },\n                  "textInvalid": {\n                    "$ref": "#/components/examples/AdminDictTextInvalid"\n                  },\n                  "conflict": {\n                    "$ref": "#/components/examples/AdminDictConflict"\n                  },\n                  "noPermission": {\n                    "$ref": "#/components/examples/AdminPermissionDenied"\n                  },\n                  "tokenExpired": {\n                    "$ref": "#/components/examples/AdminTokenExpired"\n                  }\n                }\n              }\n            }\n          },\n          "5XX": {\n            "$ref": "#/compone