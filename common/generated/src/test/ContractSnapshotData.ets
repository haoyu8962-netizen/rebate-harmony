      "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1,\n          "default": 1\n        }\n      },\n      "AdminPageSize": {\n        "name": "page_size",\n        "in": "query",\n        "required": false,\n        "description": "Page size of an admin list, at most 200 (04 §5 后台分页); above that → 20001.",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1,\n          "maximum": 200,\n          "default": 20\n        }\n      },\n      "AdminIdPath": {\n        "name": "admin_id",\n        "in": "path",\n        "required": true,\n        "description": "Id of an admin account; unknown → 20001 with data.fields=[admin_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminUserIdPath": {\n        "name": "user_id",\n        "in": "path",\n        "required": true,\n        "description": "user_id of an app user of the console\'s app; unknown → 20001 with data.fields=[user_id].",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminExportIdPath": {\n        "name": "id",\n        "in": "path",\n        "required": true,\n        "description": "opaque id of an export task (as listed); unknown, of another app, created by another\\naccount, or (for a download) whose creator no longer holds the needed points → 20001 with\\ndata.fields=[id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/AdminExportId"\n        }\n      },\n      "AdminUserUnionPlatformPath": {\n        "name": "platform",\n        "in": "path",\n        "required": true,\n        "description": "Platform of the user\'s union binding (enum platform). Only platforms with user\\nauthorization have bindings (BR-ID-17); another platform, such as jd, → 20001 with\\ndata.fields=[platform].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "AdminUserRiskStateFilter": {\n        "name": "risk_state",\n        "in": "query",\n        "required": false,\n        "description": "Only users in this risk state (enum risk_state; no row counts as normal); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminUserRiskStateCode"\n        }\n      },\n      "AdminUserLookupUid": {\n        "name": "uid",\n        "in": "query",\n        "required": false,\n        "description": "The user_id to look up; give exactly one of uid and phone (else 20001 with data.fields=[uid, phone]).",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminSearchQuery": {\n        "name": "q",\n        "in": "query",\n        "required": true,\n        "description": "A full order number, withdrawal number, phone number or UID. Trimmed of surrounding\\nwhitespace, then 1–64 characters, else 20001 with data.fields=[q]; the bound is checked\\nafter trimming, so the schema carries none.\\n",\n        "schema": {\n          "type": "string"\n        }\n      },\n      "AdminUserLookupPhone": {\n        "name": "phone",\n        "in": "query",\n        "required": false,\n        "description": "The full phone number to look up, normalised as in BR-ID-05 细则「手机号规范化」 (not a\\nmainland mobile number → 20001 with data.fields=[phone] and data.reason=phone_invalid);\\ngive exactly one of uid and phone.\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Phone"\n        }\n      },\n      "AdminClaimIdPath": {\n        "name": "claim_id",\n        "in": "path",\n        "required": true,\n        "description": "claim_id of the claim (also its display number); unknown, of another app, or (with\\nuser_id) of another applicant → 20001 with data.fields=[claim_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminClaimPlatformFilter": {\n        "name": "platform",\n        "in": "query",\n        "required": false,\n        "description": "Only claims of this platform (enum platform); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformCode"\n        }\n      },\n      "AdminClaimEvidenceLevelFilter": {\n        "name": "evidence_level",\n        "in": "query",\n        "required": false,\n        "description": "Only claims of this evidence level (enum claim_evidence_level; the claim\'s weakest child order); absent = all.",\n        "schema": {\n          "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n        }\n      },\n      "AdminClaimStatusFilter": {\n        "name": "status",\n        "in": "query",\n        "required": false,\n        "description": "Only claims in this status (enum claim_status); absent = all. The counts ignore it.",\n        "schema": {\n          "$ref": "#/components/schemas/ClaimStatus"\n        }\n      },\n      "AdminClaimUserFilter": {\n        "name": "user_id",\n        "in": "query",\n        "required": false,\n        "description": "Only claims of this applicant (the user_id; UID and phone lookups go through the top-bar\\nsearch). Required for an account holding user.lookup but not order.claim (else 10403\\nwith data.reason=admin_permission_denied).\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "AdminClaimQuery": {\n        "name": "q",\n        "in": "query",\n        "required": false,\n        "description": "A claim_id, the order number as submitted, or a child order number, matched exactly.\\nTrimmed and with spaces removed, then 1–64 characters, else 20001 with data.fields=[q];\\nthe bound is checked after trimming, so the schema carries none.\\n",\n        "schema": {\n          "type": "string"\n        }\n      },\n      "AdminClaimItemIdPath": {\n        "name": "item_id",\n        "in": "path",\n        "required": true,\n        "description": "item_id of one child order of the claim (claim_items); unknown, or of another claim →\\n20001 with data.fields=[item_id].\\n",\n        "schema": {\n          "$ref": "#/components/schemas/Id"\n        }\n      },\n      "PlatformIconKeyPath": {\n        "name": "key",\n        "in": "path",\n        "required": true,\n        "description": "Platform mark key (enum platform_icon_key); another value → 20001 with data.fields=[key].",\n        "schema": {\n          "$ref": "#/components/schemas/PlatformIconKey"\n        }\n      },\n      "PlatformIconVersionPath": {\n        "name": "version",\n        "in": "path",\n        "required": true,\n        "description": "Version of the mark, counted per mark from 1; unknown → 20001 with data.fields=[version].",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1\n        }\n      },\n      "AgreementTypePath": {\n        "name": "type",\n        "in": "path",\n        "required": true,\n        "description": "Agreement type (privacy, agreement or labor_agreement); another value → 20001 with data.fields=[type].",\n        "schema": {\n          "$ref": "#/components/schemas/AgreementType"\n        }\n      },\n      "AgreementVersionPath": {\n        "name": "version",\n        "in": "path",\n        "required": true,\n        "description": "Version of the agreement, counted per type from 1.",\n        "schema": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 1\n        }\n      },\n      "PageKeyPath": {\n        "name": "page_key",\n        "in": "path",\n        "required": true,\n        "description": "Page key: `home` or `custom:<name>` with name of 1..57 characters from [a-z0-9_-] (编排者默认);\\nanother shape → 20001 with data.fields=[page_key].\\n",\n        "schema": {\n          "type": "string",\n          "minLength": 1,\n          "maxLength": 64,\n          "pattern": "^(home|custom:[a-z0-9_-]{1,57})$"\n        }\n      },\n      "PageVersionPath": {\n        "name": "version",\n        "in": "