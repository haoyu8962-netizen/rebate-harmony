 "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/IdempotencyKey"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/SubmitAppealRequest"\n              },\n              "example": {\n                "target_type": "order",\n                "target_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a70",\n                "content": "订单返利被作废，请核查。"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The appeal, new or the processing one already on this target.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AppealResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "appeal_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a91",\n                    "target_type": "order",\n                    "target_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a70",\n                    "status": "processing",\n                    "content": "订单返利被作废，请核查。",\n                    "created_at": "2026-10-05T09:30:00+08:00",\n                    "closed_at": null\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/idempotency-keys/abandon": {\n      "post": {\n        "operationId": "abandonIdempotencyKey",\n        "tags": [\n          "identity"\n        ],\n        "summary": "Abandon the idempotency key of a sensitive operation whose result is unknown",\n        "description": "Only for the pending state of the four x-step-up operations (04 §5 step-up row) after a\\nsend whose result is unknown; the user chose to give up instead of confirming (BR-ID-10\\n细则「敏感操作的幂等键」). The server locates the idempotency record from the token\'s app_id\\nand user, the method and path that `action` maps to (the x-step-up table in\\ninfo.description) and `idempotency_key`:\\n- no record for the key → writes an abandoned record, `outcome=abandoned`, `original=null`;\\n- already abandoned → `outcome=abandoned` again (repeated calls give the same result);\\n- a completed record → `outcome=completed` and `original` = the stored response envelope\\n  `{code, msg, data}` unchanged (success or a 3xxxx business error); nothing is abandoned;\\n- the original request is still processing → 40901 (the client stays pending).\\nAfterwards a request with that key returns 20903. `action` or a key outside the formats →\\n20001 (`data.fields`). Takes no Idempotency-Key header and needs no step-up. Allowed for\\nfrozen and deleting accounts (inside the 10006 and 10007 whitelists, BR-ID-31,\\nBR-ID-27); passing them checks login, signature and subject only and grants no right to\\nrun the original operation. Single writer: platform. x-min-version-gate and\\nx-session-scopes are added by CT-17a.\\nVersion gate (conditional): not applied when action=account_deletion (abandoning an unknown\\ndeletion request); applied otherwise. Session scopes: a deletion_only session is accepted\\nonly for action=account_deletion. Both per BR-ID-01 细则, which wins on any difference.\\n",\n        "x-auth": "login",\n        "x-signed": true,\n        "x-idempotent": false,\n        "x-min-version-gate": "conditional",\n        "x-session-scopes": [\n          "full",\n          "deletion_only"\n        ],\n        "x-error-codes": [\n          20001,\n          40901,\n          10405\n        ],\n        "security": [\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/Timestamp"\n          },\n          {\n            "$ref": "#/components/parameters/Nonce"\n          },\n          {\n            "$ref": "#/components/parameters/Sign"\n          }\n        ],\n        "requestBody": {\n          "required": true,\n          "content": {\n            "application/json": {\n              "schema": {\n                "$ref": "#/components/schemas/AbandonIdempotencyKeyRequest"\n              },\n              "example": {\n                "action": "withdraw",\n                "idempotency_key": "example-withdraw-attempt"\n              }\n            }\n          }\n        },\n        "responses": {\n          "200": {\n            "description": "The key is abandoned, or its completed result is returned.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AbandonIdempotencyKeyResponse"\n                },\n                "examples": {\n                  "abandoned": {\n                    "summary": "No record for the key; it is abandoned now",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "outcome": "abandoned",\n                        "original": null\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  },\n                  "completed": {\n                    "summary": "The original request had completed with a 3xxxx business error",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "outcome": "completed",\n                        "original": {\n                          "code": 30412,\n                          "msg": "有进行中的提现，暂不能申请注销"\n                        }\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          "429": {\n            "$ref": "#/components/responses/TooManyRequests"\n          },\n          "4XX": {\n            "$ref": "#/components/responses/ClientError"\n          },\n          "5XX": {\n            "$ref": "#/components/responses/ServerError"\n          }\n        }\n      }\n    },\n    "/v1/config": {\n      "get": {\n        "operationId": "getConfig",\n        "tags": [\n          "config"\n        ],\n        "summary": "Client configuration",\n        "description": "Configuration, client switches, texts and the derived per-platform purchase status\\n(04 §10.1, excerpt). Clients keep the last good response (LKG) and fall back to it and\\nthen to the bundled default when the request fails (03 §4.3). Keys whose inner shape is\\nnot fixed by 04 yet are free-form objects and get typed by the task that consumes them.\\nx-auth is optional (04 §6.2): h5_release buckets by user_id when logged in (拍板第二批\\nTECH-28) and agent availability depends on the whitelist user (BR-AI-12).\\nSession scopes: accepts deletion_only (BR-ID-01 细则「受限会话」).\\nConditional request (02 §10, 03 §4.3): the 200 response carries a strong ETag whose value\\nwithout quotes equals data.config_version (04 §10.1); a request whose If-None-Match\\nmatches the current ETag under weak comparison gets 304 with no body, and the client\\nkeeps its LKG.\\n",\n        "x-auth": "optional",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-session-scopes": [\n          "full",\n          "deletion_only"\n        ],\n        "x-error-codes": [],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/OptionalDeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/IfNoneMatch"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The current configuration.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              },\n              "ETag": {\n                "required": false,\n                "description": "Strong ETag of the configuration on 200; without quotes it equals data.config_version\\n(04 §10.1). A server that delivers it always sends it; a client that finds it missing\\ntreats the configuration as having no config_version and sends no If-None-Match.\\n",\n                "schema": {\n                  "type": "string",\n                  "pattern": "^\\"[0-9A-Za-z._:-]{1,64}\\"$"\n                }\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/ConfigResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "dict_version": "2026100201",\n                    "h5_base_url": "https://h5.example.test/",\n                    "h5_release": {\n                      "version": "1.4.2"\n                    },\n                    "share_domains": [\n                      "s.example.test"\n                    ],\n                    "features": {\n                      "flags": {\n                        "agent.entry.visible": true,\n                        "clipboard.enabled.taobao": true,\n                        "clipboard.auto_read.ios": true,\n                        "ui.grayscale": false,\n                        "external_page.product_intercept": true,\n                        "external_page.union_host_block": true,\n                        "earnings.dashboard.visible": false\n                      },\n                      "platform_status": {\n                        "taobao": "on",\n                        "jd": "on",\n                        "pdd": "not_launched"\n                      },\n                      "search_status": {\n                        "taobao": "on",\n                   