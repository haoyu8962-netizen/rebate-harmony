gal (OPS-14)."\n          },\n          "legal_confirm_note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 500,\n            "description": "The legal confirmation note (OPS-14)."\n          },\n          "legal_confirmed_on": {\n            "type": "string",\n            "format": "date",\n            "description": "Date of the legal confirmation, written to the audit record (BR-ID-12)."\n          },\n          "expected_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "The type\'s newest version as the console showed it, 0 when none is published; a mismatch is 20902."\n          }\n        }\n      },\n      "AdminPopupAssetUploadRequest": {\n        "type": "object",\n        "description": "multipart/form-data body of a home popup asset upload; parts `kind` and `file`.",\n        "additionalProperties": false,\n        "required": [\n          "kind",\n          "file"\n        ],\n        "properties": {\n          "kind": {\n            "type": "string",\n            "enum": [\n              "lottie",\n              "image"\n            ],\n            "description": "lottie = Lottie JSON animation; image = popup picture or static fallback."\n          },\n          "file": {\n            "type": "string",\n            "contentMediaType": "application/octet-stream",\n            "description": "The file as uploaded (BR-TEXT-26 细则「素材与校验」)."\n          }\n        }\n      },\n      "AdminPopupAssetUrl": {\n        "type": "string",\n        "format": "uri",\n        "pattern": "^https://",\n        "maxLength": 2048,\n        "description": "Stored file on the media domain (set by deployment), named by its content SHA-256; the\\nsame content always gets the same url.\\n"\n      },\n      "AdminPopupAssetSha256": {\n        "type": "string",\n        "pattern": "^[0-9a-f]{64}$",\n        "description": "Lowercase hex SHA-256 of the stored