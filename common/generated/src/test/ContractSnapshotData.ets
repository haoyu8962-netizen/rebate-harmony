    }\n      },\n      "AdminUserDataExportCreateResult": {\n        "type": "object",\n        "description": "The registered request (AdminUserDataExport) plus `reused`.",\n        "additionalProperties": false,\n        "required": [\n          "export_id",\n          "user_id",\n          "delivery",\n          "status",\n          "requested_by",\n          "created_at",\n          "due_at",\n          "retry_of",\n          "generated_at",\n          "delivered_at",\n          "expires_at",\n          "failure_reason",\n          "reused"\n        ],\n        "properties": {\n          "export_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "delivery": {\n            "$ref": "#/components/schemas/PersonalDataCopyDelivery"\n          },\n          "status": {\n            "$ref": "#/components/schemas/PersonalDataCopyStatus"\n          },\n          "requested_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "requested_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current name of the registrant; null when it cannot be read.",\n            "maxLength": 64\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time the request was registered."\n          },\n          "due_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Deadline, as in AdminUserDataExport."\n          },\n          "retry_of": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The request this one replaces; null otherwise."\n          },\n          "generated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Time the file was generated; null before."\n          },\n          "delivered_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Time of delivery; null before."\n          },\n          "expires_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "24 hours after generation; null before."\n          },\n          "failure_reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Short reason when failed; null otherwise."\n          },\n          "reused": {\n            "type": "boolean",\n            "description": "true = the user\'s unfinished request was returned and nothing was created."\n          }\n        }\n      },\n      "AdminUserDataExportCreateResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserDataExportCreateResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserDataExportPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUserDataExport"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminUserDataExportPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserDataExportPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserDataExportDownloadRequest": {\n        "type": "object",\n        "description": "Body of a wecom_session download; empty for an ordinary download.",\n        "additionalProperties": false,\n        "required": [],\n        "properties": {\n          "regenerate": {\n            "type": "boolean",\n            "default": false,\n            "description": "true = re-encrypt a new file with a new password and void the previous file\\n(the password was lost); due_at and expires_at do not change.\\n"\n          }\n        }\n      },\n      "AdminUserDataExportDownload": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "url",\n          "url_expires_at",\n          "password",\n          "status",\n          "expires_at"\n        ],\n        "properties": {\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048,\n            "description": "Signed link to the encrypted file in the private bucket; valid until url_expires_at."\n          },\n          "url_expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "min(5 minutes after signing, the request\'s expires_at)."\n          },\n          "password": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 128,\n            "description": "One-time password of the file, only when this call generated it (the first download,\\nor regenerate=true); null otherwise. Never stored; tell it to the user separately\\nfrom the file.\\n"\n          },\n          "status": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml personal_data_copy_status; always delivered after a download.",\n            "enum": [\n              "delivered"\n            ]\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "End of the download period of the request (24 hours after generation)."\n          }\n        }\n      },\n      "AdminUserDataExportDownloadResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserDataExportDownload"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserProfileEditRequest": {\n        "type": "object",\n        "description": "Body of PATCH /admin/v1/users/{user_id}/profile (BR-ID-06 细则「客服代办换号」, BR-ID-39\\n细则「后台改昵称」): `reason` and at least one of `phone` and `nickname`.\\n",\n        "additionalProperties": false,\n        "required": [\n          "reason"\n        ],\n        "minProperties": 2,\n        "properties": {\n          "phone": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/Phone"\n              }\n            ],\n            "description": "The new phone number, normalised by the server (BR-ID-05 细则「手机号规范化」); equal to\\nthe current number after normalisation means not edited.\\n"\n          },\n          "nickname": {\n            "type": "string",\n            "description": "The new nickname. The server trims leading and trailing white space and checks the\\nlength as 1–16 extended grapheme clusters (BR-ID-39); no minLength / maxLength here\\nbecause JSON Schema counts code points. Equal to the current nickname after trimming\\nmeans not edited.\\n"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminOrderPlatformStatus": {\n        "type": "string",\n        "description": "Union order status (contracts/enums/order.yaml platform_status; BR-FUND-01, BR-FUND-02).",\n        "enum": [\n          "DEPOSIT_PAID",\n          "PAID",\n          "RECEIVED",\n          "SETTLED",\n          "INVALID"\n        ]\n      },\n      "AdminOrderRebateStatus": {\n        "type": "string",\n        "description": "Rebate status (contracts/enums/order.yaml rebate_status; BR-FUND-01).",\n        "enum": [\n          "UNATTRIBUTED",\n          "ESTIMATED",\n          "WAITING",\n          "CREDITED",\n          "VOID",\n          "CLAWED_BACK"\n        ]\n      },\n      "AdminOrderHoldReason": {\n        "type": "string",\n        "description": "Why the order is held (contracts/enums/order.yaml order_hold_reason; BR-FUND-06, BR-FUND-02).",\n        "enum": [\n          "RISK",\n          "CS",\n          "UNMAPPED_STATUS"\n        ]\n      },\n      "AdminOrderFlag": {\n        "type": "string",\n        "description": "A flag of an admin order row (enum admin_order_flag); the keys of AdminOrderFlags.",\n        "enum": [\n          "locked",\n          "status_locked",\n          "rights_pending",\n          "hold"\n        ]\n      },\n      "AdminOrderHistoryField": {\n        "type": "string",\n        "description": "The status field a history row records (enum admin_order_history_field).",\n        "enum": [\n          "platform",\n          "rebate"\n        ]\n      },\n      "AdminOrderHistorySource": {\n        "type": "string",\n        "description": "Where a status change came from (enum admin_order_history_source).",\n        "enum": [\n          "sync",\n          "admin",\n          "claim",\n          "system"\n        ]\n      },\n      "AdminOrderBuyType": {\n        "type": "string",\n        "description": "Self purchase or share (contracts/enums/trade.yaml buy_type; BR-ATTR-08).",\n        "enum": [\n          "self",\n          "share"\n        ]\n      },\n      "AdminOrderSceneBasis": {\n        "type": "string",\n        "description": "What buy_type was decided from (contracts/enums/trade.yaml scene_basis; BR-ATTR-09).",\n        "enum": [\n          "pid",\n          "param",\n          "fallback"\n        ]\n      },\n      "AdminOrderUserBasis": {\n        "type": "string",\n        "description": "Where the attributed user came from (contracts/enums/trade.yaml user_basis; BR-ATTR-09).",\n        "enum": [\n          "param",\n          "claim",\n          "admin"\n        ]\n      },\n      "AdminOrderLinkEvent": {\n        "type": "string",\n        "description": "Event of a link record (contracts/enums/trade.yaml link_event; BR-ATTR-14).",\n        "enum": [\n          "convert",\n          "precompute",\n          "register",\n          "open"\n        ]\n      },\n      "AdminOrderLinkScene": {\n        "type": "string",\n        "description": "Scene of a link record (contracts/enums/trade.yaml scene).",\n        "enum": [\n          "search",\n          "detail",\n          "home_card",\n          "feed",\n          "clipboard",\n          "agent",\n          "share",\n          "h5",\n          "push",\n          "taolijin",\n          "watch_alert",\n          "share_ext",\n          "wechat_bot",\n          "mcp"\n        ]\n      },\n      "AdminOrderBeneficiaryRole": {\n        "type": "string",\n        "description": "Role of a beneficiary in the commission snapshot (contracts/enums/fund.yaml beneficiary_role).",\n        "enum": [\n          "self",\n          "share",\n          "direct",\n          "indirect"\n        ]\n      },\n      "AdminOrderForfeitReason": {\n        "type": "string",\n        "description": "Why a beneficiary\'s share is forfeited (contracts/enums/fund.yaml forfeit_reason; BR-CALC-13).",\n        "enum": [\n          "banned",\n          "deleted",\n          "minor"\n        ]\n      },\n      "AdminOrderUser": {\n        "type": "object",\n        "description": "The attributed user of an order as the console shows it; the phone number only masked (BR-ID-33).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "phone_masked"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          }\n        }\n      },\n      "AdminOrderFlags": {\n        "type": "object",\n        "description": "The flags of an order (enum admin_order_flag). locked is orders.locked, the attribution\\nlock (BR-ATTR-20, 「归属已锁定」); status_locked is derived from rebate_status ∈ {VOID,\\nCREDITED, CLAWED_BACK}, not stored (BR-FUND-01 细则「订单锁定（展示标记）」, 「已锁定」);\\nrights_pending and hold are the columns of the same name (BR-FUND-06). Independent of each\\nother.\\n",\n        "additionalProperties": false,\n        "required": [\n          "locked",\n          "status_locked",\n          "rights_pending",\n          "hold"\n        ],\n        "properties": {\n          "locked": {\n            "type": "boolean"\n          },\n          "status_locked": {\n            "type": "boolean"\n          },\n          "rights_pending": {\n            "type": "boolean"\n          },\n          "hold": {\n            "type": "boolean"\n          }\n        }\n      },\n      "AdminOrderListItem": {\n        "type": "object",\n        "description": "A sub-order row of the admin order list (04 §3.2 orders). Not the user-side OrderSummary.\\nAmounts in fen.\\n",\n        "additionalProperties": false,\n        "required": [\n          "order_id",\n          "sub_order_id",\n          "parent_order_id",\n          "platform",\n          "title",\n          "image_url",\n          "user",\n          "paid_at",\n          "pay_amount_fen",\n          "est_commission_fen",\n          "settle_commission_fen",\n          "platform_status",\n          "rebate_status",\n          "hold_reason",\n          "flags"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "sub_order_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The sub-order number (orders.sub_order_id); unique together with platform."\n          },\n          "parent_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The parent order number (orders.parent_order_id); null when the union gave none."\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Product title from the union order; null when the union gave none."\n          },\n          "image_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Product image from the union order; null when the union gave none."\n          },\n          "user": {\n            "description": "The attributed user; null for an unattributed order.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminOrderUser"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Payment time (orders.paid_at); null when not known yet."\n          },\n          "pay_amount_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "est_commission_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "settle_commission_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "platform_status": {\n            "$ref": "#/components/schemas/AdminOrderPlatformStatus"\n          },\n          "rebate_status": {\n            "$ref": "#/components/schemas/AdminOrderRebateStatus"\n          },\n          "hold_reason": {\n            "description": "Set while hold is true, else null.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminOrderHoldReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "flags": {\n            "$ref": "#/components/schemas/AdminOrderFlags"\n          }\n        }\n      },\n      "AdminOrderPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminOrderListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminOrderPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminOrderPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminOrderStatusHistoryEntry": {\n        "type": "object",\n        "description": "One row of order_status_history (04 §3.2, insert only).",\n        "additionalProperties": false,\n        "required": [\n          "field",\n          "from",\n          "to",\n          "event",\n          "source",\n          "at"\n        ],\n        "properties": {\n          "field": {\n            "$ref": "#/components/schemas/AdminOrderHistoryField"\n          },\n          "from": {\n            "description": "The value before (a platform_status for field platform, a rebate_status for field rebate); null for the first value.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminOrderPlatformStatus"\n              },\n              {\n                "$ref": "#/components/schemas/AdminOrderRebateStatus"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "to": {\n            "description": "The value after, of the same kind as from.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminOrderPlatformStatus"\n              },\n              {\n                "$ref": "#/components/schemas/AdminOrderRebateStatus"\n              }\n            ]\n          },\n          "event": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The transition code as stored (order_status_history.event), such as R5 of BR-FUND-01."\n          },\n          "source": {\n            "$ref": "#/components/schemas/AdminOrderHistorySource"\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminOrderBeneficiary": {\n        "type": "object",\n        "description": "One beneficiary of the commission snapshot (commission_splits.beneficiaries).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "role",\n          "ratio_bp",\n          "forfeit_reason"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "role": {\n            "$ref": "#/components/schemas/AdminOrderBeneficiaryRole"\n          },\n          "ratio_bp": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "maximum": 10000,\n            "description": "The beneficiary\'s ratio in basis points (1/10000)."\n          },\n          "forfeit_reason": {\n            "description": "Set when the share is forfeited (BR-CALC-13), else null.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminOrderForfeitReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AdminOrderCommissionSplit": {\n        "type": "object",\n        "description": "The commission snapshot of a sub-order (04 §3.2 commission_splits; BR-CALC-10: written\\nonce). Amounts in fen, ratios in basis points (1/10000).\\n",\n        "additionalProperties": false,\n        "required": [\n          "rule_version_id",\n          "order_type",\n          "raw_n_fen",\n          "subsidy_commission_fen",\n          "reserve_bp",\n          "reserve_fen",\n          "tlj_deduct_fen",\n          "base_fen",\n          "platform_retain_fen",\n          "beneficiaries",\n          "created_at"\n        ],\n        "properties": {\n          "rule_version_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "order_type": {\n            "$ref": "#/components/schemas/AdminOrderBuyType"\n          },\n          "raw_n_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "subsidy_commission_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "reserve_bp": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "maximum": 10000,\n            "description": "Platform reserve ratio of the rule version (commission_rule_reserves), basis points."\n          },\n          "reserve_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "tlj_deduct_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "base_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "platform_retain_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "beneficiaries": {\n            "type": "array",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AdminOrderBeneficiary"\n            }\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the snapshot was generated."\n          }\n        }\n      },\n      "AdminOrderLinkLog": {\n        "type": "object",\n        "description": "A record of the order\'s link; its time, event and scene only, no product, shop, promotion, user or raw union data.",\n        "additionalProperties": false,\n        "required": [\n          "at",\n          "event",\n          "scene"\n        ],\n        "properties": {\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "event": {\n            "$ref": "#/components/schemas/AdminOrderLinkEvent"\n          },\n          "scene": {\n            "$ref": "#/components/schemas/AdminOrderLinkScene"\n          }\n        }\n      },\n      "AdminOrderDetail": {\n        "type": "object",\n        "description": "A sub-order as the order detail page sees it: the list row\'s fields plus product,\\nattribution and time fields of 04 §3.2 orders, the status history, the commission snapshot\\nand the link records. Not the user-side OrderDetail. No raw union payload (no permission\\npoint for it in 04 §11; pending).\\n",\n        "additionalProperties": false,\n        "required": [\n          "order_id",\n          "sub_order_id",\n          "parent_order_id",\n          "platform",\n          "title",\n          "image_url",\n          "user",\n          "paid_at",\n          "pay_amount_fen",\n          "est_commission_fen",\n          "settle_commission_fen",\n          "platform_status",\n          "rebate_status",\n          "hold_reason",\n          "flags",\n          "raw_item_id",\n          "product_key",\n          "quantity",\n          "refunded_quantity",\n          "display_status",\n          "reason",\n          "buy_type",\n          "scene_basis",\n          "user_basis",\n          "is_presale",\n          "deposit_paid_at",\n          "received_at",\n          "settled_at",\n          "credited_at",\n          "settle_period",\n          "commission_rate_bp",\n          "row_version",\n          "unmapped_pending_open",\n          "last_hold_by",\n          "last_hold_by_name",\n          "last_hold_note",\n          "last_hold_at",\n          "status_history",\n          "commission_split",\n          "link_logs"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "sub_order_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The sub-order number (orders.sub_order_id); unique together with platform."\n          },\n          "parent_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The parent order number; null when the union gave none."\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image_url": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "user": {\n            "description": "The attributed user; null for an unattributed order.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminOrderUser"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n        