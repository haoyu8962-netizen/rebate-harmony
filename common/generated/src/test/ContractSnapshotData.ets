en the returned union URL can be used directly (BR-ATTR-05); it does not\\nlimit opening the link_id again.\\n"\n          }\n        }\n      },\n      "IdempotencyKey": {\n        "type": "string",\n        "description": "Value of the Idempotency-Key header (04 §5「幂等」).",\n        "minLength": 8,\n        "maxLength": 64,\n        "pattern": "^[A-Za-z0-9_-]+$"\n      },\n      "SessionScope": {\n        "type": "string",\n        "description": "scp of an access token (enum session_scope; meaning in BR-ID-01 细则「受限会话」).",\n        "enum": [\n          "full",\n          "deletion_only"\n        ]\n      },\n      "H5TokenScope": {\n        "type": "string",\n        "description": "Scope of an h5_token (enum h5_token_scope; BR-ID-32 细则「只读作用域」).",\n        "enum": [\n          "standard",\n          "read_only"\n        ]\n      },\n      "IssueH5TokenRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {\n          "scope": {\n            "$ref": "#/components/schemas/H5TokenScope",\n            "description": "Filled by the native app from its force-update state; H5 cannot choose it. The value\\nused when it is absent is set in BR-ID-32 细则「只读作用域」.\\n"\n          }\n        }\n      },\n      "H5TokenData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "token",\n          "expire_at",\n          "scope"\n        ],\n        "properties": {\n          "token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 4096\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "scope": {\n            "$ref": "#/components/schemas/H5TokenScope"\n          }\n        }\n      },\n      "H5TokenResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/H5TokenData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "StepUpAction": {\n        "type": "string",\n        "description": "Action a step_up_token is bound to; one per x-step-up operation (04 §2.5, §5).",\n        "enum": [\n          "withdraw",\n          "payout_account_change",\n          "phone_change",\n          "account_deletion"\n        ]\n      },\n      "IdempotencyAbandonOutcome": {\n        "type": "string",\n        "description": "Result of POST /v1/idempotency-keys/abandon (04 §6.1).",\n        "enum": [\n          "abandoned",\n          "completed"\n        ]\n      },\n      "AbandonIdempotencyKeyRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "idempotency_key"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "idempotency_key": {\n            "$ref": "#/components/schemas/IdempotencyKey"\n          }\n        }\n      },\n      "AbandonIdempotencyKeyData": {\n        "type": "object",\n        "description": "`original` is null exactly when `outcome=abandoned`. The oneOf branches declare the\\nproperties they constrain (strict Ajv2020, ADR-0001 §4.2 #15).\\n",\n        "additionalProperties": false,\n        "required": [\n          "outcome",\n          "original"\n        ],\n        "properties": {\n          "outcome": {\n            "$ref": "#/components/schemas/IdempotencyAbandonOutcome"\n          },\n          "original": {\n            "type": [\n              "object",\n              "null"\n            ],\n            "description": "The response envelope stored with the completed idempotency record, unchanged\\n(`code` 0 or a 3xxxx business code; 1xxxx and 2xxxx results are never stored,\\nBR-WDR-07). `data` keeps the shape of the original operation, so it is left open.\\n",\n            "additionalProperties": false,\n            "required": [\n              "code",\n              "msg"\n            ],\n            "properties": {\n              "code": {\n                "type": "integer",\n                "format": "int32",\n                "anyOf": [\n                  {\n                    "type": "integer",\n                    "format": "int32",\n                    "enum": [\n                      0\n                    ]\n                  },\n                  {\n                    "type": "integer",\n                    "format": "int32",\n                    "minimum": 30000,\n                    "maximum": 39999\n                  }\n                ]\n              },\n              "msg": {\n                "type": "string"\n              },\n              "data": {\n                "type": "object",\n                "additionalProperties": true\n              }\n            }\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "outcome": {\n                "type": "string",\n                "enum": [\n                  "abandoned"\n                ]\n              },\n              "original": {\n                "type": "null"\n              }\n            },\n            "required": [\n              "outcome",\n              "original"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "outcome": {\n                "type": "string",\n                "enum": [\n                  "completed"\n                ]\n              },\n              "original": {\n                "type": "object",\n                "additionalProperties": true\n              }\n            },\n            "required": [\n              "outcome",\n              "original"\n            ]\n          }\n        ]\n      },\n      "AbandonIdempotencyKeyResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AbandonIdempotencyKeyData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ErrorEnvelope": {\n        "type": "object",\n        "description": "Error response (04 §5, §7). `data` is present only for codes that define it; its fields\\nper code are listed in contracts/error-codes.yaml, so it is left open here.\\n",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 10000,\n            "maximum": 99999\n          },\n          "msg": {\n            "type": "string",\n            "description": "Fallback text only; clients show the dictionary text error.<code>."\n          },\n          "data": {\n            "type": "object",\n            "additionalProperties": true\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "FreeForm": {\n        "type": "object",\n        "description": "Configuration block whose inner shape is not fixed by 规划/04 yet.",\n        "additionalProperties": true\n      },\n      "DeviceIdSource": {\n        "type": "string",\n        "description": "Which device identifier was hashed (enum device_id_source, BR-ID-09).",\n        "enum": [\n          "idfv",\n          "android_id",\n          "oaid",\n          "odid"\n        ]\n      },\n      "RegisterDeviceRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "device_hash",\n          "id_source"\n        ],\n        "properties": {\n          "device_hash": {\n            "type": "string",\n            "description": "lowercase_hex(SHA-256(UTF-8 bytes of the identifier, trimmed and lower-cased)) of IDFV\\n(iOS), ANDROID_ID (Android, MVP) or ODID (Harmony) (BR-ID-09 细则「设备标识的无效值」).\\n",\n            "pattern": "^[0-9a-f]{64}$"\n          },\n          "id_source": {\n            "$ref": "#/components/schemas/DeviceIdSource"\n          }\n        }\n      },\n      "RegisterDeviceData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "device_id",\n          "install_secret"\n        ],\n        "properties": {\n          "device_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "install_secret": {\n            "type": "string",\n            "description": "Signing secret, stored only in Keychain / Keystore / HUKS.",\n            "minLength": 16,\n            "maxLength": 128\n          }\n        }\n      },\n      "RegisterDeviceResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/RegisterDeviceData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "Phone": {\n        "type": "string",\n        "description": "Phone number as typed or pasted; it may carry spaces, hyphens and +86 / 0086 / 86. The\\nserver normalises it (BR-ID-05 细则「手机号规范化」); a result that is not a mainland mobile\\nnumber is 20001 with `data.fields=[phone]` and `data.reason=phone_invalid` (an empty\\nstring included). No length bound in the schema: any spacing of a valid number must reach\\nthe normaliser, and adding a bound to a request property is a breaking change (oasdiff).\\n"\n      },\n      "SendSmsCodeRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "purpose"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          },\n          "purpose": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml sms_purpose.",\n            "enum": [\n              "login",\n              "bind",\n              "step_up"\n            ]\n          },\n          "captcha_token": {\n            "type": "string",\n            "description": "Human-verification token, required after 44003 (BR-ID-05).",\n            "maxLength": 2048\n          },\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction",\n            "description": "With purpose=step_up the client always sends the action the code is for; the version\\ngate and the session scope are decided from it (BR-ID-01 细则): only\\naction=account_deletion is exempt, and a step_up request without action is gated.\\npurpose=login is exempt regardless of action; purpose=bind is gated.\\n"\n          }\n        }\n      },\n      "SendSmsCodeData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "resend_after_sec",\n          "expires_in_sec"\n        ],\n        "properties": {\n          "resend_after_sec": {\n            "type": "integer",\n            "format": "int32",\n            "description": "Seconds until another code may be requested (60, BR-ID-05)."\n          },\n          "expires_in_sec": {\n            "type": "integer",\n            "format": "int32",\n            "description": "Validity of the code in seconds (300, BR-ID-05)."\n          }\n        }\n      },\n      "SendSmsCodeResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/SendSmsCodeData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "LegalVersions": {\n        "type": "object",\n        "description": "Versions of the privacy policy and user agreement the user agreed to (BR-ID-04).",\n        "additionalProperties": false,\n        "required": [\n          "privacy",\n          "agreement"\n        ],\n        "properties": {\n          "privacy": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "agreement": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          }\n        }\n      },\n      "LoginBySmsRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "phone": {\n            "$ref": "#/components/schemas/Phone"\n          },\n          "code": {\n            "type": "string",\n            "pattern": "^[0-9]{6}$"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the box was ticked or the confirm dialog accepted (client clock)."\n          },\n          "invite_code": {\n            "type": "string",\n            "description": "Optional invite code; ignored for an existing account (BR-INV-06).",\n            "maxLength": 32\n          }\n        }\n      },\n      "LoginProvider": {\n        "type": "string",\n        "description": "Third-party identity provider (enum login_provider, BR-ID-04).",\n        "enum": [\n          "wechat",\n          "apple",\n          "huawei"\n        ]\n      },\n      "RecordConsentRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "version",\n          "accepted",\n          "channel",\n          "client_at"\n        ],\n        "properties": {\n          "type": {\n            "type": "string",\n            "description": "consent_type without labor_agreement (BR-ID-12, BR-WDR-31).",\n            "enum": [\n              "privacy",\n              "agreement",\n              "ai_third_party",\n              "id_verification",\n              "personalization"\n            ]\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The version of the text the user saw (legal.privacy.version and the like)."\n          },\n          "accepted": {\n            "type": "boolean",\n            "description": "true = agreed; false = withdrawn."\n          },\n          "channel": {\n            "type": "string",\n            "description": "consent_channel without the server-written login_merge, h5_landing and withdraw_flow.",\n            "enum": [\n              "first_launch",\n              "login_page",\n              "agent_sheet",\n              "realname_sheet",\n              "privacy_center"\n            ]\n          },\n          "client_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the user tapped (device clock)."\n          }\n        }\n      },\n      "OauthAttemptPurpose": {\n        "type": "string",\n        "description": "What a third-party authorization attempt is for (enum oauth_attempt_purpose).",\n        "enum": [\n          "login",\n          "step_up",\n          "payout_bind"\n        ]\n      },\n      "CreateOauthAttemptRequest": {\n        "type": "object",\n        "description": "`action` is required exactly for purpose=step_up. purpose=payout_bind is for WeChat only\\nand carries no `action`. The oneOf branches declare the properties they constrain (strict\\nAjv2020, ADR-0001 §4.2 #15).\\n",\n        "additionalProperties": false,\n        "required": [\n          "provider",\n          "purpose"\n        ],\n        "properties": {\n          "provider": {\n            "$ref": "#/components/schemas/LoginProvider"\n          },\n          "purpose": {\n            "$ref": "#/components/schemas/OauthAttemptPurpose"\n          },\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "login"\n                ]\n              }\n            },\n            "required": [\n              "purpose"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "step_up"\n                ]\n              },\n              "action": {\n                "$ref": "#/components/schemas/StepUpAction"\n              }\n            },\n            "required": [\n              "purpose",\n              "action"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "purpose": {\n                "type": "string",\n                "enum": [\n                  "payout_bind"\n                ]\n              },\n              "provider": {\n                "type": "string",\n                "enum": [\n                  "wechat"\n                ]\n              }\n            },\n            "required": [\n              "purpose",\n              "provider"\n            ],\n            "not": {\n              "type": "object",\n              "additionalProperties": true,\n              "properties": {\n                "action": {\n                  "$ref": "#/components/schemas/StepUpAction"\n                }\n              },\n              "required": [\n                "action"\n              ]\n            }\n          }\n        ]\n      },\n      "OauthAttemptData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "nonce",\n          "expire_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "nonce": {\n            "type": "string",\n            "description": "At least 128 random bits, passed to the provider SDK (BR-ID-04 细则).",\n            "minLength": 16,\n            "maxLength": 256\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "OauthAttemptResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OauthAttemptData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OauthCredential": {\n        "type": "string",\n        "description": "An authorization credential from the provider SDK; never stored or logged.",\n        "minLength": 1,\n        "maxLength": 4096\n      },\n      "LoginByWechatRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "LoginByAppleRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "identity_token",\n          "authorization_code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "identity_token": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "LoginByHuaweiRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "authorization_code",\n          "legal_versions",\n          "consent_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "legal_versions": {\n            "$ref": "#/components/schemas/LegalVersions"\n          },\n          "consent_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "StepUpBySmsRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "code": {\n            "type": "string",\n            "pattern": "^[0-9]{6}$"\n          }\n        }\n      },\n      "StepUpByWechatRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "provider",\n          "attempt_id",\n          "code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "provider": {\n            "type": "string",\n            "enum": [\n              "wechat"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          }\n        }\n      },\n      "StepUpByAppleRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "provider",\n          "attempt_id",\n          "identity_token",\n          "authorization_code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "provider": {\n            "type": "string",\n            "enum": [\n              "apple"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "identity_token": {\n            "$ref": "#/components/schemas/OauthCredential"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          }\n        }\n      },\n      "StepUpByHuaweiRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "provider",\n          "attempt_id",\n          "authorization_code"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/StepUpAction"\n          },\n          "provider": {\n            "type": "string",\n            "enum": [\n              "huawei"\n            ]\n          },\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "authorization_code": {\n            "$ref": "#/components/schemas/OauthCredential"\n          }\n        }\n      },\n      "StepUpRequest": {\n        "type": "object",\n        "description": "Exactly one way of second verification: an SMS code, or a new authorization with one\\nprovider carrying that provider\'s login credential fields (BR-ID-08). Each branch is a\\nclosed object, so a body mixing two ways matches none.\\n",\n        "unevaluatedProperties": false,\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/StepUpBySmsRequest"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpByWechatRequest"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpByAppleRequest"\n          },\n          {\n            "$ref": "#/components/schemas/StepUpByHuaweiRequest"\n          }\n        ]\n      },\n      "StepUpData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "step_up_token",\n          "expire_at"\n        ],\n        "properties": {\n          "step_up_token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 2048\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "StepUpResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/StepUpData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "TokenPair": {\n        "type": "object",\n        "description": "Token pair of a login or a refresh. session_scope is the scp of the access token, decided\\nfrom this request (BR-ID-01 细则「受限会话」): deletion_only when the client is below the\\nminimum supported version.\\n",\n        "additionalProperties": false,\n        "required": [\n          "access_token",\n          "access_expires_at",\n          "refresh_token",\n          "refresh_expires_at",\n          "session_scope"\n        ],\n        "properties": {\n          "session_scope": {\n            "$ref": "#/components/schemas/SessionScope"\n          },\n          "access_token": {\n            "type": "string",\n            "minLength": 1\n          },\n          "access_expires_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "refresh_token": {\n            "type": "string",\n            "minLength": 1\n          },\n          "refresh_expires_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "InviteBind": {\n        "type": "object",\n        "description": "Result of binding the invite code sent at registration (BR-INV-06).",\n        "additionalProperties": false,\n        "required": [\n          "result",\n          "code"\n        ],\n        "properties": {\n          "result": {\n            "type": "string",\n            "enum": [\n              "bound",\n              "failed",\n              "ignored_existing_user"\n            ]\n          },\n          "code": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "description": "Error code when result=failed (50001 = internal binding error).",\n            "enum": [\n              30401,\n              30403,\n              30408,\n              42901,\n              50001,\n              null\n            ]\n          }\n        }\n      },\n      "LoginData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "is_new_user",\n          "tokens"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "is_new_user": {\n            "type": "boolean"\n          },\n          "tokens": {\n            "$ref": "#/components/schemas/TokenPair"\n          },\n          "invite_bind": {\n            "$ref": "#/components/schemas/InviteBind"\n          }\n        }\n      },\n      "LoginResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/LoginData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "RefreshTokenRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "refresh_token"\n        ],\n        "properties": {\n          "refresh_token": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "TokenPairResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/TokenPair"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "MeBalance": {\n        "type": "object",\n        "description": "Summary of the single balance (拍板第二批 §8 ADD-06); meanings per BR-FUND-18.",\n        "additionalProperties": false,\n        "required": [\n          "available_fen",\n          "withdrawable_fen",\n          "estimated_total_fen"\n        ],\n        "properties": {\n          "available_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "withdrawable_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "estimated_total_fen": {\n            "$ref": "#/components/schemas/Fen"\n          }\n        }\n      },\n      "UnionBindingState": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "status"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "status": {\n            "type": "string",\n            "description": "contracts/enums/identity.yaml union_binding_status.",\n            "enum": [\n              "unbound",\n              "pending_auth",\n              "active",\n              "invalid",\n              "released",\n              "blocked"\n            ]\n          }\n        }\n      },\n      "AuthMethod": {\n        "type": "string",\n        "description": "Taobao authorization method (enum auth_method; BR-ID-17 细则「授权方式」).",\n        "enum": [\n          "web_code",\n          "sdk_token"\n        ]\n      },\n      "AuthJumpStep": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "value"\n        ],\n        "properties": {\n          "type": {\n            "type": "string",\n            "description": "A subset of jump_type; an h5 step opens in the system browser, not in the app.",\n            "enum": [\n              "scheme",\n              "universal_link",\n              "h5"\n            ]\n          },\n          "value": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "AuthJumpPlan": {\n        "type": "object",\n        "description": "Authorization jump of 30111 and of the Pinduoduo auth-url (04 §7 30111): primary and\\nfallbacks chosen by the server from the device record and installed (BR-ID-22 细则,\\nBR-ATTR-27); executed in order by the same executor as a purchase jump plan, but not\\nreported as link_jump and not a purchase jump (BR-ATTR-21).\\n",\n        "additionalProperties": false,\n        "required": [\n          "primary",\n          "fallbacks",\n          "expire_at"\n        ],\n        "properties": {\n          "primary": {\n            "$ref": "#/components/schemas/AuthJumpStep"\n          },\n          "fallbacks": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AuthJumpStep"\n            }\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "UnionBindingsData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/UnionBindingState"\n            }\n          }\n        }\n      },\n      "UnionBindingsResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/UnionBindingsData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "UnionAuthUrlData": {\n        "type": "object",\n        "description": "Exactly one of auth_methods (Taobao, ordered) and auth_jump (Pinduoduo); the oneOf branches\\ndeclare the property they require (strict Ajv2020).\\n",\n        "additionalProperties": false,\n        "required": [\n          "auth_url",\n          "state"\n        ],\n        "properties": {\n          "auth_url": {\n            "type": "string",\n            "format": "uri"\n          },\n          "state": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "auth_methods": {\n            "type": "array",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AuthMethod"\n            }\n          },\n          "auth_jump": {\n            "$ref": "#/components/schemas/AuthJumpPlan"\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "auth_methods": {\n                "type": "array"\n              }\n            },\n            "required": [\n              "auth_methods"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "auth_jump": {\n                "type": "object",\n                "additionalProperties": true\n              }\n            },\n            "required": [\n              "auth_jump"\n            ]\n          }\n        ]\n      },\n      "UnionAuthUrlResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/UnionAuthUrlData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "BindUnionByWebCode": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "state",\n          "auth_method",\n          "code"\n        ],\n        "properties": {\n          "state": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "auth_method": {\n            "type": "string",\n            "enum": [\n              "web_code"\n            ]\n          },\n          "code": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 4096\n          }\n        }\n      },\n      "BindUnionBySdkToken": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "state",\n          "auth_method",\n          "access_token",\n          "expires_in"\n        ],\n        "properties": {\n          "state": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "auth_method": {\n            "type": "string",\n            "enum": [\n              "sdk_token"\n            ]\n          },\n          "access_token": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 4096\n          },\n          "expires_in": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1,\n            "description": "Lifetime of the access token in seconds, as the SDK returned it."\n          }\n        }\n      },\n      "BindUnionRequest": {\n        "type": "object",\n        "description": "Exactly one authorization method (BR-ID-17 细则「授权方式」); each branch is closed, so\\nundefined fields are 20001.\\n",\n        "unevaluatedProperties": false,\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/BindUnionByWebCode"\n          },\n          {\n            "$ref": "#/components/schemas/BindUnionBySdkToken"\n          }\n        ]\n      },\n      "UnionBindingResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/UnionBindingState"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OrderScope": {\n        "type": "string",\n        "enum": [\n          "self",\n          "share"\n        ]\n      },\n      "OrderStatusGroup": {\n        "type": "string",\n        "description": "Status group of the order list (enum order_status_group; members in BR-TEXT-02 细则).",\n        "enum": [\n          "all",\n          "estimating",\n          "credited",\n          "no_rebate"\n        ]\n      },\n      "OrderDisplayStatus": {\n        "type": "string",\n        "description": "User-visible order status (enum display_status; BR-FUND-17); unknown codes map to UNKNOWN.",\n        "enum": [\n          "PAID",\n          "DEPOSIT_PAID",\n          "WAITING",\n          "CREDITING",\n          "REVIEWING",\n          "RIGHTS_PENDING",\n          "CREDITED",\n          "CREDITED_PART_CLAWED",\n          "NO_REBATE",\n          "INVALID",\n          "CLAWED_BACK"\n        ]\n      },\n      "OrderReasonCode": {\n        "type": "string",\n        "description": "Order reason code (enum order_reason); texts and actions come from /v1/dict.",\n        "enum": [\n          "REFUND",\n          "RIGHTS",\n          "PUNISH",\n          "PRESALE_UNPAID",\n          "COMMISSION_ZERO",\n          "OTHER",\n          "BLACKLIST",\n          "PART_REFUND",\n          "PRICE_COMPARE",\n          "PRICE_PROTECT",\n          "SETTLE_DIFF",\n          "NOT_TRACKED",\n          "EXPIRED_CLICK",\n          "OTHER_TLJ",\n          "RELATION_INVALID",\n          "CANCELLED"\n        ]\n      },\n      "OrderTimelineNode": {\n        "type": "string",\n        "description": "Timeline node of the order detail (enum order_timeline_node; BR-TEXT-02 细则「时间线」):\\na pre-sale order starts with deposit_paid and has final_paid instead of paid; invalid /\\nclawed_back / part_clawed_back only when the order reached that state.\\n",\n        "enum": [\n          "deposit_paid",\n          "paid",\n          "final_paid",\n          "received",\n          "credit_expected",\n          "credited",\n          "invalid",\n          "clawed_back",\n          "part_clawed_back"\n        ]\n      },\n      "OrderSummary": {\n        "type": "object",\n        "description": "One row of GET /v1/orders. Exactly one of order_no (my own purchase) and masked_order_no (a\\nshared order); the oneOf branches declare the property they require (strict Ajv2020). A\\nshared order with is_other_product=true has title and image_url null and never the full\\norder_no (BR-TEXT-02 细则\\n「订单的检索范围与分享单的投影」). OrderDetail repeats these fields (kept as two closed\\nobjects; redocly\'s example check closes every allOf member, so no shared allOf base).\\n",\n        "additionalProperties": false,\n        "required": [\n          "order_id",\n          "platform",\n          "title",\n          "image_url",\n          "pay_amount_fen",\n          "quantity",\n          "display_status",\n          "reason",\n          "est_rebate_fen",\n          "paid_at",\n          "is_other_product"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri"\n          },\n          "pay_amount_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "quantity": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "description": "Full platform order number (self-purchase only, copyable)."\n          },\n          "masked_order_no": {\n            "type": "string",\n            "minLength": 1,\n            "description": "Masked by the server (BR-TEXT-02 细则「订单号的显示」); shared orders never carry the full number."\n          },\n          "display_status": {\n            "$ref": "#/components/schemas/OrderDisplayStatus"\n          },\n          "reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/OrderReasonCode"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "est_rebate_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Payment time (the final payment of a pre-sale order); null for a pre-sale order still in\\nDEPOSIT_PAID (BR-ATTR-25 keeps paid_at for the final payment).\\n"\n          },\n          "is_other_product": {\n            "type": "boolean",\n            "description": "A shared order whose bought product is not the shared one."\n          }\n        },\n        "not": {\n          "type": "object",\n          "additionalProperties": true,\n          "properties": {\n            "is_other_product": {\n              "const": true\n            }\n          },\n          "required": [\n            "is_other_product"\n          ],\n          "anyOf": [\n            {\n              "type": "object",\n              "properties": {\n                "title": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "title"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "image_url": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "image_url"\n              ]\n            },\n            {\n              "type": "object",\n              "properties": {\n                "order_no": {\n                  "type": "string"\n                }\n              },\n              "required": [\n                "order_no"\n              ]\n            }\n          ]\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "order_no": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "order_no"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "masked_order_no": {\n                "type": "string"\n              }\n            },\n            "required": [\n              "masked_order_no"\n            ]\n          }\n        ]\n      },\n      "OrderListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor",\n          "earliest_visible_date"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/OrderSummary"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "earliest_visible_date": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date"\n          }\n        }\n      },\n      "OrderListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OrderListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OrderTimelineItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "node",\n          "at",\n          "period"\n        ],\n        "properties": {\n          "node": {\n            "$ref": "#/components/schemas/OrderTimelineNode"\n          },\n          "at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When it happened; null when it has not (shown greyed) or the platform gives no time."\n          },\n          "period": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",\n            "description": "Expected settlement month (YYYY-MM), only on credit_expected; null otherwise."\n          }\n        }\n      },\n      "OrderDetail": {\n        "type": "object",\n        "description": "The list row fields (same as OrderSummary) plus the detail fields of 04 §6.4. product_key\\nis null when is_other_product=true; with is_other_product=true title and image_url are\\nnull too.\\n",\n        "additionalProperties": false,\n        "required": [\n          "order_id",\n          "platform",\n          "title",\n          "image_url",\n          "pay_amount_fen",\n          "quantity",\n          "display_status",\n          "reason",\n          "est_rebate_fen",\n          "paid_at",\n          "is_other_product",\n          "product_key",\n          "reason_action",\n          "timeline",\n          "expected_credit_period",\n          "credit_overdue",\n          "actual_fen",\n          "clawback_fen",\n          "appeal_pending",\n          "is_price_compare"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/compone