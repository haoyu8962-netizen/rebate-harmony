ision": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Plus 1 on every draft save, publish, gray change and rollback, never going back. The CAS\\nvalue of every page write, so a retried old request cannot undo a later change.\\n"\n          },\n          "latest_version": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Newest saved version, drafts included."\n          },\n          "updated_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Username of the admin who last saved, published, changed the gray share or rolled back."\n          },\n          "updated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPageConfigList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Ordered by page_key.",\n            "items": {\n              "$ref": "#/components/schemas/AdminPageConfig"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminPageConfigListResponse": {\n        "type": "object",\n      