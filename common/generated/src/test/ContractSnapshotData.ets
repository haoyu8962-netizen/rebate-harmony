en whose user is the sharer of this\\nshare link; used only to show a hint, BR-ATTR-11). Unknown link or one of another app →\\n30144; the page has no card to re-convert from, shows the empty state and does not retry.\\nBuying still goes only through POST /v1/links/{link_id}/open.\\n",\n        "x-auth": "optional",\n        "x-signed": false,\n        "x-idempotent": false,\n        "x-implementation": "planned",\n        "x-error-codes": [\n          30144\n        ],\n        "security": [\n          {},\n          {\n            "bearerAuth": []\n          }\n        ],\n        "parameters": [\n          {\n            "$ref": "#/components/parameters/AppId"\n          },\n          {\n            "$ref": "#/components/parameters/Platform"\n          },\n          {\n            "$ref": "#/components/parameters/AppVersion"\n          },\n          {\n            "$ref": "#/components/parameters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/LinkId"\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The link kind and its card.",\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/LinkLandingResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "link_kind": "share",\n                    "product_card": {\n                      "product_key": "tb:7Kq9LmN3pQ",\n                      "item_ref": "v1.dGJfN0txOUxtTjNwUQ.c2ln",\n                      "platform": "taobao",\n                      "shop_type": "tmall",\n                      "title":