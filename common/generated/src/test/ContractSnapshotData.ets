1\\nwith data.fields=[id].\\n",\n            "schema": {\n              "$ref": "#/components/schemas/AdminAuditLogId"\n            }\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The audit record.",\n            "headers": {\n              "X-Trace-Id": {\n                "$ref": "#/components/headers/TraceId"\n              }\n            },\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/AdminAuditLogResponse"\n                },\n                "example": {\n                  "code": 0,\n                  "msg": "",\n                  "data": {\n                    "id": "aud_9Nr4Ut2LxA8kVq6MbG3sPd",\n                    "actor_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5b00",\n                    "actor_name": "owner",\n                    "action": "user_risk_state_change",\n                    "target_type": "user",\n                    "target_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5c02",\n                    "permission": "risk.ban",\n                    "ip": "203.0.113.8",\n                    "at": "2026-10-18T16:05:00+08:00",\n                    "before": {\n                      "user_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5c02",\n                      "state": "normal",\n                      "reason_category": null,\n                      "reason": null,\n                      "frozen_until": null,\n                      "row_version": 3\n                    },\n                    "after": {\n                      "user_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5c02",\n                      "action": "ban",\n                      "state": "banned",\n                      "reason_category": "fraud",\n                      "reason": "order brushing",\n                      "frozen_until": null,\n                      "row_version": 4\n                    }\n                  },\n                  "trace_id": "0199a3b4