h offset)."\n          },\n          "file": {\n            "$ref": "#/components/schemas/AdminRightsImportFile"\n          }\n        },\n        "dependentRequired": {\n          "from": [\n            "time_basis",\n            "to"\n          ],\n          "to": [\n            "time_basis",\n            "from"\n          ]\n        }\n      },\n      "AdminRightsImportChannel": {\n        "type": "object",\n        "description": "multipart parts of a channel (渠道单) import, by relation_id; no time window.",\n        "additionalProperties": false,\n        "required": [\n          "kind",\n          "platform",\n          "union_account_id",\n          "file"\n        ],\n        "properties": {\n          "kind": {\n            "type": "string",\n            "enum": [\n              "channel"\n            ]\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "file": {\n            "$ref": "#/components/schemas/AdminRightsImportFile"\n          }\n        }\n      },\n      "AdminRightsImportCreateRequest": {\n        "description": "multipart/form-data body of POST /admin/v1/rights-imports; one form per kind.",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/AdminRightsImportByOrder"\n          },\n          {\n            "$ref": "#/components/schemas/AdminRightsImportChannel"\n          }\n        ]\n      },\n      "AdminRightsImportCreated": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "import_id",\n          "status"\n        ],\n        "properties": {\n          "import_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "type": "string",\n            "enum": [\n              "queued"\n            ],\n            "description": "A new task is always queued."\n          }\n        }\n      },\n      "AdminRightsImportCreateResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminRightsImportCreated"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminRightsImportRowCount": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 0\n      },\n      "AdminRightsImportCreatedByName": {\n        "type": [\n          "string",\n          "null"\n        ],\n        "maxLength": 64,\n        "description": "The importing admin\'s display name (admin_users.display_name, else the username); null when the account is deleted."\n      },\n      "AdminRightsImportSummary": {\n        "type": "object",\n        "description": "One import task without its row failures (04 §3.2 rights_imports).",\n        "additionalProperties": false,\n        "required": [\n          "import_id",\n          "kind",\n          "platform",\n          "status",\n          "total_rows",\n          "succeeded_rows",\n          "failed_rows",\n          "skipped_rows",\n          "duplicate_rows",\n          "created_by",\n          "created_by_name",\n          "created_at",\n          "finished_at"\n        ],\n        "properties": {\n          "import_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "kind": {\n            "$ref": "#/components/schemas/AdminRightsImportKind"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminRightsImportStatus"\n          },\n          "total_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "succeeded_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "failed_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "skipped_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "duplicate_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "created_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "created_by_name": {\n            "$ref": "#/components/schemas/AdminRightsImportCreatedByName"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "finished_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the task became done or failed; null before."\n          }\n        }\n      },\n      "AdminRightsImportFailure": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "row_no",\n          "reason"\n        ],\n        "properties": {\n          "row_no": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "The row number in the file."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminRightsImportFailureReason"\n          }\n        }\n      },\n      "AdminRightsImportDetail": {\n        "type": "object",\n        "description": "One import task with all its row failures (04 §3.2 rights_imports / rights_import_failures).",\n        "additionalProperties": false,\n        "required": [\n          "import_id",\n          "kind",\n          "platform",\n          "status",\n          "total_rows",\n          "succeeded_rows",\n          "failed_rows",\n          "skipped_rows",\n          "duplicate_rows",\n          "created_by",\n          "created_by_name",\n          "created_at",\n          "finished_at",\n          "failures"\n        ],\n        "properties": {\n          "import_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "kind": {\n            "$ref": "#/components/schemas/AdminRightsImportKind"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminRightsImportStatus"\n          },\n          "total_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "succeeded_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "failed_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "skipped_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "duplicate_rows": {\n            "$ref": "#/components/schemas/AdminRightsImportRowCount"\n          },\n          "created_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "created_by_name": {\n            "$ref": "#/components/schemas/AdminRightsImportCreatedByName"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "finished_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the task became done or failed; null before."\n          },\n          "failures": {\n            "type": "array",\n            "maxItems": 10000,\n            "description": "Every row failure of the task, by row_no; empty while nothing failed.",\n            "items": {\n              "$ref": "#/components/schemas/AdminRightsImportFailure"\n            }\n          }\n        }\n      },\n      "AdminRightsImportPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminRightsImportSummary"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminRightsImportPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminRightsImportPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminRightsImportDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminRightsImportDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminClaimEvidenceLevel": {\n        "type": "string",\n        "description": "Evidence level of a claim or of one child order (contracts/enums/order.yaml claim_evidence_level; BR-ATTR-18).",\n        "enum": [\n          "strong",\n          "weak",\n          "none"\n        ]\n      },\n      "AdminClaimMatchField": {\n        "type": "string",\n        "description": "Field compared between what the user submitted and what the union reported (enum admin_claim_match_field).",\n        "enum": [\n          "order_no",\n          "paid_date"\n        ]\n      },\n      "AdminClaimEvidenceScene": {\n        "type": "string",\n        "description": "Scene of a link record counted as evidence (contracts/enums/trade.yaml scene).",\n        "enum": [\n          "search",\n          "detail",\n          "home_card",\n          "feed",\n          "clipboard",\n          "agent",\n          "share",\n          "h5",\n          "push",\n          "taolijin",\n          "watch_alert",\n          "share_ext",\n          "wechat_bot",\n          "mcp"\n        ]\n      },\n      "AdminClaimApplicant": {\n        "type": "object",\n        "description": "The applicant of a claim as the console shows it; the phone number only masked (BR-ID-33).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "phone_masked"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          }\n        }\n      },\n      "AdminClaimListItem": {\n        "type": "object",\n        "description": "A claim row of the review list (04 §3.2 claims). Not the user-side OrderClaim. The display\\nnumber of a claim is its claim_id (展示编号即 claim_id); there is no separate claim number.\\n",\n        "additionalProperties": false,\n        "required": [\n          "claim_id",\n          "order_no",\n          "platform",\n          "user",\n          "paid_date",\n          "submitted_at",\n          "evidence_level",\n          "status"\n        ],\n        "properties": {\n          "claim_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The order number as the user submitted it, spaces removed."\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminClaimApplicant"\n          },\n          "paid_date": {\n            "type": "string",\n            "format": "date",\n            "description": "Payment date as the user submitted it, YYYY-MM-DD in +08:00."\n          },\n          "submitted_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the claim was submitted."\n          },\n          "evidence_level": {\n            "description": "The claim\'s evidence level (its weakest child order); null while the claim is submitted and its evidence is not yet settled.",\n            "oneOf": [\n              {\n                "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "status": {\n            "$ref": "#/components/schemas/ClaimStatus"\n          }\n        }\n      },\n      "AdminClaimStatusCounts": {\n        "type": "object",\n        "description": "Number of claims per claim_status value, counted with every filter of the request except\\nstatus (0 included).\\n",\n        "additionalProperties": false,\n        "required": [\n          "submitted",\n          "auto_matched",\n          "manual_review",\n          "approved",\n          "rejected",\n          "cancelled"\n        ],\n        "properties": {\n          "submitted": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "auto_matched": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "manual_review": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "approved": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "rejected": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "cancelled": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminClaimPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total",\n          "counts"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "counts": {\n            "$ref": "#/components/schemas/AdminClaimStatusCounts"\n          }\n        }\n      },\n      "AdminClaimPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminClaimPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminClaimMatch": {\n        "type": "object",\n        "description": "One field of the evidence view, the user\'s value against the union\'s.",\n        "additionalProperties": false,\n        "required": [\n          "field",\n          "user_value",\n          "union_value",\n          "matched"\n        ],\n        "properties": {\n          "field": {\n            "$ref": "#/components/schemas/AdminClaimMatchField"\n          },\n          "user_value": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "What the user submitted, in the contract\'s format (a date as YYYY-MM-DD)."\n          },\n          "union_value": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "What the union reported for this child order, same format; null when the union gave none."\n          },\n          "matched": {\n            "type": "boolean",\n            "description": "The server\'s verdict whether the two agree (for order_no after the same normalisation as BR-ATTR-17)."\n          }\n        }\n      },\n      "AdminClaimEvidenceLink": {\n        "type": "object",\n        "description": "A link record counted as evidence; its time and scene only, no product, shop, promotion or raw union data.",\n        "additionalProperties": false,\n        "required": [\n          "at",\n          "scene"\n        ],\n        "properties": {\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "scene": {\n            "description": "The record\'s scene; null for a historical record that carries no channel (历史记录可能无渠道).",\n            "oneOf": [\n              {\n                "$ref": "#/components/schemas/AdminClaimEvidenceScene"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AdminClaimItem": {\n        "type": "object",\n        "description": "One child order of a claim (04 §3.2 claim_items). Not the user-side OrderClaimItem.",\n        "additionalProperties": false,\n        "required": [\n          "item_id",\n          "sub_order_id",\n          "evidence",\n          "decision",\n          "reject_reason",\n          "decided_at",\n          "decided_by",\n          "decided_by_name",\n          "row_version",\n          "matches",\n          "evidence_links"\n        ],\n        "properties": {\n          "item_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "sub_order_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The child order number."\n          },\n          "evidence": {\n            "description": "This child order\'s evidence level; null while the claim is submitted and its evidence is not yet settled.",\n            "oneOf": [\n              {\n                "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "decision": {\n            "description": "null while pending.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ClaimItemDecision"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reject_reason": {\n            "description": "Set with a rejection only, else null.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ClaimRejectReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "decided_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the decision was made; null while pending."\n          },\n          "decided_by": {\n            "description": "admin_id of the reviewer; null while pending or when the system decided.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "decided_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The reviewer\'s display name (admin_users.display_name, else the username); null when decided_by is null or the account is gone."\n          },\n          "row_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "CAS value; the expected_row_version of the approve and reject operations."\n          },\n          "matches": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimMatch"\n            }\n          },\n          "evidence_links": {\n            "type": "array",\n            "description": "Newest first; empty for evidence none.",\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimEvidenceLink"\n            }\n          }\n        }\n      },\n      "AdminClaimDetail": {\n        "type": "object",\n        "description": "A claim as the review page sees it: the list row\'s fields plus the latest note and the\\nchild orders. The display number is the claim_id. Not the user-side OrderClaim.\\n",\n        "additionalProperties": false,\n        "required": [\n          "claim_id",\n          "order_no",\n          "platform",\n          "user",\n          "paid_date",\n          "submitted_at",\n          "evidence_level",\n          "status",\n          "reason",\n          "items"\n        ],\n        "properties": {\n          "claim_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "order_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The order number as the user submitted it, spaces removed."\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminClaimApplicant"\n          },\n          "paid_date": {\n            "type": "string",\n            "format": "date"\n          },\n          "submitted_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "evidence_level": {\n            "description": "As the list row\'s; null while the claim is submitted.",\n            "oneOf": [\n              {\n                "$ref": "#/components/schemas/AdminClaimEvidenceLevel"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "status": {\n            "$ref": "#/components/schemas/ClaimStatus"\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Note of the latest approval or rejection (claims.reason); null before any."\n          },\n          "items": {\n            "type": "array",\n            "minItems": 1,\n            "items": {\n              "$ref": "#/components/schemas/AdminClaimItem"\n            }\n          }\n        }\n      },\n      "AdminClaimDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminClaimDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminClaimReviewReason": {\n        "type": "string",\n        "minLength": 5,\n        "maxLength": 200,\n        "description": "The review note, required for approval and rejection (BR-ATTR-20: at least 5\\ncharacters); at least 5 characters also after trimming surrounding whitespace, stored\\ntrimmed in claims.reason and the audit log.\\n"\n      },\n      "AdminClaimStaffRejectReason": {\n        "type": "string",\n        "description": "The reject reasons a reviewer may choose (enum claim_reject_reason, its first six codes;\\nBR-ATTR-18). NOT_IN_POOL and ORDER_INVALID are set by the system only.\\n",\n        "enum": [\n          "NO_EVIDENCE",\n          "EXPIRED_CLICK",\n          "NOT_TRACKED",\n          "OTHER_TLJ",\n          "FRAUD",\n          "OTHER"\n        ]\n      },\n      "AdminApproveClaimItemRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version",\n          "reason"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              }\n            ],\n            "description": "The child order\'s row_version as the console showed it; a mismatch is 20902 (claim_item)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminClaimReviewReason"\n          }\n        }\n      },\n      "AdminRejectClaimItemRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version",\n          "reason",\n          "reject_reason"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              }\n            ],\n            "description": "The child order\'s row_version as the console showed it; a mismatch is 20902 (claim_item)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminClaimReviewReason"\n          },\n          "reject_reason": {\n            "$ref": "#/components/schemas/AdminClaimStaffRejectReason"\n          }\n        }\n      },\n      "AdminSearchHitType": {\n        "type": "string",\n        "description": "Type of a search hit (enum admin_search_hit_type); each is returned only to accounts holding\\nits permission point: order order.view, user user.lookup, withdrawal fund.view.\\n",\n        "enum": [\n          "order",\n          "user",\n          "withdrawal"\n        ]\n      },\n      "AdminSearchItem": {\n        "type": "object",\n        "description": "One hit of the top-bar search.",\n        "additionalProperties": false,\n        "required": [\n          "type",\n          "id",\n          "summary"\n        ],\n        "properties": {\n          "type": {\n            "$ref": "#/components/schemas/AdminSearchHitType"\n          },\n          "id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "summary": {\n            "type": "string",\n            "description": "Masked one-line summary for the candidate list (phone masked 3 + 4, BR-ID-33); never a\\nfull phone, identity or payout account number. Display only, not parsed by clients.\\n",\n            "minLength": 1,\n            "maxLength": 200\n          }\n        }\n      },\n      "AdminSearch": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "truncated"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Hits the account may see, at most 10; an order or withdrawal is followed by its owner.",\n            "maxItems": 10,\n            "items": {\n              "$ref": "#/components/schemas/AdminSearchItem"\n            }\n          },\n          "truncated": {\n            "type": "boolean",\n            "description": "True when there were more than 10 hits and only the first 10 are returned."\n          }\n        }\n      },\n      "AdminSearchResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSearch"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserRevealField": {\n        "type": "string",\n        "description": "The sensitive field to show in full. Only phone (permission point pii.reveal_phone) for\\nnow; the identity number and payout account (pii.reveal_identity) come later.\\n",\n        "enum": [\n          "phone"\n        ]\n      },\n      "AdminUserRevealRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "field",\n          "reason"\n        ],\n        "properties": {\n          "field": {\n            "$ref": "#/components/schemas/AdminUserRevealField"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminUserReveal": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "field",\n          "value"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "field": {\n            "$ref": "#/components/schemas/AdminUserRevealField"\n          },\n          "value": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The full value (for phone, the normalised 11-digit number)."\n          }\n        }\n      },\n      "AdminUserRevealResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUserReveal"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUserRiskStateAction": {\n        "type": "string",\n        "description": "ban and unban (permission point risk.ban), freeze and unfreeze (risk.freeze); 04 §11.2,\\nBR-ID-31, BR-ID-36.\\n",\n        "enum": [\n          "ban",\n          "unban",\n          "freeze",\n          "unfreeze"\n        ]\n      },\n      "AdminUserRiskStateUpdateRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "action",\n          "reason",\n          "expected_row_version"\n        ],\n        "properties": {\n          "action": {\n            "$ref": "#/components/schemas/AdminUserRiskStateAction"\n          },\n          "reason_category": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRiskReasonCategory"\n              }\n            ],\n            "description": "Required for ban and freeze; not accepted for unban and unfreeze (20001)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          },\n          "frozen_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Only for freeze: end of the freeze, later than the server\'s current time; null or\\nabsent = without end (BR-ID-36). Given with another action → 20001.\\n"\n          },\n          "expected_row_version": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "risk.row_version as the console showed it; null = no row seen, only accepted while the\\nuser still has no row. Any mismatch (null against an existing row, an integer against\\nno row or another version) is 20902.\\n"\n          }\n        }\n      },\n      "AdminUserUnionBindingActionRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "reason",\n          "expected_row_version"\n        ],\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          },\n          "expected_row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminRowVersion"\n              }\n            ],\n            "description": "The binding\'s row_version as the console showed it; a mismatch is 20902."\n          }\n        }\n      },\n      "AgentSession": {\n        "type": "object",\n        "description": "An Agent conversation (agent_sessions; owner and expiry per BR-AI-20).",\n        "additionalProperties": false,\n        "required": [\n          "session_id",\n          "started_at",\n          "last_active_at"\n        ],\n        "properties": {\n          "session_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "started_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "last_active_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time of the last accepted message; expiry counts from it (BR-AI-20)."\n          }\n        }\n      },\n      "AgentSessionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgentSession"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AgentCurrentSessionData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "session"\n        ],\n        "properties": {\n          "session": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AgentSession"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AgentCurrentSessionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgentCurrentSessionData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AgentMessageRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "client_msg_id",\n          "text"\n        ],\n        "properties": {\n          "client_msg_id": {\n            "type": "string",\n            "description": "Generated by the client, unique in the session; a repeat returns the original run (BR-AI-23 ⑥).",\n            "minLength": 8,\n            "maxLength": 64,\n            "pattern": "^[A-Za-z0-9_-]+$"\n          },\n          "text": {\n            "type": "string",\n            "minLength": 1,\n            "description": "The message. Its length limit is step ⑤ of BR-AI-23 (20001, data.fields=[text]), checked\\nafter ①–④, so the schema sets no maxLength.\\n"\n          },\n          "context": {\n            "$ref": "#/components/schemas/AgentMessageContext"\n          }\n        }\n      },\n      "AgentMessageContext": {\n        "description": "Entry context of 01 §4 情境入口, exactly one of product_key, order_id or text.",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/AgentContextProduct"\n          },\n          {\n            "$ref": "#/components/schemas/AgentContextOrder"\n          },\n          {\n            "$ref": "#/components/schemas/AgentContextText"\n          }\n        ]\n      },\n      "AgentContextProduct": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "product_key"\n        ],\n        "properties": {\n          "product_key": {\n            "$ref": "#/components/schemas/ProductKey"\n          }\n        }\n      },\n      "AgentContextOrder": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "order_id"\n        ],\n        "properties": {\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          }\n        }\n      },\n      "AgentContextText": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "text"\n        ],\n        "properties": {\n          "text": {\n            "type": "string",\n            "description": "Clipboard text, untrusted (BR-AI-05).",\n            "minLength": 1,\n            "maxLength": 2000\n          }\n        }\n      },\n      "AgentFinishReason": {\n        "type": "string",\n        "description": "finish_reason of the done frame (contracts/enums agent_finish_reason, 04 §8.2).",\n        "enum": [\n          "stop",\n          "cancelled",\n          "limit",\n          "budget",\n          "error",\n          "auth_required",\n          "safety",\n          "fallback",\n          "timeout"\n        ]\n      },\n      "AgentHistoryCard": {\n        "type": "object",\n        "description": "A card frame as it was sent, without seq (04 §6.5). data follows\\ncontracts/agent-stream.schema.json card_<type> (earnings_summary: earnings_summary_history\\nonly); an unknown type is shown as fallback_text (03 §7.4).\\n",\n        "additionalProperties": false,\n        "required": [\n          "card_id",\n          "type",\n          "schema_version",\n          "data",\n          "fallback_text"\n        ],\n        "properties": {\n          "card_id": {\n            "type": "string",\n            "description": "Card id inside the session (c1, c2…, BR-AI-05).",\n            "pattern": "^c[1-9][0-9]*$"\n          },\n          "type": {\n            "type": "string",\n            "description": "Card type (contracts/enums agent_card_type); a newer type stays valid for an older client.",\n            "minLength": 1\n          },\n          "schema_version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "data": {\n            "type": "object",\n            "description": "Shape per type in contracts/agent-stream.schema.json (contracts/README.md 书写规则第 12 条).",\n            "additionalProperties": true\n          },\n          "fallback_text": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "AgentHistoryMessage": {\n        "type": "object",\n        "description": "One agent_messages row (04 §6.5 会话历史响应的形状).",\n        "additionalProperties": false,\n        "required": [\n          "message_id",\n          "role",\n          "created_at",\n          "text",\n          "cards",\n          "finish_reason"\n        ],\n        "properties": {\n          "message_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "role": {\n            "type": "string",\n            "description": "agent_messages.role (04 §3.2).",\n            "enum": [\n              "user",\n              "assistant"\n            ]\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "text": {\n            "type": "string",\n            "description": "user, the text as sent; assistant, the text after OutputGuard (\'\' while nothing has been written)."\n          },\n          "cards": {\n            "type": "array",\n            "description": "Always empty for user.",\n            "items": {\n              "$ref": "#/components/schemas/AgentHistoryCard"\n            }\n          },\n          "finish_reason": {\n            "description": "assistant once the run has ended; null for user and for a run still going.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AgentFinishReason"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AgentHistoryData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor",\n          "expired"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Oldest first within the page.",\n            "items": {\n              "$ref": "#/components/schemas/AgentHistoryMessage"\n            }\n          },\n          "next_cursor": {\n            "description": "Cursor of the earlier page; null when there are no earlier messages.",\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "expired": {\n            "type": "boolean",\n            "description": "true when the session has expired; the history is then read-only (BR-AI-20)."\n          }\n        }\n      },\n      "AgentHistoryResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AgentHistoryData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AgentFeedbackRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "feedback"\n        ],\n        "properties": {\n          "feedback": {\n            "type": "string",\n            "description": "agent_messages.feedback (04 §3.2); down marks a badcase (BR-AI-19).",\n            "enum": [\n              "up",\n              "down"\n            ]\n          }\n        }\n      },\n      "AgentReportRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "reason"\n        ],\n        "properties": {\n          "reason": {\n            "type": "string",\n            "description": "Free text kept in agent_messages.report_reason; 08 has no reason set yet, so no enum.",\n            "minLength": 1,\n            "maxLength": 200\n          }\n        }\n      },\n      "AdminUnionAuthStatus": {\n        "type": "string",\n        "description": "Station-owner authorization status (enum union_auth_status; 04 §3.2\\nunion_accounts.auth_status, BR-ID-24).\\n",\n        "enum": [\n          "active",\n          "expiring",\n          "expired"\n        ]\n      },\n      "AdminUnionReauthMode": {\n        "type": "string",\n        "description": "How the station-owner credential of the account is renewed (enum union_reauth_mode;\\nBR-ID-24 细则「后台告警手机号与重新授权会话」, orchestrator ruling D10-159 and its supplement).\\n",\n        "enum": [\n          "oauth",\n          "manual",\n          "none"\n        ]\n      },\n      "AdminUnionAuthSessionStatus": {\n        "type": "string",\n        "description": "Status of a console re-authorization session (enum admin_union_auth_session_status; 04 §3.2).",\n        "enum": [\n          "pending",\n          "succeeded",\n          "failed",\n          "expired"\n        ]\n      },\n      "AdminUnionPidStatus": {\n        "type": "string",\n        "description": "PID status (enum union_pid_status; BR-ATTR-02); pending → active → retired only.",\n        "enum": [\n          "pending",\n          "active",\n          "retired"\n        ]\n      },\n      "AdminUnionPidScene": {\n        "type": "string",\n        "description": "PID scene (enum pid_scene; 04 §2.2, BR-ATTR-08).",\n        "enum": [\n          "self_buy",\n          "agent",\n          "share",\n          "taolijin",\n          "fallback",\n          "query"\n        ]\n      },\n      "AdminUnionOptionalReason": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 200,\n        "description": "Optional free-text reason, kept in the audit record (BR-ID-24 细则, BR-ATTR-02 细则)."\n      },\n      "AdminUnionAccountName": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 100,\n        "description": "Display name of a station-owner union account (union_accounts.account_name)."\n      },\n      "AdminUnionAccount": {\n        "type": "object",\n        "description": "A station-owner union account (04 §3.2 union_accounts, §6.6 union-accounts). Never\\ncarries alert_stage or any credential.\\n",\n        "additionalProperties": false,\n        "required": [\n          "union_account_id",\n          "platform",\n          "account_name",\n          "status",\n          "sync_start_at",\n          "auth_expires_at",\n          "auth_expires_estimated",\n          "auth_status",\n          "auth_renewed_at",\n          "auth_renewed_by",\n          "last_probe_at",\n          "last_probe_ok",\n          "last_probe_error",\n          "alert_phones_configured",\n          "reauth_mode"\n        ],\n        "properties": {\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "account_name": {\n            "$ref": "#/components/schemas/AdminUnionAccountName"\n          },\n          "status": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "union_accounts.status as stored; values registered with B1-22 (not an enum yet)."\n          },\n          "sync_start_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Creation time of the app\'s first PID under this account (BR-ATTR-02); null before any."\n          },\n          "auth_expires_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the current station-owner authorization expires; null when unknown."\n          },\n          "auth_expires_estimated": {\n            "type": "boolean",\n            "description": "True when the expiry is estimated (oauth — authorization time + 90 days; manual — entry time + the platform\'s Key validity from the platform registry; BR-ID-24 细则)."\n          },\n          "auth_status": {\n            "$ref": "#/components/schemas/AdminUnionAuthStatus"\n          },\n          "auth_renewed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "auth_renewed_by": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The admin who renewed last; null for an automatic refresh or before any renewal."\n          },\n          "last_probe_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "last_probe_ok": {\n            "type": [\n              "boolean",\n              "null"\n            ]\n          },\n          "last_probe_error": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 500,\n            "description": "Cause recorded by the last failed probe (never a token); null when ok or never probed."\n          },\n          "alert_phones_configured": {\n            "type": "boolean",\n            "description": "False when union.auth_alert_phones is empty (BR-ID-24 ②「未配置告警手机号」)."\n          },\n          "reauth_mode": {\n            "$ref": "#/components/schemas/AdminUnionReauthMode"\n          }\n        }\n      },\n      "AdminUnionAccountList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUnionAccount"\n            }\n          }\n        }\n      },\n      "AdminUnionAccountListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionAccountList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionAccountOption": {\n        "type": "object",\n        "description": "One choice of the union account dropdown of the PID registration form (GET\\n/admin/v1/union/account-options, D10-243): only the identifier, the platform and the\\ndisplay name of a union_accounts row; no status, authorization, probe, alert or\\ncredential field.\\n",\n        "additionalProperties": false,\n        "required": [\n          "union_account_id",\n          "platform",\n          "account_name"\n        ],\n        "properties": {\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "account_name": {\n            "$ref": "#/components/schemas/AdminUnionAccountName"\n          }\n        }\n      },\n      "AdminUnionAccountOptionList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUnionAccountOption"\n            }\n          }\n        }\n      },\n      "AdminUnionAccountOptionListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionAccountOptionList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionAccountResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionAccount"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionReauthorizeRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/union-accounts/{union_account_id}/reauthorize; may be empty.",\n        "additionalProperties": false,\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionReauthSession": {\n        "type": "object",\n        "description": "A new console re-authorization session (04 §3.2 admin_union_auth_sessions).",\n        "additionalProperties": false,\n        "required": [\n          "session_id",\n          "auth_url",\n          "expires_at"\n        ],\n        "properties": {\n          "session_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "auth_url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048,\n            "description": "The union\'s authorization address, valid until expires_at; carries the state once."\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "10 minutes after creation (BR-ID-24 细则)."\n          }\n        }\n      },\n      "AdminUnionReauthSessionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionReauthSession"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionReauthResult": {\n        "type": "object",\n        "description": "A re-authorization session as it is now; never the state, code or credential.",\n        "additionalProperties": false,\n        "required": [\n          "session_id",\n          "union_account_id",\n          "status",\n          "error",\n          "expires_at",\n          "finished_at"\n        ],\n        "properties": {\n          "session_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminUnionAuthSessionStatus"\n          },\n          "error": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Failure cause recorded by the server when failed; null otherwise (values registered with B1-22)."\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "finished_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminUnionReauthResultResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionReauthResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionCredentialRequest": {\n        "type": "object",\n        "description": "Body of PUT /admin/v1/union-accounts/{union_account_id}/credential (reauth_mode manual).",\n        "additionalProperties": false,\n        "required": [\n          "credential"\n        ],\n        "properties": {\n          "credential": {\n            "type": "string",\n            "writeOnly": true,\n            "minLength": 1,\n            "maxLength": 512,\n            "pattern": "^\\\\S(.*\\\\S)?$",\n            "description": "The new station-owner credential in plaintext; only encrypted, never returned or logged."\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Expiry shown by the union, later than now; absent → now + the platform\'s Key validity from the platform registry (not fixed), marked estimated."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionAlertPhoneId": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 128,\n        "pattern": "^[A-Za-z0-9_-]+$",\n        "description": "Identifier of one alert phone, the HMAC of the normalized number as the server encodes it; opaque to the console."\n      },\n      "AdminUnionAlertPhone": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "phone_id",\n          "phone_masked"\n        ],\n        "properties": {\n          "phone_id": {\n            "$ref": "#/components/schemas/AdminUnionAlertPhoneId"\n          },\n          "phone_masked": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "The number masked 3 + 4 (`138****5678`, BR-ID-33); the full number is never returned."\n          }\n        }\n      },\n      "AdminUnionAlertPhones": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "items"\n        ],\n        "properties": {\n          "version": {\n            "$ref": "#/components/schemas/AdminConfigVersionNumber"\n          },\n          "items": {\n            "type": "array",\n            "maxItems": 10,\n            "items": {\n              "$ref": "#/components/schemas/AdminUnionAlertPhone"\n            }\n          }\n        }\n      },\n      "AdminUnionAlertPhonesResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionAlertPhones"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionAlertPhoneAddRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/union-accounts/alert-phones.",\n        "additionalProperties": false,\n        "required": [\n          "phone",\n          "expected_version"\n        ],\n        "properties": {\n          "phone": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "The number as entered; normalized by BR-ID-05 细则 before checking."\n          },\n          "expected_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminConfigVersionNumber"\n              }\n            ],\n            "description": "The `version` of the list as the console showed it; a mismatch is 20902."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionPidCode": {\n        "type": "string",\n        "minLength": 1,\n        "maxLength": 64,\n        "pattern": "^[0-9A-Za-z_-]+$",\n        "description": "A union-side identifier (pid / adzone / positionId, or the taobao site_id) as the union shows it."\n      },\n      "AdminUnionPid": {\n        "type": "object",\n        "description": "A registered PID (04 §3.2 union_pids, §6.6 union-pids).",\n        "additionalProperties": false,\n        "required": [\n          "pid_id",\n          "platform",\n          "union_account_id",\n          "site_id",\n          "pid",\n          "pid_scene",\n          "status",\n          "hjy_ignore_confirmed_at",\n          "hjy_ignore_evidence_path",\n          "row_version",\n          "created_at"\n        ],\n        "properties": {\n          "pid_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "site_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminUnionPidCode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Taobao site id; null on every other platform."\n          },\n          "pid": {\n            "$ref": "#/components/schemas/AdminUnionPidCode"\n          },\n          "pid_scene": {\n            "$ref": "#/components/schemas/AdminUnionPidScene"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminUnionPidStatus"\n          },\n          "hjy_ignore_confirmed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the 花卷云 ignore was confirmed (BR-ATTR-28); null while pending."\n          },\n          "hjy_ignore_evidence_path": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 512,\n            "description": "Private OSS object path of the 花卷云 ignore screenshot; null while pending."\n          },\n          "row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminUnionPidList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUnionPid"\n            }\n          }\n        }\n      },\n      "AdminUnionPidListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionPidList"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionPidResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnionPid"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnionPidCreateRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/union-pids; the new row is always pending.",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "union_account_id",\n          "pid",\n          "pid_scene"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "site_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminUnionPidCode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Required for taobao; absent or null on every other platform."\n          },\n          "pid": {\n            "$ref": "#/components/schemas/AdminUnionPidCode"\n          },\n          "pid_scene": {\n            "$ref": "#/components/schemas/AdminUnionPidScene"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionPidUpdateRequest": {\n        "type": "object",\n        "description": "Body of PATCH /admin/v1/union-pids/{pid_id} (pending rows only): `expected_row_version`\\nplus at least one more field; a body that names none of the five fields (only\\n`expected_row_version` and `reason`) is 20001 with `data.fields=[body]`.\\n",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version"\n        ],\n        "minProperties": 2,\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "union_account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "site_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminUnionPidCode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The taobao site id; null clears it when the row moves to another platform."\n          },\n          "pid": {\n            "$ref": "#/components/schemas/AdminUnionPidCode"\n          },\n          "pid_scene": {\n            "$ref": "#/components/schemas/AdminUnionPidScene"\n          },\n          "expected_row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionPidActivateRequest": {\n        "type": "object",\n        "description": "multipart/form-data body of POST /admin/v1/union-pids/{pid_id}/activate.",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version",\n          "hjy_ignore_confirmed_at",\n          "hjy_ignore_evidence"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          },\n          "hjy_ignore_confirmed_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the 花卷云 ignore was confirmed; not later than now."\n          },\n          "hjy_ignore_evidence": {\n            "type": "string",\n            "contentMediaType": "application/octet-stream",\n            "description": "The screenshot, PNG or JPEG, at most 5 MB (BR-ATTR-02 细则)."\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionPidRetireRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/union-pids/{pid_id}/retire.",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminUnionOptionalReason"\n          }\n        }\n      },\n      "AdminUnionOAuthCallbackRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/union-accounts/oauth/callback: what the console callback page\\nreceived from the union, unchanged: `state` and exactly one of `code` or `error`\\n(neither or both → 20001 with `data.fields=[code]`).\\n",\n        "additionalProperties": false,\n        "required": [\n          "state"\n        ],\n        "minProperties": 2,\n        "maxProperties": 2,\n        "properties": {\n          "state": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 512,\n            "description": "The state the union echoed back; looked up by its hash."\n          },\n          "code": {\n            "type": "string",\n            "writeOnly": true,\n            "minLength": 1,\n            "maxLength": 1024,\n            "description": "The authorization code from the union; exchanged once, never logged or returned."\n          },\n          "error": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "The error the union sent instead of a code; kept as the session\'s failure cause."\n          }\n        }\n      },\n      "AdminPayChannel": {\n        "type": "string",\n        "description": "Pay channel (contracts/enums/pay.yaml pay_channel; BR-PAY-01); not the payout channel.",\n        "enum": [\n          "wechat_pay",\n          "alipay"\n        ]\n      },\n      "AdminPayOrderStatus": {\n        "type": "string",\n        "description": "Pay order status (contracts/enums/pay.yaml pay_order_status; BR-PAY-02); PAID and CLOSED are final.",\n        "enum": [\n          "PENDING",\n          "PAID",\n          "CLOSED"\n        ]\n      },\n      "AdminPayRefundStatus": {\n        "type": "string",\n        "description": "Refund status (contracts/enums/pay.yaml pay_refund_status; BR-PAY-06 ①).",\n        "enum": [\n          "PROCESSING",\n          "SUCCESS",\n          "FAILED"\n        ]\n      },\n      "AdminPayRefundTargetType": {\n        "type": "string",\n        "description": "What a refund pays back (contracts/enums/pay.yaml pay_refund_target_type; BR-PAY-06 ①).",\n        "enum": [\n          "pay_order",\n          "pay_anomaly"\n        ]\n      },\n      "AdminPayRefundReason": {\n        "type": "string",\n        "description": "Refund reason code (contracts/enums/pay.yaml pay_refund_reason; BR-PAY-06); names from admin_dict.pay_refund_reason.",\n        "enum": [\n          "USER_REQUEST",\n          "DUPLICATE_PAYMENT",\n          "ANOMALY_RECEIPT",\n          "RECON_DIFF",\n          "OTHER"\n        ]\n      },\n      "AdminPayQueryAttemptKind": {\n        "type": "string",\n        "description": "Kind of a channel request record (contracts/enums/pay.yaml pay_query_attempt_kind).",\n        "enum": [\n          "query",\n          "close",\n          "refund",\n          "refund_query"\n        ]\n      },\n      "AdminReconDiffStatus": {\n        "type": "string",\n        "description": "Reconciliation difference status (contracts/enums/fund.yaml recon_diff_status).",\n        "enum": [\n          "open",\n          "processing",\n          "adjusted",\n          "written_off",\n          "closed"\n        ]\n      },\n      "AdminPayReconDiffType": {\n        "type": "string",\n        "description": "The R4 types of contracts/enums/fund.yaml recon_diff_type (BR-PAY-07); the other types belong to R1–R3.",\n        "enum": [\n          "pay_mismatch",\n          "pay_anomaly"\n        ]\n      },\n      "AdminPayOrder": {\n        "type": "object",\n        "description": "One pay order (04 §3.2 pay_orders) as the console shows it. `refunded_fen` is the total of\\nits successful refunds (BR-PAY-06 ③); `closing` is true while the close flow runs and\\n`needs_manual` while it waits for POST /admin/v1/pay-orders/{pay_order_id}/resolve\\n(BR-PAY-05). `user_id` is our user; no channel-side user identifier is included.\\n",\n        "additionalProperties": false,\n        "required": [\n          "pay_order_id",\n          "user_id",\n          "biz_type",\n          "biz_ref",\n          "pay_channel",\n          "amount_fen",\n          "refunded_fen",\n          "status",\n          "out_trade_no",\n          "channel_trade_no",\n          "needs_manual",\n          "closing",\n          "expire_at",\n          "paid_at",\n          "closed_at",\n          "created_at"\n        ],\n        "properties": {\n          "pay_order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "biz_type": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The business type that registered the pay order."\n          },\n          "biz_ref": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128,\n            "description": "The business object of that type the pay order pays for."\n          },\n          "pay_channel": {\n            "$ref": "#/components/schemas/AdminPayChannel"\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "refunded_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminPayOrderStatus"\n          },\n          "out_trade_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Our merchant order number, unique and never changed."\n          },\n          "channel_trade_no": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The channel\'s transaction number; null until the channel reports one."\n          },\n          "needs_manual": {\n            "type": "boolean"\n          },\n          "closing": {\n            "type": "boolean"\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "closed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayOrderPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminPayOrder"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminPayOrderPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayOrderPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayQueryAttempt": {\n        "type": "object",\n        "description": "Summary of one channel request record (pay_query_attempts); the request and response bodies are never returned.",\n        "additionalProperties": false,\n        "required": [\n          "kind",\n          "result",\n          "at"\n        ],\n        "properties": {\n          "kind": {\n            "$ref": "#/components/schemas/AdminPayQueryAttemptKind"\n          },\n          "result": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The outcome the server recorded for the request (pay_query_attempts.result), such as ok or unknown."\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayOrderDetail": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "pay_order",\n          "refunds",\n          "query_attempts"\n        ],\n        "properties": {\n          "pay_order": {\n            "$ref": "#/components/schemas/AdminPayOrder"\n          },\n          "refunds": {\n            "type": "array",\n            "description": "The pay order\'s refunds, newest first.",\n            "items": {\n              "$ref": "#/components/schemas/AdminPayRefund"\n            }\n          },\n          "query_attempts": {\n            "type": "array",\n            "description": "The 20 newest channel requests of the pay order and its refunds, newest first.",\n            "maxItems": 20,\n            "items": {\n              "$ref": "#/components/schemas/AdminPayQueryAttempt"\n            }\n          }\n        }\n      },\n      "AdminPayOrderDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayOrderDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayOrderResolveRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/pay-orders/{pay_order_id}/resolve: fixed values only. The server\\nqueries the channel itself; the console sends no status, channel result or evidence.\\n",\n        "additionalProperties": false,\n        "required": [\n          "expected_status",\n          "action"\n        ],\n        "properties": {\n          "expected_status": {\n            "type": "string",\n            "description": "CAS on the pay order status; only PENDING (subset of pay_order_status).",\n            "enum": [\n              "PENDING"\n            ]\n          },\n          "action": {\n            "type": "string",\n            "description": "Query the channel now and settle by its answer (BR-PAY-05 ③).",\n            "enum": [\n              "query_and_settle"\n            ]\n          }\n        }\n      },\n      "AdminPayChannelResult": {\n        "type": "object",\n        "description": "Summary of the query the server made for the settlement (its evidence, BR-PAY-05 ③; the\\nrecorded response itself is not returned). `state` is how the server read the answer:\\npaid (→ PAID), closed (→ CLOSED), not_exist (CLOSED only under the BR-PAY-05 ② condition,\\notherwise unchanged) or unknown (unchanged). `channel_state` is the channel\'s own status\\ncode as received (null when the query gave none); no channel-side user identifier.\\n",\n        "additionalProperties": false,\n        "required": [\n          "state",\n          "channel_state",\n          "channel_trade_no",\n          "queried_at"\n        ],\n        "properties": {\n          "state": {\n            "type": "string",\n            "enum": [\n              "paid",\n              "closed",\n              "not_exist",\n              "unknown"\n            ]\n          },\n          "channel_state": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64\n          },\n          "channel_trade_no": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64\n          },\n          "queried_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayOrderResolveResult": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "pay_order",\n          "channel_result"\n        ],\n        "properties": {\n          "pay_order": {\n            "$ref": "#/components/schemas/AdminPayOrder"\n          },\n          "channel_result": {\n            "$ref": "#/components/schemas/AdminPayChannelResult"\n          }\n        }\n      },\n      "AdminPayOrderResolveResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayOrderResolveResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayRefundCreateRequest": {\n        "type": "object",\n        "description": "Body of the two original-route refund operations. The target comes from the path; the\\nchannel, refund number, operator and status are set by the server.\\n",\n        "additionalProperties": false,\n        "required": [\n          "amount_fen",\n          "reason_code"\n        ],\n        "properties": {\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1,\n            "description": "Positive integer fen; with the successful and processing refunds at most the refundable amount (else 20001)."\n          },\n          "reason_code": {\n            "$ref": "#/components/schemas/AdminPayRefundReason"\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Optional free text kept with the refund and in the audit record."\n          }\n        }\n      },\n      "AdminPayRefund": {\n        "type": "object",\n        "description": "One refund (04 §3.2 pay_refunds); `out_refund_no` is generated at creation, unique and never changed.",\n        "additionalProperties": false,\n        "required": [\n          "pay_refund_id",\n          "target_type",\n          "target_id",\n          "out_refund_no",\n          "amount_fen",\n          "reason_code",\n          "note",\n          "status",\n          "channel_refund_no",\n          "operator",\n          "created_at",\n          "succeeded_at"\n        ],\n        "properties": {\n          "pay_refund_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "target_type": {\n            "$ref": "#/components/schemas/AdminPayRefundTargetType"\n          },\n          "target_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "out_refund_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "reason_code": {\n            "$ref": "#/components/schemas/AdminPayRefundReason"\n          },\n          "note": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminPayRefundStatus"\n          },\n          "channel_refund_no": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The channel\'s refund number; null until the channel reports one."\n          },\n          "operator": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "succeeded_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayRefundResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayRefund"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayRefundPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminPayRefund"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminPayRefundPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayRefundPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayAnomaly": {\n        "type": "object",\n        "description": "One pay anomaly (04 §3.2 pay_anomalies; BR-PAY-05 ④): money received for a CLOSED pay\\norder or for a merchant order number that names no pay order (then `pay_order_id` is null;\\n`out_trade_no` is null when the channel gave none). The evidence is kept server side and not returned.\\n",\n        "additionalProperties": false,\n        "required": [\n          "pay_anomaly_id",\n          "pay_channel",\n          "channel_trade_no",\n          "out_trade_no",\n          "pay_order_id",\n          "amount_fen",\n          "refunded_fen",\n          "status",\n          "created_at"\n        ],\n        "properties": {\n          "pay_anomaly_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "pay_channel": {\n            "$ref": "#/components/schemas/AdminPayChannel"\n          },\n          "channel_trade_no": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "out_trade_no": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64\n          },\n          "pay_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Our pay order when the merchant order number names one (a CLOSED pay order), else null."\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "refunded_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "status": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "pay_anomalies.status as stored; 04 §3.2 names the column but fixes no value set yet, so it is not an enum here."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayAnomalyPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminPayAnomaly"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminPayAnomalyPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayAnomalyPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayReconDiff": {\n        "type": "object",\n        "description": "One reconciliation difference of source R4 (04 §3.2 recon_diffs; BR-PAY-07). `diff_fen` = `expected_fen` − `actual_fen`.",\n        "additionalProperties": false,\n        "required": [\n          "recon_diff_id",\n          "source",\n          "type",\n          "period",\n          "ref_type",\n          "ref_id",\n          "expected_fen",\n          "actual_fen",\n          "diff_fen",\n          "status",\n          "created_at",\n          "closed_at"\n        ],\n        "properties": {\n          "recon_diff_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "source": {\n            "type": "string",\n            "description": "Always R4 (收款对账) here.",\n            "enum": [\n              "R4"\n            ]\n          },\n          "type": {\n            "$ref": "#/components/schemas/AdminPayReconDiffType"\n          },\n          "period": {\n            "type": "string",\n            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$",\n            "description": "The channel bill date (YYYY-MM-DD)."\n          },\n          "ref_type": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "What the difference refers to, such as pay_order, pay_refund or pay_anomaly."\n          },\n          "ref_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "expected_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "actual_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "diff_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminReconDiffStatus"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "closed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPayReconDiffPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminPayReconDiff"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminPayReconDiffPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayReconDiffPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminReconDiffType": {\n        "type": "string",\n        "description": "The R1–R3 types of contracts/enums/fund.yaml recon_diff_type (BR-FUND-01, BR-FUND-04, BR-FUND-19, BR-FUND-22, BR-FUND-23); the R4 types pay_mismatch and pay_anomaly are AdminPayReconDiffType.",\n        "enum": [\n          "union_mismatch",\n          "channel_mismatch",\n          "ledger_mismatch",\n          "platform_restore",\n          "month_end_unbalanced",\n          "settle_amount_mismatch",\n          "settle_missing",\n          "appeal_restore",\n          "estimate_changed_after_credit"\n        ]\n      },\n      "AdminReconDiffSource": {\n        "type": "string",\n        "description": "Source of a difference listed under /admin/v1/recon-diffs (recon_diffs.source without R4) — R1 联盟对账, R2 通道对账, R3 内部日终与月末核对.",\n        "enum": [\n          "R1",\n          "R2",\n          "R3"\n        ]\n      },\n      "AdminReconDiffPeriod": {\n        "type": "string",\n        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$",\n        "description": "A reconciliation period, a month (YYYY-MM) or a day (YYYY-MM-DD), as recon_diffs.period."\n      },\n      "AdminReconDiff": {\n        "type": "object",\n        "description": "One reconciliation difference of source R1, R2 or R3 (04 §3.2 recon_diffs). `diff_fen` = `expected_fen` − `actual_fen`.",\n        "additionalProperties": false,\n        "required": [\n          "recon_diff_id",\n          "source",\n          "type",\n          "period",\n          "ref_type",\n          "ref_id",\n          "expected_fen",\n          "actual_fen",\n          "diff_fen",\n          "status",\n          "created_at",\n          "closed_at"\n        ],\n        "properties": {\n          "recon_diff_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "source": {\n            "$ref": "#/components/schemas/AdminReconDiffSource"\n          },\n          "type": {\n            "$ref": "#/components/schemas/AdminReconDiffType"\n          },\n          "period": {\n            "$ref": "#/components/schemas/AdminReconDiffPeriod"\n          },\n          "ref_type": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "What the difference refers to, such as order, account or settlement."\n          },\n          "ref_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "expected_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "actual_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "diff_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminReconDiffStatus"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "closed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminReconDiffPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminReconDiff"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminReconDiffPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminReconDiffPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminReconDiffDetail": {\n        "type": "object",\n        "description": "One reconciliation difference of source R1, R2 or R3 with its handling summary: the fields\\nof AdminReconDiff plus `handler_id` (admin_users.id of who handled it; null until handled),\\n`updated_at` and `resolution` (recon_diffs.resolution; null while unhandled). The keys of\\n`resolution` are not fixed by this contract; it is for display only.\\n",\n        "additionalProperties": false,\n        "required": [\n          "recon_diff_id",\n          "source",\n          "type",\n          "period",\n          "ref_type",\n          "ref_id",\n          "expected_fen",\n          "actual_fen",\n          "diff_fen",\n          "status",\n          "created_at",\n          "closed_at",\n          "handler_id",\n          "updated_at",\n          "resolution"\n        ],\n        "properties": {\n          "recon_diff_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "source": {\n            "$ref": "#/components/schemas/AdminReconDiffSource"\n          },\n          "type": {\n            "$ref": "#/components/schemas/AdminReconDiffType"\n          },\n          "period": {\n            "$ref": "#/components/schemas/AdminReconDiffPeriod"\n          },\n          "ref_type": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "What the difference refers to, such as order, account or settlement."\n          },\n          "ref_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          },\n          "expected_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "actual_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "diff_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminReconDiffStatus"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "closed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "handler_id": {\n            "description": "admin_users.id of the admin who handled the difference; null until handled.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "updated_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "resolution": {\n            "type": [\n              "object",\n              "null"\n            ],\n            "description": "The handling summary as stored (recon_diffs.resolution), for display only; its keys are not fixed by this contract. Null while unhandled.",\n            "additionalProperties": true\n          }\n        }\n      },\n      "AdminReconDiffCloseRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/recon-diffs/{recon_diff_id}/close.",\n        "additionalProperties": false,\n        "required": [\n          "reason"\n        ],\n        "properties": {\n          "reason": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Why the difference is closed without further handling; 1–200 characters after trimming, else 20001 with data.fields=[reason]. Stored as resolution.reason."\n          },\n          "outcome": {\n            "$ref": "#/components/schemas/AdminReconDiffOutcome",\n            "description": "Optional structured conclusion, for type=settle_amount_mismatch (source R1) only; any other type or source → 20001 with data.fields=[outcome] from B2-09h on. Stored as resolution.outcome from B2-09h on; do not send it before then."\n          }\n        }\n      },\n      "AdminReconDiffOutcome": {\n        "type": "string",\n        "description": "contracts/enums/admin.yaml admin_recon_diff_outcome: the structured conclusion of a\\nsettle_amount_mismatch difference of source R1 (D10-447 ②, D10-506; BR-FUND-04 ④, 校验结果\\ntable, 例 2), optional in the close request and stored as resolution.outcome (written from\\nB2-09h on). union = 以联盟为准: counts as matched in the monthly check, and the order goes\\non to a supplement batch, only while the current base_fen and B_settle both equal the\\ndifference\'s expected_fen and actual_fen; otherwise the amounts are compared as usual, a\\nmismatch opens a new settle_amount_mismatch difference with ref_id\\n{order_key}#AMT#{base_fen}:{b_settle_fen} and the order stays WAITING. ours =\\n以我方为准: does not count as matched. Sent for any other type or source → 20001 with\\ndata.fields=[outcome] (from B2-09h on; see closeAdminReconDiff for the window before it).\\n",\n        "enum": [\n          "union",\n          "ours"\n        ]\n      },\n      "AdminReconDiffClose": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "recon_diff",\n          "released_hold_count"\n        ],\n        "properties": {\n          "recon_diff": {\n            "$ref": "#/components/schemas/AdminReconDiffDetail"\n          },\n          "released_hold_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Withdrawal holds whose source is this difference that this call released (holds released earlier are not counted)."\n          }\n        }\n      },\n      "AdminReconDiffCloseResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminReconDiffClose"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminReconDiffWriteOffRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/recon-diffs/{recon_diff_id}/write-off. The console confirms the\\nwithdrawal status it showed and may leave a note; the evidence is the bill line stored with\\nthe difference, never sent by the console.\\n",\n        "additionalProperties": false,\n        "required": [\n          "expected_withdrawal_status"\n        ],\n        "properties": {\n          "expected_withdrawal_status": {\n            "type": "string",\n            "description": "Compare-and-set on the withdrawal status; only APPROVED (subset of withdrawal_status), else 20902 with data.resource=withdrawal.",\n            "enum": [\n              "APPROVED"\n            ]\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Optional operator note, 1–200 characters after trimming (else 20001 with data.fields=[note]); recorded under resolution.note."\n          }\n        }\n      },\n      "AdminReconDiffWriteOffWithdrawal": {\n        "type": "object",\n        "description": "The withdrawal after W11, as GET /admin/v1/withdrawals/{withdrawal_id} shows these fields.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "status",\n          "paid_at",\n          "channel_order_id"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "$ref": "#/components/schemas/WithdrawalStatus"\n          },\n          "paid_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "The bill line\'s time when it carries one, else 00:00 +08:00 of the bill day (D10-431); never the time of the write-off."\n          },\n          "channel_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The channel\'s order id from the bill line; null when the line has none."\n          }\n        }\n      },\n      "AdminReconDiffWriteOff": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "recon_diff",\n          "withdrawal",\n          "released_hold_count"\n        ],\n        "properties": {\n          "recon_diff": {\n            "$ref": "#/components/schemas/AdminReconDiffDetail"\n          },\n          "withdrawal": {\n            "$ref": "#/components/schemas/AdminReconDiffWriteOffWithdrawal"\n          },\n          "released_hold_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Withdrawal holds whose source is this difference that this call released (holds released earlier are not counted)."\n          }\n        }\n      },\n      "AdminReconDiffWriteOffResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminReconDiffWriteOff"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminReconDiffRestoreRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/recon-diffs/{recon_diff_id}/restore. The console sends no amount:\\nthe amount is calculated by the server (BR-FUND-22 ③); `expected_fen` is for display only.\\n",\n        "additionalProperties": false,\n        "properties": {\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Optional operator note, 1–200 characters after trimming (else 20001 with data.fields=[note]); recorded under resolution.note."\n          }\n        }\n      },\n      "AdminReconDiffRestore": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "recon_diff",\n          "restored_fen"\n        ],\n        "properties": {\n          "recon_diff": {\n            "$ref": "#/components/schemas/AdminReconDiffDetail"\n          },\n          "restored_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Total this call paid to the member over all roles; 0 when nothing was posted (D10-469 ③, D10-482). Never `expected_fen` taken as is."\n          }\n        }\n      },\n      "AdminReconDiffRestoreResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminReconDiffRestore"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAdjustmentStatus": {\n        "type": "string",\n        "description": "Status of a manual adjustment form (contracts/enums/fund.yaml admin_adjustment_status).\\nForms a person submits are born APPROVED; only system-prefilled forms are PENDING. 已红冲\\nis not a status (BR-TEXT-25).\\n",\n        "enum": [\n          "PENDING",\n          "APPROVED",\n          "REJECTED",\n          "CANCELLED"\n        ]\n      },\n      "AdminAdjustmentDirection": {\n        "type": "string",\n        "description": "Direction on the member\'s available balance (contracts/enums/fund.yaml admin_adjustment_direction).",\n        "enum": [\n          "increase",\n          "decrease"\n        ]\n      },\n      "AdminAdjustmentReasonCode": {\n        "type": "string",\n        "description": "The reason code, equal to the ADMIN_ADJUST sub_type (contracts/enums/fund.yaml admin_adjust_sub_type; BR-FUND-24 ②).",\n        "enum": [\n          "RESTORE",\n          "RECON_FIX",\n          "PAYOUT_RECOVERY",\n          "ACCOUNT_CLOSED",\n          "OTHER"\n        ]\n      },\n      "AdminAdjustmentRefType": {\n        "type": "string",\n        "description": "Type of a linked document (contracts/enums/fund.yaml admin_adjustment_ref_type;\\nBR-FUND-24 ③): `recon_diff` (`ref_id` = recon_diffs.id, not of source R4), `withdrawal`\\n(withdrawals.id), `order` (the sub-order\'s order_key), `account_deletion`\\n(deletion_requests.id).\\n",\n        "enum": [\n          "recon_diff",\n          "withdrawal",\n          "order",\n          "account_deletion"\n        ]\n      },\n      "AdminAdjustmentRef": {\n        "type": "object",\n        "description": "One linked document of an adjustment form (BR-FUND-24 ③).",\n        "additionalProperties": false,\n        "required": [\n          "ref_type",\n          "ref_id"\n        ],\n        "properties": {\n          "ref_type": {\n            "$ref": "#/components/schemas/AdminAdjustmentRefType"\n          },\n          "ref_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128,\n            "description": "The document\'s id, or the order_key for ref_type `order`."\n          }\n        }\n      },\n      "AdminAdjustmentContraSubject": {\n        "type": "string",\n        "description": "The ledger subject opposite USER_BALANCE.available (contracts/enums/fund.yaml\\nadmin_adjustment_contra_subject; BR-FUND-24 ⑥, specs/ledger-rules.md §6, pending the\\nfinance confirmation).\\n",\n        "enum": [\n          "COMMISSION_REVENUE",\n          "UNION_RECEIVABLE",\n          "BAD_DEBT",\n          "MKT_EXPENSE",\n          "CASH_ALIPAY",\n          "CASH_WECHAT",\n          "CASH_BANK"\n        ]\n      },\n      "AdminAdjustment": {\n        "type": "object",\n        "description": "One manual adjustment form (04 §3.2 admin_adjustments). `amount_fen` is null on an\\nACCOUNT_CLOSED form until it is approved (BR-FUND-24 ⑧), so also on a rejected one.\\n`created_by` is null on a form the system prefilled. `refs` is empty on a reversal, whose\\nlink is `reverses_adjust_id`, and on an OTHER form whose `note` stands in for a document.\\n`reversed_by_adjust_id` is the reversal of this form, null when it has none: the console\\nshows 已红冲 from it and links to that form. `contra_platform` is set only for\\nUNION_RECEIVABLE. `voucher_id` (the voucher, also the link to the balance history) is\\nnull until the form is executed.\\n",\n        "additionalProperties": false,\n        "required": [\n          "adjust_id",\n          "user_id",\n          "direction",\n          "amount_fen",\n          "reason_code",\n          "refs",\n          "contra_subject",\n          "contra_platform",\n          "note",\n          "status",\n          "reverses_adjust_id",\n          "reversed_by_adjust_id",\n          "created_by",\n          "created_at",\n          "reviewed_by",\n          "reviewed_at",\n          "reject_note",\n          "voucher_id"\n        ],\n        "properties": {\n          "adjust_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "direction": {\n            "$ref": "#/components/schemas/AdminAdjustmentDirection"\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "reason_code": {\n            "$ref": "#/components/schemas/AdminAdjustmentReasonCode"\n          },\n          "refs": {\n            "type": "array",\n            "maxItems": 10,\n            "items": {\n              "$ref": "#/components/schemas/AdminAdjustmentRef"\n            }\n          },\n          "contra_subject": {\n            "$ref": "#/components/schemas/AdminAdjustmentContraSubject"\n          },\n          "contra_platform": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/PlatformCode"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "note": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 500,\n            "description": "Internal explanation, shown in the console only (BR-FUND-24 ⑦)."\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminAdjustmentStatus"\n          },\n          "reverses_adjust_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reversed_by_adjust_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "created_by": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "reviewed_by": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "reviewed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "reject_note": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200\n          },\n          "voucher_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AdminAdjustmentPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminAdjustment"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminAdjustmentPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAdjustmentPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAdjustmentBalancePreview": {\n        "type": "object",\n        "description": "What executing the form now would do to `available` (BR-FUND-24 ④), read when the detail\\nis read: the form itself for a PENDING form, its reversal for an APPROVED one.\\n",\n        "additionalProperties": false,\n        "required": [\n          "direction",\n          "amount_fen",\n          "available_before_fen",\n          "available_after_fen"\n        ],\n        "properties": {\n          "direction": {\n            "$ref": "#/components/schemas/AdminAdjustmentDirection"\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "available_before_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "available_after_fen": {\n            "$ref": "#/components/schemas/Fen"\n          }\n        }\n      },\n      "AdminAdjustmentDetail": {\n        "type": "object",\n        "description": "One adjustment form with `balance_preview` (null unless the form can still be executed or reversed, so null on an APPROVED form once its member is deleted).",\n        "additionalProperties": false,\n        "required": [\n          "adjustment",\n          "balance_preview"\n        ],\n        "properties": {\n          "adjustment": {\n            "$ref": "#/components/schemas/AdminAdjustment"\n          },\n          "balance_preview": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminAdjustmentBalancePreview"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "AdminAdjustmentDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAdjustmentDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAdjustmentCreateNew": {\n        "type": "object",\n        "description": "A new adjustment. Which `refs`, `note`, `contra_subject` and `contra_platform` a reason code needs is in POST /admin/v1/adjustments.",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "direction",\n          "amount_fen",\n          "reason_code"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "direction": {\n            "$ref": "#/components/schemas/AdminAdjustmentDirection"\n          },\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1,\n            "description": "Integer fen above 0, no upper limit (BR-FUND-24 ④)."\n          },\n          "reason_code": {\n            "type": "string",\n            "description": "Only these three can be chosen; RESTORE and ACCOUNT_CLOSED → 20001 at the schema (see AdminAdjustmentCreateRequest).",\n            "enum": [\n              "RECON_FIX",\n              "PAYOUT_RECOVERY",\n              "OTHER"\n            ]\n          },\n          "refs": {\n            "type": "array",\n            "maxItems": 10,\n            "items": {\n              "$ref": "#/components/schemas/AdminAdjustmentRef"\n            }\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 500,\n            "description": "Internal explanation, at most 500 characters, not blank after trimming; required for OTHER."\n          },\n          "contra_subject": {\n            "type": "string",\n            "description": "RECON_FIX and OTHER only, required for them (BR-FUND-24 ⑥).",\n            "enum": [\n              "COMMISSION_REVENUE",\n              "UNION_RECEIVABLE",\n              "BAD_DEBT",\n              "MKT_EXPENSE"\n            ]\n          },\n          "contra_platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          }\n        }\n      },\n      "AdminAdjustmentCreateReversal": {\n        "type": "object",\n        "description": "A whole-form reversal; everything else comes from the original (BR-FUND-24 细则「红冲只按原单整笔」).",\n        "additionalProperties": false,\n        "required": [\n          "reverses_adjust_id",\n          "note"\n        ],\n        "properties": {\n          "reverses_adjust_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 500,\n            "description": "The reason for the reversal, at most 500 characters, not blank after trimming."\n          }\n        }\n      },\n      "AdminAdjustmentCreateRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/adjustments, a new adjustment or a reversal. Each branch is a closed object; a body that fits neither is 20001 with data.fields listing what fails in both branches plus `body`.",\n        "unevaluatedProperties": false,\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/AdminAdjustmentCreateNew"\n          },\n          {\n            "$ref": "#/components/schemas/AdminAdjustmentCreateReversal"\n          }\n        ]\n      },\n      "AdminAdjustmentExecuted": {\n        "type": "object",\n        "description": "The form in effect, with `available` before and after, as read in the transaction that wrote the voucher.",\n        "additionalProperties": false,\n        "required": [\n          "adjustment",\n          "available_before_fen",\n          "available_after_fen"\n        ],\n        "properties": {\n          "adjustment": {\n            "$ref": "#/components/schemas/AdminAdjustment"\n          },\n          "available_before_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "available_after_fen": {\n            "$ref": "#/components/schemas/Fen"\n          }\n        }\n      },\n      "AdminAdjustmentExecutedResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAdjustmentExecuted"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminEmptyActionRequest": {\n        "type": "object",\n        "description": "The body of an action that takes no input; the amount is read by the server, never sent by the console.",\n        "additionalProperties": false,\n        "properties": {}\n      },\n      "AdminAdjustmentRejectRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "reason"\n        ],\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          }\n        }\n      },\n      "AdminAdjustmentReject": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "adjustment"\n        ],\n        "properties": {\n          "adjustment": {\n            "$ref": "#/components/schemas/AdminAdjustment"\n          }\n        }\n      },\n      "AdminAdjustmentRejectResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAdjustmentReject"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminBadDebtWriteoffStatus": {\n        "type": "string",\n        "description": "Status of a write-off candidate (contracts/enums/fund.yaml bad_debt_writeoff_status).",\n        "enum": [\n          "PENDING",\n          "APPROVED",\n          "CANCELLED"\n        ]\n      },\n      "AdminBadDebtWriteoff": {\n        "type": "object",\n        "description": "One write-off candidate (04 §3.2 bad_debt_writeoffs; BR-FUND-12). `candidate_fen` is the\\namount when it was generated, for reference only. `available_fen`, `frozen_fen` and\\n`negative_days` are read with the row. `initiator_id` is null on a candidate the daily\\njob generated. `approver_id` and `approved_at` stay null on a CANCELLED candidate.\\n",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "account_id",\n          "user_id",\n          "negative_since",\n          "negative_days",\n          "candidate_fen",\n          "available_fen",\n          "frozen_fen",\n          "status",\n          "approve_blocked",\n          "initiator_id",\n          "approver_id",\n          "approved_at",\n          "voucher_id",\n          "created_at"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "account_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "negative_since": {\n            "type": "string",\n            "format": "date",\n            "description": "The accounting day `available` went below 0."\n          },\n          "negative_days": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Current accounting day minus `negative_since`."\n          },\n          "candidate_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "available_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "frozen_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminBadDebtWriteoffStatus"\n          },\n          "approve_blocked": {\n            "type": "boolean",\n            "description": "True when approving now would be refused with writeoff_frozen_pending; always false unless `status=PENDING`."\n          },\n          "initiator_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "approver_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "approved_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "voucher_id": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/Id"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminBadDebtWriteoffPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminBadDebtWriteoff"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminBadDebtWriteoffPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminBadDebtWriteoffPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminBadDebtWriteoffApprove": {\n        "type": "object",\n        "description": "The candidate after approval; `written_off_fen` is the amount of the voucher, 0 when the candidate was cancelled.",\n        "additionalProperties": false,\n        "required": [\n          "writeoff",\n          "written_off_fen"\n        ],\n        "properties": {\n          "writeoff": {\n            "$ref": "#/components/schemas/AdminBadDebtWriteoff"\n          },\n          "written_off_fen": {\n            "$ref": "#/components/schemas/Fen"\n          }\n        }\n      },\n      "AdminBadDebtWriteoffApproveResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminBadDebtWriteoffApprove"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminReconDiffDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminReconDiffDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminWithdrawalDisplayStatus": {\n        "type": "string",\n        "description": "contracts/enums/admin.yaml admin_withdrawal_display_status: the console\'s display status\\nof a withdrawal, derived by the server from status + review_mode + hold_reason as the\\nBR-WDR-08 细则 table (花卷云「会员提现管理」mapping); not stored and not a withdrawal status.\\npending_review = PENDING_REVIEW, or APPROVED with hold_reason other than\\npayer_side_after_transfer; pending_handle = APPROVED with hold_reason\\npayer_side_after_transfer; rejected = REJECTED; paid_manual = PAID_MANUAL;\\npaid_auto_system = PAID_API with review_mode auto; paid_auto_review = PAID_API otherwise;\\npaying = PAYING (needs_manual included); failed = FAILED. Chinese names from BR-TEXT-25\\nadmin_dict.\\n",\n        "enum": [\n          "pending_review",\n          "pending_handle",\n          "rejected",\n          "paid_manual",\n          "paid_auto_system",\n          "paid_auto_review",\n          "paying",\n          "failed"\n        ]\n      },\n      "AdminWithdrawalHoldReason": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml withdrawal_hold_reason (withdrawals.hold_reason, BR-WDR-13, BR-WDR-17).",\n        "enum": [\n          "payout_disabled",\n          "queue_paused",\n          "channel_disabled",\n          "member_blocked",\n          "single_cap",\n          "daily_cap",\n          "payer_side_after_transfer"\n        ]\n      },\n      "AdminWithdrawalBlockedReason": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml withdrawal_blocked_reason (withdrawals.blocked_reason, BR-WDR-05).",\n        "enum": [\n          "NEGATIVE_BALANCE"\n        ]\n      },\n      "AdminWithdrawalRejectReason": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml withdraw_reject_reason (withdrawals.reject_reason_code, BR-WDR-10; NEGATIVE_BALANCE system only).",\n        "enum": [\n          "RISK_SUSPECT",\n          "ORDER_ABNORMAL",\n          "PAYEE_INFO_INVALID",\n          "USER_REQUEST",\n          "OTHER",\n          "NEGATIVE_BALANCE"\n        ]\n      },\n      "AdminWithdrawalBatchManualPaidRequest": {\n        "type": "object",\n        "description": "The offline payments to record; see POST /admin/v1/withdrawals/batch-manual-paid.",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "minItems": 1,\n            "maxItems": 200,\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalManualPaidEntry"\n            }\n          }\n        }\n      },\n      "AdminWithdrawalManualPaidEntry": {\n        "type": "object",\n        "description": "One offline payment.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "channel_order_id",\n          "paid_at",\n          "paid_fen"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "channel_order_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "pattern": "^[^\\\\s\\\\u0000]+$",\n            "description": "The Alipay or bank transfer serial number; no whitespace or NUL, compared exactly."\n          },\n          "paid_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the money was really paid, checked against the injected Clock."\n          },\n          "paid_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Integer fen really paid; anything but the withdrawal\'s net_fen is that item\'s amount_mismatch."\n          }\n        }\n      },\n      "AdminWithdrawalBatchManualPaidItem": {\n        "type": "object",\n        "description": "The result of one item. `reason` is null exactly when `result` is paid.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "result",\n          "reason"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "result": {\n            "type": "string",\n            "enum": [\n              "paid",\n              "skipped"\n            ]\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "enum": [\n              "not_found",\n              "not_approved",\n              "channel_not_allowed",\n              "amount_mismatch",\n              "paid_at_invalid",\n              "has_transfer_attempt",\n              "query_required",\n              "query_success",\n              "member_blocked",\n              "channel_order_id_taken",\n              "identity_missing",\n              null\n            ]\n          }\n        }\n      },\n      "AdminWithdrawalBatchManualPaid": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "One per request item, in request order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalBatchManualPaidItem"\n            }\n          }\n        }\n      },\n      "AdminWithdrawalBatchManualPaidResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminWithdrawalBatchManualPaid"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnknownPayoutFailBlocker": {\n        "type": "string",\n        "description": "A condition of a `failed` resolution that does not hold now, by its refusal reason.",\n        "enum": [\n          "resolve_too_early",\n          "resolve_bill_unverifiable",\n          "resolve_query_unverifiable"\n        ]\n      },\n      "AdminUnknownPayoutLatestQuery": {\n        "type": "object",\n        "description": "The newest kind=query attempt.",\n        "additionalProperties": false,\n        "required": [\n          "result",\n          "at",\n          "resp_code",\n          "resp_sub_code",\n          "channel_status",\n          "channel_order_id",\n          "paid_at"\n        ],\n        "properties": {\n          "result": {\n            "type": "string",\n            "enum": [\n              "pending",\n              "success",\n              "fail",\n              "unknown"\n            ]\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "resp_code": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "resp_sub_code": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "channel_status": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "The order status the channel answered, as received."\n          },\n          "channel_order_id": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "The time the channel answered, when it gave one."\n          }\n        }\n      },\n      "AdminUnknownPayoutItem": {\n        "type": "object",\n        "description": "One withdrawal waiting for a person; see GET /admin/v1/unknown-payouts.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "out_biz_no",\n          "user",\n          "payout_channel",\n          "amount_fen",\n          "net_fen",\n          "first_transfer_at",\n          "latest_query",\n          "fail_blockers"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "out_biz_no": {\n            "$ref": "#/components/schemas/AdminWithdrawalOutBizNo"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminWithdrawalUser"\n          },\n          "payout_channel": {\n            "$ref": "#/components/schemas/AdminPayoutChannelCode"\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "net_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "first_transfer_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "T, the earliest kind=transfer attempt."\n          },\n          "latest_query": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminUnknownPayoutLatestQuery"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "fail_blockers": {\n            "type": "array",\n            "description": "In the order of adminResolveUnknownPayout\'s checks.",\n            "items": {\n              "$ref": "#/components/schemas/AdminUnknownPayoutFailBlocker"\n            }\n          }\n        }\n      },\n      "AdminUnknownPayoutPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminUnknownPayoutItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminUnknownPayoutPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnknownPayoutPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPayoutQueryRequest": {\n        "type": "object",\n        "description": "No fields; see POST /admin/v1/withdrawals/{withdrawal_id}/query.",\n        "additionalProperties": false,\n        "properties": {}\n      },\n      "AdminPayoutQuerySubmitted": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "result"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "result": {\n            "type": "string",\n            "description": "The query is queued; the answer appears later as latest_query.",\n            "enum": [\n              "submitted"\n            ]\n          }\n        }\n      },\n      "AdminPayoutQueryResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminPayoutQuerySubmitted"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminUnknownPayoutResolveRequest": {\n        "type": "object",\n        "description": "How a person ends the withdrawal; see POST /admin/v1/withdrawals/{withdrawal_id}/resolve.",\n        "additionalProperties": false,\n        "required": [\n          "resolution",\n          "proof_text"\n        ],\n        "properties": {\n          "resolution": {\n            "type": "string",\n            "enum": [\n              "paid",\n              "failed"\n            ]\n          },\n          "proof_text": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 4000,\n            "description": "The pasted proof, not blank after trimming; not shown to the member."\n          },\n          "channel_order_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "pattern": "^[^\\\\s\\\\u0000]+$",\n            "description": "Required with paid. The channel\'s serial number; no whitespace or NUL, compared exactly."\n          },\n          "paid_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Required with paid. When the channel paid, checked against T and the injected Clock."\n          }\n        }\n      },\n      "AdminUnknownPayoutResolved": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "status",\n          "manual_resolution",\n          "channel_order_id",\n          "paid_at"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "type": "string",\n            "description": "Only PAID_API today; a failed resolution is refused (D10-625).",\n            "enum": [\n              "PAID_API"\n            ]\n          },\n          "manual_resolution": {\n            "type": "string",\n            "enum": [\n              "paid"\n            ]\n          },\n          "channel_order_id": {\n            "type": "string"\n          },\n          "paid_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminUnknownPayoutResolveResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminUnknownPayoutResolved"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminWithdrawalBatchApproveRequest": {\n        "type": "object",\n        "description": "The withdrawals to approve; see POST /admin/v1/withdrawals/batch-approve.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_ids"\n        ],\n        "properties": {\n          "withdrawal_ids": {\n            "type": "array",\n            "minItems": 1,\n            "maxItems": 200,\n            "items": {\n              "$ref": "#/components/schemas/Id"\n            }\n          }\n        }\n      },\n      "AdminWithdrawalBatchApproveItem": {\n        "type": "object",\n        "description": "The result of one id. `reason` is null exactly when `result` is approved.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "result",\n          "reason"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "result": {\n            "type": "string",\n            "enum": [\n              "approved",\n              "skipped"\n            ]\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "enum": [\n              "not_found",\n              "not_pending",\n              "negative_balance",\n              "blocked",\n              null\n            ]\n          }\n        }\n      },\n      "AdminWithdrawalBatchApprove": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "One per id, in request order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalBatchApproveItem"\n            }\n          }\n        }\n      },\n      "AdminWithdrawalBatchApproveResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminWithdrawalBatchApprove"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminWithdrawalRejectRequest": {\n        "type": "object",\n        "description": "One rejection; see POST /admin/v1/withdrawals/{withdrawal_id}/reject.",\n        "additionalProperties": false,\n        "required": [\n          "reason_code"\n        ],\n        "properties": {\n          "reason_code": {\n            "type": "string",\n            "description": "The five a person can choose; NEGATIVE_BALANCE is written by the system only.",\n            "enum": [\n              "RISK_SUSPECT",\n              "ORDER_ABNORMAL",\n              "PAYEE_INFO_INVALID",\n              "USER_REQUEST",\n              "OTHER"\n            ]\n          },\n          "note": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 500,\n            "description": "Internal, never shown to the member; not blank after trimming; required for USER_REQUEST."\n          }\n        }\n      },\n      "AdminWithdrawalRejected": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "status",\n          "reject_reason_code",\n          "reviewer_id",\n          "reviewed_at"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "type": "string",\n            "enum": [\n              "REJECTED"\n            ]\n          },\n          "reject_reason_code": {\n            "$ref": "#/components/schemas/AdminWithdrawalRejectReason"\n          },\n          "reviewer_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "reviewed_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminWithdrawalRejectResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminWithdrawalRejected"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminWithdrawalManualResolution": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml withdrawal_manual_resolution (BR-WDR-15).",\n        "enum": [\n          "paid",\n          "failed"\n        ]\n      },\n      "AdminWithdrawHoldKind": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml withdraw_hold_kind (withdraw_holds.reason).",\n        "enum": [\n          "manual",\n          "recon_diff",\n          "ledger_mismatch",\n          "manual_failed_watch"\n        ]\n      },\n      "AdminPayoutBatchKind": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml payout_batch_kind (payout_batches.kind).",\n        "enum": [\n          "manual",\n          "auto"\n        ]\n      },\n      "AdminPayoutBatchItemResult": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml payout_batch_item_result (payout_batch_items.result, BR-WDR-11, BR-WDR-12).",\n        "enum": [\n          "paying",\n          "skipped",\n          "blocked",\n          "moved_out"\n        ]\n      },\n      "AdminPayoutAttemptKind": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml payout_attempt_kind (payout_attempts.kind; cancel only for wechat withdrawals).",\n        "enum": [\n          "transfer",\n          "query",\n          "cancel"\n        ]\n      },\n      "AdminPayoutAttemptResult": {\n        "type": "string",\n        "description": "payout_attempts.result as stored (04 §3.2; BR-WDR-13, BR-WDR-14); unknown = result not known, query only, never resend.",\n        "enum": [\n          "pending",\n          "success",\n          "fail",\n          "unknown"\n        ]\n      },\n      "AdminWithdrawalRiskFlagCode": {\n        "type": "string",\n        "description": "A code of the withdrawals.risk_flags snapshot (04 §3.2): the labels ①–⑩ of BR-WDR-29 and\\nrisk_calc_failed. Chinese names from BR-TEXT-25 admin_dict.withdrawals.risk_flags.\\n",\n        "enum": [\n          "first_withdrawal",\n          "credited_today",\n          "same_device_multi_account",\n          "invalid_ratio_60d",\n          "high_commission_ratio_60d",\n          "withdraw_vs_received",\n          "had_negative",\n          "recon_diff",\n          "blacklist_hit",\n          "payee_prev_other_user",\n          "risk_calc_failed"\n        ]\n      },\n      "AdminWithdrawalOutBizNo": {\n        "type": "string",\n        "pattern": "^[A-Za-z0-9]{1,32}$",\n        "description": "The withdrawal number (withdrawals.out_biz_no, BR-WDR-07), 1–32 letters or digits."\n      },\n      "AdminWithdrawalUser": {\n        "type": "object",\n        "description": "The user of a withdrawal as the console shows it; the phone number only masked (BR-ID-33).",\n        "additionalProperties": false,\n        "required": [\n          "user_id",\n          "phone_masked"\n        ],\n        "properties": {\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "phone_masked": {\n            "$ref": "#/components/schemas/AdminMaskedPhone"\n          }\n        }\n      },\n      "AdminWithdrawalAutoDecision": {\n        "type": "object",\n        "description": "withdrawals.auto_decision (04 §3.2; BR-WDR-30 细则「可追溯」): `result`, every unmet\\ncondition code (`failed_conditions`, the 转人工原因, in the order ①–⑬; risk flags as\\n`risk_flag:<code>`), the three ⑧ actual values in bp (`warn_values`, each null when its\\ndenominator is 0), `rule_version`, `decided_at`, and `execute_blocked`, the reason added when\\na withdrawal decided auto could not be executed (执行受阻, kept apart from the condition list,\\nBR-WDR-08 细则). A key missing in the stored object reads as null. The values of the codes\\nare maintained in BR-WDR-30 only; Chinese names from BR-TEXT-25\\nadmin_dict.withdrawals.auto_decision.failed_conditions.\\n",\n        "additionalProperties": false,\n        "required": [\n          "result",\n          "failed_conditions",\n          "warn_values",\n          "rule_version",\n          "decided_at",\n          "execute_blocked"\n        ],\n        "properties": {\n          "result": {\n            "$ref": "#/components/schemas/WithdrawalReviewMode"\n          },\n          "failed_conditions": {\n            "type": "array",\n            "items": {\n              "type": "string",\n              "minLength": 1,\n              "maxLength": 64,\n              "pattern": "^(risk_flag:)?[a-z0-9_]+$"\n            }\n          },\n          "warn_values": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalWarnValues"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "rule_version": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0\n          },\n          "decided_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "execute_blocked": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "pattern": "^[a-z0-9_]+$",\n            "description": "Why EXECUTE did not run after an auto decision (BR-WDR-30, BR-WDR-12 ①–③, such as\\npayout_disabled, queue_paused, channel_disabled or a watermark reason); null otherwise.\\n"\n          }\n        }\n      },\n      "AdminWithdrawalWarnValues": {\n        "type": "object",\n        "description": "The three BR-WDR-30 ⑧ actual values in bp; null when the denominator is 0.",\n        "additionalProperties": false,\n        "required": [\n          "high_commission_order_ratio_bp",\n          "invalid_ratio_bp",\n          "withdraw_received_ratio_bp"\n        ],\n        "properties": {\n          "high_commission_order_ratio_bp": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "minimum": 0\n          },\n          "invalid_ratio_bp": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "minimum": 0\n          },\n          "withdraw_received_ratio_bp": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminWithdrawalRiskFlag": {\n        "type": "object",\n        "description": "One hit of the risk_flags snapshot (04 §3.2; BR-WDR-29): `value` is true for the yes / no\\nlabels, a ratio in bp for ④⑤⑥ (null for ⑥ with a zero denominator), and for\\nrisk_calc_failed the codes whose calculation failed; `threshold` is the bp threshold of\\n④⑤⑥, otherwise null.\\n",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "value",\n          "threshold"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/AdminWithdrawalRiskFlagCode"\n          },\n          "value": {\n            "anyOf": [\n              {\n                "type": "boolean"\n              },\n              {\n                "type": "integer",\n                "format": "int64"\n              },\n              {\n                "type": "null"\n              },\n              {\n                "type": "array",\n                "items": {\n                  "$ref": "#/components/schemas/AdminWithdrawalRiskFlagCode"\n                }\n              }\n            ]\n          },\n          "threshold": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32"\n          }\n        }\n      },\n      "AdminWithdrawalPayee": {\n        "type": "object",\n        "description": "The payee snapshot of the application (BR-WDR-07), masked only (BR-ID-33): no full\\naccount, full name, openid or launch data.\\n",\n        "additionalProperties": false,\n        "required": [\n          "masked_account",\n          "masked_name",\n          "bank_name"\n        ],\n        "properties": {\n          "masked_account": {\n            "type": "string",\n            "maxLength": 128,\n            "description": "Masked by payout method as BR-ID-33 细则 (alipay `138****5678` or `zh***@example.com`, bank card `尾号 1234`)."\n          },\n          "masked_name": {\n            "type": "string",\n            "maxLength": 64,\n            "description": "Payee name with only the last character kept (`**三`, BR-ID-33)."\n          },\n          "bank_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Bank of a bank_card withdrawal; null for the other methods."\n          }\n        }\n      },\n      "AdminWithdrawalBatch": {\n        "type": "object",\n        "description": "A payout batch (04 §3.2 payout_batches).",\n        "additionalProperties": false,\n        "required": [\n          "batch_id",\n          "kind",\n          "created_at"\n        ],\n        "properties": {\n          "batch_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "kind": {\n            "$ref": "#/components/schemas/AdminPayoutBatchKind"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminWithdrawalBatchItem": {\n        "type": "object",\n        "description": "One payout_batch_items row of the withdrawal (04 §3.2; insert only).",\n        "additionalProperties": false,\n        "required": [\n          "batch_id",\n          "result",\n          "reason",\n          "moved_to_batch_id",\n          "at"\n        ],\n        "properties": {\n          "batch_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "result": {\n            "$ref": "#/components/schemas/AdminPayoutBatchItemResult"\n          },\n          "reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 200,\n            "description": "Why the withdrawal was skipped or blocked; null for paying and moved_out."\n          },\n          "moved_to_batch_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The batch it moved to (moved_out only); null otherwise."\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminWithdrawalPayoutAttempt": {\n        "type": "object",\n        "description": "Summary of one payout_attempts row (04 §3.2); the channel request and response bodies are not returned.",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "kind",\n          "result",\n          "resp_code",\n          "resp_sub_code",\n          "at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "kind": {\n            "$ref": "#/components/schemas/AdminPayoutAttemptKind"\n          },\n          "result": {\n            "$ref": "#/components/schemas/AdminPayoutAttemptResult"\n          },\n          "resp_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "The channel\'s response code; null when none."\n          },\n          "resp_sub_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 128,\n            "description": "The channel\'s sub-code; null when none."\n          },\n          "at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminWithdrawalHold": {\n        "type": "object",\n        "description": "A withdraw_holds row of the user in effect (04 §3.2; BR-WDR-05, BR-FUND-19).",\n        "additionalProperties": false,\n        "required": [\n          "hold_id",\n          "reason",\n          "source_ref",\n          "created_at",\n          "hold_until"\n        ],\n        "properties": {\n          "hold_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "reason": {\n            "$ref": "#/components/schemas/AdminWithdrawHoldKind"\n          },\n          "source_ref": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 128,\n            "description": "What caused the hold, such as a recon_diffs id; null when none."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "hold_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of a timed hold (manual_failed_watch); null = until released."\n          }\n        }\n      },\n      "AdminWithdrawalListItem": {\n        "type": "object",\n        "description": "One withdrawal of the console\'s list (04 §3.2 withdrawals); amounts in fen, net_fen = amount_fen − fee_fen − tax_fen.",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "out_biz_no",\n          "user",\n          "status",\n          "display_status",\n          "review_mode",\n          "payout_channel",\n          "amount_fen",\n          "fee_fen",\n          "tax_fen",\n          "net_fen",\n          "auto_decision",\n          "hold_reason",\n          "blocked_reason",\n          "needs_manual",\n          "reject_reason_code",\n          "reject_note",\n          "reviewer_id",\n          "reviewed_at",\n          "batch_id",\n          "risk_flags",\n          "risk_flags_at",\n          "created_at",\n          "paid_at"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "out_biz_no": {\n            "$ref": "#/components/schemas/AdminWithdrawalOutBizNo"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminWithdrawalUser"\n          },\n          "status": {\n            "$ref": "#/components/schemas/WithdrawalStatus"\n          },\n          "display_status": {\n            "$ref": "#/components/schemas/AdminWithdrawalDisplayStatus"\n          },\n          "review_mode": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalReviewMode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Null until decided after submission (BR-WDR-30)."\n          },\n          "payout_channel": {\n            "$ref": "#/components/schemas/AdminPayoutChannelCode"\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "fee_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "tax_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "net_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "auto_decision": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalAutoDecision"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "withdrawals.auto_decision; null while no decision is stored."\n          },\n          "hold_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalHoldReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Why W9 returned the withdrawal to APPROVED (BR-WDR-13, BR-WDR-17); null otherwise."\n          },\n          "blocked_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalBlockedReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The withdrawal block (BR-WDR-05), shown as the「暂停」mark; null when not blocked."\n          },\n          "needs_manual": {\n            "type": "boolean",\n            "description": "withdrawals.needs_manual (BR-WDR-15); ends only through W10."\n          },\n          "reject_reason_code": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalRejectReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Set on a REJECTED withdrawal (BR-WDR-10), otherwise null."\n          },\n          "reject_note": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 500,\n            "description": "Internal note of the rejection, admin only (BR-WDR-10); null when none."\n          },\n          "reviewer_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "admin_users.id of the reviewer; null before review and for a system review (review_mode auto)."\n          },\n          "reviewed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "batch_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The payout batch the withdrawal is in now (payout_batches.id); null when none."\n          },\n          "risk_flags": {\n            "type": "array",\n            "description": "The risk flag snapshot written with W1 and never recalculated here (BR-WDR-29); [] when nothing hit.",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalRiskFlag"\n            }\n          },\n          "risk_flags_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the risk_flags snapshot was computed; null when none is stored."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Application time."\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Set only in PAID_API / PAID_MANUAL, otherwise null."\n          }\n        }\n      },\n      "AdminWithdrawalPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalListItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminWithdrawalPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminWithdrawalPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminWithdrawalDetail": {\n        "type": "object",\n        "description": "One withdrawal with the fields of AdminWithdrawalListItem plus the remaining columns, the\\nmasked payee snapshot, the batch, its batch items, the transfer attempt summaries and the\\nuser\'s holds in effect. Withdrawals have no status history table (04 §3.2): the time\\npoints of the row stand for it.\\n",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "out_biz_no",\n          "user",\n          "status",\n          "display_status",\n          "review_mode",\n          "payout_channel",\n          "amount_fen",\n          "fee_fen",\n          "tax_fen",\n          "net_fen",\n          "auto_decision",\n          "hold_reason",\n          "blocked_reason",\n          "needs_manual",\n          "reject_reason_code",\n          "reject_note",\n          "reviewer_id",\n          "reviewed_at",\n          "batch_id",\n          "risk_flags",\n          "risk_flags_at",\n          "created_at",\n          "paid_at",\n          "payout_method",\n          "review_deadline",\n          "fail_code",\n          "executor_id",\n          "executed_at",\n          "execute_seq",\n          "manual_resolution",\n          "resolver_ids",\n          "manual_entry_by",\n          "manual_confirm_by",\n          "hold_at",\n          "channel_state",\n          "confirm_deadline",\n          "channel_order_id",\n          "updated_at",\n          "row_version",\n          "payee",\n          "batch",\n          "batch_items",\n          "payout_attempts",\n          "holds"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "out_biz_no": {\n            "$ref": "#/components/schemas/AdminWithdrawalOutBizNo"\n          },\n          "user": {\n            "$ref": "#/components/schemas/AdminWithdrawalUser"\n          },\n          "status": {\n            "$ref": "#/components/schemas/WithdrawalStatus"\n          },\n          "display_status": {\n            "$ref": "#/components/schemas/AdminWithdrawalDisplayStatus"\n          },\n          "review_mode": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalReviewMode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Null until decided after submission (BR-WDR-30)."\n          },\n          "payout_channel": {\n            "$ref": "#/components/schemas/AdminPayoutChannelCode"\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "fee_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "tax_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "net_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "auto_decision": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalAutoDecision"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "withdrawals.auto_decision; null while no decision is stored."\n          },\n          "hold_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalHoldReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Why W9 returned the withdrawal to APPROVED (BR-WDR-13, BR-WDR-17); null otherwise."\n          },\n          "blocked_reason": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalBlockedReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The withdrawal block (BR-WDR-05), shown as the「暂停」mark; null when not blocked."\n          },\n          "needs_manual": {\n            "type": "boolean",\n            "description": "withdrawals.needs_manual (BR-WDR-15); ends only through W10."\n          },\n          "reject_reason_code": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalRejectReason"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Set on a REJECTED withdrawal (BR-WDR-10), otherwise null."\n          },\n          "reject_note": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 500,\n            "description": "Internal note of the rejection, admin only (BR-WDR-10); null when none."\n          },\n          "reviewer_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "admin_users.id of the reviewer; null before review and for a system review (review_mode auto)."\n          },\n          "reviewed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "batch_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The payout batch the withdrawal is in now (payout_batches.id); null when none."\n          },\n          "risk_flags": {\n            "type": "array",\n            "description": "The risk flag snapshot written with W1 and never recalculated here (BR-WDR-29); [] when nothing hit.",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalRiskFlag"\n            }\n          },\n          "risk_flags_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the risk_flags snapshot was computed; null when none is stored."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Application time."\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Set only in PAID_API / PAID_MANUAL, otherwise null."\n          },\n          "payout_method": {\n            "$ref": "#/components/schemas/AdminPayoutChannelCode"\n          },\n          "review_deadline": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "The manual-review deadline (BR-WDR-26); null when the withdrawal has none."\n          },\n          "fail_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Failure code of a FAILED withdrawal (BR-TEXT-08); null otherwise."\n          },\n          "executor_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "admin_users.id of who executed the payout; null before execution, for a system execution and again after W9 (BR-WDR-13)."\n          },\n          "executed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Null before execution and again after a W9 return to APPROVED (BR-WDR-13)."\n          },\n          "execute_seq": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "withdrawals.execute_seq, plus 1 on every EXECUTE (BR-WDR-12)."\n          },\n          "manual_resolution": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalManualResolution"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The W10 resolution of a needs_manual withdrawal (BR-WDR-15); null otherwise."\n          },\n          "resolver_ids": {\n            "type": "array",\n            "description": "admin_users.id of who resolved the needs_manual withdrawal (BR-WDR-15); [] when none.",\n            "items": {\n              "$ref": "#/components/schemas/Id"\n            }\n          },\n          "manual_entry_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "admin_users.id of who entered the manual payout (BR-WDR-16); null otherwise."\n          },\n          "manual_confirm_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "admin_users.id of who confirmed the manual payout (BR-WDR-16; may be the same admin); null otherwise."\n          },\n          "hold_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When W9 returned the withdrawal to APPROVED; null together with hold_reason."\n          },\n          "channel_state": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalChannelState"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Only a wechat withdrawal in PAYING has a value (BR-WDR-33 ⑤); not a withdrawal status."\n          },\n          "confirm_deadline": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Latest time to confirm the transfer in WeChat (BR-WDR-33 ⑥); wechat withdrawals only, otherwise null."\n          },\n          "channel_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 128,\n            "description": "Channel serial number when recorded (BR-WDR-16); null otherwise."\n          },\n          "updated_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "row_version": {\n            "$ref": "#/components/schemas/AdminRowVersion"\n          },\n          "payee": {\n            "$ref": "#/components/schemas/AdminWithdrawalPayee"\n          },\n          "batch": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminWithdrawalBatch"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The payout_batches row of batch_id; null when batch_id is null."\n          },\n          "batch_items": {\n            "type": "array",\n            "description": "Every payout_batch_items row of this withdrawal, oldest first (insert only, BR-WDR-11, BR-WDR-12).",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalBatchItem"\n            }\n          },\n          "payout_attempts": {\n            "type": "array",\n            "description": "Every payout_attempts row of this withdrawal, oldest first, summary only (no request or response body).",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalPayoutAttempt"\n            }\n          },\n          "holds": {\n            "type": "array",\n            "description": "The user\'s withdraw_holds in effect at response time, oldest first (BR-WDR-05, BR-FUND-19); [] when none.",\n            "items": {\n              "$ref": "#/components/schemas/AdminWithdrawalHold"\n            }\n          }\n        }\n      },\n      "AdminWithdrawalDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminWithdrawalDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminSettleBillId": {\n        "type": "string",\n        "description": "A bill month (settle_bills.bill_id, YYYY-MM; BR-FUND-04 ③).",\n        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n      },\n      "AdminSettleBillStatus": {\n        "type": "string",\n        "description": "contracts/enums/admin.yaml admin_settle_bill_status: the console status of a monthly\\nsettlement bill (BR-FUND-04 细则「月结账单状态」), derived by the server at read time and\\nnot stored (settle_bills has no status column). It is derived from the batches of the\\nbill\'s latest round, read from settle_batches: the first round is every batch of the bill\\nwith kind main (generated by the bill-day task); each supplement launch is one round, the\\nbatches with kind supplement sharing the same (platform, created_at) (one launch inserts\\nall its batches in one transaction, so they share the column-default created_at). A\\nround\'s time is the largest created_at of its batches; the latest round is the one with\\nthe largest round time (on a tie, the round holding the largest batch_id). Batches\\nrejected (CANCELLED) do not take part. In this order, the first rule that holds wins\\n(now = the server clock):\\ngenerating = generated_at is null (the bill-day task is still checking and generating);\\nissued = the round has no batch left that is not CANCELLED (no candidate, a platform\\nwith credit.enabled off keeping only its check results, or every batch of the round\\nrejected), or any batch of the round is DRAFT;\\nsettled = every batch of the round is DONE;\\nsettling = some batch of the round is EXECUTING or PARTIAL, or CONFIRMED with settle_mode\\nIMMEDIATE or with scheduled_at not later than now (due, not started yet);\\nscheduled = otherwise (the batches not yet DONE are all CONFIRMED with scheduled_at later\\nthan now). Chinese names from BR-TEXT-25 admin_dict.\\nOnly the latest round counts, so a batch that is DRAFT outside it (a schedule cancelled\\nafter a later supplement launch) does not make the bill issued: the status can be, for\\nexample, settled while that batch waits for confirmation (编排裁定 D10-444). Which batches\\nwait for confirmation is read from the batches with status DRAFT, not from this status.\\n",\n        "enum": [\n          "generating",\n          "issued",\n          "scheduled",\n          "settling",\n          "settled"\n        ]\n      },\n      "AdminSettleBillPlatformCounts": {\n        "type": "object",\n        "description": "Count per platform (settle_bills.platform_order_counts); a platform without sub-orders in the bill is absent.",\n        "propertyNames": {\n          "$ref": "#/components/schemas/PlatformCode"\n        },\n        "additionalProperties": {\n          "type": "integer",\n          "format": "int32",\n          "minimum": 0\n        }\n      },\n      "AdminSettleBillPlatformTotals": {\n        "type": "object",\n        "description": "Amount in fen per platform (settle_bills.platform_settle_commission_totals); a platform without sub-orders in the bill is absent.",\n        "propertyNames": {\n          "$ref": "#/components/schemas/PlatformCode"\n        },\n        "additionalProperties": {\n          "$ref": "#/components/schemas/Fen"\n        }\n      },\n      "AdminSettleBatchKind": {\n        "type": "string",\n        "description": "settle_batches.kind (04 §3.2; BR-FUND-04 ⑤ ⑨) — main = generated by the bill-day task, supplement = generated by a supplement launch. Values as the table\'s check constraint; contracts/enums has no entry for it yet.",\n        "enum": [\n          "main",\n          "supplement"\n        ]\n      },\n      "AdminSettleBatchStatus": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml settle_batch_status (BR-FUND-04; transitions 04 §4 4.7).",\n        "enum": [\n          "DRAFT",\n          "CONFIRMED",\n          "EXECUTING",\n          "PARTIAL",\n          "DONE",\n          "CANCELLED"\n        ]\n      },\n      "AdminSettleMode": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml settle_mode (BR-FUND-04).",\n        "enum": [\n          "IMMEDIATE",\n          "SCHEDULED"\n        ]\n      },\n      "AdminSettleBatchItemType": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml settle_batch_item_type — order = sub-order row, beneficiary = beneficiary make-up item (BR-FUND-04 ⑫).",\n        "enum": [\n          "order",\n          "beneficiary"\n        ]\n      },\n      "AdminSettleBatchItemResult": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml settle_batch_item_result (BR-FUND-04 ⑦ ⑫).",\n        "enum": [\n          "credited",\n          "skipped",\n          "deferred"\n        ]\n      },\n      "AdminSettleBatchItemResultFilterValue": {\n        "type": "string",\n        "description": "The `result` filter of the batch items — a settle_batch_item_result value, or pending = not executed yet (result null). pending is a filter value only, never a result.",\n        "enum": [\n          "credited",\n          "skipped",\n          "deferred",\n          "pending"\n        ]\n      },\n      "AdminSettleBatchItemRole": {\n        "type": "string",\n        "description": "contracts/enums/fund.yaml beneficiary_role (settle_batch_items.role, beneficiary items only).",\n        "enum": [\n          "self",\n          "share",\n          "direct",\n          "indirect"\n        ]\n      },\n      "AdminSettleBill": {\n        "type": "object",\n        "description": "One monthly settlement bill of the console\'s list (04 §3.2 settle_bills) with its derived\\nstatus and batch summary. The totals and error_count / held_count reflect the bill-day\\ntask only — supplement batches do not write them back (编排裁定 D10-280 ③) — and are for\\ndisplay only: amount judgements and reconciliation go by the batch items.\\n",\n        "additionalProperties": false,\n        "required": [\n          "bill_id",\n          "status",\n          "generation_started_at",\n          "generated_at",\n          "platform_order_counts",\n          "platform_settle_commission_totals",\n          "beneficiary_total_fen",\n          "platform_retained_fen",\n          "error_count",\n          "held_count",\n          "batch_count",\n          "draft_batch_count",\n          "created_at"\n        ],\n        "properties": {\n          "bill_id": {\n            "$ref": "#/components/schemas/AdminSettleBillId"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminSettleBillStatus"\n          },\n          "generation_started_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the bill-day task started generating this bill (BR-FUND-04 ③)."\n          },\n          "generated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the check and every batch of the bill-day task were generated; null while generating."\n          },\n          "platform_order_counts": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBillPlatformCounts"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Sub-orders in the bill per platform (bill-day task only); null while generating."\n          },\n          "platform_settle_commission_totals": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBillPlatformTotals"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Union settlement commission per platform in fen (bill-day task only); null while generating."\n          },\n          "beneficiary_total_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "description": "Total of the beneficiary shares in fen (bill-day task only); null while generating."\n          },\n          "platform_retained_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "description": "Total retained by the platform in fen (bill-day task only); null while generating."\n          },\n          "error_count": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "description": "Differences (差错单) opened by the bill-day task; null while generating. The rows are in GET /admin/v1/recon-diffs."\n          },\n          "held_count": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "description": "Sub-orders put aside (暂缓, hold or rights pending) by the bill-day task; null while generating."\n          },\n          "batch_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Batches of the bill, main and supplement, CANCELLED included (counted at read time)."\n          },\n          "draft_batch_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Batches of the bill in DRAFT, waiting for confirmation (counted at read time)."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminSettleBatchItemCounts": {\n        "type": "object",\n        "description": "Items of a batch by item_type × result, summed at read time (not stored); pending = result null (not executed yet).",\n        "additionalProperties": false,\n        "required": [\n          "order",\n          "beneficiary"\n        ],\n        "properties": {\n          "order": {\n            "type": "object",\n            "additionalProperties": false,\n            "required": [\n              "credited",\n              "skipped",\n              "pending"\n            ],\n            "properties": {\n              "credited": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              },\n              "skipped": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              },\n              "pending": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              }\n            }\n          },\n          "beneficiary": {\n            "type": "object",\n            "additionalProperties": false,\n            "required": [\n              "credited",\n              "skipped",\n              "deferred",\n              "pending"\n            ],\n            "properties": {\n              "credited": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              },\n              "skipped": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              },\n              "deferred": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              },\n              "pending": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 0\n              }\n            }\n          }\n        }\n      },\n      "AdminSettleBatchRowVersion": {\n        "type": "integer",\n        "format": "int32",\n        "minimum": 0,\n        "description": "settle_batches.row_version, the compare-and-set version of a batch; each batch command adds one."\n      },\n      "AdminSettleBatch": {\n        "type": "object",\n        "description": "One settle_batches row of a bill (04 §3.2) with whether it is in the bill\'s latest round and its item counts.",\n        "additionalProperties": false,\n        "required": [\n          "batch_id",\n          "platform",\n          "kind",\n          "status",\n          "settle_mode",\n          "scheduled_at",\n          "confirmed_by",\n          "confirmed_at",\n          "cancelled_reason",\n          "order_count",\n          "started_at",\n          "finished_at",\n          "paused_by_switch_at",\n          "created_at",\n          "row_version",\n          "in_current_round",\n          "item_counts"\n        ],\n        "properties": {\n          "batch_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "kind": {\n            "$ref": "#/components/schemas/AdminSettleBatchKind"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminSettleBatchStatus"\n          },\n          "settle_mode": {\n            "$ref": "#/components/schemas/AdminSettleMode"\n          },\n          "scheduled_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "The scheduled execution time; null unless settle_mode is SCHEDULED."\n          },\n          "confirmed_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The admin who confirmed the batch; null until confirmed (and again after a schedule is cancelled)."\n          },\n          "confirmed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "cancelled_reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "description": "The rejection reason; set exactly when status is CANCELLED."\n          },\n          "order_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Sub-orders in the batch."\n          },\n          "started_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "finished_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          },\n          "paused_by_switch_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When execution stopped because a switch was off (BR-FUND-04 SB10); null otherwise."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "row_version": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBatchRowVersion"\n              }\n            ],\n            "description": "The version the batch commands take as expected_row_version (POST /admin/v1/settle-bills/{bill_id}/confirm, POST /admin/v1/settle-batches/{batch_id}/cancel-schedule, /reject, /resume)."\n          },\n          "in_current_round": {\n            "type": "boolean",\n            "description": "Whether the batch belongs to the bill\'s latest round as defined in AdminSettleBillStatus (main round = all kind main batches; supplement round = kind supplement batches sharing (platform, created_at); latest = largest round time, a tie going to the round holding the largest batch_id); a CANCELLED batch of that round is true but takes no part. It only says which batches the derived status comes from; a DRAFT batch can be false (a schedule cancelled after a later supplement launch) and POST /admin/v1/settle-bills/{bill_id}/confirm still covers it (编排裁定 D10-444)."\n          },\n          "item_counts": {\n            "$ref": "#/components/schemas/AdminSettleBatchItemCounts"\n          }\n        }\n      },\n      "AdminSettleExpectedBatch": {\n        "type": "object",\n        "description": "One DRAFT batch of the bill as the console read it.",\n        "additionalProperties": false,\n        "required": [\n          "batch_id",\n          "expected_row_version"\n        ],\n        "properties": {\n          "batch_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "expected_row_version": {\n            "$ref": "#/components/schemas/AdminSettleBatchRowVersion"\n          }\n        }\n      },\n      "AdminSettleBillConfirmRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/settle-bills/{bill_id}/confirm. `expected_batches` must match all\\nthe DRAFT batches of the bill one to one, whatever their round and platform (BR-FUND-04 ⑥,\\n编排裁定 D10-444), never a choice among them; any other set is 20902 with\\ndata.resource=settle_batch.\\n",\n        "additionalProperties": false,\n        "required": [\n          "expected_batches"\n        ],\n        "properties": {\n          "expected_batches": {\n            "type": "array",\n            "maxItems": 1000,\n            "items": {\n              "$ref": "#/components/schemas/AdminSettleExpectedBatch"\n            }\n          },\n          "settle_mode": {\n            "allOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleMode"\n              }\n            ],\n            "default": "IMMEDIATE",\n            "description": "IMMEDIATE when absent."\n          },\n          "scheduled_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Required with SCHEDULED, not allowed with IMMEDIATE; later than the moment of confirmation and outside the nominal asset snapshot window (BR-FUND-04 ⑥, BR-FUND-18), else 20001 with data.fields=[scheduled_at]."\n          }\n        }\n      },\n      "AdminSettleBatchVersionRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/settle-batches/{batch_id}/cancel-schedule and /resume.",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "$ref": "#/components/schemas/AdminSettleBatchRowVersion"\n          }\n        }\n      },\n      "AdminSettleBatchRejectRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/settle-batches/{batch_id}/reject.",\n        "additionalProperties": false,\n        "required": [\n          "expected_row_version",\n          "reason"\n        ],\n        "properties": {\n          "expected_row_version": {\n            "$ref": "#/components/schemas/AdminSettleBatchRowVersion"\n          },\n          "reason": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 200,\n            "description": "Why the batch is rejected; 1–200 characters after trimming, else 20001 with data.fields=[reason]. Stored as cancelled_reason."\n          }\n        }\n      },\n      "AdminSettleSupplementRequest": {\n        "type": "object",\n        "description": "Body of POST /admin/v1/settle-bills/{bill_id}/supplement-batches.",\n        "additionalProperties": false,\n        "required": [\n          "platform"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          }\n        }\n      },\n      "AdminSettleSupplementOutcome": {\n        "type": "string",\n        "description": "contracts/enums/admin.yaml admin_settle_supplement_outcome — generated = the check ran (batch_ids may be empty); duplicate = already claimed for the same nominal moment, nothing generated.",\n        "enum": [\n          "generated",\n          "duplicate"\n        ]\n      },\n      "AdminSettleSupplement": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "bill_id",\n          "platform",\n          "outcome",\n          "batch_ids"\n        ],\n        "properties": {\n          "bill_id": {\n            "$ref": "#/components/schemas/AdminSettleBillId"\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "outcome": {\n            "$ref": "#/components/schemas/AdminSettleSupplementOutcome"\n          },\n          "batch_ids": {\n            "type": "array",\n            "description": "The batches this launch generated; empty when there was nothing to include (no empty batch is generated) and on outcome duplicate.",\n            "items": {\n              "$ref": "#/components/schemas/Id"\n            }\n          }\n        }\n      },\n      "AdminSettleSupplementResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSettleSupplement"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminSettleBillPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminSettleBill"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminSettleBillPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSettleBillPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminSettleBillDetail": {\n        "type": "object",\n        "description": "One monthly settlement bill with the fields of AdminSettleBill plus every batch of the\\nbill. Totals and counts of settle_bills reflect the bill-day task only and are for\\ndisplay only (编排裁定 D10-280 ③).\\n",\n        "additionalProperties": false,\n        "required": [\n          "bill_id",\n          "status",\n          "generation_started_at",\n          "generated_at",\n          "platform_order_counts",\n          "platform_settle_commission_totals",\n          "beneficiary_total_fen",\n          "platform_retained_fen",\n          "error_count",\n          "held_count",\n          "batch_count",\n          "draft_batch_count",\n          "created_at",\n          "batches"\n        ],\n        "properties": {\n          "bill_id": {\n            "$ref": "#/components/schemas/AdminSettleBillId"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminSettleBillStatus"\n          },\n          "generation_started_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the bill-day task started generating this bill (BR-FUND-04 ③)."\n          },\n          "generated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "When the check and every batch of the bill-day task were generated; null while generating."\n          },\n          "platform_order_counts": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBillPlatformCounts"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Sub-orders in the bill per platform (bill-day task only); null while generating."\n          },\n          "platform_settle_commission_totals": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBillPlatformTotals"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Union settlement commission per platform in fen (bill-day task only); null while generating."\n          },\n          "beneficiary_total_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "description": "Total of the beneficiary shares in fen (bill-day task only); null while generating."\n          },\n          "platform_retained_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "description": "Total retained by the platform in fen (bill-day task only); null while generating."\n          },\n          "error_count": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "description": "Differences (差错单) opened by the bill-day task; null while generating. The rows are in GET /admin/v1/recon-diffs."\n          },\n          "held_count": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 0,\n            "description": "Sub-orders put aside (暂缓, hold or rights pending) by the bill-day task; null while generating."\n          },\n          "batch_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Batches of the bill, main and supplement, CANCELLED included (counted at read time)."\n          },\n          "draft_batch_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Batches of the bill in DRAFT, waiting for confirmation (counted at read time)."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "batches": {\n            "type": "array",\n            "description": "Every batch of the bill, main and supplement, CANCELLED included, ordered by created_at then batch_id; [] when none.",\n            "items": {\n              "$ref": "#/components/schemas/AdminSettleBatch"\n            }\n          }\n        }\n      },\n      "AdminSettleBillDetailResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSettleBillDetail"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminSettleBatchItem": {\n        "type": "object",\n        "description": "One settle_batch_items row (04 §3.2; BR-FUND-04 ⑦ ⑫); user_id only, never a phone number.",\n        "additionalProperties": false,\n        "required": [\n          "id",\n          "item_type",\n          "order_id",\n          "user_id",\n          "role",\n          "beneficiary_credit_id",\n          "settle_seq",\n          "b_settle_fen",\n          "amount_fen",\n          "result",\n          "skip_reason",\n          "created_at"\n        ],\n        "properties": {\n          "id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "item_type": {\n            "$ref": "#/components/schemas/AdminSettleBatchItemType"\n          },\n          "order_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The beneficiary (beneficiary items only); null on order rows."\n          },\n          "role": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBatchItemRole"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "The beneficiary role (beneficiary items only); null on order rows."\n          },\n          "beneficiary_credit_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "The make-up obligation (beneficiary items only); null on order rows."\n          },\n          "settle_seq": {\n            "type": "integer",\n            "format": "int32",\n            "description": "order_settlements.seq at check time; execution skips the item when it no longer matches (BR-FUND-04 ⑦)."\n          },\n          "b_settle_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "description": "B_settle in fen (order rows always; beneficiary items when recorded)."\n          },\n          "amount_fen": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int64",\n            "description": "The amount credited in fen, recomputed at execution (beneficiary items); null on order rows and before execution."\n          },\n          "result": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminSettleBatchItemResult"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Null while the item is not executed yet."\n          },\n          "skip_reason": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "description": "Why the item was skipped; null otherwise."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminSettleBatchItemPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminSettleBatchItem"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminSettleBatchItemPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSettleBatchItemPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAssetSnapshotReceivable": {\n        "type": "object",\n        "description": "One asset_snapshot_receivables row of the snapshot (04 §3.2; BR-FUND-18, BR-FUND-20).",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "union_receivable_fen"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "union_receivable_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Balance in fen of the platform\'s union receivable account (UNION_RECEIVABLE:{platform}) over the entries with accounting_date ≤ D, as the snapshot wrote it."\n          }\n        }\n      },\n      "AdminAssetSnapshot": {\n        "type": "object",\n        "description": "One daily asset snapshot (04 §3.2 asset_snapshots) of accounting day D, written at D+1\\n00:01:00 +08:00 (BR-FUND-18). Amounts are integer fen exactly as the snapshot wrote them,\\nnever recomputed. The balance totals cover the entries with accounting_date ≤ D; the\\nwaiting and estimated totals are the order states at the time the snapshot ran.\\n",\n        "additionalProperties": false,\n        "required": [\n          "snapshot_date",\n          "total_available_positive_fen",\n          "total_negative_fen",\n          "total_frozen_fen",\n          "total_waiting_fen",\n          "total_estimated_fen",\n          "waiting_comparable",\n          "receivables",\n          "created_at",\n          "updated_at"\n        ],\n        "properties": {\n          "snapshot_date": {\n            "type": "string",\n            "format": "date",\n            "description": "The accounting day D (YYYY-MM-DD, +08:00); unique per app, the row key."\n          },\n          "total_available_positive_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Sum of the positive available balances in fen (withdrawable side, BR-FUND-18)."\n          },\n          "total_negative_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Sum of the magnitudes of the negative available balances in fen (BR-FUND-18 negative_fen side)."\n          },\n          "total_frozen_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Sum of the frozen balances in fen."\n          },\n          "total_waiting_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Shares in fen of the orders with rebate_status WAITING (已收货预估) when the snapshot ran."\n          },\n          "total_estimated_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Estimated total in fen (rebate_status ESTIMATED or WAITING, 预估合计) when the snapshot ran."\n          },\n          "waiting_comparable": {\n            "type": "boolean",\n            "description": "Whether the snapshot completed in time (BR-FUND-18): true only when it was confirmed\\nbefore D+1 00:30 +08:00, the latest the settlement batches wait for it. false when it\\ntimed out (an alert is raised and batches could run meanwhile) or was not yet\\nconfirmed; settlement batches may then have run before the snapshot read the orders,\\nso `total_waiting_fen` / `total_estimated_fen` of that day are not comparable with\\nother days. The balance totals do not depend on it (they go by accounting_date).\\n"\n          },\n          "receivables": {\n            "type": "array",\n            "description": "The union receivable per platform of the snapshot (asset_snapshot_receivables), ordered by platform code; only platforms with at least one receivable entry dated ≤ D; empty when none.",\n            "items": {\n              "$ref": "#/components/schemas/AdminAssetSnapshotReceivable"\n            }\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the snapshot row was written."\n          },\n          "updated_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the row last changed (the confirmation that sets waiting_comparable)."\n          }\n        }\n      },\n      "AdminAssetSnapshotPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminAssetSnapshot"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n      