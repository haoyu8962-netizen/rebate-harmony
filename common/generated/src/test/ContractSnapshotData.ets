: 1,\n          "maximum": 50,\n          "default": 20\n        }\n      }\n    },\n    "responses": {\n      "NoStoreClientError": {\n        "description": "Same as ClientError, with Cache-Control no-store (share pages, BR-ATTR-10 细则).",\n        "headers": {\n          "Cache-Control": {\n            "$ref": "#/components/headers/NoStore"\n          }\n        },\n        "content": {\n          "application/json": {\n            "schema": {\n              "$ref": "#/components/schemas/ErrorEnvelope"\n            },\n            "examples": {\n              "unionAuthRequired": {\n                "summary": "30101 Taobao not authorized",\n                "value": {\n                  "code": 30101,\n                  "msg": "请先授权淘宝",\n                  "data": {\n                    "auth_url": "https://oauth.example.test/authorize?state=st_01",\n                    "state": "st_01",\n                    "auth_methods": [\n                      "sdk_token",\n                      "web_code"\n                    ]\n                  },\n                  "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                }\n              },\n              "pddAuthRequired": {\n                "summary": "30111 Pinduoduo not authorized",\n                "value": {\n                  "code": 30111,\n                  "msg": "请先授权拼多多",\n                  "data": {\n                    "auth_jump": {\n                      "primary": {\n                        "type": "universal_link",\n                        "value": "https://auth.example.test/pdd/authorize?state=st_02"\n                      },\n                      "fallbacks": [\n                        {\n                          "type": "h5",\n                          "value": "https://auth.example.test/pdd/authorize?state=st_02&web=1"\n                        }\n                      ],\n                      "expire_at": "2026-10-02T09:40:00+08:00"\n                    }\n                  },\n          