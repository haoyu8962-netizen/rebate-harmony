ired": [\n          "privacy",\n          "agreement"\n        ],\n        "properties": {\n          "privacy": {\n            "$ref": "#/components/schemas/ConfigLegalPrivacy"\n          },\n          "agreement": {\n            "$ref": "#/components/schemas/ConfigLegalAgreement"\n          }\n        }\n      },\n      "ConfigInvite": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "required",\n          "backfill_hours"\n        ],\n        "properties": {\n          "required": {\n            "type": "boolean",\n            "description": "Must be false in the MVP (BR-INV-06)."\n          },\n          "backfill_hours": {\n            "type": "integer",\n            "format": "int32",\n            "description": "Window for entering an inviter later (BR-INV-07)."\n          },\n          "bind_phone_guide": {\n            "type": "boolean",\n            "description": "Show the bind-phone guide to new third-party accounts (BR-INV-03 细则). Optional in\\nthe schema like every key added after v0.9; the server always sends it.\\n"\n          },\n          "before_buy_tip": {\n            "type": "boolean",\n            "description": "Show the inviter tip before the first purchase (BR-INV-21)."\n          }\n        }\n      },\n      "ConfigAgent": {\n        "type": "object",\n        "description": "Agent availability and guest quota (04 §10.1; BR-AI-11, BR-AI-12).",\n        "additionalProperties": false,\n        "required": [\n          "enabled",\n          "whitelist_only",\n          "filing_text",\n          "examples",\n          "guest_daily_quota",\n          "require_phone"\n        ],\n        "properties": {\n          "enabled": {\n            "type": "boolean"\n          },\n          "whitelist_only": {\n            "type": "boolean"\n          },\n          "filing_text": {\n            "type": "string"\n          },\n          "examples": {\n            "type": "array",\n            "items": {\n              "type": "string"\n            }\n          },\n          "guest_daily_quota": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "require_phone": {\n            "type": "boolean"\n          }\n        }\n      },\n      "ConfigH5Release": {\n        "type": "object",\n        "description": "H5 version bucket for this caller (拍板第二批 TECH-28).",\n        "additionalProperties": false,\n        "required": [\n          "version"\n        ],\n        "properties": {\n          "version": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "ConfigKf": {\n        "type": "object",\n        "description": "WeCom customer-service chat link (chat entry only).",\n        "additionalProperties": false,\n        "required": [\n          "url"\n        ],\n        "properties": {\n          "url": {\n            "type": "string",\n            "format": "uri"\n          }\n        }\n      },\n      "ConfigExternalPage": {\n        "type": "object",\n        "description": "Third-party page container settings (BR-ATTR-29).",\n        "additionalProperties": false,\n        "required": [\n          "nav_host_sample_bp"\n        ],\n        "properties": {\n          "nav_host_sample_bp": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "maximum": 10000,\n            "description": "Sampling rate of document-level navigation hosts, 1/10000 (default in BR-ATTR-29)."\n          }\n        }\n      },\n      "LinkPatternCategory": {\n        "type": "string",\n        "description": "Category of a platform link pattern (enum link_pattern_category, BR-ATTR-29).",\n        "enum": [\n          "product",\n          "promo",\n          "union_host"\n        ]\n      },\n      "LinkPatternRule": {\n        "type": "object",\n        "description": "Hosts and path patterns of one platform and category. How hosts match (union_host by\\nregistered domain including subdomains) and the path pattern syntax are defined with the\\nsource table specs/link-patterns.yaml (CT-15g); concrete values come from real samples (B1-07).\\n",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "category",\n          "hosts",\n          "path_patterns"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "category": {\n            "$ref": "#/components/schemas/LinkPatternCategory"\n          },\n          "hosts": {\n            "type": "array",\n            "items": {\n              "type": "string",\n              "minLength": 1\n            }\n          },\n          "path_patterns": {\n            "type": "array",\n            "items": {\n              "type": "string",\n              "minLength": 1\n            }\n          }\n        }\n      },\n      "ConfigLinkPatterns": {\n        "type": "object",\n        "description": "Client pre-filter subset of the platform link pattern table (source\\nspecs/link-patterns.yaml). Clients decide where a document-level navigation in the\\nthird-party page container goes (main frame, subframe, new window); product recognition\\nfollows the server. When the fetch fails they use the last good version, then the bundled\\nsnapshot, and never stop intercepting (BR-ATTR-29).\\n",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "rules"\n        ],\n        "properties": {\n          "version": {\n            "type": "string",\n            "minLength": 1\n          },\n          "rules": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/LinkPatternRule"\n            }\n          }\n        }\n      },\n      "ConfigAppUpdate": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "recheck_interval_sec"\n        ],\n        "properties": {\n          "recheck_interval_sec": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "On returning to the foreground, call GET /v1/app-versions/check again when the last\\nsuccessful check is older than this (value and bundled default in BR-ID-01 细则\\n「最低支持版本的接口层拦截」).\\n"\n          }\n        }\n      },\n      "HelpLinkTarget": {\n        "type": "object",\n        "description": "Jump target {route, params} of a help_links entry: always one help article, the Help\\nroute of contracts/routes.json with its article_id (04 §10.1「原生页到帮助文章的入口表」).\\nconformance.ts checks that the route exists there and that params is a subset of that\\nroute\'s params schema.\\n",\n        "additionalProperties": false,\n        "required": [\n          "route",\n          "params"\n        ],\n        "properties": {\n          "route": {\n            "type": "string",\n            "enum": [\n              "Help"\n            ]\n          },\n          "params": {\n            "type": "object",\n            "additionalProperties": false,\n            "required": [\n              "article_id"\n            ],\n            "properties": {\n              "article_id": {\n                "type": "string",\n                "minLength": 1\n              }\n            }\n          }\n        }\n      },\n      "ConfigClaim": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "window_days"\n        ],\n        "properties": {\n          "window_days": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Days within which an order claim may be filed, claim.window_hours rounded down to\\ndays; null when below one day or not configured. Only renders the claim form\'s period\\nsentence (BR-ATTR-17 细则「找回页的填写指引」); claim.window_hours is not sent.\\n"\n          }\n        }\n      },\n      "Config": {\n        "type": "object",\n        "description": "Top-level keys of /v1/config (04 §10.1, excerpt). Keys added after v0.9 (external_page,\\nlink_patterns, external_hosts, app_update, help_links, claim, platform_icons,\\nlkg_max_age_sec, config_version, bridge_disabled_methods) are optional, so a client keeps reading an older last-good configuration (04 §5「兼容」); the\\nserver always sends them, except that platform_icons lists only the marks with a published\\nreplacement image (BR-TEXT-24). jump_tip, bridge_origins, auth_tips, compliance and display are not\\nshaped by 04 yet and stay free-form; the task that consumes each one types it\\n(bridge_origins with CT-03). clipboard is ConfigClipboard (only consent_version is typed).\\n",\n        "additionalProperties": false,\n        "required": [\n          "dict_version",\n          "h5_base_url",\n          "h5_release",\n          "share_domains",\n          "features",\n          "texts",\n          "legal",\n          "invite",\n          "agent",\n          "kf",\n          "jump_tip",\n          "clipboard",\n          "bridge_origins",\n          "auth_tips",\n          "compliance",\n          "display"\n        ],\n        "properties": {\n          "dict_version": {\n            "type": "string",\n            "description": "Version of the /v1/dict dictionary (BR-TEXT-12)."\n          },\n          "h5_base_url": {\n            "type": "string",\n            "format": "uri"\n          },\n          "h5_release": {\n            "$ref": "#/components/schemas/ConfigH5Release"\n          },\n          "share_domains": {\n            "type": "array",\n            "items": {\n              "type": "string"\n            }\n          },\n          "features": {\n            "$ref": "#/components/schemas/ConfigFeatures"\n          },\n          "texts": {\n            "type": "object",\n            "description": "Custom text keys, e.g. withdraw.sla_text (BR-TEXT-07).",\n            "additionalProperties": {\n              "type": "string"\n            }\n          },\n          "legal": {\n            "$ref": "#/components/schemas/ConfigLegal"\n          },\n          "invite": {\n            "$ref": "#/components/schemas/ConfigInvite"\n          },\n          "agent": {\n            "$ref": "#/components/schemas/ConfigAgent"\n          },\n          "kf": {\n            "$ref": "#/components/schemas/ConfigKf"\n          },\n          "jump_tip": {\n            "$ref": "#/components/schemas/FreeForm"\n          },\n          "clipboard": {\n            "$ref": "#/components/schemas/ConfigClipboard"\n          },\n          "bridge_origins": {\n            "$ref": "#/components/schemas/FreeForm"\n          },\n          "auth_tips": {\n            "$ref": "#/components/schemas/FreeForm"\n          },\n          "compliance": {\n            "$ref": "#/components/schemas/FreeForm"\n          },\n          "display": {\n            "$ref": "#/components/schemas/FreeForm"\n          },\n          "external_page": {\n            "$ref": "#/components/schemas/ConfigExternalPage"\n          },\n          "link_patterns": {\n            "$ref": "#/components/schemas/ConfigLinkPatterns"\n          },\n          "external_hosts": {\n            "type": "array",\n            "description": "Third-party page hosts a deep link may open in ExternalPage, matched by full host name\\n(values and default in BR-ID-10 细则「深链能打开的第三方页面」); push and in-app\\ntargets are not limited by it (03 §4.4).\\n",\n            "items": {\n              "type": "string",\n              "minLength": 1\n            }\n          },\n          "app_update": {\n            "$ref": "#/components/schemas/ConfigAppUpdate"\n          },\n          "help_links": {\n            "type": "object",\n            "description": "Native entries to help articles: key → jump target; an entry whose key is not\\nconfigured is not shown. Keys are defined by the rules that use them: price_compare\\n(BR-TEXT-03), claim_guide.<platform> (BR-ATTR-17 细则), login_help (BR-ID-02 细则),\\nwithdraw_rules (BR-WDR-04 细则). Values are operations configuration (article ids).\\n",\n            "additionalProperties": {\n              "$ref": "#/components/schemas/HelpLinkTarget"\n            }\n          },\n          "claim": {\n            "$ref": "#/components/schemas/ConfigClaim"\n          },\n          "platform_icons": {\n            "$ref": "#/components/schemas/ConfigPlatformIcons"\n          },\n          "lkg_max_age_sec": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "How long a last good configuration may be used, in seconds (02 §10, 03 §4.3); default 604800 (7 days)."\n          },\n          "config_version": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "pattern": "^[0-9A-Za-z._:-]+$",\n            "description": "Release version of this configuration, equal to the response ETag without quotes; saved together with the LKG (04 §10.1, 03 §4.7)."\n          },\n          "bridge_disabled_methods": {\n            "type": "array",\n            "uniqueItems": true,\n            "description": "Bridge methods disabled remotely; a call answers 90403 method_disabled (03 §5.3). Trial; default empty array.",\n            "items": {\n              "type": "string",\n              "pattern": "^[a-z][a-zA-Z0-9]*\\\\.[a-z][a-zA-Z0-9]*$"\n            }\n          }\n        }\n      },\n      "ConfigPlatformIcon": {\n        "type": "object",\n        "description": "A replacement image published in the admin console for one platform mark (BR-TEXT-24).\\nStored in the OSS media bucket under its content SHA-256 and cached long; each platform is\\nversioned on its own and a publish takes effect at once.\\n",\n        "additionalProperties": false,\n        "required": [\n          "url",\n          "sha256",\n          "version"\n        ],\n        "properties": {\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "pattern": "^https://",\n            "maxLength": 2048,\n            "description": "Image address on the media domain (set by deployment, not fixed by the contract); the\\nfile name is the content SHA-256.\\n"\n          },\n          "sha256": {\n            "type": "string",\n            "pattern": "^[0-9a-f]{64}$",\n            "description": "Lowercase hex SHA-256 of the image content, the same digest as the file name."\n          },\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Version of this platform\'s replacement image, counted per platform."\n          }\n        }\n      },\n      "ConfigPlatformIcons": {\n        "type": "object",\n        "description": "Platform mark replacement images (04 §10.1, BR-TEXT-24 细则): mark key → replacement\\nimage. Lists only the keys for which the admin console has published a replacement; a\\nmissing key (never replaced, or 「恢复内置」) means the client shows the image bundled in\\nthe package, and the object may be empty. Native clients download the image and check its\\nSHA-256 before use, falling back to the bundled image on a mismatch; H5 loads it with\\n`<img src=url>` and falls back to the bundled image on error. The accessible name is always\\nthe platform\'s Chinese name and never follows the image. The keys are enum\\nplatform_icon_key (PlatformIconKey, also the {key} of /admin/v1/platform-icons); new\\nplatforms add a key to both the same way.\\n",\n        "additionalProperties": false,\n        "properties": {\n          "taobao": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "tmall": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "jd": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "pdd": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "wechat": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "wechat_pay": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "alipay": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          },\n          "wecom": {\n            "$ref": "#/components/schemas/ConfigPlatformIcon"\n          }\n        }\n      },\n      "Dict": {\n        "type": "object",\n        "description": "The text dictionary (BR-TEXT-12); a key `<dict>.<code>` is items[dict][code].",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "items"\n        ],\n        "properties": {\n          "version": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 32,\n            "description": "Dictionary version, equal to data.dict_version of GET /v1/config; \\"0\\" before the first publish."\n          },\n          "items": {\n            "type": "object",\n            "description": "Texts by dict (the key\'s first segment), then by code (the rest of the key).",\n            "additionalProperties": {\n              "type": "object",\n              "additionalProperties": {\n                "type": "string"\n              }\n            }\n          }\n        }\n      },\n      "DictResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/Dict"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ConfigResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/Config"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ProductCta": {\n        "type": "object",\n        "description": "Buy button chosen by the server; the client never decides it (BR-TEXT-12, 拍板第二批\\nTRADE-21): btn.buy.coupon (有券有返), btn.buy (无券有返 and amount_unknown),\\nbtn.buy.no_rebate (无返利); other keys come with login_required and taolijin cards.\\n",\n        "additionalProperties": false,\n        "required": [\n          "text_key"\n        ],\n        "properties": {\n          "text_key": {\n            "type": "string",\n            "minLength": 1\n          }\n        }\n      },\n      "ProductTlj": {\n        "type": "object",\n        "description": "Taolijin of the card, absent when there is none (BR-PRICE-08); never folded into prices.",\n        "additionalProperties": false,\n        "required": [\n          "amount_fen",\n          "remain",\n          "kind"\n        ],\n        "properties": {\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "remain": {\n            "type": "integer",\n            "format": "int32"\n          },\n          "kind": {\n            "type": "string",\n            "description": "contracts/enums/trade.yaml tlj_kind.",\n            "enum": [\n              "ours",\n              "brand_open",\n              "third_party",\n              "unknown"\n            ]\n          }\n        }\n      },\n      "ProductCard": {\n        "type": "object",\n        "description": "Product card (04 §8.3). Price semantics BR-PRICE-01 / 05; rebate_* and est_net_price_fen\\nare computed per request for the current caller and never cached (BR-PRICE-11). The card\\ncarries a registered `link_id`; buying always goes through POST /v1/links/{link_id}/open\\n(BR-PRICE-12, BR-PRICE-21). amount_unknown cards have product_key, prices and rebate\\nnull (BR-PRICE-08).\\n",\n        "additionalProperties": false,\n        "required": [\n          "product_key",\n          "item_ref",\n          "platform",\n          "title",\n          "image",\n          "price_fen",\n          "coupon_fen",\n          "final_price_fen",\n          "est_net_price_fen",\n          "rebate_min_fen",\n          "rebate_max_fen",\n          "rebate_basis",\n          "benefit_tags",\n          "is_presale",\n          "link_id",\n          "cta",\n          "quoted_at",\n          "stale",\n          "age_sec",\n          "source",\n          "disclaimer_keys",\n          "availability"\n        ],\n        "properties": {\n          "card_id": {\n            "type": "string",\n            "description": "Agent card sequence id (c1, c2…), only on Agent cards (BR-AI-05)."\n          },\n          "product_key": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Opaque product key (BR-PROD-02); null only on amount_unknown cards.",\n            "minLength": 3,\n            "maxLength": 128\n          },\n          "item_ref": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Opaque signed reference passed through unchanged (BR-PROD-11).",\n            "minLength": 1,\n            "maxLength": 1024\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "shop_type": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Shop type, e.g. tmall for Tmall shops on taobao."\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri"\n          },\n          "shop_name": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "coupon_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "final_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "est_net_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "rebate_min_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "rebate_max_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "rebate_basis": {\n            "$ref": "#/components/schemas/RebateBasis"\n          },\n          "no_rebate_cause": {\n            "description": "May be non-null only when rebate_basis=no_rebate (BR-PRICE-08 细则「无返利原因」);\\nunknown values are treated as null. Not the open request\'s no_rebate_reason.\\n",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/NoRebateCause"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "benefit_tags": {\n            "type": "array",\n            "description": "Server-generated labels (有券, 预售, 标题显示为 X…); no per-card reasons.",\n            "items": {\n              "type": "string"\n            }\n          },\n          "match_tag": {\n            "type": "string",\n            "description": "Agent cards only (BR-AI-24); contracts/enums/trade.yaml match_tag.",\n            "enum": [\n              "matched",\n              "relaxed",\n              "spec_unconfirmed"\n            ]\n          },\n          "spec_text": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "is_presale": {\n            "type": "boolean",\n            "description": "Presale; shown with the total price (BR-PRICE-22)."\n          },\n          "tlj": {\n            "$ref": "#/components/schemas/ProductTlj"\n          },\n          "link_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "cta": {\n            "$ref": "#/components/schemas/ProductCta"\n          },\n          "quoted_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Receipt time of the union response the price is based on (BR-PRICE-11)."\n          },\n          "stale": {\n            "type": "boolean"\n          },\n          "age_sec": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "description": "Age of the price in seconds, computed by the server (BR-PRICE-11)."\n          },\n          "source": {\n            "type": "string",\n            "description": "Price source (BR-PRICE-16).",\n            "enum": [\n              "taobao_union",\n              "jd_union",\n              "pdd_union"\n            ]\n          },\n          "disclaimer_keys": {\n            "type": "array",\n            "description": "Ordered dictionary keys (BR-PRICE-17), including price_basis.",\n            "items": {\n              "type": "string"\n            }\n          },\n          "ad_label": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Ad label (BR-TEXT-17); null on Agent relevance cards."\n          },\n          "availability": {\n            "$ref": "#/components/schemas/Availability"\n          },\n          "favorited": {\n            "type": "boolean",\n            "description": "Only on the product detail response (GET /v1/products/{product_key}): whether the\\ncaller has favorited this product; false when not logged in (规划/01 F-PROD-12).\\n"\n          }\n        }\n      },\n      "SearchProductsData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor",\n          "has_more",\n          "fallback_items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "maxItems": 50,\n            "items": {\n              "$ref": "#/components/schemas/ProductCard"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "has_more": {\n            "type": "boolean",\n            "description": "As reported by the union, not by the filtered page size (BR-PRICE-08)."\n          },\n          "fallback_items": {\n            "type": "array",\n            "description": "Only when items is empty on the first page; the platform\'s first 10 feed items.",\n            "maxItems": 10,\n            "items": {\n              "$ref": "#/components/schemas/ProductCard"\n            }\n          }\n        }\n      },\n      "SearchProductsResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/SearchProductsData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ProductResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ProductCard"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "Favorite": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "product_key",\n          "favorited_at"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "product_key": {\n            "$ref": "#/components/schemas/ProductKey"\n          },\n          "favorited_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "When the product was favorited (the original time for a repeated add)."\n          }\n        }\n      },\n      "FavoriteResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/Favorite"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "InvalidFavoriteCard": {\n        "type": "object",\n        "description": "Card of an invalid favorite; only the title and the image, no price and no rebate.",\n        "additionalProperties": false,\n        "required": [\n          "title",\n          "image"\n        ],\n        "properties": {\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri"\n          }\n        }\n      },\n      "FavoriteItem": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "product_key",\n          "favorited_at",\n          "invalid",\n          "product_card"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "product_key": {\n            "$ref": "#/components/schemas/ProductKey"\n          },\n          "favorited_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "invalid": {\n            "type": "boolean",\n            "description": "true when fetching the card the union answered that the product does not exist, is\\noff shelf or cannot be promoted.\\n"\n          },\n          "product_card": {\n            "description": "invalid=false: the list card, same shape as a search card (ProductCard). invalid=true:\\nInvalidFavoriteCard, only the title and the image.\\n",\n            "oneOf": [\n              {\n                "$ref": "#/components/schemas/ProductCard"\n              },\n              {\n                "$ref": "#/components/schemas/InvalidFavoriteCard"\n              }\n            ]\n          }\n        }\n      },\n      "FavoriteListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "maxItems": 50,\n            "items": {\n              "$ref": "#/components/schemas/FavoriteItem"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          }\n        }\n      },\n      "FavoriteListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/FavoriteListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "FavoriteRef": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "product_key"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "product_key": {\n            "$ref": "#/components/schemas/ProductKey"\n          }\n        }\n      },\n      "BatchDeleteFavoritesRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "minItems": 1,\n            "maxItems": 100,\n            "items": {\n              "$ref": "#/components/schemas/FavoriteRef"\n            }\n          }\n        }\n      },\n      "PriceTrendPoint": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "date",\n          "final_price_fen"\n        ],\n        "properties": {\n          "date": {\n            "type": "string",\n            "format": "date",\n            "description": "Natural day in +08:00 (YYYY-MM-DD)."\n          },\n          "final_price_fen": {\n            "$ref": "#/components/schemas/Fen"\n          }\n        }\n      },\n      "ProductPriceTrend": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "status",\n          "points",\n          "start_date",\n          "window_days",\n          "source_key"\n        ],\n        "properties": {\n          "status": {\n            "type": "string",\n            "description": "ok = points to draw; no_data = show price_trend.empty.",\n            "enum": [\n              "ok",\n              "no_data"\n            ]\n          },\n          "points": {\n            "type": "array",\n            "description": "One point per day in date order; empty when status=no_data.",\n            "items": {\n              "$ref": "#/components/schemas/PriceTrendPoint"\n            }\n          },\n          "start_date": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date",\n            "description": "Date of the first record in the window; null when status=no_data."\n          },\n          "window_days": {\n            "type": "integer",\n            "format": "int32",\n            "description": "Window length in days, 30.",\n            "enum": [\n              30\n            ]\n          },\n          "source_key": {\n            "type": "string",\n            "description": "Text key of the source line (price_trend.source.general for a product without coupon).",\n            "enum": [\n              "price_trend.source",\n              "price_trend.source.general"\n            ]\n          }\n        }\n      },\n      "ProductPriceTrendResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ProductPriceTrend"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ParseInputRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "text",\n          "scene"\n        ],\n        "properties": {\n          "text": {\n            "type": "string",\n            "description": "Locally filtered clipboard or typed text (03 §4.6). Text outside links and tokens\\nis untrusted (BR-AI-05); prices in it are only material.claimed_price_fen.\\n",\n            "minLength": 1,\n            "maxLength": 4000\n          },\n          "scene": {\n            "type": "string",\n            "description": "Entry the text came from (subset of contracts/enums scene). Attribution-bearing\\nscenes (share, agent, …) cannot be chosen by the client: share links come only from\\nPOST /v1/shares (phone level), Agent cards from the Agent service (BR-ATTR-05, 08).\\nshare_ext is P1.\\n",\n            "enum": [\n              "clipboard",\n              "search",\n              "share_ext"\n            ]\n          }\n        }\n      },\n      "InputHit": {\n        "type": "object",\n        "description": "One candidate found by parse_input (04 §8.5).",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "kind",\n          "raw"\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "kind": {\n            "type": "string",\n            "description": "contracts/enums/trade.yaml input_kind.",\n            "enum": [\n              "tpwd",\n              "url",\n              "text"\n            ]\n          },\n          "raw": {\n            "type": "string",\n            "description": "The matched link or token as it appeared in the input."\n          }\n        }\n      },\n      "ParseResult": {\n        "type": "object",\n        "description": "Result of one hit; exactly one of `card` and `error_code` is present. The oneOf branches\\ndeclare the property they require (strict Ajv2020, ADR-0001 §4.2 #15).\\n",\n        "additionalProperties": false,\n        "required": [\n          "hit"\n        ],\n        "properties": {\n          "hit": {\n            "$ref": "#/components/schemas/InputHit"\n          },\n          "card": {\n            "$ref": "#/components/schemas/ProductCard"\n          },\n          "error_code": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 10000,\n            "maximum": 59999,\n            "description": "Error code for this hit (30131, 30132, 30141, 50301…), see error-codes.yaml."\n          }\n        },\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "card": {\n                "$ref": "#/components/schemas/ProductCard"\n              }\n            },\n            "required": [\n              "card"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "error_code": {\n                "type": "integer",\n                "format": "int32",\n                "minimum": 10000,\n                "maximum": 59999\n              }\n            },\n            "required": [\n              "error_code"\n            ]\n          }\n        ]\n      },\n      "ParseInputData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "results"\n        ],\n        "properties": {\n          "results": {\n            "type": "array",\n            "minItems": 1,\n            "maxItems": 3,\n            "items": {\n              "$ref": "#/components/schemas/ParseResult"\n            }\n          }\n        }\n      },\n      "ParseInputResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ParseInputData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "OpenLinkRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "properties": {\n          "installed": {\n            "$ref": "#/components/schemas/InstalledState",\n            "description": "Default unknown; H5 always sends unknown (BR-ATTR-27 ①)."\n          },\n          "no_rebate": {\n            "type": "boolean",\n            "default": false,\n            "description": "Buy without rebate (BR-ID-18)."\n          },\n          "no_rebate_reason": {\n            "type": "string",\n            "description": "Only with no_rebate=true; default auth_declined. The server overrides it with\\nrelation_conflict / binding_blocked when it decides so (BR-ID-18).\\n",\n            "enum": [\n              "auth_declined",\n              "auth_failed"\n            ]\n          },\n          "spm": {\n            "type": "string",\n            "description": "page.module.slot of the tapped button (03 §4.7).",\n            "maxLength": 128\n          }\n        }\n      },\n      "OpenLinkResult": {\n        "type": "object",\n        "description": "Response of open (04 §8.4). old_final_price_fen is the link\'s quoted_final_price_fen;\\nprice_changed when |new − old| ≥ 100 fen or ≥ 5 % of old, both directions (BR-PRICE-13).\\nPrices and rebates are null on amount_unknown links, which are not re-checked. There is no\\nrebate_basis: no rebate is expressed by new_rebate_max_fen = 0 (BR-PRICE-08, BR-PRICE-13).\\n",\n        "additionalProperties": false,\n        "required": [\n          "attempt_id",\n          "jump",\n          "price_changed",\n          "old_final_price_fen",\n          "new_final_price_fen",\n          "new_link_id",\n          "requote_failed",\n          "new_rebate_min_fen",\n          "new_rebate_max_fen",\n          "availability",\n          "quoted_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Issued by the server for this open attempt: a new one for every open of a link, the\\nsame one when the same Idempotency-Key is replayed. The client sends it in every\\nlink_jump of this jump (BR-ATTR-21 细则「待跟单卡按实际外跳选」).\\n"\n          },\n          "no_rebate_cause": {\n            "description": "Non-null only when new_rebate_max_fen = 0 and the reason is known; unknown values are\\ntreated as null. Not the request\'s no_rebate_reason (BR-ID-18).\\n",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/NoRebateCause"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "jump": {\n            "$ref": "#/components/schemas/JumpPlan"\n          },\n          "price_changed": {\n            "type": "boolean"\n          },\n          "old_final_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "new_final_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "new_link_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Set whenever the new price differs from the snapshot, or when a new link was\\nregistered for the current user (BR-PRICE-12, BR-ATTR-05 ③); the client replaces the\\ncard with it whether or not the user continues.\\n"\n          },\n          "requote_failed": {\n            "type": "boolean",\n            "description": "Re-check failed: the user\'s cached link (≤ 900 s) is used, or, for a `no_rebate=true`\\nopen, the no-rebate conversion or unpromoted product page (BR-PRICE-13).\\n"\n          },\n          "new_rebate_min_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "new_rebate_max_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "availability": {\n            "$ref": "#/components/schemas/Availability"\n          },\n          "quoted_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "OpenLinkResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/OpenLinkResult"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ConvertLinkRequest": {\n        "type": "object",\n        "description": "Either product_key (with the tapped card\'s item_ref) or url; neither, or both, is 20001.\\nThe oneOf branches declare the property they require (strict Ajv2020, ADR-0001 §4.2 #15).\\nA Taobao url is first resolved to an item_id and answered with a Baichuan open instruction\\n(JumpStep.sdk); the pasted link or token itself is never passed on (BR-PRICE-21).\\n",\n        "additionalProperties": false,\n        "required": [\n          "platform",\n          "scene"\n        ],\n        "oneOf": [\n          {\n            "type": "object",\n            "properties": {\n              "product_key": {\n                "$ref": "#/components/schemas/ProductKey"\n              }\n            },\n            "required": [\n              "product_key"\n            ]\n          },\n          {\n            "type": "object",\n            "properties": {\n              "url": {\n                "type": "string",\n                "format": "uri",\n                "maxLength": 2048\n              }\n            },\n            "required": [\n              "url"\n            ]\n          }\n        ],\n        "properties": {\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "product_key": {\n            "$ref": "#/components/schemas/ProductKey"\n          },\n          "item_ref": {\n            "$ref": "#/components/schemas/ItemRef"\n          },\n          "url": {\n            "type": "string",\n            "format": "uri",\n            "maxLength": 2048\n          },\n          "scene": {\n            "type": "string",\n            "description": "Only the H5 entry (trade.convertAndOpen) uses convert (拍板第二批 TRADE-03); other\\nscenes are rejected with 20001 so that the client cannot pick an attribution scene\\nsuch as share (BR-ATTR-05, BR-ATTR-08).\\n",\n            "enum": [\n              "h5"\n            ]\n          },\n          "spm": {\n            "type": "string",\n            "maxLength": 128\n          },\n          "installed": {\n            "$ref": "#/components/schemas/InstalledState",\n            "description": "Default unknown; H5 always sends unknown (BR-ATTR-27 ①)."\n          }\n        }\n      },\n      "ConvertLinkData": {\n        "type": "object",\n        "description": "The registered link_id plus the same fields as the open result (04 §6.3).",\n        "additionalProperties": false,\n        "required": [\n          "link_id",\n          "attempt_id",\n          "jump",\n          "price_changed",\n          "old_final_price_fen",\n          "new_final_price_fen",\n          "new_link_id",\n          "requote_failed",\n          "new_rebate_min_fen",\n          "new_rebate_max_fen",\n          "availability",\n          "quoted_at"\n        ],\n        "properties": {\n          "attempt_id": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Issued by the server for this open attempt: a new one for every open of a link, the\\nsame one when the same Idempotency-Key is replayed. The client sends it in every\\nlink_jump of this jump (BR-ATTR-21 细则「待跟单卡按实际外跳选」).\\n"\n          },\n          "no_rebate_cause": {\n            "description": "Non-null only when new_rebate_max_fen = 0 and the reason is known; unknown values are\\ntreated as null. Not the request\'s no_rebate_reason (BR-ID-18).\\n",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/NoRebateCause"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "link_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "jump": {\n            "$ref": "#/components/schemas/JumpPlan"\n          },\n          "price_changed": {\n            "type": "boolean"\n          },\n          "old_final_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "new_final_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "new_link_id": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "requote_failed": {\n            "type": "boolean"\n          },\n          "new_rebate_min_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "new_rebate_max_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "availability": {\n            "$ref": "#/components/schemas/Availability"\n          },\n          "quoted_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "ConvertLinkResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ConvertLinkData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "LinkKind": {\n        "type": "string",\n        "description": "Kind of a link on the in-app landing page (contracts/enums/trade.yaml link_kind).",\n        "enum": [\n          "share",\n          "other"\n        ]\n      },\n      "SharedProductCard": {\n        "type": "object",\n        "description": "Product card subset of the share page and the in-app link landing page (04 §6.3): the\\nfields of ProductCard without rebate_min_fen, rebate_max_fen, rebate_basis,\\nno_rebate_cause and est_net_price_fen (no rebate amount is shown to the opener,\\nBR-PRICE-06, BR-ATTR-10), without cta (its key is derived from the rebate state), and\\nwithout the Agent-only card_id, match_tag and spec_text. quoted_at sits next to the card.\\n",\n        "additionalProperties": false,\n        "required": [\n          "product_key",\n          "item_ref",\n          "platform",\n          "title",\n          "image",\n          "price_fen",\n          "coupon_fen",\n          "final_price_fen",\n          "benefit_tags",\n          "is_presale",\n          "link_id",\n          "stale",\n          "age_sec",\n          "source",\n          "disclaimer_keys",\n          "availability"\n        ],\n        "properties": {\n          "product_key": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Opaque product key (BR-PROD-02); null only on amount_unknown cards.",\n            "minLength": 3,\n            "maxLength": 128\n          },\n          "item_ref": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Opaque signed reference passed through unchanged (BR-PROD-11).",\n            "minLength": 1,\n            "maxLength": 1024\n          },\n          "platform": {\n            "$ref": "#/components/schemas/PlatformCode"\n          },\n          "shop_type": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Shop type, e.g. tmall for Tmall shops on taobao."\n          },\n          "title": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "image": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri"\n          },\n          "shop_name": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "coupon_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "final_price_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "benefit_tags": {\n            "type": "array",\n            "description": "Server-generated labels (有券, 预售…).",\n            "items": {\n              "type": "string"\n            }\n          },\n          "is_presale": {\n            "type": "boolean",\n            "description": "Presale; shown with the total price (BR-PRICE-22)."\n          },\n          "tlj": {\n            "$ref": "#/components/schemas/ProductTlj"\n          },\n          "link_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "stale": {\n            "type": "boolean"\n          },\n          "age_sec": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "description": "Age of the price in seconds, computed by the server (BR-PRICE-11)."\n          },\n          "source": {\n            "type": "string",\n            "description": "Price source (BR-PRICE-16).",\n            "enum": [\n              "taobao_union",\n              "jd_union",\n              "pdd_union"\n            ]\n          },\n          "disclaimer_keys": {\n            "type": "array",\n            "description": "Ordered dictionary keys (BR-PRICE-17), including price_basis.",\n            "items": {\n              "type": "string"\n            }\n          },\n          "ad_label": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Ad label (BR-TEXT-17)."\n          },\n          "availability": {\n            "$ref": "#/components/schemas/Availability"\n          }\n        }\n      },\n      "LinkLandingData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "link_kind",\n          "product_card",\n          "quoted_at",\n          "viewer_is_sharer"\n        ],\n        "properties": {\n          "link_kind": {\n            "$ref": "#/components/schemas/LinkKind"\n          },\n          "product_card": {\n            "$ref": "#/components/schemas/SharedProductCard"\n          },\n          "quoted_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Receipt time of the union response the price is based on (BR-PRICE-11)."\n          },\n          "viewer_is_sharer": {\n            "type": "boolean",\n            "description": "True only when called with a token whose user is the sharer of this share link; only\\nfor the hint above the card (BR-ATTR-11). False for anonymous calls and other links.\\n"\n          }\n        }\n      },\n      "LinkLandingResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/LinkLandingData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "SharePageData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "product_card",\n          "quoted_at",\n          "jump_url",\n          "tpwd_ticket",\n          "open_in_app_url"\n        ],\n        "properties": {\n          "product_card": {\n            "$ref": "#/components/schemas/SharedProductCard"\n          },\n          "quoted_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Receipt time of the union response the price is based on (BR-PRICE-11)."\n          },\n          "jump_url": {\n            "type": "string",\n            "format": "uri",\n            "description": "The sharer\'s converted short link used for the jump; never contains a token."\n          },\n          "tpwd_ticket": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "minLength": 1,\n            "maxLength": 256,\n            "description": "Short-lived ticket for POST /v1/share-pages/{link_id}/tpwd; null inside WeChat, without\\nUser-Agent, or when the link has no token (BR-ATTR-10 细则).\\n"\n          },\n          "open_in_app_url": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "uri",\n            "description": "LinkLanding deep link; null while share.open_in_app.enabled is off."\n          }\n        }\n      },\n      "SharePageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/SharePageData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "ShareTpwdRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "ticket"\n        ],\n        "properties": {\n          "ticket": {\n            "type": "string",\n            "description": "tpwd_ticket from GET /v1/share-pages/{link_id}.",\n            "minLength": 1,\n            "maxLength": 256\n          }\n        }\n      },\n      "ShareTpwdData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "tpwd"\n        ],\n        "properties": {\n          "tpwd": {\n            "type": "string",\n            "minLength": 1,\n            "description": "The token of the share link, to be copied by the page."\n          }\n        }\n      },\n      "ShareTpwdResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/ShareTpwdData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "EarningsPeriod": {\n        "type": "object",\n        "description": "One period of the self or share column (BR-FUND-25).",\n        "additionalProperties": false,\n        "required": [\n          "paid_count",\n          "est_fen",\n          "credited_fen"\n        ],\n        "properties": {\n          "paid_count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Paid child orders attributed to the user in the period (by paid_at)."\n          },\n          "est_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Estimated share of the user, by paid_at."\n          },\n          "credited_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Signed sum of the credit entries by accounting_date; negative when the period has only reversals."\n          }\n        }\n      },\n      "ReferralEarningsPeriod": {\n        "type": "object",\n        "description": "One period of the referral column (BR-FUND-25); no count.",\n        "additionalProperties": false,\n        "required": [\n          "est_fen",\n          "credited_fen"\n        ],\n        "properties": {\n          "est_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Estimated direct and indirect referral share, by paid_at."\n          },\n          "credited_fen": {\n            "type": "integer",\n            "format": "int64",\n            "description": "Signed sum of the REFERRAL_CREDIT entries by accounting_date."\n          }\n        }\n      },\n      "EarningsColumn": {\n        "type": "object",\n        "description": "Self or share column, four periods.",\n        "additionalProperties": false,\n        "required": [\n          "today",\n          "yesterday",\n          "this_month",\n          "last_month"\n        ],\n        "properties": {\n          "today": {\n            "$ref": "#/components/schemas/EarningsPeriod"\n          },\n          "yesterday": {\n            "$ref": "#/components/schemas/EarningsPeriod"\n          },\n          "this_month": {\n            "$ref": "#/components/schemas/EarningsPeriod"\n          },\n          "last_month": {\n            "$ref": "#/components/schemas/EarningsPeriod"\n          }\n        }\n      },\n      "ReferralEarnings": {\n        "type": "object",\n        "description": "Referral column, only this month and last month, all platforms.",\n        "additionalProperties": false,\n        "required": [\n          "this_month",\n          "last_month"\n        ],\n        "properties": {\n          "this_month": {\n            "$ref": "#/components/schemas/ReferralEarningsPeriod"\n          },\n          "last_month": {\n            "$ref": "#/components/schemas/ReferralEarningsPeriod"\n          }\n        }\n      },\n      "EarningsSummary": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "as_of",\n          "self",\n          "share",\n          "referral"\n        ],\n        "properties": {\n          "as_of": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Time the figures were computed (BR-FUND-25 细则)."\n          },\n          "self": {\n            "$ref": "#/components/schemas/EarningsColumn"\n          },\n          "share": {\n            "$ref": "#/components/schemas/EarningsColumn"\n          },\n          "referral": {\n            "description": "null while earnings.dashboard.referral_visible is off.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/ReferralEarnings"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          }\n        }\n      },\n      "EarningsSummaryResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/EarningsSummary"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminLoginTicket": {\n        "type": "string",\n        "description": "Intermediate credential of the admin login (BR-ID-34 细则「首次绑定身份验证器」): valid only for\\nthe step it was issued for, sent in the request body, never an admin_token.\\n",\n        "minLength": 1,\n        "maxLength": 2048\n      },\n      "AdminLoginRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "username",\n          "password"\n        ],\n        "properties": {\n          "username": {\n            "type": "string",\n            "description": "Account name (unique; a disabled account keeps its name, BR-ID-34).",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "password": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 128\n          }\n        }\n      },\n      "AdminLoginTicketRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "login_ticket"\n        ],\n        "properties": {\n          "login_ticket": {\n            "$ref": "#/components/schemas/AdminLoginTicket"\n          }\n        }\n      },\n      "AdminChangePasswordRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "login_ticket",\n          "new_password"\n        ],\n        "properties": {\n          "login_ticket": {\n            "$ref": "#/components/schemas/AdminLoginTicket"\n          },\n          "new_password": {\n            "type": "string",\n            "description": "Must differ from the initial password; composition rules are set by the server.",\n            "minLength": 1,\n            "maxLength": 128\n          }\n        }\n      },\n      "AdminTotpCode": {\n        "type": "string",\n        "description": "Current 6-digit code of the authenticator, or of the SMS for the sms tier.",\n        "pattern": "^[0-9]{6}$"\n      },\n      "AdminTotpCodeRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "login_ticket",\n          "code"\n        ],\n        "properties": {\n          "login_ticket": {\n            "$ref": "#/components/schemas/AdminLoginTicket"\n          },\n          "code": {\n            "$ref": "#/components/schemas/AdminTotpCode"\n          }\n        }\n      },\n      "AdminLoginStep": {\n        "type": "string",\n        "description": "Next login step (enum admin_login_step).",\n        "enum": [\n          "totp",\n          "change_password",\n          "bind_totp"\n        ]\n      },\n      "AdminLoginStepData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "next",\n          "login_ticket",\n          "ticket_expires_at"\n        ],\n        "properties": {\n          "next": {\n            "$ref": "#/components/schemas/AdminLoginStep"\n          },\n          "login_ticket": {\n            "$ref": "#/components/schemas/AdminLoginTicket"\n          },\n          "ticket_expires_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminLoginStepResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminLoginStepData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminTotpSecretData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "totp_secret",\n          "otpauth_uri"\n        ],\n        "properties": {\n          "totp_secret": {\n            "type": "string",\n            "description": "Base32 TOTP secret, shown for manual entry.",\n            "minLength": 16,\n            "maxLength": 128,\n            "pattern": "^[A-Z2-7]+=*$"\n          },\n          "otpauth_uri": {\n            "type": "string",\n            "description": "Key URI the console renders as the QR code.",\n            "maxLength": 2048,\n            "pattern": "^otpauth://totp/"\n          }\n        }\n      },\n      "AdminTotpSecretResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminTotpSecretData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminSession": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "admin_token",\n          "expires_at",\n          "idle_timeout_sec"\n        ],\n        "properties": {\n          "admin_token": {\n            "type": "string",\n            "description": "Sent in the Authorization header as a Bearer token (security scheme adminBearerAuth).",\n            "minLength": 1,\n            "maxLength": 4096\n          },\n          "expires_at": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Absolute expiry of the session (BR-ID-34)."\n          },\n          "idle_timeout_sec": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Seconds without activity after which the token stops working (BR-ID-34)."\n          }\n        }\n      },\n      "AdminSessionResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminSession"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminStepUpTier": {\n        "type": "string",\n        "description": "Admin step-up tier (enum admin_step_up_tier, BR-ID-34).",\n        "enum": [\n          "totp",\n          "sms"\n        ]\n      },\n      "AdminStepUpRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "tier",\n          "code"\n        ],\n        "properties": {\n          "tier": {\n            "$ref": "#/components/schemas/AdminStepUpTier"\n          },\n          "code": {\n            "$ref": "#/components/schemas/AdminTotpCode"\n          }\n        }\n      },\n      "AdminStepUpData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "step_up_token",\n          "tier",\n          "expire_at"\n        ],\n        "properties": {\n          "step_up_token": {\n            "type": "string",\n            "description": "Sent as the `X-Step-Up-Token` header of the admin operation; records its tier.",\n            "minLength": 1,\n            "maxLength": 2048\n          },\n          "tier": {\n            "$ref": "#/components/schemas/AdminStepUpTier"\n          },\n          "expire_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminStepUpResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminStepUpData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminPermissionKey": {\n        "type": "string",\n        "description": "A value of contracts/enums/admin.yaml `admin_permission` (04 §11). Kept a string here so the\\nlist lives in one place; clients ignore keys they do not know.\\n",\n        "minLength": 1,\n        "maxLength": 64,\n        "pattern": "^[a-z][a-z_]*(\\\\.[a-z_]+)*$"\n      },\n      "AdminStepUpOperation": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "operation",\n          "tier"\n        ],\n        "properties": {\n          "operation": {\n            "type": "string",\n            "description": "Operation key from specs/permissions.yaml (B1-18).",\n            "minLength": 1,\n            "maxLength": 128,\n            "pattern": "^[a-z][a-z0-9_]*(\\\\.[a-z0-9_]+)*$"\n          },\n          "tier": {\n            "$ref": "#/components/schemas/AdminStepUpTier"\n          }\n        }\n      },\n      "AdminPermissionGrant": {\n        "type": "object",\n        "description": "A permission point of the account with its step-up annotation (04 §11 step-up column).",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "step_up_tier",\n          "step_up_operations"\n        ],\n        "properties": {\n          "key": {\n            "$ref": "#/components/schemas/AdminPermissionKey"\n          },\n          "step_up_tier": {\n            "description": "Tier of every step-up operation of this point; null = none needs step-up.",\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminStepUpTier"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "step_up_operations": {\n            "type": "array",\n            "description": "Operations of this point whose tier differs from step_up_tier.",\n            "items": {\n              "$ref": "#/components/schemas/AdminStepUpOperation"\n            }\n          }\n        }\n      },\n      "AdminMe": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "admin_id",\n          "username",\n          "is_super",\n          "verify_phone_masked",\n          "permissions"\n        ],\n        "properties": {\n          "admin_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "username": {\n            "type": "string",\n            "description": "Account name, also shown as the display name.",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "is_super": {\n            "type": "boolean"\n          },\n          "verify_phone_masked": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Masked verify phone (BR-ID-33); null = none registered, sms tier unavailable.",\n            "maxLength": 32\n          },\n          "permissions": {\n            "type": "array",\n            "description": "Every point for a super admin, the ticked points otherwise; empty = no permission.",\n            "items": {\n              "$ref": "#/components/schemas/AdminPermissionGrant"\n            }\n          }\n        }\n      },\n      "AdminMeResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminMe"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminDashboardTodoKey": {\n        "type": "string",\n        "description": "A to-do card of the workbench (enum admin_dashboard_todo_key; 01 F-ADM-26 ①). Each value\\nis shown only to accounts holding its permission point (see the enum).\\n",\n        "enum": [\n          "withdraw_review_pending",\n          "claim_review_pending",\n          "settle_bill_pending",\n          "recon_diff_open",\n          "appeal_pending",\n          "agent_report_overdue",\n          "beneficiary_held_overdue",\n          "union_auth_expiring"\n        ]\n      },\n      "AdminDashboardTodoBreakdown": {\n        "type": "object",\n        "description": "One sub-count of a card (e.g. claim_review_pending auto_matched / manual_review).",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "count"\n        ],\n        "properties": {\n          "key": {\n            "type": "string",\n            "description": "Card-specific sub-key; clients ignore keys they do not know.",\n            "minLength": 1,\n            "maxLength": 64,\n            "pattern": "^[a-z][a-z0-9_]*$"\n          },\n          "count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminDashboardTodo": {\n        "type": "object",\n        "description": "One to-do card. Present only when the account holds the card\'s permission point and the\\ncard\'s module has shipped; then present with count 0 too.\\n",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "count",\n          "route"\n        ],\n        "properties": {\n          "key": {\n            "$ref": "#/components/schemas/AdminDashboardTodoKey"\n          },\n          "count": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "Items waiting, equal to the pending count of the card\'s list page."\n          },\n          "route": {\n            "type": "string",\n            "description": "Console route the card opens, with its filter query.",\n            "minLength": 1,\n            "maxLength": 512,\n            "pattern": "^/"\n          },\n          "oldest_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Time of the earliest waiting item; null when count is 0."\n          },\n          "breakdown": {\n            "type": "array",\n            "description": "Sub-counts of the card; their sum equals count.",\n            "items": {\n              "$ref": "#/components/schemas/AdminDashboardTodoBreakdown"\n            }\n          }\n        }\n      },\n      "AdminDashboardYesterday": {\n        "type": "object",\n        "description": "Yesterday\'s whole day, aggregated daily with the report rules (01 F-ADM-26 ②).",\n        "additionalProperties": false,\n        "required": [\n          "date",\n          "links",\n          "orders",\n          "est_rebate_fen",\n          "new_users",\n          "as_of"\n        ],\n        "properties": {\n          "date": {\n            "type": "string",\n            "format": "date",\n            "description": "The day aggregated (yesterday, Asia/Shanghai)."\n          },\n          "links": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "link_logs created that day."\n          },\n          "orders": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Sub-orders with paid_at that day, not reduced by later invalidation."\n          },\n          "est_rebate_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "new_users": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 0,\n            "description": "Users registered that day."\n          },\n          "as_of": {\n            "type": "string",\n            "format": "date-time",\n            "description": "Aggregation time."\n          }\n        }\n      },\n      "AdminPayoutChannelCode": {\n        "type": "string",\n        "description": "Payout channel (enum payout_method; the <channel> of payout.channel_paused.<channel>).",\n        "enum": [\n          "alipay",\n          "bank_card",\n          "wechat"\n        ]\n      },\n      "AdminDashboardStatus": {\n        "type": "object",\n        "description": "System status cards; returned only with permission point fund.view.",\n        "additionalProperties": false,\n        "required": [\n          "payout_queue_paused",\n          "payout_channel_paused",\n          "settle_auto_enabled",\n          "balance_w_expired"\n        ],\n        "properties": {\n          "payout_queue_paused": {\n            "type": "boolean",\n            "description": "payout.queue_paused."\n          },\n          "payout_channel_paused": {\n            "type": "array",\n            "description": "Channels whose payout.channel_paused.<channel> is on; empty when none.",\n            "items": {\n              "$ref": "#/components/schemas/AdminPayoutChannelCode"\n            }\n          },\n          "settle_auto_enabled": {\n            "type": "boolean",\n            "description": "settle.auto.enabled."\n          },\n          "balance_w_expired": {\n            "type": [\n              "boolean",\n              "null"\n            ],\n            "description": "Whether the enterprise Alipay balance W is expired (BR-WDR-18); null until W entry ships."\n          }\n        }\n      },\n      "AdminDashboard": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "todo",\n          "yesterday"\n        ],\n        "properties": {\n          "todo": {\n            "type": "array",\n            "description": "To-do cards the account may see, in enum order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminDashboardTodo"\n            }\n          },\n          "yesterday": {\n            "$ref": "#/components/schemas/AdminDashboardYesterday"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminDashboardStatus"\n          }\n        }\n      },\n      "AdminDashboardResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminDashboard"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAccountStatus": {\n        "type": "string",\n        "description": "Admin account status (enum admin_account_status).",\n        "enum": [\n          "active",\n          "disabled"\n        ]\n      },\n      "AdminAccount": {\n        "type": "object",\n        "description": "Read-only view of an admin account; no password, hash, TOTP secret or full phone.",\n        "additionalProperties": false,\n        "required": [\n          "admin_id",\n          "username",\n          "is_super",\n          "status",\n          "totp_bound",\n          "verify_phone_masked",\n          "locked_until",\n          "permissions",\n          "created_at"\n        ],\n        "properties": {\n          "admin_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "username": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64\n          },\n          "is_super": {\n            "type": "boolean"\n          },\n          "status": {\n            "$ref": "#/components/schemas/AdminAccountStatus"\n          },\n          "totp_bound": {\n            "type": "boolean",\n            "description": "false = the next login goes through the first binding."\n          },\n          "verify_phone_masked": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 32\n          },\n          "locked_until": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "End of the current login lock; null when not locked."\n          },\n          "permissions": {\n            "type": "array",\n            "description": "Ticked points (admin_permissions); empty for a super admin, who has every point.",\n            "uniqueItems": true,\n            "items": {\n              "$ref": "#/components/schemas/AdminPermissionKey"\n            }\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminAccountResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAccount"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "AdminAccountPage": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "page",\n          "page_size",\n          "total"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/AdminAccount"\n            }\n          },\n          "page": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1\n          },\n          "page_size": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "maximum": 200\n          },\n          "total": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          }\n        }\n      },\n      "AdminAccountPageResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/AdminAccountPage"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "PlatformIconKey": {\n        "type": "string",\n        "description": "Platform mark key (enum platform_icon_key, BR-TEXT-24 细则标识键表); the keys of /v1/config\\n`platform_icons` (ConfigPlatformIcons) are the same list.\\n",\n        "enum": [\n          "taobao",\n          "tmall",\n          "jd",\n          "pdd",\n          "wechat",\n          "wechat_pay",\n          "alipay",\n          "wecom"\n        ]\n      },\n      "AdminPlatformIconFormat": {\n        "type": "string",\n        "description": "Format of a cleaned platform mark file.",\n        "enum": [\n          "svg",\n          "png"\n        ]\n      },\n      "AdminPlatformIconSha256": {\n        "type": "string",\n        "pattern": "^[0-9a-f]{64}$",\n        "description": "Lowercase hex SHA-256 of the cleaned file, the same digest as its file name."\n      },\n      "AdminPlatformIconUrl": {\n        "type": "string",\n        "format": "uri",\n        "pattern": "^https://",\n        "maxLength": 2048,\n        "description": "Cleaned file on the media domain (set by deployment), named by its SHA-256; shown only as\\nan image (`<img>`), never inlined into the page.\\n"\n      },\n      "AdminPlatformIconSourceUrl": {\n        "type": "string",\n        "format": "uri",\n        "pattern": "^https?://",\n        "maxLength": 2048,\n        "description": "Official brand or asset download page the file was taken from (BR-TEXT-24 细则「必填登记」)."\n      },\n      "AdminPlatformIconVersion": {\n        "type": "object",\n        "description": "One saved version of a platform mark (BR-TEXT-24).",\n        "additionalProperties": false,\n        "required": [\n          "version",\n          "url",\n          "sha256",\n          "format",\n          "bytes",\n          "sanitized",\n          "source_url",\n          "downloaded_on",\n          "publishable",\n          "ever_published",\n          "revision",\n          "created_by",\n          "created_at"\n        ],\n        "properties": {\n          "version": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Counted per mark from 1; the same number /v1/config sends once published."\n          },\n          "url": {\n            "$ref": "#/components/schemas/AdminPlatformIconUrl"\n          },\n          "sha256": {\n            "$ref": "#/components/schemas/AdminPlatformIconSha256"\n          },\n          "format": {\n            "$ref": "#/components/schemas/AdminPlatformIconFormat"\n          },\n          "bytes": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "Size of the cleaned file."\n          },\n          "sanitized": {\n            "type": "boolean",\n            "description": "true = the cleaned file differs from the uploaded original."\n          },\n          "source_url": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminPlatformIconSourceUrl"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "downloaded_on": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date",\n            "description": "Date the file was downloaded from the source page; null = not registered."\n          },\n          "publishable": {\n            "type": "boolean",\n            "description": "true = both source_url and downloaded_on are registered; false = draft."\n          },\n          "ever_published": {\n            "type": "boolean",\n            "description": "true = published at least once; its registration can no longer be changed."\n          },\n          "revision": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 1,\n            "description": "1 when saved, plus 1 on every registration change (PATCH .../versions/{version}); the\\nCAS value of that PATCH.\\n"\n          },\n          "created_by": {\n            "type": "string",\n            "minLength": 1,\n            "maxLength": 64,\n            "description": "Username of the admin who saved the version."\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPlatformIcon": {\n        "type": "object",\n        "description": "A platform mark and its published version (null = built-in image).",\n        "additionalProperties": false,\n        "required": [\n          "key",\n          "current_version",\n          "revision",\n          "current",\n          "latest_version",\n          "updated_by",\n          "updated_at"\n        ],\n        "properties": {\n          "key": {\n            "$ref": "#/components/schemas/PlatformIconKey"\n          },\n          "current_version": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Published version; null = the client shows the bundled image."\n          },\n          "revision": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0,\n            "description": "0 until the first publish; plus 1 on every publish, rollback and restore-builtin, never\\ngoing back (saving or registering a version does not change it). The CAS value of\\npublish and restore-builtin, so a retried old request cannot undo a later change.\\n"\n          },\n          "current": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/AdminPlatformIconVersion"\n              },\n              {\n                "type": "null"\n              }\n            ]\n          },\n          "latest_version": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Newest saved version, drafts included; null = nothing saved yet."\n          },\n          "updated_by": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "maxLength": 64,\n            "description": "Username of the admin who last saved, published, rolled back or restored; null = never changed."\n          },\n          "updated_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time"\n          }\n        }\n      },\n      "AdminPlatformIconList": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "description": "Every key of enum platform_icon_key once, in enum order.",\n            "items": {\n              "$ref": "#/components/schemas/AdminPlatformIcon"\n            }\n          }\n        }\n      },\n      "AdminPlatformIconListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\