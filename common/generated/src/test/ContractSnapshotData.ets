mas/Fen"\n          },\n          "estimated_total_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "estimated_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "pending_credit_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "pending_credit_paused_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "next_credit_period": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"\n          },\n          "credit_overdue": {\n            "type": "boolean"\n          },\n          "withdrawn_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "risk_paused_reason": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "withdraw_enabled": {\n            "type": "boolean"\n          }\n        }\n      },\n      "WalletSummaryResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/WalletSummary"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "LedgerEntry": {\n        "description": "An available-subaccount entry, or the WITHDRAW_PAID summary entry of a paid withdrawal (BR-FUND-15).",\n        "oneOf": [\n          {\n            "$ref": "#/components/schemas/LedgerPostingEntry"\n          },\n          {\n            "$ref": "#/components/schemas/LedgerWithdrawPaidEntry"\n          }\n        ]\n      },\n      "LedgerPostingEn