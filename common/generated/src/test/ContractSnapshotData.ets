meters/Build"\n          },\n          {\n            "$ref": "#/components/parameters/Channel"\n          },\n          {\n            "$ref": "#/components/parameters/TraceId"\n          },\n          {\n            "$ref": "#/components/parameters/DeviceId"\n          },\n          {\n            "$ref": "#/components/parameters/UnionPlatform"\n          },\n          {\n            "name": "installed",\n            "in": "query",\n            "required": false,\n            "description": "Whether the platform app is installed; when absent see BR-ID-22 细则.",\n            "schema": {\n              "$ref": "#/components/schemas/InstalledState"\n            }\n          }\n        ],\n        "responses": {\n          "200": {\n            "description": "The authorization link.",\n            "content": {\n              "application/json": {\n                "schema": {\n                  "$ref": "#/components/schemas/UnionAuthUrlResponse"\n                },\n                "examples": {\n                  "taobao": {\n                    "summary": "Taobao, SDK first",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "auth_url": "https://oauth.example.test/authorize?state=st_01",\n                        "state": "st_01",\n                        "auth_methods": [\n                          "sdk_token",\n                          "web_code"\n                        ]\n                      },\n                      "trace_id": "0199a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"\n                    }\n                  },\n                  "pdd": {\n                    "summary": "Pinduoduo, with an authorization jump plan",\n                    "value": {\n                      "code": 0,\n                      "msg": "",\n                      "data": {\n                        "auth_url": "https://auth.example.test/pdd/authorize?state=st_02",\n                  