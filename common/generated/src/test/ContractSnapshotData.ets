   ],\n            "format": "int32",\n            "description": "The error code that blocks a withdrawal now (contracts/error-codes.yaml), null when none."\n          },\n          "block_reason": {\n            "type": [\n              "string",\n              "null"\n            ]\n          },\n          "max_withdrawable_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "withdrawable_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "daily_remaining": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "monthly_remaining": {\n            "type": "integer",\n            "format": "int32",\n            "minimum": 0\n          },\n          "est_fee_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "est_tax_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "est_net_fen": {\n            "$ref": "#/components/schemas/NullableFen"\n          },\n          "quick_amounts_fen": {\n            "type": "array",\n            "description": "Quick amount choices; empty when there are none.",\n            "items": {\n              "$ref": "#/components/schemas/Fen"\n            }\n          }\n        }\n      },\n      "WithdrawRulesResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/WithdrawRules"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "CreateWithdrawalRequest": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "amount_fen"\n        ],\n        "properties": {\n          "amount_fen": {\n            "type": "integer",\n            "format": "int64",\n            "minimum": 1\n          }\n        }\n      },\n      "WithdrawalSummary": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "withdrawal_id",\n          "status",\n          "review_mode",\n          "amount_fen",\n          "fee_fen",\n          "tax_fen",\n          "net_fen",\n          "payout_channel",\n          "payout_channel_name",\n          "masked_account",\n          "reason_code",\n          "fail_action",\n          "created_at",\n          "review_deadline",\n          "executed_at",\n          "first_attempt_at",\n          "paid_at",\n          "channel_state",\n          "confirm_deadline",\n          "sub_text_branch",\n          "hold_days"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "$ref": "#/components/schemas/WithdrawalStatus"\n          },\n          "review_mode": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalReviewMode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Null until decided after submission (BR-WDR-30)."\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "fee_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "tax_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "net_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "payout_channel": {\n            "type": "string",\n            "description": "contracts/enums/fund.yaml payout_method (withdrawals.payout_channel).",\n            "enum": [\n              "alipay",\n              "bank_card",\n              "wechat"\n            ]\n          },\n          "payout_channel_name": {\n            "type": "string"\n          },\n          "masked_account": {\n            "type": "string",\n            "description": "Masked snapshot of the payee account (BR-ID-33 细则)."\n          },\n          "reason_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "reject_reason_code or fail_code of a rejected or failed withdrawal (BR-TEXT-06)."\n          },\n          "fail_action": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Action for account-type failures, e.g. change_payout_account (BR-TEXT-08). Null on\\nevery other withdrawal, including a W10 failure (manual_resolution=failed,\\nsub_text_branch failed_manual): the needs_manual resolution (BR-WDR-15) does not offer\\nchanging the payout account.\\n"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "review_deadline": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.review_deadline, the manual-review deadline (BR-WDR-26); null when the\\nwithdrawal has none. Interpolated by the manual_review_pending sub-text (BR-WDR-25).\\n"\n          },\n          "executed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.executed_at; null before execution and again after a W9 return to APPROVED\\n(BR-WDR-13).\\n"\n          },\n          "first_attempt_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Time of the first transfer attempt (payout_attempts kind=transfer) of this withdrawal;\\nnull while there is none. T of the PAYING branches of BR-WDR-25 is first_attempt_at, or\\nexecuted_at when first_attempt_at is null; the server applies it in sub_text_branch.\\n"\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.paid_at; set only in PAID_API / PAID_MANUAL, otherwise null."\n          },\n          "channel_state": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalChannelState"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "withdrawals.channel_state (BR-WDR-33 ⑤); only a wechat withdrawal in PAYING has a\\nvalue, otherwise null. Not a withdrawal status.\\n"\n          },\n          "confirm_deadline": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.confirm_deadline, the latest time to confirm the transfer in WeChat\\n(BR-WDR-33 ⑥); only wechat withdrawals, otherwise null. Interpolated by the\\nwechat_wait_confirm sub-text (BR-WDR-25).\\n"\n          },\n          "sub_text_branch": {\n            "$ref": "#/components/schemas/WithdrawalSubTextBranch"\n          },\n          "hold_days": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Days of the manual_failed_watch hold added with a W10 failure (BR-WDR-15; the hold\\nperiod of withdraw.manual_failed_hold_days at the time of the decision), interpolated by\\nthe failed_manual sub-text (BR-WDR-25). Both W10 rows of the BR-WDR-25 table have\\nsub_text_branch failed_manual; hold_days alone tells them apart: non-null when the hold\\nwas added (the sub-text with the hold sentence), null when it was not (a wechat\\nwithdrawal proven cancelled, BR-WDR-33 ⑧; the sub-text without the hold sentence). Null\\non every other withdrawal.\\n"\n          }\n        }\n      },\n      "Withdrawal": {\n        "type": "object",\n        "additionalProperties": false,\n        "description": "A withdrawal with channel_order_id (detail and create response).",\n        "required": [\n          "withdrawal_id",\n          "status",\n          "review_mode",\n          "amount_fen",\n          "fee_fen",\n          "tax_fen",\n          "net_fen",\n          "payout_channel",\n          "payout_channel_name",\n          "masked_account",\n          "reason_code",\n          "fail_action",\n          "created_at",\n          "review_deadline",\n          "executed_at",\n          "first_attempt_at",\n          "paid_at",\n          "channel_state",\n          "confirm_deadline",\n          "sub_text_branch",\n          "hold_days",\n          "channel_order_id"\n        ],\n        "properties": {\n          "withdrawal_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "status": {\n            "$ref": "#/components/schemas/WithdrawalStatus"\n          },\n          "review_mode": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalReviewMode"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "Null until decided after submission (BR-WDR-30)."\n          },\n          "amount_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "fee_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "tax_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "net_fen": {\n            "$ref": "#/components/schemas/Fen"\n          },\n          "payout_channel": {\n            "type": "string",\n            "description": "contracts/enums/fund.yaml payout_method (withdrawals.payout_channel).",\n            "enum": [\n              "alipay",\n              "bank_card",\n              "wechat"\n            ]\n          },\n          "payout_channel_name": {\n            "type": "string"\n          },\n          "masked_account": {\n            "type": "string",\n            "description": "Masked snapshot of the payee account (BR-ID-33 细则)."\n          },\n          "reason_code": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "reject_reason_code or fail_code of a rejected or failed withdrawal (BR-TEXT-06)."\n          },\n          "fail_action": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Action for account-type failures, e.g. change_payout_account (BR-TEXT-08). Null on\\nevery other withdrawal, including a W10 failure (manual_resolution=failed,\\nsub_text_branch failed_manual): the needs_manual resolution (BR-WDR-15) does not offer\\nchanging the payout account.\\n"\n          },\n          "created_at": {\n            "type": "string",\n            "format": "date-time"\n          },\n          "review_deadline": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.review_deadline, the manual-review deadline (BR-WDR-26); null when the\\nwithdrawal has none. Interpolated by the manual_review_pending sub-text (BR-WDR-25).\\n"\n          },\n          "executed_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.executed_at; null before execution and again after a W9 return to APPROVED\\n(BR-WDR-13).\\n"\n          },\n          "first_attempt_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "Time of the first transfer attempt (payout_attempts kind=transfer) of this withdrawal;\\nnull while there is none. T of the PAYING branches of BR-WDR-25 is first_attempt_at, or\\nexecuted_at when first_attempt_at is null; the server applies it in sub_text_branch.\\n"\n          },\n          "paid_at": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.paid_at; set only in PAID_API / PAID_MANUAL, otherwise null."\n          },\n          "channel_state": {\n            "anyOf": [\n              {\n                "$ref": "#/components/schemas/WithdrawalChannelState"\n              },\n              {\n                "type": "null"\n              }\n            ],\n            "description": "withdrawals.channel_state (BR-WDR-33 ⑤); only a wechat withdrawal in PAYING has a\\nvalue, otherwise null. Not a withdrawal status.\\n"\n          },\n          "confirm_deadline": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "format": "date-time",\n            "description": "withdrawals.confirm_deadline, the latest time to confirm the transfer in WeChat\\n(BR-WDR-33 ⑥); only wechat withdrawals, otherwise null. Interpolated by the\\nwechat_wait_confirm sub-text (BR-WDR-25).\\n"\n          },\n          "sub_text_branch": {\n            "$ref": "#/components/schemas/WithdrawalSubTextBranch"\n          },\n          "hold_days": {\n            "type": [\n              "integer",\n              "null"\n            ],\n            "format": "int32",\n            "minimum": 1,\n            "description": "Days of the manual_failed_watch hold added with a W10 failure (BR-WDR-15; the hold\\nperiod of withdraw.manual_failed_hold_days at the time of the decision), interpolated by\\nthe failed_manual sub-text (BR-WDR-25). Both W10 rows of the BR-WDR-25 table have\\nsub_text_branch failed_manual; hold_days alone tells them apart: non-null when the hold\\nwas added (the sub-text with the hold sentence), null when it was not (a wechat\\nwithdrawal proven cancelled, BR-WDR-33 ⑧; the sub-text without the hold sentence). Null\\non every other withdrawal.\\n"\n          },\n          "channel_order_id": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Channel serial number, only in PAID_API / PAID_MANUAL when recorded (BR-WDR-25 细则)."\n          }\n        }\n      },\n      "WithdrawalListData": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "items",\n          "next_cursor"\n        ],\n        "properties": {\n          "items": {\n            "type": "array",\n            "items": {\n              "$ref": "#/components/schemas/WithdrawalSummary"\n            }\n          },\n          "next_cursor": {\n            "type": [\n              "string",\n              "null"\n            ]\n          }\n        }\n      },\n      "WithdrawalListResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n        ],\n        "properties": {\n          "code": {\n            "$ref": "#/components/schemas/SuccessCode"\n          },\n          "msg": {\n            "type": "string"\n          },\n          "data": {\n            "$ref": "#/components/schemas/WithdrawalListData"\n          },\n          "trace_id": {\n            "$ref": "#/components/schemas/TraceId"\n          }\n        }\n      },\n      "WithdrawalResponse": {\n        "type": "object",\n        "additionalProperties": false,\n        "required": [\n          "code",\n          "msg",\n          "data",\n          "trace_id"\n   