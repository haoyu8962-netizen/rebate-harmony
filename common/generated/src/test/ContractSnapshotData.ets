erties": false,\n        "required": [\n          "reason",\n          "app_login_ok",\n          "phone_sms_ok"\n        ],\n        "properties": {\n          "reason": {\n            "$ref": "#/components/schemas/AdminUserReason"\n          },\n          "app_login_ok": {\n            "type": "boolean",\n            "description": "The agent confirmed in the conversation that the user can sign in to the App."\n          },\n          "phone_sms_ok": {\n            "type": "boolean",\n            "description": "The agent confirmed in the conversation that the bound phone number can receive SMS."\n          }\n        }\n      },\n      "AdminUserDataExport": {\n        "type": "object",\n        "description": "A personal information copy request (04 §3.2 personal_data_copies). Never carries a\\nlink, an extraction code or a password. Fields that only apply to some statuses are null\\notherwise.\\n",\n        "additionalProperties": false,\n        "required": [\n          "export_id",\n          "user_id",\n          "delivery",\n          "status",\n          "requested_by",\n          "created_at",\n          "due_at",\n          "retry_of",\n          "generated_at",\n          "delivered_at",\n          "expires_at",\n          "failure_reason"\n        ],\n        "properties": {\n          "export_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "user_id": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "delivery": {\n            "$ref": "#/components/schemas/PersonalDataCopyDelivery"\n          },\n          "status": {\n            "$ref": "#/components/schemas/PersonalDataCopyStatus"\n          },\n          "requested_by": {\n            "$ref": "#/components/schemas/Id"\n          },\n          "requested_by_name": {\n            "type": [\n              "string",\n              "null"\n            ],\n            "description": "Current name of the registrant (admin_users.display_name, else the 