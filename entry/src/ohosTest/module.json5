        "srcEntry": "./ets/testability/Fx25TestAbility.ets",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      },
      {
        "name": "Fx05aAbility",
        "srcEntry": "./ets/testability/Fx05aAbility.ets",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      }
    ]
  }
}
